{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "goal", "sources", "target", "currentStage", "writeScope"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "goal": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "path"],
        "properties": {
          "sourceId": { "type": "string" },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"
          },
          "role": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "target": {
      "type": "object",
      "required": ["map", "commander"],
      "properties": {
        "map": { "type": "string", "minLength": 1 },
        "commander": { "type": "string", "minLength": 1 },
        "series": { "type": "string" }
      },
      "additionalProperties": false
    },
    "currentStage": { "type": "string" },
    "writeScope": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"
      }
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
