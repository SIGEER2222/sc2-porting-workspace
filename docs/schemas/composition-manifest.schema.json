{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "composition-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "mapPackage", "commanderPackage", "loadOrder", "runtime", "acceptance"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "mapPackage": { "type": "string" },
    "commanderPackage": { "type": "string" },
    "loadOrder": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "runtime": {
      "type": "object",
      "required": ["launcherId", "mapPath", "commanderId"],
      "properties": {
        "launcherId": { "type": "string" },
        "mapPath": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"
        },
        "commanderId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "criterion", "evidenceType"],
        "properties": {
          "id": { "type": "string" },
          "criterion": { "type": "string", "minLength": 1 },
          "evidenceType": { "enum": ["static", "runtime", "manual"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
