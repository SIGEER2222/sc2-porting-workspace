{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-verdict.schema.json",
  "type": "object",
  "required": ["schemaVersion", "scenarioId", "runId", "status", "criteria", "evidence"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "scenarioId": { "type": "string" },
    "runId": { "type": "string" },
    "status": { "enum": ["passed", "failed", "inconclusive"] },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["passed", "failed", "not-observed"] },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
