{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-scenario.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "compositionId", "launcher", "readiness", "steps", "evidenceRoot"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "compositionId": { "type": "string" },
    "launcher": {
      "type": "object",
      "required": ["toolId", "command", "arguments"],
      "properties": {
        "toolId": { "type": "string" },
        "command": { "type": "string" },
        "arguments": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": ["strategy", "timeoutSeconds"],
      "properties": {
        "strategy": { "enum": ["alerts-and-script-error-grace", "process-and-game-logs", "observer-event"] },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "expected"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "expected": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "evidenceRoot": { "type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+" }
  },
  "additionalProperties": false
}
