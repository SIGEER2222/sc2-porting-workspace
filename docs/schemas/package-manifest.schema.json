{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "package-manifest.schema.json",
  "type": "object",
  "required": ["schemaVersion", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "ownership", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "kind": {
            "enum": [
              "map",
              "mod",
              "campaign",
              "shared-runtime",
              "commander",
              "series-adapter",
              "map-adapter",
              "commander-map-adapter",
              "external"
            ]
          },
          "ownership": { "enum": ["external", "source", "shared", "commander", "series", "map", "pairing"] },
          "source": {
            "type": "object",
            "required": ["sourceId", "path", "containerType"],
            "properties": {
              "sourceId": { "type": "string", "minLength": 1 },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+"
              },
              "containerType": { "enum": ["unpacked", "mpq", "native", "generated"] }
            },
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["packageId", "relation"],
              "properties": {
                "packageId": { "type": "string" },
                "relation": { "enum": ["declared", "transitive", "adapter", "runtime"] },
                "required": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
