{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-extraction-recipe.schema.json",
  "type": "object",
  "required": ["schemaVersion", "id", "source", "output", "copyPaths", "wholeEntries", "fieldMoves"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "source": {
      "type": "object",
      "required": ["sourceId", "baseMod", "targetMod", "gameDataRoot"],
      "properties": {
        "sourceId": { "type": "string" },
        "baseMod": { "type": "string" },
        "targetMod": { "type": "string" },
        "gameDataRoot": { "type": "string" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["artifactRoot", "report"],
      "properties": {
        "artifactRoot": { "type": "string", "pattern": "^artifacts/" },
        "report": { "type": "string" }
      },
      "additionalProperties": false
    },
    "copyPaths": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
    "wholeEntries": {
      "type": "object",
      "required": ["idOrParentPattern", "flags", "excludeIds", "includeIds", "expectedCount"],
      "properties": {
        "idOrParentPattern": { "type": "string" },
        "flags": { "type": "string" },
        "excludeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "includeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "expectedCount": { "type": "integer", "minimum": 1 },
        "targetCollisionPolicy": { "enum": ["merge-base-before-target", "retain-target-definition", "fail"] }
      },
      "additionalProperties": false
    },
    "fieldMoves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entryId", "childTag", "attribute", "pattern"],
        "properties": {
          "entryId": { "type": "string" },
          "childTag": { "type": "string" },
          "attribute": { "type": "string" },
          "pattern": { "type": "string" },
          "flags": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
