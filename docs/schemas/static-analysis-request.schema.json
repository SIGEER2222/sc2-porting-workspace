{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "static-analysis-request.schema.json",
  "type": "object",
  "required": ["schemaVersion", "compositionId", "analyzers", "coverage", "output"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "compositionId": { "type": "string" },
    "analyzers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["toolId", "capability"],
        "properties": {
          "toolId": { "type": "string" },
          "capability": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["dependencies", "catalog", "galaxy", "initializers", "triggers", "banks", "objectives", "rewards"]
      }
    },
    "output": {
      "type": "object",
      "required": ["dependencyGraph", "unresolved"],
      "properties": {
        "dependencyGraph": { "type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+" },
        "unresolved": { "type": "string", "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/]).+" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
