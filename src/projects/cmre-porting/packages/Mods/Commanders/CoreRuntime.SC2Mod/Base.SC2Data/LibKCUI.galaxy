//--------------------------------------------------------------------------------------------------
// Trigger: CU_GPAlarakGemPress
//--------------------------------------------------------------------------------------------------
bool libKCUI_gt_CU_GPAlarakGemPress_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_indexPlayer;

    // Automatic Variable Declarations
    playergroup autoAADB37CA_g;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    autoAADB37CA_g = libKCOR_gf_HumanPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(autoAADB37CA_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        if ((EventDialogControl() == libKCUI_gv_cU_GPAlarakButton[lv_indexPlayer])) {
            libKCUI_gv_cU_GPAlarakGemClickCount += 1;
            if ((ModI(libKCUI_gv_cU_GPAlarakGemClickCount, 2) == 1)) {
                CutsceneGoToBookmark(CutsceneGetTriggerControl(libKCUI_gv_cU_GPCutscene[lv_indexPlayer]), "WorkStart");
                SoundPlayForPlayer(SoundLink("AlarakGemActivate", 0), c_maxPlayers, PlayerGroupSingle(lv_indexPlayer), 100.0, 0.0);
            }
            else {
                CutsceneGoToBookmark(CutsceneGetTriggerControl(libKCUI_gv_cU_GPCutscene[lv_indexPlayer]), "WorkEnd");
                SoundPlayForPlayer(SoundLink("AlarakGemDeactivate", 0), c_maxPlayers, PlayerGroupSingle(lv_indexPlayer), 100.0, 0.0);
            }
            TriggerEnable(TriggerGetCurrent(), false);
            Wait(2.5, c_timeReal);
            TriggerEnable(TriggerGetCurrent(), true);
            return true;
        }

    }
    return true;
}

