// Trigger: CU_StetelliteMaxChargesChanged
//--------------------------------------------------------------------------------------------------
bool libKCUI_gt_CU_StetelliteMaxChargesChanged_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_stetmann;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_stetmann = EventPlayer();

    // Conditions
    if (testConds) {
        if (!((EventUpgradeName() == "DeployPowerTowerTechLevel"))) {
            return false;
        }

        if (!((libKCOR_gf_ActiveCommanderForPlayer(lv_stetmann) == "ZergStetmann"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libKCUI_gf_CU_SetStetelliteChargeMax(lv_stetmann);
    libKCUI_gf_CU_DrawStetelliteChargePips(lv_stetmann, (libKCUI_gv_cU_StetmannMaxStetelliteCharges[lv_stetmann] - RoundI(PlayerGetChargeUsed(lv_stetmann, "Abil/DeployPowerTowerStetmann"))), libKCUI_gv_cU_StetmannMaxStetelliteCharges[lv_stetmann]);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libKCUI_gt_CU_StetelliteMaxChargesChanged_Init () {
    libKCUI_gt_CU_StetelliteMaxChargesChanged = TriggerCreate("libKCUI_gt_CU_StetelliteMaxChargesChanged_Func");
    TriggerEnable(libKCUI_gt_CU_StetelliteMaxChargesChanged, false);
    TriggerAddEventUpgradeLevelChanged(libKCUI_gt_CU_StetelliteMaxChargesChanged, c_playerAny);
}

//--------------------------------------------------------------------------------------------------
// Trigger: CU_StetelliteChargesChanged
//--------------------------------------------------------------------------------------------------
bool libKCUI_gt_CU_StetelliteChargesChanged_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_stetmann;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_stetmann = UnitGetOwner(EventUnit());

    // Conditions
    if (testConds) {
        if (!((libKCOR_gf_PlayerIsCommander(lv_stetmann) == true))) {
            return false;
        }

        if (!((EventUnitBehavior() == "StetmannStetelliteChargesUsed"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libKCUI_gf_CU_DrawStetelliteChargePips(lv_stetmann, (libKCUI_gv_cU_StetmannMaxStetelliteCharges[lv_stetmann] - RoundI(PlayerGetChargeUsed(lv_stetmann, "Abil/DeployPowerTowerStetmann"))), libKCUI_gv_cU_StetmannMaxStetelliteCharges[lv_stetmann]);
    return true;
}

//--------------------------------------------------------------------------------------------------
void libKCUI_gt_CU_StetelliteChargesChanged_Init () {
    libKCUI_gt_CU_StetelliteChargesChanged = TriggerCreate("libKCUI_gt_CU_StetelliteChargesChanged_Func");
    TriggerEnable(libKCUI_gt_CU_StetelliteChargesChanged, false);
    TriggerAddEventUnitAttributeChange(libKCUI_gt_CU_StetelliteChargesChanged, null);
}

