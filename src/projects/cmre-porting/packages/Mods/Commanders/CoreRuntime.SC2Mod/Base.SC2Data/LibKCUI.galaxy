// Presets
// Functions
void libKCUI_gf_SetHeroPanelUnit (int lp_index, unit lp_heroUnit, int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    if ((lp_index != 2)) {
        libKCUI_gf_SetHeroPanelUnitOverride(lp_index, lp_heroUnit, lp_player);
    }
    else if ((UserDataGetInt("PlayerPrestige", libKCOR_gf_CC_PlayerActivePrestigeInstance(lp_player), "ReserveSecondaryHeroPanel", 1) != 1)) {
        libKCUI_gf_SetHeroPanelUnitOverride(lp_index, lp_heroUnit, lp_player);
    }
    else if (true) {
        TriggerDebugOutput(1, StringExternal("Param/Value/lib_KCUI_6622617D"), false);
    }
}

void libKCUI_gf_SetHeroPanelUnitOverride (int lp_index, unit lp_heroUnit, int lp_player) {
    // Variable Declarations
    bool lv_noValidHeroes;
    int lv_heroHotkey;
    playergroup lv_heroGroup;

    // Automatic Variable Declarations
    int autoCF1BD6E7_val;
    unit auto047A189E_val;
    int autoA3DB6D8D_val;

    // Variable Initialization
    lv_heroGroup = PlayerGroupEmpty();

    // Implementation
    lv_heroGroup = PlayerGroupSingle(lp_player);
    libKCUI_gv_cU_HeroUnit[lp_index][lp_player] = lp_heroUnit;
    libKCUI_gv_cU_HeroType[lp_index][lp_player] = libKCUI_gf_CU_HeroTypeFromUnitType(UnitGetType(lp_heroUnit));
    autoCF1BD6E7_val = libKCUI_gv_cU_HeroType[lp_index][lp_player];
    if (autoCF1BD6E7_val == libKCUI_ge_CampaignHeroes_Hyperion) {
        libKCUI_gv_cU_HeroShowLevel[lp_index][lp_player] = false;
    }
    else if (autoCF1BD6E7_val == libKCUI_ge_CampaignHeroes_LaserDrill) {
        libKCUI_gv_cU_HeroShowLevel[lp_index][lp_player] = false;
    }
    else {
        libKCUI_gv_cU_HeroShowLevel[lp_index][lp_player] = true;
    }
    libKCUI_gf_CU_UpdateHeroPanel(lp_index, lp_player);
    if ((PlayerRace(lp_player) == "Zerg")) {
        DialogControlSendAnimationEvent(libKCUI_gv_cU_HeroPanel[lp_index], PlayerGroupSingle(lp_player), "SwitchZerg");
    }
    else if ((PlayerRace(lp_player) == "Terr")) {
        DialogControlSendAnimationEvent(libKCUI_gv_cU_HeroPanel[lp_index], PlayerGroupSingle(lp_player), "SwitchTerran");
    }
    else if ((libKCUI_gf_CU_ChampionHasShields2(libKCUI_gf_CU_HeroTypeFromUnitType(UnitGetType(lp_heroUnit))) == true)) {
        DialogControlSendAnimationEvent(libKCUI_gv_cU_HeroPanel[lp_index], PlayerGroupSingle(lp_player), "DefaultBarOffset");
    }
    else if (true) {
        DialogControlSendAnimationEvent(libKCUI_gv_cU_HeroPanel[lp_index], PlayerGroupSingle(lp_player), "EnergyBarOffset");
    }
    libKCUI_gv_cU_HeroExists[lp_player][lp_index] = true;
    if ((libKCUI_gv_cU_HeroUnit[lp_index][lp_player] == null)) {
        libKCUI_gv_cU_HeroExists[lp_player][lp_index] = false;
    }
    else {
        TriggerEnable(libKCUI_gt_CU_HeroPanelUpdate, true);
        TriggerEnable(libKCUI_gt_CU_HeroUnitDamaged, true);
        TriggerEnable(libKCUI_gt_CU_HeroMouseHoverText, true);
        TriggerEnable(libKCUI_gt_CU_HeroUnitVitalChange, true);
        auto047A189E_val = lp_heroUnit;
        {
            libNtve_gf_SetDialogItemAnimationDuration(libKCUI_gv_cU_HeroDialogCooldownImage[lp_index], 60.0, lv_heroGroup);
        }
        autoA3DB6D8D_val = lp_index;
        if (autoA3DB6D8D_val == 1) {
            lv_heroHotkey = c_hotkeyHeroSelect0;
        }
        else if (autoA3DB6D8D_val == 2) {
            lv_heroHotkey = c_hotkeyHeroSelect1;
        }
        else {
        }
        if ((lp_index <= libKCUI_gv_cUC_HeroMaxCount)) {
            libNtve_gf_SetDialogItemHotkey(libKCUI_gv_cU_HeroDialogButton[lp_index], lv_heroHotkey, lv_heroGroup);
        }
        else {
            TriggerDebugOutput(1, StringExternal("Param/Value/lib_KCUI_63E3D1F3"), false);
        }
    }
}

void libKCUI_gf_CU_ShowHideHeroPanel (bool lp_showHide, int lp_index) {
    // Variable Declarations
    int lv_index;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    if ((libKCUI_gv_cU_HeroPanel[lp_index] != c_invalidDialogControlId)) {
        DialogControlSetVisible(libKCUI_gv_cU_HeroPanel[lp_index], PlayerGroupAll(), lp_showHide);
    }

}

void libKCUI_gf_CU_CreateHeroPanel (int lp_index) {
    // Automatic Variable Declarations
    int auto2536CC65_val;

    // Implementation
    if ((lp_index == 1)) {
        DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/ConsoleUIContainer/VoidHeroUnitFrame");
    }
    else {
        DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/ConsoleUIContainer/SecondaryVoidHeroUnitFrame");
    }
    libKCUI_gv_cU_HeroPanel[lp_index] = DialogControlLastCreated();
    DialogControlSetVisible(DialogControlLastCreated(), PlayerGroupAll(), false);
    DialogControlHookup(libKCUI_gv_cU_HeroPanel[lp_index], c_triggerControlTypeImage, "BorderImage");
    libKCUI_gv_cU_HeroDialogBorderImage[lp_index] = DialogControlLastCreated();
    libNtve_gf_SetDialogItemAcceptMouse(DialogControlLastCreated(), true, PlayerGroupAll());
    DialogControlHookup(libKCUI_gv_cU_HeroPanel[lp_index], c_triggerControlTypeImage, "BorderNoEnergyImage");
    libKCUI_gv_cU_HeroDialogBorderImageNoEnergy[lp_index] = DialogControlLastCreated();
