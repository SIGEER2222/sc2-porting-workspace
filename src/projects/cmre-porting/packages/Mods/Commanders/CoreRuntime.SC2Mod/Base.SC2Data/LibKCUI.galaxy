        if (((EventDialogControl() == libKCUI_gv_cU_HeroDialogBorderImage[2]) || (EventDialogControl() == libKCUI_gv_cU_HeroDialogBorderImageNoEnergy[2]) || (EventDialogControl() == libKCUI_gv_cU_HeroDialogButton[2]))) {
            lv_index = 2;
        }
        else {
            return true;
        }
    }
    autoF3A5F50D_val = EventDialogControlEventType();
    if (autoF3A5F50D_val == c_triggerControlEventTypeMouseEnter) {
        if ((UnitGetPropertyFixed(libKCUI_gv_cU_HeroUnit[lv_index][EventPlayer()], c_unitPropLifeMax, c_unitPropCurrent) > 0)) {
            DialogControlSetVisible(libKCUI_gv_cU_HeroDialogHealthLabel[lv_index], lv_heroGroup, true);
