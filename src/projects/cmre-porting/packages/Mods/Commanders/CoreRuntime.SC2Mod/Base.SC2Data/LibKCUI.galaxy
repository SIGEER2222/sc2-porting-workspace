    if ((lv_commander == "ProtossArtanis") || (lv_commander == "ProtossVorazun") || (lv_commander == "ProtossKarax") || (lv_commander == "ProtossAlarak") || (lv_commander == "ProtossFenix") || (lv_commander == "ProtossZeratul") || (lv_commander == "TerranRaynor") || (lv_commander == "TerranSwann") || (lv_commander == "TerranNova") || (lv_commander == "TerranHorner") || (lv_commander == "TerranTychus") || (lv_commander == "TerranMengsk") || (lv_commander == "ZergStetmann") || (lv_commander == "ZergAbathur") || (lv_commander == "ZergStukov") || (lv_commander == "ZergDehaka")) {
