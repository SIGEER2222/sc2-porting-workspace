// Trigger: CU_TimerWindowThresholdCrossed
//--------------------------------------------------------------------------------------------------
bool libKCUI_gt_CU_TimerWindowThresholdCrossed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TimerWindowSetTimer(TimerWindowLastCreated(), TimerLastStarted());
    if ((TimerGetRemaining(libKCUI_gv_cU_TimerWindowTimer) <= libKCUI_gv_cU_TimerWindowDangerThreshold) && (libKCUI_gv_cU_TimerWindowInDanger == false)) {
        libKCUI_gv_cU_TimerWindowInDanger = true;
        DialogControlSendAnimationEvent(libKCUI_gv_cU_TimerWindowHighlightFrame, PlayerGroupAll(), "Danger");
    }
    else if ((TimerGetRemaining(libKCUI_gv_cU_TimerWindowTimer) > libKCUI_gv_cU_TimerWindowDangerThreshold) && (libKCUI_gv_cU_TimerWindowInDanger == true)) {
        libKCUI_gv_cU_TimerWindowInDanger = false;
        DialogControlSendAnimationEvent(libKCUI_gv_cU_TimerWindowHighlightFrame, PlayerGroupAll(), "DangerStop");
    }
    return true;
}

