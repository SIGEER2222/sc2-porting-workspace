//--------------------------------------------------------------------------------------------------
// Trigger: ChooseUnit
//--------------------------------------------------------------------------------------------------
bool lib67C0F0E7_gt_ChooseUnit_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_j;
    int lv_i;
    int lv_player;
    string[10] lv_unitType;
    unitgroup lv_unitGroup;
    unitgroup lv_cUG;
    unit lv_u;
    int lv_ui;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_j = -1;
    lv_player = EventPlayer();
    lv_unitGroup = UnitGroupEmpty();
    lv_cUG = UnitGroupEmpty();

    // Actions
    if (!runActions) {
        return true;
    }

        lv_cUG = UnitGroupSelected(lv_player);
        lv_ui = UnitGroupCount(lv_cUG, c_unitCountAll);
        for (;; lv_ui -= 1) {
            lv_u = UnitGroupUnitFromEnd(lv_cUG, lv_ui);
            if (lv_u == null) { break; }
            lv_i = 0;
            for ( ; (lv_i <= 9) ; lv_i += 1) {
                if ((lv_unitType[lv_i] == null)) {
                    lv_unitType[lv_i] = UnitGetType(lv_u);
                    lv_j += 1;
                    break;
                }
                else {
                    if ((lv_unitType[lv_i] == UnitGetType(lv_u))) {
                        break;
                    }
                }
            }
        }
        if ((lv_j == -1)) {
            UnitGroupAddUnitGroup(lv_unitGroup, UnitGroup(null, lv_player, RegionPlayableMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterAlly) | (1 << c_targetFilterNeutral) | (1 << c_targetFilterEnemy) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
        }
        else {
            lv_i = 0;
            for ( ; (lv_i <= lv_j) ; lv_i += 1 ) {
                UnitGroupAddUnitGroup(lv_unitGroup, UnitGroup(lv_unitType[lv_i], lv_player, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
            }
        }
        UnitGroupSelect(lv_unitGroup, lv_player, true);
    return true;
}

