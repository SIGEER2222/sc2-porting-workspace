point lib67C0F0E7_gf_EdgeInstersection (point lp_start, point lp_end, region lp_region) {
    // Variable Declarations
    fixed lv_x1;
    fixed lv_y1;
    fixed lv_x2;
    fixed lv_y2;
    fixed lv_dx;
    fixed lv_dy;
    fixed lv_a;
    fixed lv_fin;
    int lv_i;
    int lv_index;
    point lv_target;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_x1 = PointGetX(lp_start);
    lv_y1 = PointGetY(lp_start);
    lv_x2 = PointGetX(lp_end);
    lv_y2 = PointGetY(lp_end);
    lv_dx = (lv_x2-lv_x1);
    lv_dy = (lv_y2-lv_y1);
    if (lv_dx!=0){
        lv_a=(PointGetX(RegionGetBoundsMin(lp_region))-lv_x1)/lv_dx;
        if (lv_a>0){
            lv_fin=(lv_y1+(lv_dy*lv_a));
            if ((PointGetY(RegionGetBoundsMin(lp_region))<=lv_fin)&&(lv_fin<=PointGetY(RegionGetBoundsMax(lp_region)))){
                lv_target=Point(PointGetX(RegionGetBoundsMin(lp_region)),lv_fin);
            }
        }
    }
    if (lv_dx!=0){
        lv_a=(PointGetX(RegionGetBoundsMax(lp_region))-lv_x1)/lv_dx;
        if (lv_a>0){
            lv_fin=(lv_y1+(lv_dy*lv_a));
            if ((PointGetY(RegionGetBoundsMin(lp_region))<=lv_fin)&&(lv_fin<=PointGetY(RegionGetBoundsMax(lp_region)))){
                lv_target=Point(PointGetX(RegionGetBoundsMax(lp_region)),lv_fin);
            }
        }
    }
    if (lv_dy!=0){
        lv_a=(PointGetY(RegionGetBoundsMin(lp_region))-lv_y1)/lv_dy;
        if (lv_a>0){
            lv_fin=(lv_x1+(lv_dx*lv_a));
            if ((PointGetX(RegionGetBoundsMin(lp_region))<=lv_fin)&&(lv_fin<=PointGetX(RegionGetBoundsMax(lp_region)))){
                lv_target=Point(lv_fin,PointGetY(RegionGetBoundsMin(lp_region)));
            }
        }
    }
    if (lv_dy!=0){
        lv_a=(PointGetY(RegionGetBoundsMax(lp_region))-lv_y1)/lv_dy;
        if (lv_a>0){
            lv_fin=(lv_x1+(lv_dx*lv_a));
            if ((PointGetX(RegionGetBoundsMin(lp_region))<=lv_fin)&&(lv_fin<=PointGetX(RegionGetBoundsMax(lp_region)))){
                lv_target=Point(lv_fin,PointGetY(RegionGetBoundsMax(lp_region)));
            }
        }
    }
    return lv_target;
}

bool lib67C0F0E7_gf_IsEven (int lp_var) {
    // Automatic Variable Declarations
    // Implementation
    if (((lp_var & 1) == 0)) {
        return true;
    }
    else {
        return false;
    }
}

int lib67C0F0E7_gf_BitMaskSetIndex (int lp_bit, int lp_index, bool lp_on) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_i=lp_bit;
    if (lp_on)  {lv_i |= (1<<lp_index);} 
    else {lv_i &= (~(1<<lp_index));}
    return lv_i;
}

bool lib67C0F0E7_gf_BitMaskTrueIndexIs (int lp_bit, int lp_index) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_i=(1<<lp_index);
    return ((lp_bit & lv_i) == lv_i);
}

bool lib67C0F0E7_gf_BitMaskTrueIndex (int lp_bit, int lp_index) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_i=(1<<lp_index);
    return ((lp_bit & lv_i) == lv_i);
}

