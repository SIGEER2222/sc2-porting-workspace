//--------------------------------------------------------------------------------------------------
bool lib67C0F0E7_gt_SOATargetingOrder_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_casterPlayer;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

