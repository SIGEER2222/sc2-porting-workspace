// Functions
bool lib67C0F0E7_gf_Once () {
    // Automatic Variable Declarations
    // Implementation
    return (TriggerGetExecCount(TriggerGetCurrent())==0);
}

bool lib67C0F0E7_gf_Open () {
    // Automatic Variable Declarations
    // Implementation
    return TriggerIsEnabled(TriggerGetCurrent());
}

bool lib67C0F0E7_gf_PlayerControl (unitgroup lp_ug) {
    // Variable Declarations
    unit lv_u;
    int lv_i;
    int lv_j;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_i = UnitGroupCount(lp_ug, c_unitCountAll);
    for (;; lv_i -= 1) {
        lv_u = UnitGroupUnitFromEnd(lp_ug, lv_i);
        if (lv_u == null) { break; }
        if ((PlayerType(UnitGetOwner(lv_u)) == c_playerTypeUser)) {
            lv_j += 1;
        }

    }
    if ((UnitGroupCount(lp_ug, c_unitCountAlive) == lv_j)) {
        return true;
    }
    else {
        return false;
    }
}

void lib67C0F0E7_gf_RandomIntNR (int lp_var) {
    // Variable Declarations
    int lv_i;
    int lv_r;
    int lv_j;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    lv_i = 0;
    for ( ; ( lv_i <= lp_var ) ; lv_i += 1 ) {
        DataTableSetInt(true, ("Random" + IntToString(lv_i)), lv_i);
    }
    lv_i = 0;
    for ( ; ( lv_i <= lp_var ) ; lv_i += 1 ) {
        lv_r = RandomInt(lv_i, lp_var);
        lv_j = DataTableGetInt(true, ("Random" + IntToString(lv_i)));
        DataTableSetInt(true, ("Random" + IntToString(lv_i)), DataTableGetInt(true, ("Random" + IntToString(lv_r))));
        DataTableSetInt(true, ("Random" + IntToString(lv_r)), lv_j);
    }
}

