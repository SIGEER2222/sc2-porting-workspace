        TriggerDebugOutput(1, StringToText("EffPrep"), true);
    }
    else if (auto2A5BC9B8_val == c_abilEffectStageCast) {
        TriggerDebugOutput(1, StringToText("EffCast"), true);
    }
    else if (auto2A5BC9B8_val == c_abilEffectStageChannel) {
        TriggerDebugOutput(1, StringToText("EffChannel"), true);
    }
    else if (auto2A5BC9B8_val == c_abilEffectStageFinish) {
        TriggerDebugOutput(1, StringToText("EffFinish"), true);
    }
    else if (auto2A5BC9B8_val == c_abilEffectStageBail) {
