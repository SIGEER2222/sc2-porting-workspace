void lib67C0F0E7_gf_AnnularEffect (unit lp_unit, point lp_targetPoint, string lp_effect, fixed lp_radius, int lp_times) {
    // Variable Declarations
    int lv_roundNum;
    int lv_i;
    fixed lv_angle;
    fixed lv_distance;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_roundNum = 1;

    // Implementation
    if ((lp_times == 0)) {
        UnitCreateEffectPoint(lp_unit, lp_effect, lp_targetPoint);
        return ;
    }

    lv_roundNum = lp_times;
    lv_distance = lp_radius;
    lv_distance = (lv_distance*lv_roundNum*2);
    lv_roundNum = (lv_roundNum*6);
    lv_angle = (360/lv_roundNum);
        for ( ; ( lv_i <= lv_roundNum) ; lv_i += 1 ) {
            UnitCreateEffectPoint(lp_unit, lp_effect, PointWithOffsetPolar(lp_targetPoint, lv_distance, (lv_angle*lv_i)));
        }
}

void lib67C0F0E7_gf_AreaAnnularEffect (unit lp_unit, point lp_targetPoint, string lp_effect, fixed lp_radius, int lp_times, fixed lp_delayTime, bool lp_fromCenter) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
        if ((lp_fromCenter == true)) {
            lv_i = 0;
            for ( ; lv_i <= lp_times; lv_i += 1 ) {
                lib67C0F0E7_gf_AnnularEffect(lp_unit, lp_targetPoint, lp_effect, lp_radius, lv_i);
                Wait(lp_delayTime, c_timeGame);
            }
        }
        else {
            lv_i=lp_times;
            for ( ; lv_i >= 0; lv_i -= 1 ) {
                lib67C0F0E7_gf_AnnularEffect(lp_unit, lp_targetPoint, lp_effect, lp_radius, lv_i);
                Wait(lp_delayTime, c_timeGame);
            }
        }
}

