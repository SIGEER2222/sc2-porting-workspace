bool libKPVP_gt_mengsk_colors_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int lv_owner;

    // Conditions
    lv_owner = UnitGetOwner(EventUnitCreatedUnit());
    if (testConds) {
        if (!((PlayerGroupHasPlayer(libKPVP_gv_mengsk_players, lv_owner) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libE0EAE146_gf_RuntimeVisualProbe("KPVP_UnitCreateTeamColor", lv_owner, UnitGetType(EventUnitCreatedUnit()), IntToString(PlayerGetColorIndex(lv_owner, false)), UnitGetTag(EventUnitCreatedUnit()));
    UnitSetTeamColorIndex(EventUnitCreatedUnit(), PlayerGetColorIndex(lv_owner, false));
    return true;
}

