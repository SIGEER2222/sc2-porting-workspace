    TriggerExecute(libKMIS_gt_CM_HeroSpawn, true, true);
    TriggerExecute(libKMIS_gt_CM_GlobalCasterInit, true, true);
    Wait(0.05, c_timeGame);
    auto9B654530_g = libKCOR_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(auto9B654530_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        MeleeSetOption(lv_indexPlayer, c_meleeOptionXPGainDisable, false);
        if (((libKCOR_gf_ActiveCommanderForPlayer(lv_indexPlayer) == "TerranNova") || (libKCOR_gf_ActiveCommanderForPlayer(lv_indexPlayer) == "ZergZagara") || (libKCOR_gf_ActiveCommanderForPlayer(lv_indexPlayer) == "TerranTychus") || (libKCOR_gf_ActiveCommanderForPlayer(lv_indexPlayer) == "ProtossZeratul"))) {
            PlayerModifyPropertyFixed(lv_indexPlayer, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 100.0);
        }

    }
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeMenuBar, true);
    libKPVP_gf_set_alliance_button();
    libKMIS_gf_CM_ChatBarSetMode(libKMIS_ge_CM_ChatBarMode_CM_ChatBarNormal, PlayerGroupAll());
    libKPVP_gf_apply_peace_time();
    Wait(4.0, c_timeGame);
    autoB401BABE_g = libKCOR_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(autoB401BABE_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        libKCUI_gf_CU_GPVisibilitySet(true, lv_indexPlayer, c_transitionDurationImmediate);
    }
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KPVP_5B84F5F1"));
    Wait(20.0, c_timeGame);
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_KPVP_A61FC2DA"));
    Wait(30.0, c_timeGame);
    if ((PlayerGroupCount(PlayerGroupActive()) > 6)) {
        UIDisplayMessage(PlayerGroupActive(), c_messageAreaChat, StringExternal("Param/Value/lib_KPVP_C934A0F8"));
    }

}

