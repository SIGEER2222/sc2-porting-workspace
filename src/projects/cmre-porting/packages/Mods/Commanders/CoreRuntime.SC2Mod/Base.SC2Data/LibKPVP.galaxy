//--------------------------------------------------------------------------------------------------
// Trigger: set observer
//--------------------------------------------------------------------------------------------------
bool libKPVP_gt_setobserver_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto83D5F9D4_g;
    int auto83D5F9D4_var;

    // Actions
    if (!runActions) {
        return true;
    }

    UIUnitColorStyleOverride(libKPVP_gv_observerGroup, c_unitColorStyleNormal);
    auto83D5F9D4_g = PlayerGroupActive();
    auto83D5F9D4_var = -1;
    while (true) {
        auto83D5F9D4_var = PlayerGroupNextPlayer(auto83D5F9D4_g, auto83D5F9D4_var);
        if (auto83D5F9D4_var < 0) { break; }
        libNtve_gf_SetAllianceOneWay(libKPVP_gv_observer, auto83D5F9D4_var, libNtve_ge_AllianceSetting_Neutral);
        PlayerSetAlliance(auto83D5F9D4_var, c_allianceIdDefeat, libKPVP_gv_observer, true);
        PlayerSetAlliance(auto83D5F9D4_var, c_allianceIdPassive, libKPVP_gv_observer, true);
        PlayerSetAlliance(auto83D5F9D4_var, c_allianceIdControl, libKPVP_gv_observer, true);
        PlayerSetAlliance(auto83D5F9D4_var, c_allianceIdVision, libKPVP_gv_observer, true);
    }
    return true;
}

