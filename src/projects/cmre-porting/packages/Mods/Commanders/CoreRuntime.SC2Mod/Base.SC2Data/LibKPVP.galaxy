point libKPVP_gf_get_point_for_zeratul_artifact (int lp_player, int lp_artifact_num) {
    // Variable Declarations
    int lv_offset;
    fixed lv_r;
    point lv_artifact_point;
    point lv_tmp_point;
    region lv_search_region;
    region lv_search_region2;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_offset = 30;
    lv_r = DistanceBetweenPoints(RegionGetCenter(RegionPlayableMap()), PlayerStartLocation(lp_player));
    lv_search_region = RegionCircle(RegionGetCenter(RegionPlayableMap()), (DistanceBetweenPoints(RegionGetCenter(RegionPlayableMap()), PlayerStartLocation(lp_player)) - lv_offset));
    lv_search_region2 = RegionCircle(RegionGetCenter(RegionPlayableMap()), DistanceBetweenPoints(RegionGetCenter(RegionPlayableMap()), PlayerStartLocation(lp_player)));

    // Implementation
    if ((lv_r < 60.0)) {
        lv_search_region = RegionCircle(RegionGetCenter(RegionPlayableMap()), lv_r);
    }
    else {
        lv_search_region = RegionCircle(RegionGetCenter(RegionPlayableMap()), (lv_r - lv_offset));
    }
    while ((lv_artifact_point == null)) {
        lv_tmp_point = RegionRandomPoint(lv_search_region);
        if ((PointPathingPassable(lv_tmp_point) == true)) {
            lv_artifact_point = lv_tmp_point;
        }

    }
    return lv_artifact_point;
}

