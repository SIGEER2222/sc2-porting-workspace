include "LibKPVP_h"
include "LibKPVP_Commander"

//--------------------------------------------------------------------------------------------------
// Library: PVP
//--------------------------------------------------------------------------------------------------
// External Library Initialization
void libKPVP_InitLibraries () {
    libNtve_InitVariables();
    libKCOR_InitVariables();
    libKMIS_InitVariables();
    libKCUI_InitVariables();
}

// Variable Initialization
bool libKPVP_InitVariables_completed = false;

void libKPVP_InitVariables () {
    int init_i;

    if (libKPVP_InitVariables_completed) {
        return;
    }

    libKPVP_InitVariables_completed = true;

    libKPVP_gv_alliance_tab = c_invalidDialogId;
    for (init_i = 0; init_i <= 16; init_i += 1) {
        libKPVP_gv_commanders_names[init_i] = c_invalidDialogControlId;
    }
    libKPVP_gv_alliance_button_dialog = c_invalidDialogId;
    libKPVP_gv_alliance_button = c_invalidDialogControlId;
    libKPVP_gv_han_allies = PlayerGroupEmpty();
    libKPVP_gv_cOMMANDERS = PlayerGroupEmpty();
    libKPVP_gv_dehaka_players = PlayerGroupEmpty();
    libKPVP_gv_abathur_players = PlayerGroupEmpty();
    libKPVP_gv_tychus_players = PlayerGroupEmpty();
    libKPVP_gv_mengsk_players = PlayerGroupEmpty();
    libKPVP_gv_observer = CatalogFieldValueGetAsInt(c_gameCatalogGameUI, "Dflt", "DefaultObservedPlayerId", c_playerAny);
    libKPVP_gv_observerGroup = PlayerGroupSingle(CatalogFieldValueGetAsInt(c_gameCatalogGameUI, "Dflt", "DefaultObservedPlayerId", c_playerAny));
    libKPVP_gv_sTUKOV_ACTIVATED = PlayerGroupEmpty();
}

// Functions
void libKPVP_gf_set_alliance_button () {
    // Variable Declarations
    int lv_offset_y;
    int lv_label_height;
    int lv_player;
    int lv_num_of_players;
    string lv_button;

    // Automatic Variable Declarations
    playergroup auto749A30A7_g;

    // Variable Initialization
    lv_offset_y = 35;
    lv_label_height = 28;
    lv_num_of_players = PlayerGroupCount(PlayerGroupActive());

    // Implementation
    DialogCreate(825, (lv_label_height*lv_num_of_players+60), c_anchorTopLeft, 0, 0, true);
    libKPVP_gv_alliance_tab = DialogLastCreated();
    auto749A30A7_g = PlayerGroupActive();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(auto749A30A7_g, lv_player);
        if (lv_player < 0) { break; }
        libNtve_gf_CreateDialogItemLabel(libKPVP_gv_alliance_tab, 200, lv_label_height, c_anchorTopLeft, 35, lv_offset_y, PlayerName(lv_player), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(lv_player, false)), false, 2.0);
        libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ModLeftSize20", PlayerGroupAll());
        libNtve_gf_CreateDialogItemLabel(libKPVP_gv_alliance_tab, 250, lv_label_height, c_anchorTopLeft, 250, lv_offset_y, libKCOR_gf_CC_CommanderName(libKCOR_gf_ActiveCommanderForPlayer(lv_player)), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(lv_player, false)), false, 2.0);
        libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ModLeftSize20", PlayerGroupAll());
        libKPVP_gv_commanders_names[lv_player] = DialogControlLastCreated();
        if ((GameAttributeGameValue("[bnet:local/0.0/223536]3") == "0001")) {
            libNtve_gf_SetDialogItemTooltip(DialogControlLastCreated(), libKPVP_gf_mastery_tooltip_for_player(lv_player), PlayerGroupAll());
        }

        if ((GameAttributeGameValue("[bnet:local/0.0/223536]9") == "0001")) {
            lv_button = libKCOR_gf_CC_CommanderPrestigeIndexFace(libKCOR_gf_CC_CommanderData(libKCOR_gv_cCX_PlayerCommander[lv_player]), libKCOR_gf_CC_PlayerActivePrestigeIndex(lv_player));
            libNtve_gf_CreateDialogItemLabel(libKPVP_gv_alliance_tab, 300, lv_label_height, c_anchorTopRight, 35, lv_offset_y, StringExternal(CatalogFieldValueGet(c_gameCatalogButton, lv_button, "Name", lv_player)), libNtve_gf_ConvertPlayerColorToColor(PlayerGetColorIndex(lv_player, false)), false, 2.0);
            libNtve_gf_SetDialogItemStyle(DialogControlLastCreated(), "ModRightSize20", PlayerGroupAll());
            libNtve_gf_SetDialogItemTooltip(DialogControlLastCreated(), StringExternal(CatalogFieldValueGet(c_gameCatalogButton, lv_button, "Tooltip", lv_player)), PlayerGroupAll());
        }

        lv_offset_y = (lv_offset_y+lv_label_height);
    }
    DialogSetVisible(libKPVP_gv_alliance_tab, PlayerGroupAll(), false);
    DialogCreate(36, 36, c_anchorTopRight, 5, 5, true);
    libKPVP_gv_alliance_button_dialog = DialogLastCreated();
    libNtve_gf_CreateDialogItemButton(libKPVP_gv_alliance_button_dialog, 36, 36, c_anchorTopLeft, 0, 0, StringToText(""), StringToText(""), "Assets\\Textures\\ui_alliance_button_normalpressed.dds");
    libNtve_gf_SetDialogItemImage(DialogControlLastCreated(), "Assets\\Textures\\ui_alliance_button_normalpressed.dds", PlayerGroupAll());
    libNtve_gf_SetDialogItemImageType(DialogControlLastCreated(), c_triggerImageTypeNormal, PlayerGroupAll());
    libKPVP_gv_alliance_button = DialogControlLastCreated();
    DialogSetVisible(libKPVP_gv_alliance_button_dialog, PlayerGroupAll(), true);
    DialogSetVisible(libKPVP_gv_alliance_button_dialog, libKPVP_gv_observerGroup, false);
}

