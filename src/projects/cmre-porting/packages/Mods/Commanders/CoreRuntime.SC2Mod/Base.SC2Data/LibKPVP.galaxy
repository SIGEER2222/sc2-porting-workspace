// Trigger: alliance_button_pressed
//--------------------------------------------------------------------------------------------------
bool libKPVP_gt_alliance_button_pressed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == libKPVP_gv_alliance_button))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((DialogIsVisible(libKPVP_gv_alliance_tab, EventPlayer()) == true)) {
        DialogSetVisible(libKPVP_gv_alliance_tab, PlayerGroupSingle(EventPlayer()), false);
    }
    else {
        DialogSetVisible(libKPVP_gv_alliance_tab, PlayerGroupSingle(EventPlayer()), true);
    }
    return true;
}

