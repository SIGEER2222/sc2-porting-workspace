// Functions
void lib81FF3B49_gf_InitializeTychusEvent () {
    // Automatic Variable Declarations
    // Implementation
    lib67C0F0E7_gf_SOAStickyPoint(1, "TychusMedicTransport");
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility1Tychus")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility1Tychus");
    }
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility2Tychus")) {
