        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility3Tychus");
    }
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility4Tychus")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility4Tychus");
    }
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility5Tychus")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility5Tychus");
    }
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility6Tychus")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility6Tychus");
    }
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility7Tychus")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility7Tychus");
    }
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility8Tychus")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility8Tychus");
    }
    if (CatalogEntryIsValid(c_gameCatalogEffect, "ReviveAbility9Tychus")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_ReviveTychusSquad, 1, "ReviveAbility9Tychus");
    }
    TriggerEnable(lib81FF3B49_gt_ReviveTychusSquad,true);
    if (CatalogEntryIsValid(c_gameCatalogEffect, "TychusMedicTransportUnit")) {
        TriggerAddEventPlayerEffectUsed(lib81FF3B49_gt_TychusMedicTransportUnit, 1, "TychusMedicTransportUnit");
    }
    TriggerEnable(lib81FF3B49_gt_TychusMedicTransportUnit,true);
}

void lib81FF3B49_gf_ReviveUnit (unit lp_reviveUnit, unit lp_caster, int lp_player) {
    // Automatic Variable Declarations
    // Implementation
    UnitRevive(lp_reviveUnit);
    UnitSetPropertyFixed(lp_reviveUnit, c_unitPropLife, UnitGetPropertyFixed(lp_reviveUnit, c_unitPropLife, c_unitPropNormal));
    UnitSetPosition(lp_reviveUnit, UnitTypePlacementTestsFromUnit(UnitGetType(lp_reviveUnit), lp_player, lp_caster, 5.0, c_placementTestCliffMask), false);
    UnitIssueOrder(lp_reviveUnit, OrderTargetingPoint(AbilityCommand("move", 0), UnitRallyPointTargetPoint(lp_caster, 1, 1)), c_orderQueueReplace);
}

