// Functions
void libE0EAE146_gf_FinishLevel () {
    // Variable Declarations
    string lv_map;
    int lv_i;

    // Automatic Variable Declarations
    const int auto510FA344_ae = 29;
    const int auto510FA344_ai = 1;

    // Variable Initialization
    lv_map = lib67C0F0E7_gf_MapPathName("XM/");

    // Implementation
    BankLoad("CampaignXCore", 1);
    BankValueSetFromInt(BankLastCreated(), "Finished", lv_map, 1);
    BankValueSetFromInt(BankLastCreated(), "Bon", lv_map, MaxI(libE0EAE146_gv_bon, BankValueGetAsInt(BankLastCreated(), "Bon", lv_map)));
    BankSave(BankLastCreated());
    XMProgression_RecordVictory(1, lv_map, libE0EAE146_gv_commander, libE0EAE146_gv_bon, libE0EAE146_gv_commanderHeroDeathCount);
    TriggerQueueClear(c_triggerQueueRetain);
    TriggerQueuePause(true);
    UISetWorldVisible(PlayerGroupAll(), false);
    libNtve_gf_HideGameUI(false, PlayerGroupAll());
    UISetCursorVisible(PlayerGroupAll(), true);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeBattleUI, true);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    TransmissionClearAll();
    ConversationDataStop();
    SoundStopAllTriggerSounds(false);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Victory);
    lv_i = 1;
    for ( ; ( (auto510FA344_ai >= 0 && lv_i <= auto510FA344_ae) || (auto510FA344_ai < 0 && lv_i >= auto510FA344_ae) ) ; lv_i += auto510FA344_ai ) {
        if ((lv_map == UserDataGetString("Campaign", "Wol", "MapPathName", lv_i))) {
            VictoryPanelSetMissionText(UserDataGetText("Campaign", "Wol", "MapName", lv_i));
            break;
        }

    }
    VictoryPanelSetMissionTimeTitle(StringExternal("Param/Value/lib_E0EAE146_3D02C191"));
    VictoryPanelSetBackgroundFilePath(UserDataGetImagePath("Campaign", "Wol", "scorescreen", lv_i));
    VictoryPanelSetSummaryBackgroundFilePath(UserDataGetImagePath("Campaign", "Wol", "battlereports", lv_i));
    if ((lv_map == "tzeratul04")) {
        VictoryPanelSetVictoryText(StringExternal("Param/Value/lib_E0EAE146_54CC491A"));
    }
    else {
        VictoryPanelSetVictoryText(StringExternal("Param/Value/lib_E0EAE146_F6A6069C"));
    }
    VictoryPanelSetMissionTimeText(FormatDuration(FixedToInt(AIGetTime())));
    VictoryPanelSetRewardTitle(StringToText(""));
    VictoryPanelSetAchievementsTitle(StringExternal("Param/Value/lib_E0EAE146_16658C1E"));
    VictoryPanelSetMissionTitle(StringExternal("Param/Value/lib_E0EAE146_8E44EBBC"));
    VictoryPanelSetStatisticsTitle(StringExternal("Param/Value/lib_E0EAE146_4CDEE1E2"));
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeVictoryPanel, true);
    GameSetNextMap(("XM/" + ("Launcher")));
}

void libE0EAE146_gf_Initialize (bool lp_rpg) {
    // Variable Declarations
    string lv_consoleSkin;

    // Implementation
    libE0EAE146_gf_RuntimeCheckpoint("Initialize.enter");
    GameSetSpeedValue(c_gameSpeedFaster);
    BankLoad("CampaignXCore", 1);
    libE0EAE146_gv_commander = libE0EAE146_gf_RuntimePrimaryCommander();
    XMProgression_Init(1);
    libE0EAE146_gf_RuntimeCheckpoint("Initialize.commander");
    // Data-driven console skin + special init (replaces 18-branch if-else).
    lv_consoleSkin = libE0EAE146_gf_CommanderConsoleSkin(libE0EAE146_gv_commander);
    if ((lv_consoleSkin != "")) {
        lib67C0F0E7_gf_PlayerSetCommanderConsoleSkin(1, lv_consoleSkin);
    }
    libE0EAE146_gf_CommanderApplySpecialInit(1, libE0EAE146_gv_commander, lp_rpg);
    libE0EAE146_gf_ApplyConsoleSkinOverride(1);
    libE0EAE146_gf_RuntimeCheckpoint("Initialize.console");
    libE0EAE146_gf_RuntimeCheckpoint("Initialize.exit");
}

void libE0EAE146_gf_InitializeMapBaseScenario (string lp_mapId) {
    point lv_secondUnit;
    int lv_worker;
    point lv_secondBase;
    bool lv_createHero;
    point lv_mapOverride;
    point lv_startLoc;

    libE0EAE146_gv_currentMapId = lp_mapId;
    // 战役图改造为 7vs1 时 PlayerStartLocation 可能返回 null，使用 effectiveBaseAnchor 作为回退
    lv_startLoc = PlayerStartLocation(1);
    if (lv_startLoc == null) {
        lv_startLoc = libE0EAE146_gv_effectiveBaseAnchor;
    }
    if (lv_startLoc == null) {
        // 仍然为 null 时无法继续，直接返回避免 ScriptError
        return;
    }
    lv_secondUnit = PointWithOffsetPolar(lv_startLoc, 6.0, 45.0);
    lv_worker = 11;
    lv_secondBase = null;
    lv_createHero = true;
    // Horner-series commanders need extra space; offset to the other side.
    if (((libE0EAE146_gv_commander == "Mira") || (libE0EAE146_gv_commander == "Horner") || (libE0EAE146_gv_commander == "HanHorner") || (libE0EAE146_gv_commander == "HanAndHorner"))) {
        lv_secondUnit = PointWithOffsetPolar(lv_startLoc, 8.0, -45.0);
    }
    // Map-specific second-unit override (data-driven, see LibE0EAE146_MapMetadata.galaxy).
    lv_mapOverride = libE0EAE146_gf_MapSecondUnitPoint(lp_mapId, lv_startLoc);
    if (lv_mapOverride != null) {
        lv_secondUnit = lv_mapOverride;
    }
    libE0EAE146_gf_InitializeBase(lv_secondUnit, lv_worker, lv_secondBase, lv_createHero);
}

void libE0EAE146_gf_InitializeMapScenario (string lp_mapId, bool lp_rpg) {
    libE0EAE146_gf_Initialize(lp_rpg);
    libE0EAE146_gf_InitializeMapBaseScenario(lp_mapId);
}

// Map resource tables and special flags are now data-driven.
