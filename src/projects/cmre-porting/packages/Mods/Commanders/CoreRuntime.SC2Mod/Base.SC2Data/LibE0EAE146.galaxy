    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "Goliath", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "ScienceVessel", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "Vulture", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "SiegeTank", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "SiegeTankSieged", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "VikingFighter", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "VikingAssault", "BehaviorArray", "AllUnitBehaviorController", 6);

    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "SCV", "AbilArray", "SprayTerran", 8);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "ScienceVessel", "AbilArray", "ScienceVesselNanoRepairDouble", 8);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "ScienceVessel", "AbilArray", "CommanderPrestigeSwannHerculesScienceVesselTacticalJump", 8);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "Vulture", "AbilArray", "VehicleAfterburners", 8);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "SiegeTank", "AbilArray", "VehicleAfterburners", 8);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "SiegeTankSieged", "AbilArray", "VehicleAfterburners", 8);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "VikingFighter", "AbilArray", "VehicleAfterburners", 8);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "VikingAssault", "AbilArray", "VehicleAfterburners", 8);

    libE0EAE146_gf_ClearUnitCatalogFieldIfMatchesForPlayer(lp_player, "VikingFighter", "EffectArray[Create]", "CommanderPrestigeRaynorAirTriggerAdd");
    libE0EAE146_gf_ClearUnitCatalogFieldIfMatchesForPlayer(lp_player, "VikingFighter", "EffectArray[Death]", "CommanderPrestigeRaynorAirTriggerRemove");
    libE0EAE146_gf_ClearUnitCatalogFieldIfMatchesForPlayer(lp_player, "VikingAssault", "EffectArray[Create]", "CommanderPrestigeRaynorAirTriggerAdd");
    libE0EAE146_gf_ClearUnitCatalogFieldIfMatchesForPlayer(lp_player, "VikingAssault", "EffectArray[Death]", "CommanderPrestigeRaynorAirTriggerRemove");
}

void libE0EAE146_gf_ApplySharedPlayerCampaignAllyCatalogSanitization (string lp_mapId) {
    int lv_player;

    if ((lp_mapId == "") || (libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lp_mapId) == false)) {
        return;
    }
    // The live runtime rejects these unit catalog writes during map initialization on current builds.
    // Keep startup stable first; shared-ally visual cleanup stays handled by runtime duplicate removal.
    return;
    if (DataTableGetBool(true, ("XMSharedAllyCatalogSanitized_" + lp_mapId)) == true) {
        return;
    }

    DataTableSetBool(true, ("XMSharedAllyCatalogSanitized_" + lp_mapId), true);
    for (lv_player = 1; lv_player <= 15; lv_player += 1) {
        libE0EAE146_gf_ApplySharedPlayerCampaignAllyCatalogSanitizationForPlayer(lp_mapId, lv_player);
    }
}

void libE0EAE146_gf_RunSharedPlayerCampaignAllyDuplicateCleanup (string lp_mapId) {
    int lv_removed;
    int lv_player;

    if ((lp_mapId == "") || (libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lp_mapId) == false)) {
        return;
    }
    if (DataTableGetBool(true, ("XMSharedAllyDuplicateCleanup_" + lp_mapId)) == true) {
        return;
    }

    DataTableSetBool(true, ("XMSharedAllyDuplicateCleanup_" + lp_mapId), true);
    lv_removed = 0;
    if (lp_mapId == "thanson03a_7vs1") {
        lv_removed += libE0EAE146_gf_RemoveOverlappingDuplicatesForPlayer(3, 0.20);
        lv_removed += libE0EAE146_gf_RemoveOverlappingDuplicatesForPlayer(5, 0.20);
        lv_removed += libE0EAE146_gf_RemoveOverlappingDuplicatesForPlayer(11, 0.20);
    }
    else if (lp_mapId == "thanson01_7vs1") {
        lv_removed += libE0EAE146_gf_RemoveOverlappingDuplicatesForPlayer(4, 0.20);
        lv_removed += libE0EAE146_gf_RemoveOverlappingDuplicatesForPlayer(7, 0.20);
        lv_removed += libE0EAE146_gf_RemoveOverlappingDuplicatesForPlayer(8, 0.20);
    }

    BankLoad("CampaignXCore", 1);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "SharedAllyDuplicateCleanupMap", lp_mapId);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "SharedAllyDuplicateCleanupRemoved", lv_removed);
    BankSave(BankLastCreated());
}

bool libE0EAE146_gf_IsSharedPlayerCampaignAllyPlayer (string lp_mapId, int lp_player) {
    if (lp_mapId == "thanson03a_7vs1") {
        return ((lp_player == 3) || (lp_player == 5) || (lp_player == 11));
    }
    if (lp_mapId == "thanson01_7vs1") {
        return ((lp_player == 4) || (lp_player == 7) || (lp_player == 8));
    }
    return false;
}

int libE0EAE146_gf_SanitizeSharedPlayerCampaignAllyUnit (unit lp_unit, string lp_mapId) {
    int lv_removed;

    if ((lp_unit == null) || (UnitIsAlive(lp_unit) == false)) {
        return 0;
    }
    if (libE0EAE146_gf_IsSharedPlayerCampaignAllyPlayer(lp_mapId, UnitGetOwner(lp_unit)) == false) {
        return 0;
    }

    lv_removed = 0;
    lv_removed += UnitBehaviorCount(lp_unit, "AllUnitBehaviorController");
    UnitBehaviorRemove(lp_unit, "AllUnitBehaviorController", c_unitBehaviorCountAll);
    lv_removed += UnitBehaviorCount(lp_unit, "VorazunCloakedShieldRegenPermanent");
    UnitBehaviorRemove(lp_unit, "VorazunCloakedShieldRegenPermanent", c_unitBehaviorCountAll);
    lv_removed += UnitBehaviorCount(lp_unit, "CorsairPermanentCloak");
    UnitBehaviorRemove(lp_unit, "CorsairPermanentCloak", c_unitBehaviorCountAll);
    lv_removed += UnitBehaviorCount(lp_unit, "BansheeBlackOpsPermanentCloak");
    UnitBehaviorRemove(lp_unit, "BansheeBlackOpsPermanentCloak", c_unitBehaviorCountAll);
    lv_removed += UnitBehaviorCount(lp_unit, "KerriganAssimilationLifesteal");
    UnitBehaviorRemove(lp_unit, "KerriganAssimilationLifesteal", c_unitBehaviorCountAll);
    lv_removed += UnitBehaviorCount(lp_unit, "GenerateCreepHealingBehavior");
    UnitBehaviorRemove(lp_unit, "GenerateCreepHealingBehavior", c_unitBehaviorCountAll);
    return lv_removed;
}

