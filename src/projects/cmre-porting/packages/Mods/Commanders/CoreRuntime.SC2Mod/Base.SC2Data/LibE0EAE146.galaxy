void libE0EAE146_gf_ApplyMapStartResources (int lp_player, int lp_minerals, int lp_vespene, int lp_suppliesMade) {
    if ((lp_minerals >= 0)) {
        PlayerModifyPropertyInt(lp_player, c_playerPropMinerals, c_playerPropOperSetTo, lp_minerals);
    }
    if ((lp_vespene >= 0)) {
        PlayerModifyPropertyInt(lp_player, c_playerPropVespene, c_playerPropOperSetTo, lp_vespene);
    }
    if ((lp_suppliesMade >= 0)) {
        PlayerModifyPropertyInt(lp_player, c_playerPropSuppliesMade, c_playerPropOperSetTo, lp_suppliesMade);
    }
}

