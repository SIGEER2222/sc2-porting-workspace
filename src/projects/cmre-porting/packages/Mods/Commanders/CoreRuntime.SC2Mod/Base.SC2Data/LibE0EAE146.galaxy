void libE0EAE146_gf_GenericBonusEnsureTriggers () {
    if (libE0EAE146_gt_GenericBonusMechanicalRepair == null) {
        libE0EAE146_gt_GenericBonusMechanicalRepair = TriggerCreate("libE0EAE146_gt_GenericBonusMechanicalRepair_Func");
