void libE0EAE146_gf_ApplySharedPlayerCampaignAllyBoostToUnit (unit lp_unit, bool lp_earlyDamageReduction, bool lp_sustainBoost) {
    if ((lp_unit == null) || (UnitIsAlive(lp_unit) == false)) {
        return;
    }

    if (lp_earlyDamageReduction) {
        if (UnitBehaviorCount(lp_unit, "GenericBonusAllyEarlyDamageReduction") <= 0) {
            UnitBehaviorAdd(lp_unit, "GenericBonusAllyEarlyDamageReduction", lp_unit, 1);
        }
    }
    else {
        UnitBehaviorRemove(lp_unit, "GenericBonusAllyEarlyDamageReduction", c_unitBehaviorCountAll);
    }

    if (lp_sustainBoost) {
        UnitSetPropertyFixed(lp_unit, c_unitPropLifePercent, 100.0);
        UnitSetPropertyFixed(lp_unit, c_unitPropShieldsPercent, 100.0);
    }
}

void libE0EAE146_gf_RunSharedPlayerCampaignAllyBoost (string lp_mapId) {
    unitgroup lv_units;
    int lv_player;
    int lv_count;
    int lv_boostedUnits;
    int lv_earlyDamageReductionInt;
    int lv_sustainBoostInt;
    bool lv_earlyDamageReductionSelected;
    bool lv_sustainBoostSelected;
    bool lv_earlyDamageReduction;
    bool lv_sustainBoost;
    fixed lv_boostDeadline;
    unit lv_unit;

    if ((lp_mapId == "") || (libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lp_mapId) == false)) {
        return;
    }

    lv_earlyDamageReductionSelected = libE0EAE146_gf_GenericBonusEnabled("AllyEarlyDamageReduction");
    lv_sustainBoostSelected = libE0EAE146_gf_GenericBonusEnabled("AllySustainBoost");
    if ((!lv_earlyDamageReductionSelected) && (!lv_sustainBoostSelected)) {
        return;
    }
    lv_boostDeadline = DataTableGetFixed(true, ("XMSharedAllyBoostDeadline_" + lp_mapId));
    if (lv_boostDeadline <= 0.0) {
        lv_boostDeadline = (GameGetMissionTime() + 180.0);
        DataTableSetFixed(true, ("XMSharedAllyBoostDeadline_" + lp_mapId), lv_boostDeadline);
    }
    lv_earlyDamageReduction = (lv_earlyDamageReductionSelected && (GameGetMissionTime() <= lv_boostDeadline));
    lv_sustainBoost = (lv_sustainBoostSelected && (GameGetMissionTime() <= lv_boostDeadline));

    lv_boostedUnits = 0;
    for (lv_player = 1; lv_player <= 15; lv_player += 1) {
        if (libE0EAE146_gf_IsSharedPlayerCampaignAllyPlayer(lp_mapId, lv_player) == false) {
            continue;
        }
        libE0EAE146_gf_SetSharedPlayerCampaignAllyUpgradeBoostForPlayer(lv_player, lv_sustainBoost);

        lv_units = UnitGroup(null, lv_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        for ( ; (lv_count >= 1) ; lv_count -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_units, lv_count);
            libE0EAE146_gf_ApplySharedPlayerCampaignAllyBoostToUnit(lv_unit, lv_earlyDamageReduction, lv_sustainBoost);
            lv_boostedUnits += 1;
        }
    }

    lv_earlyDamageReductionInt = 0;
    lv_sustainBoostInt = 0;
    if (lv_earlyDamageReduction) { lv_earlyDamageReductionInt = 1; }
    if (lv_sustainBoost) { lv_sustainBoostInt = 1; }

    if ((DataTableGetInt(true, ("XMSharedAllyBoostEarlyDamageReduction_" + lp_mapId)) != lv_earlyDamageReductionInt) || (DataTableGetInt(true, ("XMSharedAllyBoostSustain_" + lp_mapId)) != lv_sustainBoostInt) || (DataTableGetInt(true, ("XMSharedAllyBoostUnits_" + lp_mapId)) != lv_boostedUnits) || (DataTableGetBool(true, ("XMSharedAllyBoostSaved_" + lp_mapId)) == false)) {
        DataTableSetInt(true, ("XMSharedAllyBoostEarlyDamageReduction_" + lp_mapId), lv_earlyDamageReductionInt);
        DataTableSetInt(true, ("XMSharedAllyBoostSustain_" + lp_mapId), lv_sustainBoostInt);
        DataTableSetInt(true, ("XMSharedAllyBoostUnits_" + lp_mapId), lv_boostedUnits);
        DataTableSetBool(true, ("XMSharedAllyBoostSaved_" + lp_mapId), true);
        BankLoad("CampaignXCore", 1);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "SharedAllyBoostMap", lp_mapId);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "SharedAllyBoostEarlyDamageReduction", lv_earlyDamageReductionInt);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "SharedAllyBoostSustain", lv_sustainBoostInt);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "SharedAllyBoostUnits", lv_boostedUnits);
        BankSave(BankLastCreated());
    }
}

int libE0EAE146_gf_RunSharedPlayerCampaignAllySanitization (string lp_mapId) {
    unitgroup lv_units;
    int lv_player;
    int lv_count;
    unit lv_unit;
    int lv_removed;

    if ((lp_mapId == "") || (libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lp_mapId) == false)) {
        return 0;
    }

    lv_removed = 0;
    for (lv_player = 1; lv_player <= 15; lv_player += 1) {
        if (libE0EAE146_gf_IsSharedPlayerCampaignAllyPlayer(lp_mapId, lv_player) == false) {
            continue;
        }
        lv_units = UnitGroup(null, lv_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        for ( ; (lv_count >= 1) ; lv_count -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_units, lv_count);
            lv_removed += libE0EAE146_gf_SanitizeSharedPlayerCampaignAllyUnit(lv_unit, lp_mapId);
        }
    }
    return lv_removed;
}

bool libE0EAE146_gt_SharedPlayerCampaignAllySanitizer_Func (bool testConds, bool runActions) {
    string lv_mapId;
    int lv_removed;
    unitgroup lv_units;
    unitgroup lv_nearbyUnits;
    int lv_player;
    int lv_count;
    int lv_nearbyCount;
    int lv_overlapCount;
    int lv_sampleCount;
    unit lv_unit;
    unit lv_nearbyUnit;
    string lv_sample;
    string lv_prefix;

    if (!runActions) {
        return true;
    }

    lv_mapId = libE0EAE146_gv_currentMapId;
    if (lv_mapId == "") {
        return true;
    }
    if (libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lv_mapId) == false) {
        return true;
    }

    lv_removed = libE0EAE146_gf_RunSharedPlayerCampaignAllySanitization(lv_mapId);
    if (lv_removed > 0) {
        DataTableSetInt(true, ("XMSharedAllySanitizerLastRemoved_" + lv_mapId), lv_removed);
    }
    libE0EAE146_gf_RunSharedPlayerCampaignAllyBoost(lv_mapId);
    lv_overlapCount = 0;
    lv_sampleCount = 0;
    for (lv_player = 1; lv_player <= 15; lv_player += 1) {
        if (libE0EAE146_gf_IsSharedPlayerCampaignAllyPlayer(lv_mapId, lv_player) == false) {
            continue;
        }
        lv_units = UnitGroup(null, lv_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_count = UnitGroupCount(lv_units, c_unitCountAll);
        for ( ; (lv_count >= 1) ; lv_count -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_units, lv_count);
            if ((lv_unit == null) || (UnitIsAlive(lv_unit) == false)) {
                continue;
            }
            lv_nearbyUnits = UnitGroupSearch(null, c_playerAny, UnitGetPosition(lv_unit), 0.20, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
            lv_nearbyCount = UnitGroupCount(lv_nearbyUnits, c_unitCountAll);
            for ( ; (lv_nearbyCount >= 1) ; lv_nearbyCount -= 1) {
                lv_nearbyUnit = UnitGroupUnitFromEnd(lv_nearbyUnits, lv_nearbyCount);
                if ((lv_nearbyUnit == null) || (UnitGetTag(lv_nearbyUnit) == UnitGetTag(lv_unit))) {
                    continue;
                }
                if ((UnitGetOwner(lv_nearbyUnit) == UnitGetOwner(lv_unit)) && (UnitGetType(lv_nearbyUnit) == UnitGetType(lv_unit))) {
                    continue;
                }
                lv_overlapCount += 1;
                if (lv_sampleCount < 6) {
                    lv_sampleCount += 1;
                    lv_sample = ("A[p" + IntToString(UnitGetOwner(lv_unit)) + ":" + UnitGetType(lv_unit) + "#" + IntToString(UnitGetTag(lv_unit)) + "] B[p" + IntToString(UnitGetOwner(lv_nearbyUnit)) + ":" + UnitGetType(lv_nearbyUnit) + "#" + IntToString(UnitGetTag(lv_nearbyUnit)) + "]");
                    DataTableSetString(true, ("XMSharedAllyOverlapSample_" + lv_mapId + "_" + IntToString(lv_sampleCount)), lv_sample);
                }
            }
        }
    }
    lv_prefix = ("XMSharedAllyOverlap_" + lv_mapId);
    if ((DataTableGetInt(true, (lv_prefix + "_LastCount")) != lv_overlapCount) || (DataTableGetBool(true, (lv_prefix + "_Saved")) == false)) {
        DataTableSetInt(true, (lv_prefix + "_LastCount"), lv_overlapCount);
        DataTableSetBool(true, (lv_prefix + "_Saved"), true);
        BankLoad("CampaignXCore", 1);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "SharedAllyOverlapMap", lv_mapId);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "SharedAllyOverlapCount", lv_overlapCount);
        for (lv_count = 1; lv_count <= 6; lv_count += 1) {
            BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", ("SharedAllyOverlapSample" + IntToString(lv_count)), DataTableGetString(true, ("XMSharedAllyOverlapSample_" + lv_mapId + "_" + IntToString(lv_count))));
        }
        BankSave(BankLastCreated());
    }
    return true;
}

void libE0EAE146_gf_EnsureSharedPlayerCampaignAllySanitizer (string lp_mapId) {
    if ((lp_mapId == "") || (libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lp_mapId) == false)) {
        return;
    }
    if (libE0EAE146_gt_SharedPlayerCampaignAllySanitizer == null) {
        libE0EAE146_gt_SharedPlayerCampaignAllySanitizer = TriggerCreate("libE0EAE146_gt_SharedPlayerCampaignAllySanitizer_Func");
        TriggerAddEventTimePeriodic(libE0EAE146_gt_SharedPlayerCampaignAllySanitizer, 0.50, c_timeGame);
        TriggerEnable(libE0EAE146_gt_SharedPlayerCampaignAllySanitizer, false);
    }
    TriggerEnable(libE0EAE146_gt_SharedPlayerCampaignAllySanitizer, true);
    libE0EAE146_gf_RunSharedPlayerCampaignAllySanitization(lp_mapId);
    libE0EAE146_gf_RunSharedPlayerCampaignAllyBoost(lp_mapId);
}

