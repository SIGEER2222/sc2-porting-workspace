}

void libE0EAE146_gf_InitializeStandardMapScenario (string lp_mapId, bool lp_rpg, int lp_player, int lp_minerals, int lp_vespene, int lp_suppliesMade, trigger lp_preInit, trigger lp_init01, bool lp_init01WaitUntilDone, trigger lp_init02, trigger lp_init03, trigger lp_init04, trigger lp_init05, trigger lp_init06, trigger lp_postInit, trigger lp_intro) {
