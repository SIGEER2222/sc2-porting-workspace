    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "Marine", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "Marauder", "BehaviorArray", "AllUnitBehaviorController", 6);
    libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer(lp_player, "Hellion", "BehaviorArray", "AllUnitBehaviorController", 6);
