        TriggerAddEventTimePeriodic(libE0EAE146_gt_GenericBonusControllerWatchdog, 2.0, c_timeGame);
        TriggerEnable(libE0EAE146_gt_GenericBonusControllerWatchdog, false);
    }
}

fixed libE0EAE146_gf_GenericBonusResourceMultiplier (int lp_level) {
    if (lp_level <= 0) {
        return 1.0;
    }
    return (1.0 + IntToFixed(lp_level));
}

unit libE0EAE146_gf_GenericBonusReplaceResourceUnit (unit lp_resourceUnit, string lp_newUnitType, fixed lp_resourceAmount) {
    point lv_point;
    int lv_owner;
    fixed lv_facing;
    unit lv_newUnit;

    if ((lp_resourceUnit == null) || (lp_newUnitType == "")) {
        return lp_resourceUnit;
    }
    if (UnitGetType(lp_resourceUnit) == lp_newUnitType) {
        return lp_resourceUnit;
    }

    lv_point = UnitGetPosition(lp_resourceUnit);
    lv_owner = UnitGetOwner(lp_resourceUnit);
    lv_facing = UnitGetFacing(lp_resourceUnit);
    UnitCreate(1, lp_newUnitType, c_unitCreateIgnorePlacement, lv_owner, lv_point, lv_facing);
    lv_newUnit = UnitLastCreated();
    if (UnitIsValid(lv_newUnit) == true) {
        UnitSetPropertyFixed(lv_newUnit, c_unitPropResources, lp_resourceAmount);
        UnitRemove(lp_resourceUnit);
        return lv_newUnit;
    }

    return lp_resourceUnit;
}

void libE0EAE146_gf_GenericBonusApplyResources (int lp_doubleMineralsLevel, int lp_doubleVespeneLevel, bool lp_richResources) {
    unitgroup lv_resourceNodes;
    unit lv_resourceUnit;
    unit lv_groupResourceUnit;
    string lv_resourceType;
    string lv_resourceUnitType;
    string lv_behavior;
    string lv_targetUnitType;
    fixed lv_resourceAmount;
    fixed lv_mineralMultiplier;
    fixed lv_gasMultiplier;
    int lv_mineralNodeCount;
    int lv_gasNodeCount;
    int lv_resourceTag;
    string lv_mineralSampleBehavior;
    string lv_gasSampleBehavior;
    int lv_mineralSampleAmount;
    int lv_gasSampleAmount;
    int lv_mineralSampleBefore;
    int lv_gasSampleBefore;
    int lv_mineralTotalBefore;
    int lv_mineralTotalAfter;
    int lv_gasTotalBefore;
    int lv_gasTotalAfter;

    lv_resourceNodes = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterRawResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
    UnitGroupAddUnitGroup(lv_resourceNodes, UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter((1 << c_targetFilterHarvestableResource), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    lv_mineralNodeCount = 0;
    lv_gasNodeCount = 0;
    lv_mineralSampleBehavior = "";
    lv_gasSampleBehavior = "";
    lv_mineralSampleAmount = 0;
    lv_gasSampleAmount = 0;
    lv_mineralSampleBefore = 0;
    lv_gasSampleBefore = 0;
    lv_mineralTotalBefore = 0;
    lv_mineralTotalAfter = 0;
    lv_gasTotalBefore = 0;
    lv_gasTotalAfter = 0;
    lv_mineralMultiplier = libE0EAE146_gf_GenericBonusResourceMultiplier(lp_doubleMineralsLevel);
    lv_gasMultiplier = libE0EAE146_gf_GenericBonusResourceMultiplier(lp_doubleVespeneLevel);
    lv_resourceUnit = UnitGroupUnit(lv_resourceNodes, 1);
    while (lv_resourceUnit != null) {
        lv_groupResourceUnit = lv_resourceUnit;
        lv_resourceTag = UnitGetTag(lv_resourceUnit);
        if (DataTableGetBool(true, ("XMGenericBonusResourceProcessed_" + IntToString(lv_resourceTag)))) {
            UnitGroupRemove(lv_resourceNodes, lv_groupResourceUnit);
            lv_resourceUnit = UnitGroupUnit(lv_resourceNodes, 1);
            continue;
        }
        DataTableSetBool(true, ("XMGenericBonusResourceProcessed_" + IntToString(lv_resourceTag)), true);
        lv_resourceUnitType = UnitGetType(lv_resourceUnit);
        lv_resourceType = CatalogFieldValueGet(c_gameCatalogUnit, lv_resourceUnitType, "ResourceType", c_playerAny);
        if (lv_resourceType == "Minerals") {
            lv_resourceAmount = libNtve_gf_UnitGetPropertyResources(lv_resourceUnit, c_unitPropCurrent);
            lv_behavior = "";
            lv_targetUnitType = "";
            if (UnitHasBehavior2(lv_resourceUnit, "MineralFieldMinerals")) {
                lv_behavior = "MineralFieldMinerals";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "MineralFieldMinerals750")) {
                lv_behavior = "MineralFieldMinerals750";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "HighYieldMineralFieldMinerals")) {
                lv_behavior = "HighYieldMineralFieldMinerals";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "HighYieldMineralFieldMinerals750")) {
                lv_behavior = "HighYieldMineralFieldMinerals750";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "MineralsMineralFieldcoop")) {
                lv_behavior = "MineralsMineralFieldcoop";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "MineralsMineralFieldmany")) {
                lv_behavior = "MineralsMineralFieldmany";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "MineralsMineralFieldverymany")) {
                lv_behavior = "MineralsMineralFieldverymany";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "GenericBonusRichMineralFieldMinerals")) {
                lv_behavior = "GenericBonusRichMineralFieldMinerals";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "GenericBonusRichMineralFieldMinerals750")) {
                lv_behavior = "GenericBonusRichMineralFieldMinerals750";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "MineralFieldMineralsNoRemove")) {
                lv_behavior = "MineralFieldMineralsNoRemove";
            }

            if (lv_behavior != "") {
                if (lp_richResources) {
                    if (lv_resourceUnitType != "RichMineralField") {
                        lv_targetUnitType = "RichMineralField";
                    }
                }
                if (lv_targetUnitType != "") {
                    lv_resourceUnit = libE0EAE146_gf_GenericBonusReplaceResourceUnit(lv_resourceUnit, lv_targetUnitType, lv_resourceAmount);
                }
                UnitBehaviorRemove(lv_resourceUnit, "MineralFieldMinerals", 1);
                UnitBehaviorRemove(lv_resourceUnit, "MineralFieldMinerals750", 1);
                UnitBehaviorRemove(lv_resourceUnit, "HighYieldMineralFieldMinerals", 1);
                UnitBehaviorRemove(lv_resourceUnit, "HighYieldMineralFieldMinerals750", 1);
                UnitBehaviorRemove(lv_resourceUnit, "GenericBonusRichMineralFieldMinerals", 1);
                UnitBehaviorRemove(lv_resourceUnit, "GenericBonusRichMineralFieldMinerals750", 1);
                UnitBehaviorRemove(lv_resourceUnit, "MineralFieldMineralsNoRemove", 1);

                if (lp_richResources) {
                    if ((lv_behavior == "HighYieldMineralFieldMinerals") || (lv_behavior == "HighYieldMineralFieldMinerals750")) {
                    }
                    else if ((lv_behavior == "MineralsMineralFieldcoop") || (lv_behavior == "MineralsMineralFieldmany") || (lv_behavior == "MineralsMineralFieldverymany")) {
                        lv_behavior = "RichMineralField";
                    }
                    else if ((lv_behavior == "MineralFieldMinerals750") || (lv_behavior == "GenericBonusRichMineralFieldMinerals750")) {
                        lv_behavior = "HighYieldMineralFieldMinerals750";
                    }
                    else if (lv_behavior == "MineralFieldMineralsNoRemove") {
                        lv_behavior = "MineralFieldMineralsNoRemove";
                    }
                    else if (lv_behavior == "GenericBonusRichMineralFieldMinerals") {
                        lv_behavior = "HighYieldMineralFieldMinerals";
                    }
                    else {
                        lv_behavior = "HighYieldMineralFieldMinerals";
                    }
                }
                else {
                    if ((lv_behavior == "HighYieldMineralFieldMinerals750") || (lv_behavior == "MineralFieldMinerals750")) {
                        lv_behavior = "MineralFieldMinerals750";
                    }
                    else if (lv_behavior == "GenericBonusRichMineralFieldMinerals750") {
                        lv_behavior = "MineralFieldMinerals750";
                    }
                    else if (lv_behavior == "MineralFieldMineralsNoRemove") {
                        lv_behavior = "MineralFieldMineralsNoRemove";
                    }
                    else if (lv_behavior == "GenericBonusRichMineralFieldMinerals") {
                        lv_behavior = "MineralFieldMinerals";
                    }
                    else {
                        lv_behavior = "MineralFieldMinerals";
                    }
                }

                UnitBehaviorAdd(lv_resourceUnit, lv_behavior, lv_resourceUnit, 1);
                lv_mineralTotalBefore += FixedToInt(lv_resourceAmount);
                if (lv_mineralSampleBehavior == "") {
                    lv_mineralSampleBehavior = lv_behavior;
                    lv_mineralSampleBefore = FixedToInt(lv_resourceAmount);
                }
                if (lp_doubleMineralsLevel > 0) {
                    lv_resourceAmount = (lv_resourceAmount * lv_mineralMultiplier);
                }
                UnitSetPropertyFixed(lv_resourceUnit, c_unitPropResources, lv_resourceAmount);
                lv_mineralNodeCount += 1;
                lv_mineralTotalAfter += FixedToInt(lv_resourceAmount);
                if (lv_mineralSampleBehavior != "" && lv_mineralSampleAmount == 0) {
                    lv_mineralSampleAmount = FixedToInt(lv_resourceAmount);
                }
            }
        }
        else if ((lv_resourceType == "Vespene") && UnitFilterMatch(lv_resourceUnit, 1, UnitFilter((1 << c_targetFilterRawResource), 0, 0, 0))) {
            lv_resourceAmount = libNtve_gf_UnitGetPropertyResources(lv_resourceUnit, c_unitPropCurrent);
            lv_behavior = "";
            lv_targetUnitType = "";
            if (UnitHasBehavior2(lv_resourceUnit, "RawRichVespeneGeyserGas")) {
                lv_behavior = "RawRichVespeneGeyserGas";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "RawVespeneGeyserGas")) {
                lv_behavior = "RawVespeneGeyserGas";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "GasRawVespeneGeysercoop")) {
                lv_behavior = "GasRawVespeneGeysercoop";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "GasRawVespeneGeysermany")) {
                lv_behavior = "GasRawVespeneGeysermany";
            }
            else if (UnitHasBehavior2(lv_resourceUnit, "GasRawVespeneGeyserverymany")) {
                lv_behavior = "GasRawVespeneGeyserverymany";
            }

            if (lv_behavior != "") {
                if (lp_richResources) {
                    if (lv_resourceUnitType != "RichVespeneGeyser") {
                        lv_targetUnitType = "RichVespeneGeyser";
                    }
                }
                if (lv_targetUnitType != "") {
                    lv_resourceUnit = libE0EAE146_gf_GenericBonusReplaceResourceUnit(lv_resourceUnit, lv_targetUnitType, lv_resourceAmount);
                }
                UnitBehaviorRemove(lv_resourceUnit, "RawVespeneGeyserGas", 1);
                UnitBehaviorRemove(lv_resourceUnit, "RawRichVespeneGeyserGas", 1);
                if (lp_richResources) {
                    lv_behavior = "RawRichVespeneGeyserGas";
                }
                else {
                    lv_behavior = "RawVespeneGeyserGas";
                }
                UnitBehaviorAdd(lv_resourceUnit, lv_behavior, lv_resourceUnit, 1);
                lv_gasTotalBefore += FixedToInt(lv_resourceAmount);
                if (lv_gasSampleBehavior == "") {
                    lv_gasSampleBehavior = lv_behavior;
                    lv_gasSampleBefore = FixedToInt(lv_resourceAmount);
                }
                if (lp_doubleVespeneLevel > 0) {
                    lv_resourceAmount = (lv_resourceAmount * lv_gasMultiplier);
                }
                UnitSetPropertyFixed(lv_resourceUnit, c_unitPropResources, lv_resourceAmount);
                lv_gasNodeCount += 1;
                lv_gasTotalAfter += FixedToInt(lv_resourceAmount);
                if (lv_gasSampleBehavior != "" && lv_gasSampleAmount == 0) {
                    lv_gasSampleAmount = FixedToInt(lv_resourceAmount);
                }
            }
        }

        UnitGroupRemove(lv_resourceNodes, lv_groupResourceUnit);
        lv_resourceUnit = UnitGroupUnit(lv_resourceNodes, 1);
    }

    BankLoad("CampaignXCore", 1);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralNodesProcessed", lv_mineralNodeCount);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasNodesProcessed", lv_gasNodeCount);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralTotalBefore", lv_mineralTotalBefore);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralTotalAfter", lv_mineralTotalAfter);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasTotalBefore", lv_gasTotalBefore);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasTotalAfter", lv_gasTotalAfter);
    if (lv_mineralSampleBehavior != "") {
        BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralSampleBehavior", lv_mineralSampleBehavior);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralSampleBefore", lv_mineralSampleBefore);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusMineralSampleAmount", lv_mineralSampleAmount);
    }
    if (lv_gasSampleBehavior != "") {
        BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasSampleBehavior", lv_gasSampleBehavior);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasSampleBefore", lv_gasSampleBefore);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "GenericBonusGasSampleAmount", lv_gasSampleAmount);
    }
    BankSave(BankLastCreated());
}

void libE0EAE146_gf_GenericBonusApplyPassives (int lp_player) {
    // Data-driven bonus passive application (replaces 11 hardcoded if-else blocks).
    // Upgrade IDs and extra calls are defined in Shared/GenericBonuses.json
    // and dispatched by LibE0EAE146_GenericBonusCatalog.galaxy.
    libE0EAE146_gf_ApplyAllGenericBonusPassives(lp_player);

    // Special trigger logic for CreepRegeneration and MechanicalRepair (runtime-only, not data-driven).
    libE0EAE146_gf_GenericBonusEnsureTriggers();
    libE0EAE146_gv_genericBonusMechanicalRepairEnabled = false;
    libE0EAE146_gv_genericBonusCreepRegenEnabled = libE0EAE146_gf_GenericBonusEnabled("CreepRegeneration");
    TriggerEnable(libE0EAE146_gt_GenericBonusMechanicalRepair, false);
    TriggerEnable(libE0EAE146_gt_GenericBonusCreepRegen, libE0EAE146_gv_genericBonusCreepRegenEnabled);
}

point libE0EAE146_gf_GenericBonusControllerPoint (int lp_player) {
    point lv_origin;
    point lv_candidate;
    point lv_placement;
    int lv_angleIndex;
    int lv_radiusIndex;
    fixed lv_angle;
    fixed lv_radius;
    fixed[6] lv_angles;
    fixed[4] lv_radii;

    lv_origin = libE0EAE146_gf_CommanderEffectiveBaseAnchor(lp_player, libE0EAE146_gv_commander);
    if (lv_origin == null) {
        lv_origin = PlayerStartLocation(lp_player);
    }

    if (libE0EAE146_gv_currentMapId == "thanson01_7vs1") {
        lv_angles[0] = 90.0;
        lv_angles[1] = 45.0;
        lv_angles[2] = 135.0;
        lv_angles[3] = 0.0;
        lv_angles[4] = 180.0;
        lv_angles[5] = 315.0;
        lv_radii[0] = 14.0;
        lv_radii[1] = 16.0;
        lv_radii[2] = 18.0;
        lv_radii[3] = 20.0;
    }
    else {
        lv_angles[0] = 135.0;
        lv_angles[1] = 225.0;
        lv_angles[2] = 315.0;
        lv_angles[3] = 45.0;
        lv_angles[4] = 180.0;
        lv_angles[5] = 270.0;
        lv_radii[0] = 11.0;
        lv_radii[1] = 13.0;
        lv_radii[2] = 15.0;
        lv_radii[3] = 17.0;
    }

    lv_candidate = lv_origin;
    for (lv_radiusIndex = 0; lv_radiusIndex < 4; lv_radiusIndex += 1) {
        lv_radius = lv_radii[lv_radiusIndex];
        for (lv_angleIndex = 0; lv_angleIndex < 6; lv_angleIndex += 1) {
            lv_angle = lv_angles[lv_angleIndex];
            lv_candidate = PointWithOffsetPolar(lv_origin, lv_radius, lv_angle);
            lv_placement = UnitTypePlacementFromPoint("GenericBonusController", lp_player, lv_candidate, 12.0);
            if (lv_placement != null) {
                return lv_placement;
            }
        }
    }

    return lv_candidate;
}

unit libE0EAE146_gf_CreateGenericBonusController (int lp_player) {
    point lv_point;
    unit lv_controller;

    if (!CatalogEntryIsValid(c_gameCatalogUnit, "GenericBonusController")) {
        return null;
    }
    if ((UnitIsValid(libE0EAE146_gv_genericBonusController) == true) && (UnitIsAlive(libE0EAE146_gv_genericBonusController) == true)) {
        return libE0EAE146_gv_genericBonusController;
    }

    lv_point = libE0EAE146_gf_GenericBonusControllerPoint(lp_player);
    UnitCreate(1, "GenericBonusController", 0, lp_player, lv_point, 225.0);
    lv_controller = UnitLastCreated();
    if (((UnitIsValid(lv_controller) == true) && (UnitGetOwner(lv_controller) == lp_player)) && (UnitGetType(lv_controller) == "GenericBonusController")) {
        libE0EAE146_gv_genericBonusController = lv_controller;
        return lv_controller;
    }

    UnitCreate(1, "GenericBonusController", c_unitCreateIgnorePlacement, lp_player, lv_point, 225.0);
    lv_controller = UnitLastCreated();
    if (((UnitIsValid(lv_controller) == true) && (UnitGetOwner(lv_controller) == lp_player)) && (UnitGetType(lv_controller) == "GenericBonusController")) {
        libE0EAE146_gv_genericBonusController = lv_controller;
        return lv_controller;
    }

    return null;
}

void libE0EAE146_gf_GenericBonusEnsureController (int lp_player) {
    unitgroup lv_nearbyUnits;
    unit lv_unit;
    point lv_point;
    int lv_count;
    string lv_unitType;

    if (!libE0EAE146_gv_genericBonusControllerRequired) {
        return;
    }
    if ((UnitIsValid(libE0EAE146_gv_genericBonusController) == true) && (UnitIsAlive(libE0EAE146_gv_genericBonusController) == true) && (UnitGetOwner(libE0EAE146_gv_genericBonusController) == lp_player) && (UnitGetType(libE0EAE146_gv_genericBonusController) == "GenericBonusController")) {
        return;
    }

    lv_point = libE0EAE146_gf_GenericBonusControllerPoint(lp_player);
    lv_nearbyUnits = UnitGroupSearch(null, lp_player, lv_point, 4.0, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_nearbyUnits, c_unitCountAll);
    while (lv_count > 0) {
        lv_unit = UnitGroupUnitFromEnd(lv_nearbyUnits, lv_count);
        lv_unitType = UnitGetType(lv_unit);
        if (lv_unitType == "GenericBonusController") {
            libE0EAE146_gv_genericBonusController = lv_unit;
            return;
        }
        if ((lv_unitType == "SolarForge") || (lv_unitType == "DamagedSolarForge")) {
            UnitRemove(lv_unit);
        }
        lv_count -= 1;
    }

    libE0EAE146_gv_genericBonusController = null;
    libE0EAE146_gv_genericBonusController = libE0EAE146_gf_CreateGenericBonusController(lp_player);
}

void libE0EAE146_gf_ApplyGenericBonuses (int lp_player) {
    int lv_doubleMineralsLevel;
    int lv_doubleVespeneLevel;
    bool lv_richResources;
    bool lv_guardianShell;
    bool lv_creepRegeneration;
    bool lv_mechanicalRepair;
    bool lv_chronoBoost;
    bool lv_abathurBiomassDrop;
    bool lv_maxSupply50;
    bool lv_allyEarlyDamageReduction;
    bool lv_allySustainBoost;
    int lv_selectedCount;
    int lv_controllerCreated;
    int lv_supplyLimitAfter;
    int lv_doubleMineralsInt;
    int lv_doubleVespeneInt;
    int lv_richResourcesInt;
    int lv_guardianShellInt;
    int lv_creepRegenerationInt;
    int lv_mechanicalRepairInt;
    int lv_chronoBoostInt;
    int lv_abathurBiomassDropInt;
    int lv_maxSupply50Int;
    int lv_allyEarlyDamageReductionInt;
    int lv_allySustainBoostInt;
    unit lv_controller;

    if (libE0EAE146_gv_genericBonusesApplied) {
        return;
    }
    if (libE0EAE146_gf_GenericBonusBankInt("Enabled") <= 0) {
        return;
    }

    lv_doubleMineralsLevel = libE0EAE146_gf_GenericBonusLevel("DoubleMinerals");
    lv_doubleVespeneLevel = libE0EAE146_gf_GenericBonusLevel("DoubleVespene");
    lv_richResources = libE0EAE146_gf_GenericBonusEnabled("RichResources");
    lv_guardianShell = libE0EAE146_gf_GenericBonusEnabled("GuardianShell");
    lv_creepRegeneration = libE0EAE146_gf_GenericBonusEnabled("CreepRegeneration");
    lv_mechanicalRepair = libE0EAE146_gf_GenericBonusEnabled("MechanicalRepair");
    lv_chronoBoost = libE0EAE146_gf_GenericBonusEnabled("ChronoBoost");
    lv_abathurBiomassDrop = libE0EAE146_gf_GenericBonusEnabled("AbathurBiomassDrop");
    lv_maxSupply50 = libE0EAE146_gf_GenericBonusEnabled("MaxSupply50");
    lv_allyEarlyDamageReduction = libE0EAE146_gf_GenericBonusEnabled("AllyEarlyDamageReduction");
    lv_allySustainBoost = libE0EAE146_gf_GenericBonusEnabled("AllySustainBoost");
    lv_selectedCount = 0;
    if (lv_doubleMineralsLevel > 0) { lv_selectedCount += 1; }
    if (lv_doubleVespeneLevel > 0) { lv_selectedCount += 1; }
    if (lv_richResources) { lv_selectedCount += 1; }
    if (lv_guardianShell) { lv_selectedCount += 1; }
    if (lv_creepRegeneration) { lv_selectedCount += 1; }
    if (lv_mechanicalRepair) { lv_selectedCount += 1; }
    if (lv_chronoBoost) { lv_selectedCount += 1; }
    if (lv_abathurBiomassDrop) { lv_selectedCount += 1; }
    if (lv_maxSupply50) { lv_selectedCount += 1; }
    if (lv_allyEarlyDamageReduction) { lv_selectedCount += 1; }
    if (lv_allySustainBoost) { lv_selectedCount += 1; }

    libE0EAE146_gv_genericBonusesApplied = true;
    libE0EAE146_gv_genericBonusControllerRequired = ((lv_doubleMineralsLevel > 0) || (lv_doubleVespeneLevel > 0) || lv_richResources || lv_guardianShell || lv_creepRegeneration || lv_mechanicalRepair || lv_chronoBoost || lv_abathurBiomassDrop);
    if ((lv_doubleMineralsLevel > 0) || (lv_doubleVespeneLevel > 0) || lv_richResources) {
        libE0EAE146_gf_GenericBonusApplyResources(lv_doubleMineralsLevel, lv_doubleVespeneLevel, lv_richResources);
    }
    libE0EAE146_gf_GenericBonusApplyPassives(lp_player);
    if (libE0EAE146_gt_GenericBonusControllerWatchdog != null) {
        TriggerEnable(libE0EAE146_gt_GenericBonusControllerWatchdog, libE0EAE146_gv_genericBonusControllerRequired);
    }
    if (libE0EAE146_gv_genericBonusControllerRequired) {
        lv_controller = libE0EAE146_gf_CreateGenericBonusController(lp_player);
    }
    libE0EAE146_gf_GenericBonusEnsureController(lp_player);
    lv_controller = libE0EAE146_gv_genericBonusController;
    if ((lv_abathurBiomassDrop == true) && (UnitIsValid(lv_controller) == true)) {
        libE0EAE146_gf_CreateAbathurBiomassPickup(PointWithOffsetPolar(UnitGetPosition(lv_controller), 3.0, 45.0), 20);
    }
    if (lv_maxSupply50) {
        PlayerModifyPropertyInt(lp_player, c_playerPropSuppliesLimit, c_playerPropOperAdd, 50);
    }
    lv_supplyLimitAfter = PlayerGetPropertyInt(lp_player, c_playerPropSuppliesLimit);
    lv_doubleMineralsInt = 0;
    lv_doubleVespeneInt = 0;
    lv_richResourcesInt = 0;
    lv_guardianShellInt = 0;
    lv_creepRegenerationInt = 0;
    lv_mechanicalRepairInt = 0;
    lv_chronoBoostInt = 0;
    lv_abathurBiomassDropInt = 0;
    lv_maxSupply50Int = 0;
    lv_allyEarlyDamageReductionInt = 0;
    lv_allySustainBoostInt = 0;
    lv_doubleMineralsInt = lv_doubleMineralsLevel;
    lv_doubleVespeneInt = lv_doubleVespeneLevel;
    if (lv_richResources) { lv_richResourcesInt = 1; }
    if (lv_guardianShell) { lv_guardianShellInt = 1; }
    if (lv_creepRegeneration) { lv_creepRegenerationInt = 1; }
    if (lv_mechanicalRepair) { lv_mechanicalRepairInt = 1; }
    if (lv_chronoBoost) { lv_chronoBoostInt = 1; }
    if (lv_abathurBiomassDrop) { lv_abathurBiomassDropInt = 1; }
    if (lv_maxSupply50) { lv_maxSupply50Int = 1; }
    if (lv_allyEarlyDamageReduction) { lv_allyEarlyDamageReductionInt = 1; }
