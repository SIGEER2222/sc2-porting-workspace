// MapUsesSharedPlayerCampaignAlly is now data-driven.
// See LibE0EAE146_MapMetadata.galaxy (generated from Shared/Maps/maps.json).

bool libE0EAE146_gf_ShouldApplyPlayerSkins () {
    string lv_mapId;

    lv_mapId = libE0EAE146_gv_currentMapId;
    if (lv_mapId == "") {
        lv_mapId = GameMapPath();
        if ((StringContains(lv_mapId, "thanson01_7vs1", c_stringAnywhere, c_stringCase) == true)) {
            return false;
        }
        if ((StringContains(lv_mapId, "thanson03a_7vs1", c_stringAnywhere, c_stringCase) == true)) {
            return false;
        }
        return true;
    }
    if ((libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lv_mapId) == true)) {
        return false;
    }
    return true;
}

bool libE0EAE146_gf_SuppressPlayerCinematicUnits (string lp_mapId) {
    if (lp_mapId == "thanson02_7vs1") {
        return true;
    }
    if ((libE0EAE146_gf_MapUsesSharedPlayerCampaignAlly(lp_mapId) == true)) {
        return true;
    }
    return false;
}

int libE0EAE146_gf_RemoveOverlappingDuplicatesForPlayer (int lp_player, fixed lp_radius) {
    unitgroup lv_units;
    int lv_i;
    int lv_j;
    unit lv_unitA;
    unit lv_unitB;
    point lv_pointA;
    string lv_typeA;
    int lv_removed;

    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_removed = 0;
    lv_i = UnitGroupCount(lv_units, c_unitCountAll);
    for ( ; ( lv_i >= 1 ) ; lv_i -= 1 ) {
        lv_unitA = UnitGroupUnitFromEnd(lv_units, lv_i);
        if ((lv_unitA == null) || (UnitIsAlive(lv_unitA) == false)) {
            continue;
        }

        lv_typeA = UnitGetType(lv_unitA);
        lv_pointA = UnitGetPosition(lv_unitA);
        lv_j = (lv_i - 1);
        for ( ; ( lv_j >= 1 ) ; lv_j -= 1 ) {
            lv_unitB = UnitGroupUnitFromEnd(lv_units, lv_j);
            if ((lv_unitB == null) || (UnitIsAlive(lv_unitB) == false)) {
                continue;
            }
            if (UnitGetType(lv_unitB) != lv_typeA) {
                continue;
            }
            if (DistanceBetweenPoints(lv_pointA, UnitGetPosition(lv_unitB)) > lp_radius) {
                continue;
            }

            if (UnitGetTag(lv_unitA) > UnitGetTag(lv_unitB)) {
                UnitRemove(lv_unitA);
                lv_removed += 1;
                lv_unitA = null;
                break;
            }

            UnitRemove(lv_unitB);
            lv_removed += 1;
        }
    }
    return lv_removed;
}

void libE0EAE146_gf_ClearUnitCatalogArrayLinkForPlayer (int lp_player, string lp_unitType, string lp_arrayField, string lp_link, int lp_maxIndex) {
    int lv_index;
    string lv_path;

    if ((lp_player <= 0) || (lp_unitType == "") || (lp_arrayField == "") || (lp_link == "") || (lp_maxIndex <= 0)) {
        return;
    }

    for (lv_index = 0; lv_index < lp_maxIndex; lv_index += 1) {
        lv_path = (lp_arrayField + "[" + IntToString(lv_index) + "].Link");
        if (CatalogFieldValueGet(c_gameCatalogUnit, lp_unitType, lv_path, lp_player) == lp_link) {
            CatalogFieldValueSet(c_gameCatalogUnit, lp_unitType, lv_path, lp_player, "");
        }
    }
}

void libE0EAE146_gf_ClearUnitCatalogFieldIfMatchesForPlayer (int lp_player, string lp_unitType, string lp_fieldPath, string lp_value) {
    if ((lp_player <= 0) || (lp_unitType == "") || (lp_fieldPath == "") || (lp_value == "")) {
        return;
    }

    if (CatalogFieldValueGet(c_gameCatalogUnit, lp_unitType, lp_fieldPath, lp_player) == lp_value) {
        CatalogFieldValueSet(c_gameCatalogUnit, lp_unitType, lp_fieldPath, lp_player, "");
    }
}

