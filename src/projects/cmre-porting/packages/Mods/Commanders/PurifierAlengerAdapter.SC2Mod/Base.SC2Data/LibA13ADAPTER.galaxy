    TechTreeUnitAllow(lp_player, "13yingxionghexin", true);
    TechTreeUnitAllow(lp_player, "13jinghuazheshuniu", true);
    TechTreeUnitAllow(lp_player, "13tanji", true);
    TechTreeUnitAllow(lp_player, "13jinghuazhehexin", true);
    TechTreeUnitAllow(lp_player, "13tianwangjuzhen", true);
    TechTreeUnitAllow(lp_player, "13fuwuqi", true);
    TechTreeUnitAllow(lp_player, "13zhongjiezhe", true);
    TechTreeUnitAllow(lp_player, "13zhongjiezhezhanjia", true);
    TechTreeUnitAllow(lp_player, "13zhongjilengjingPhasing", true);
    TechTreeUnitAllow(lp_player, "13zhongjilengjingTransport", true);
    TechTreeUnitAllow(lp_player, "13shouweizhe", true);
    TechTreeUnitAllow(lp_player, "13shouweizhecanhai", true);
    TechTreeUnitAllow(lp_player, "13fensuizhe", true);
    TechTreeUnitAllow(lp_player, "13buxiuzhe", true);
    TechTreeUnitAllow(lp_player, "13baohuzhe", true);
    TechTreeUnitAllow(lp_player, "13guangzipaotai", true);
    TechTreeUnitAllow(lp_player, "13hudunchongnengqi", true);
    TechTreeUnitAllow(lp_player, "13zhinengxinacang", true);
    TechTreeUnitAllow(lp_player, "13jianduihangbiao", true);
    TechTreeUnitAllow(lp_player, "13chuansongmen", true);
    TechTreeUnitAllow(lp_player, "13kongzhixinhe", true);
    TechTreeUnitAllow(lp_player, "13chuanxinzhe", true);
    TechTreeUnitAllow(lp_player, "13chuanxinzhetouying", true);
    TechTreeUnitAllow(lp_player, "13ganraozhe", true);
    TechTreeUnitAllow(lp_player, "13chengjiezhe", true);
    TechTreeUnitAllow(lp_player, "13chaoyuezhe", true);
    TechTreeUnitAllow(lp_player, "13duanlu", true);
    TechTreeUnitAllow(lp_player, "13jinghuaxinbiao", true);
    TechTreeUnitAllow(lp_player, "13yazhita", true);
    TechTreeUnitAllow(lp_player, "13xingmen", true);
    TechTreeUnitAllow(lp_player, "13jixietai", true);
    TechTreeUnitAllow(lp_player, "13jixieyanjiusuo", true);
