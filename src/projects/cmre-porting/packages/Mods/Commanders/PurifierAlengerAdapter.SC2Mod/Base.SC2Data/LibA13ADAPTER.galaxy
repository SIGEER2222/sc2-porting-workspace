        TechTreeAbilityAllow(lp_player, AbilityCommand("13bianxingweijinghuazhehexin2", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13bianxingweiyingxionghexin", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13chaoxinxing", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13liangzijuzhenguangbo", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zhongxingqiangjijijiku", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13huweijianjiku", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13guidaohongzha", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13hudunshuaxin", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13hudunshuaxin5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuadajidanmu", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuadajidanmu5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuaxinbiao", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuaxinbiao5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuafengbao", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13daxinglanjiejijiku", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13qiangjijijiku", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13lingnengyizhilichang", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13daxingqiangjijijiku", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13quanxiangfuzhi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13guwushanxian", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13tiaoji5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13touying", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13touying5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13wajie", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13xiangweitousheqi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13yanfa3", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jueduifangyulingyu", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13yanfa4", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13yazhichengxu", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13yazhichengxu5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyue5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyuebianxing5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyuejianzao", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyue1", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13chonggouguangshuBeam", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyuebianxing", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13yunshumoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13xiangweimoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13bianxingjianzao", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13bushufuwuqi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyuejianzao5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyueshouweizhe5", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyueshouweizhe", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zhuangzai", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13tiaoji", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13hudunchongneng", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyue2", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13zheyuexunlian2", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13yanfa2", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13shanxian", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jidongmoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13kuozhanmoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13shuzikongjian", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuaxinxing", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuapao", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13shouweizhechonggou", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13shouweizhesiwang", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13quntifengyin", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13guangshujijiku", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13lanjiejijiku", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13jinghuaguangshu", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13quntizheyue", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13bianxingweijinghuazhehexinPlacement", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("13bianxingweijinghuazhehexin", lv_i), true);
    }

    // 2. 允许所有自定义单位（确保建筑可出兵、单位可使用）
    TechTreeUnitAllow(lp_player, "13buxiuzhezhanjia", true);
    TechTreeUnitAllow(lp_player, "13huweijian", true);
    TechTreeUnitAllow(lp_player, "13chengjiezhezhanjia", true);
