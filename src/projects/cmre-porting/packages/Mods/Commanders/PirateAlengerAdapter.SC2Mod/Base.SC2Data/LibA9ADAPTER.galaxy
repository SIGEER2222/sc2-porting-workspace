//--------------------------------------------------------------------------------------------------
// Library: Alenger9Adapter
// 通用 Alenger adapter（完整模式）：
//   1. 为玩家1升级全部科技（数据驱动，来自源 mod UpgradeData.xml）
//   2. 为所有人类玩家解锁全部自定义能力（cmd 0-31 全解锁）
//   3. 为所有人类玩家解锁全部自定义单位（TechTreeUnitAllow）
//   4. 周期性重解锁（5 秒×8 次，覆盖 40 秒）以覆盖 7v1/CMRE 框架 MapInit 后的重新禁用
// 这样避免 ApplyOriginal7V1OpenerTech 没有 Alenger 分支导致的建造选项不完整问题。
//--------------------------------------------------------------------------------------------------

void libA9ADAPTER_gf_UnlockAllAbilities (int lp_player) {
    int lv_i;

    // 1. 解锁所有自定义能力（cmd 0-31 全解锁，TechTreeAbilityAllow 幂等）
