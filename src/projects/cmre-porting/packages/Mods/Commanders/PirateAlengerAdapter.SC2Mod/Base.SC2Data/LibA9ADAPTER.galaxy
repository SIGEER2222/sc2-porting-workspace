//--------------------------------------------------------------------------------------------------
// Trigger: MapInit - 执行解锁逻辑
//--------------------------------------------------------------------------------------------------
bool libA9ADAPTER_gt_MapInit_Func (bool testConds, bool runActions) {
    int lp_player;
    int lv_player;
    int lv_i;
    int lv_retry;
    string lv_upgradeId;
    int lv_upgradeLevel;
    playergroup autolibA9ADAPTER_g;

    lp_player = 1;

    // Conditions
    if (testConds) {
        return true;
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // -------- 1. 为玩家1升级全部科技（数据驱动）--------
    lv_i = 1;
    for ( ; ( lv_i <= libA9ADAPTER_gv_upgradeCount ) ; lv_i += 1 ) {
        lv_upgradeId = libA9ADAPTER_gf_UpgradeId(lv_i);
        lv_upgradeLevel = libA9ADAPTER_gf_UpgradeLevel(lv_i);
        if ((lv_upgradeId != "")) {
            TechTreeUpgradeAddLevel(lp_player, lv_upgradeId, lv_upgradeLevel);
        }
    }

    // -------- 2. 第一次解锁所有能力和单位 --------
    autolibA9ADAPTER_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(autolibA9ADAPTER_g, lv_player);
        if (lv_player < 0) { break; }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            libA9ADAPTER_gf_UnlockAllAbilities(lv_player);
        }
    }

    // -------- 3. 周期性重解锁，覆盖 7v1/CMRE 框架 MapInit 后的重新禁用 --------
    // TechTreeAbilityAllow/UnitAllow 幂等，重复调用 true 无副作用，对 7v1 地图安全。
    for (lv_retry = 0; lv_retry < 8; lv_retry += 1) {
        Wait(5.0, c_timeReal);
        autolibA9ADAPTER_g = PlayerGroupAll();
        lv_player = -1;
        while (true) {
            lv_player = PlayerGroupNextPlayer(autolibA9ADAPTER_g, lv_player);
            if (lv_player < 0) { break; }
            if ((PlayerType(lv_player) == c_playerTypeUser)) {
                libA9ADAPTER_gf_UnlockAllAbilities(lp_player);
            }
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libA9ADAPTER_InitTriggers () {
    libA9ADAPTER_gt_MapInit = TriggerCreate("libA9ADAPTER_gt_MapInit_Func");
    TriggerAddEventMapInit(libA9ADAPTER_gt_MapInit);
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA9ADAPTER_InitLib_completed = false;

void libA9ADAPTER_InitLib () {
    if (libA9ADAPTER_InitLib_completed) {
        return;
    }

    libA9ADAPTER_InitLib_completed = true;

    libA9ADAPTER_InitTriggers();
}
