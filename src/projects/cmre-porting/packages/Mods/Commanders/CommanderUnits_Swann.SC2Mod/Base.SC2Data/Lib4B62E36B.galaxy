void lib4B62E36B_gt_DrakkenLaserDrillBFGAb_Init () {
    lib4B62E36B_gt_DrakkenLaserDrillBFGAb = TriggerCreate("lib4B62E36B_gt_DrakkenLaserDrillBFGAb_Func");
    TriggerEnable(lib4B62E36B_gt_DrakkenLaserDrillBFGAb, false);
    TriggerAddEventUnitAbility(lib4B62E36B_gt_DrakkenLaserDrillBFGAb, null, AbilityCommand("DrakkenLaserDrillBFG", 0), c_unitAbilStageComplete, false);
}

void lib4B62E36B_InitTriggers () {
    lib4B62E36B_gt_DrakkenLaserDrillBFGAb_Init();
}

