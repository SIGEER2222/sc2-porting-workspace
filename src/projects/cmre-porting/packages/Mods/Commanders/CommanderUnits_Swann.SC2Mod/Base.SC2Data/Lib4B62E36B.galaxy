// Functions
void lib4B62E36B_gf_DrakkenLaserDrillUnit (unit lp_u, int lp_p) {
    // Automatic Variable Declarations
    // Implementation
    DataTableSetUnitGroup(true, ("DrakkenLaserDrill" + IntToString(lp_p)), libNtve_gf_ConvertUnitToUnitGroup(lp_u));
    TriggerEnable(lib4B62E36B_gt_DrakkenLaserDrillBFGAb, true);
}

void lib4B62E36B_gf_DrakkenLaserDrillAddCasterGroup (int lp_p) {
    // Automatic Variable Declarations
    // Implementation
    lib67C0F0E7_gf_AddCasterGroup(lp_p, UnitGroupUnit(DataTableGetUnitGroup(true, ("DrakkenLaserDrill" + IntToString(lp_p))), 1));
}

// Triggers
//--------------------------------------------------------------------------------------------------
// Trigger: DrakkenLaserDrillBFGAb
//--------------------------------------------------------------------------------------------------
bool lib4B62E36B_gt_DrakkenLaserDrillBFGAb_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_p;
    int lv_r;

    // Automatic Variable Declarations
    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    lv_p = lib67C0F0E7_gf_EdgeInstersection(UnitGetPosition(EventUnit()), EventUnitTargetPoint(), RegionPlayableMap());
    lv_r = FixedToInt(DistanceBetweenPoints(UnitGetPosition(EventUnit()), lv_p));
    CatalogFieldValueModify(c_gameCatalogEffect, "DrakkenLaserDrillBFGCP", "PeriodicOffsetArray[" + IntToString(0) + "]", EventPlayer(), ("0, -" + IntToString((lv_r / 2)) + ", 0"), c_upgradeOperationSet);
    CatalogFieldValueModify(c_gameCatalogEffect, "DrakkenLaserDrillBFGSearch", "AreaArray[" + IntToString(0) + "].RectangleHeight", EventPlayer(), IntToString(lv_r), c_upgradeOperationSet);
    UnitCreateEffectPoint(EventUnit(), "DrakkenLaserDrillBFGSet", lv_p);
    return true;
}

