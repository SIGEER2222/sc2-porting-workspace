include "TriggerLibs/NativeLib"

include "LibA11ADAPTER_h"

//--------------------------------------------------------------------------------------------------
// Library: Alenger11Adapter
// 通用 Alenger adapter（完整模式）：
//   1. 为玩家1升级全部科技（数据驱动，来自源 mod UpgradeData.xml）
//   2. 为所有人类玩家解锁全部自定义能力（cmd 0-31 全解锁）
//   3. 为所有人类玩家解锁全部自定义单位（TechTreeUnitAllow）
//   4. 周期性重解锁（5 秒×8 次，覆盖 40 秒）以覆盖 7v1/CMRE 框架 MapInit 后的重新禁用
// 这样避免 ApplyOriginal7V1OpenerTech 没有 Alenger 分支导致的建造选项不完整问题。
//--------------------------------------------------------------------------------------------------

void libA11ADAPTER_gf_UnlockAllAbilities (int lp_player) {
    int lv_i;

    // 1. 解锁所有自定义能力（cmd 0-31 全解锁，TechTreeAbilityAllow 幂等）
    for (lv_i = 0; lv_i <= 31; lv_i += 1) {
        TechTreeAbilityAllow(lp_player, AbilityCommand("11jietu", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("11kongtoucang", lv_i), true);
    }

    // 2. 允许所有自定义单位（确保建筑可出兵、单位可使用）
    TechTreeUnitAllow(lp_player, "11xiaojianguo", true);
    TechTreeUnitAllow(lp_player, "11nuowalu", true);
    TechTreeUnitAllow(lp_player, "11yuyingweilai", true);
    TechTreeUnitAllow(lp_player, "11zishen", true);
    TechTreeUnitAllow(lp_player, "11jddhsn", true);
    TechTreeUnitAllow(lp_player, "11jibianti", true);
    TechTreeUnitAllow(lp_player, "11jjgg", true);
    TechTreeUnitAllow(lp_player, "11xingchen", true);
    TechTreeUnitAllow(lp_player, "11sepilongwang", true);
    TechTreeUnitAllow(lp_player, "11zaixiaheikong", true);
    TechTreeUnitAllow(lp_player, "11Ob", true);
    TechTreeUnitAllow(lp_player, "11jibamaoxiaowo", true);
    TechTreeUnitAllow(lp_player, "11longjuanfengbaodancang", true);
    TechTreeUnitAllow(lp_player, "11qiuligao", true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: MapInit - 执行解锁逻辑
//--------------------------------------------------------------------------------------------------
bool libA11ADAPTER_gt_MapInit_Func (bool testConds, bool runActions) {
    int lp_player;
    int lv_player;
    int lv_i;
    int lv_retry;
    playergroup autolibA11ADAPTER_g;

    lp_player = 1;

    // Conditions
    if (testConds) {
        return true;
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // -------- 1. 第一次解锁所有能力和单位 --------
    autolibA11ADAPTER_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(autolibA11ADAPTER_g, lv_player);
        if (lv_player < 0) { break; }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            libA11ADAPTER_gf_UnlockAllAbilities(lv_player);
        }
    }

    // -------- 3. 周期性重解锁，覆盖 7v1/CMRE 框架 MapInit 后的重新禁用 --------
    // TechTreeAbilityAllow/UnitAllow 幂等，重复调用 true 无副作用，对 7v1 地图安全。
    for (lv_retry = 0; lv_retry < 8; lv_retry += 1) {
        Wait(5.0, c_timeReal);
        autolibA11ADAPTER_g = PlayerGroupAll();
        lv_player = -1;
        while (true) {
            lv_player = PlayerGroupNextPlayer(autolibA11ADAPTER_g, lv_player);
            if (lv_player < 0) { break; }
            if ((PlayerType(lv_player) == c_playerTypeUser)) {
                libA11ADAPTER_gf_UnlockAllAbilities(lp_player);
            }
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libA11ADAPTER_InitTriggers () {
    libA11ADAPTER_gt_MapInit = TriggerCreate("libA11ADAPTER_gt_MapInit_Func");
    TriggerAddEventMapInit(libA11ADAPTER_gt_MapInit);
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA11ADAPTER_InitLib_completed = false;

void libA11ADAPTER_InitLib () {
    if (libA11ADAPTER_InitLib_completed) {
        return;
    }

    libA11ADAPTER_InitLib_completed = true;

    libA11ADAPTER_InitTriggers();
}
