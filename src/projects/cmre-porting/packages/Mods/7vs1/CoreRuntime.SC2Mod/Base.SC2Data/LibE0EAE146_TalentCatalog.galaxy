    // [2] switch: 虚空先驱 (CommanderPrestigeZeratulTornadoes)
    if (libE0EAE146_gf_TalentBankEnabled(lv_cmd, "CommanderPrestigeZeratulTornadoes")) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeZeratulTornadoes", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeZeratulTornadoesShadowCleave1", 1);
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "CommanderPrestigeZeratulTornadoesShadowCleave2", 1);
    }

    // [3] level: 泽拉图攻击速度 (ZeratulMastery1)
    lv_lvl_0 = libE0EAE146_gf_TalentBankValue(lv_cmd, "ZeratulMastery1");
    if (lv_lvl_0 > 0) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MasteryZeratulZeratulAttackSpeed", lv_lvl_0);
    }

    // [4] level: 战斗单位攻击速度 (ZeratulMastery2)
    lv_lvl_1 = libE0EAE146_gf_TalentBankValue(lv_cmd, "ZeratulMastery2");
    if (lv_lvl_1 > 0) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MasteryZeratulCombatUnitAttackSpeed", lv_lvl_1);
    }

    // [5] level: 神器碎片刷新速度 (ZeratulMastery3)
    lv_lvl_2 = libE0EAE146_gf_TalentBankValue(lv_cmd, "ZeratulMastery3");
    if (lv_lvl_2 > 0) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MasteryZeratulArtifactFragmentSpawnRate", lv_lvl_2);
    }

    // [6] level: 支援力量冷却时间缩减 (ZeratulMastery4)
    lv_lvl_3 = libE0EAE146_gf_TalentBankValue(lv_cmd, "ZeratulMastery4");
    if (lv_lvl_3 > 0) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MasteryZeratulSupportCalldownCooldownReduction", lv_lvl_3);
    }

    // [7] level: 传奇军团费用 (ZeratulMastery5)
    lv_lvl_4 = libE0EAE146_gf_TalentBankValue(lv_cmd, "ZeratulMastery5");
    if (lv_lvl_4 > 0) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MasteryZeratulLegendaryLegionCost", lv_lvl_4);
    }

    // [8] level: 化身冷却时间 (ZeratulMastery6)
    lv_lvl_5 = libE0EAE146_gf_TalentBankValue(lv_cmd, "ZeratulMastery6");
    if (lv_lvl_5 > 0) {
        libE0EAE146_gf_CommanderPowerSetUpgradeAtLeast(lp_player, "MasteryZeratulAvatarCooldown", lv_lvl_5);
    }
}

