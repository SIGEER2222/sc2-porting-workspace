include "LibE0EAE146_h"

// ---- Bank key helpers ----

// Read talent level from Bank: <Commander>.<TalentId> in CommanderTalents section
int libE0EAE146_gf_TalentBankValue (string lp_commander, string lp_talentId) {
    bank lv_bank = BankLoad("CampaignXCore", 1);
    string lv_key = lp_commander + "." + lp_talentId;
    if (BankKeyExists(lv_bank, "CommanderTalents", lv_key)) {
        return BankValueGetAsInt(lv_bank, "CommanderTalents", lv_key);
    }
    return 0;
}

bool libE0EAE146_gf_TalentBankEnabled (string lp_commander, string lp_talentId) {
    return (libE0EAE146_gf_TalentBankValue(lp_commander, lp_talentId) > 0);
}

// Read extra option flag: <Commander>.<TalentId>.<OptionId>
bool libE0EAE146_gf_TalentExtraOptionEnabled (string lp_commander, string lp_talentId, string lp_optionId) {
    bank lv_bank = BankLoad("CampaignXCore", 1);
    string lv_key = lp_commander + "." + lp_talentId + "." + lp_optionId;
    if (BankKeyExists(lv_bank, "CommanderTalents", lv_key)) {
        return (BankValueGetAsInt(lv_bank, "CommanderTalents", lv_key) > 0);
    }
    return false;
}

