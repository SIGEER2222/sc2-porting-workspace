void libE0EAE146_gf_TestZergCreateBuilding (int lp_player, point lp_center, string lp_unitType, fixed lp_offsetX, fixed lp_offsetY) {
    point lv_p;
    lv_p = PointWithOffset(lp_center, lp_offsetX, lp_offsetY);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, lp_unitType, c_unitCreateIgnorePlacement, lp_player, lv_p);
}

void libE0EAE146_gf_TestZergCreateBuildings (int lp_player, point lp_center) {
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "SpawningPool", -5.0, -5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "BanelingNest", 5.0, -5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "RoachWarren", -5.0, 5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "HydraliskDen", 5.0, 5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "LurkerDen", 10.0, 5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "InfestationPit", -10.0, 5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "Spire", 10.0, -5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "GreaterSpire", 15.0, -5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "UltraliskCavern", -10.0, -5.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "EvolutionChamber", 0.0, 10.0);
    libE0EAE146_gf_TestZergCreateBuilding(lp_player, lp_center, "Lair", 20.0, 0.0);
}

void libE0EAE146_gf_TestZergRuntimeInit (int lp_player, point lp_heroPoint, bool lp_createHero) {
    libE0EAE146_gf_TestZergApplyTechFilter(lp_player);
    libE0EAE146_gf_TestZergCreateBuildings(lp_player, lp_heroPoint);
}
