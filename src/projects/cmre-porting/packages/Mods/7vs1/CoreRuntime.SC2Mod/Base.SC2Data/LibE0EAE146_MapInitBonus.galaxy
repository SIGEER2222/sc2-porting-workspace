// MapInitBonus - 开局奖励触发器，替代 jimu 库 (Lib45C3A6C3)
// 迁移自 Lib45C3A6C3.galaxy 的 3 个触发器，前缀替换为 libE0EAE146_
//   gt_bug                       — 开局 3 秒后人族兵营解锁
//   gt_E5BC80E5B180E8B584E6BA90  — 开局 0.1 秒后设置玩家 1 资源为 500/250
//   gt_E4B88DE58DA0E4BABAE58FA3  — 每 30 秒检查 ZeroSupply 并设置补给

// ===== 触发器声明 =====
trigger libE0EAE146_gt_bug;
trigger libE0EAE146_gt_E5BC80E5B180E8B584E6BA90;
trigger libE0EAE146_gt_E4B88DE58DA0E4BABAE58FA3;

//--------------------------------------------------------------------------------------------------
// Trigger: bug — 开局 3 秒后人族兵营解锁
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_bug_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_e78EA9E5AEB6;
    unit lv_e58D95E4BD8D;

    // Automatic Variable Declarations
    playergroup auto68C294FA_g;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    auto68C294FA_g = PlayerGroupAll();
    lv_e78EA9E5AEB6 = -1;
    while (true) {
        lv_e78EA9E5AEB6 = PlayerGroupNextPlayer(auto68C294FA_g, lv_e78EA9E5AEB6);
        if (lv_e78EA9E5AEB6 < 0) { break; }
        if ((PlayerType(lv_e78EA9E5AEB6) == c_playerTypeUser)) {
            TechTreeUnitAllow(lv_e78EA9E5AEB6, "Barracks", true);
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gt_bug_Init () {
    libE0EAE146_gt_bug = TriggerCreate("libE0EAE146_gt_bug_Func");
    TriggerAddEventTimeElapsed(libE0EAE146_gt_bug, 3.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: 开局资源 — 开局 0.1 秒后设置玩家 1 资源为 500/250
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_E5BC80E5B180E8B584E6BA90_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_e78EA9E5AEB6;

    // Automatic Variable Declarations
    playergroup autoE150305B_g;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    autoE150305B_g = PlayerGroupAll();
    lv_e78EA9E5AEB6 = -1;
    while (true) {
        lv_e78EA9E5AEB6 = PlayerGroupNextPlayer(autoE150305B_g, lv_e78EA9E5AEB6);
        if (lv_e78EA9E5AEB6 < 0) { break; }
        if ((PlayerType(lv_e78EA9E5AEB6) == c_playerTypeUser)) {
            PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperAdd, (500 - PlayerGetPropertyInt(1, c_playerPropMinerals)));
            PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperAdd, (250 - PlayerGetPropertyInt(1, c_playerPropVespene)));
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gt_E5BC80E5B180E8B584E6BA90_Init () {
    libE0EAE146_gt_E5BC80E5B180E8B584E6BA90 = TriggerCreate("libE0EAE146_gt_E5BC80E5B180E8B584E6BA90_Func");
    TriggerAddEventTimeElapsed(libE0EAE146_gt_E5BC80E5B180E8B584E6BA90, 0.1, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: 不占人口 — 每 30 秒检查 ZeroSupply 并设置补给
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_E4B88DE58DA0E4BABAE58FA3_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_e78EA9E5AEB6;
    unit lv_e58D95E4BD8D;
    bool lv_zeroSupplyEnabled;
    int lv_supplyLimit;

    // Automatic Variable Declarations
    playergroup autoDB482E3C_g;
    unitgroup autoBD71835F_g;
    int autoBD71835F_u;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("CampaignXCore", 1);
    lv_zeroSupplyEnabled = (BankValueGetAsInt(BankLastCreated(), "GenericBonuses", "Selected.ZeroSupply") > 0);
    if (!lv_zeroSupplyEnabled) {
        return true;
    }
    lv_supplyLimit = 200;
    if ((BankValueGetAsInt(BankLastCreated(), "GenericBonuses", "Selected.MaxSupply50") > 0)) {
        lv_supplyLimit = 250;
    }

    autoDB482E3C_g = PlayerGroupAll();
    lv_e78EA9E5AEB6 = -1;
    while (true) {
        lv_e78EA9E5AEB6 = PlayerGroupNextPlayer(autoDB482E3C_g, lv_e78EA9E5AEB6);
        if (lv_e78EA9E5AEB6 < 0) { break; }
        if ((PlayerType(lv_e78EA9E5AEB6) == c_playerTypeUser) && (PlayerGetPropertyInt(lv_e78EA9E5AEB6, c_playerPropSuppliesUsed) >= 1)) {
            PlayerModifyPropertyInt(lv_e78EA9E5AEB6, c_playerPropSuppliesLimit, c_playerPropOperSetTo, lv_supplyLimit);
            autoBD71835F_g = UnitGroup(null, lv_e78EA9E5AEB6, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
            autoBD71835F_u = UnitGroupCount(autoBD71835F_g, c_unitCountAll);
            for (;; autoBD71835F_u -= 1) {
                lv_e58D95E4BD8D = UnitGroupUnitFromEnd(autoBD71835F_g, autoBD71835F_u);
                if (lv_e58D95E4BD8D == null) { break; }
                UnitSetState(lv_e58D95E4BD8D, c_unitStateUsingSupply, false);
            }
        }

    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gt_E4B88DE58DA0E4BABAE58FA3_Init () {
    libE0EAE146_gt_E4B88DE58DA0E4BABAE58FA3 = TriggerCreate("libE0EAE146_gt_E4B88DE58DA0E4BABAE58FA3_Func");
    TriggerAddEventTimePeriodic(libE0EAE146_gt_E4B88DE58DA0E4BABAE58FA3, 30.0, c_timeGame);
}

// ===== 触发器初始化入口 =====
void libE0EAE146_MapInitBonus_InitTriggers () {
    libE0EAE146_gt_bug_Init();
    libE0EAE146_gt_E5BC80E5B180E8B584E6BA90_Init();
    libE0EAE146_gt_E4B88DE58DA0E4BABAE58FA3_Init();
}
