    }
}

bool libE0EAE146_gf_CommanderUseOriginal7v1SharedOpeners () {
    return true;
}

bool libE0EAE146_gf_CommanderUsePrivateTechFilter (string lp_commander) {
    lp_commander = libE0EAE146_gf_CommanderShortName(lp_commander);
    return ((lp_commander == "Kerrigan") || (lp_commander == "Raynor") || (lp_commander == "RaynorX"));
}

void libE0EAE146_gf_AllowUnitIfPresent (int lp_player, string lp_unit) {
    if ((lp_unit == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unit))) {
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unit, true);
}

void libE0EAE146_gf_AllowAbilityIfPresent (int lp_player, string lp_abil, int lp_cmdIndex) {
    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
    }
    TechTreeAbilityAllow(lp_player, AbilityCommand(lp_abil, lp_cmdIndex), true);
}

void libE0EAE146_gf_AllowAbilityCommandsIfPresent (int lp_player, string lp_abil, int lp_maxCmdIndex) {
    int lv_i;

    if ((lp_abil == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abil))) {
        return;
    }
    lv_i = 0;
    for ( ; ( lv_i <= lp_maxCmdIndex ) ; lv_i += 1 ) {
        TechTreeAbilityAllow(lp_player, AbilityCommand(lp_abil, lv_i), true);
    }
}

void libE0EAE146_gf_ApplyOriginal7v1OpenerTech (int lp_player, string lp_commander) {
    lp_commander = libE0EAE146_gf_CommanderShortName(lp_commander);
    if (libE0EAE146_gf_CommanderUsePrivateTechFilter(lp_commander)) {
        return;
    }

    if ((lp_commander == "Raynor") || (lp_commander == "Swann") || (lp_commander == "Nova")) {
        if (lp_commander == "Swann") {
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "CommandCenterSwann");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "CommandCenterSwannFlying");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "OrbitalCommandSwann");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "OrbitalCommandSwannFlying");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "PlanetaryFortressSwann");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "SCVSwann");
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "CommandCenterTrainSwann", 0);
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "CommandCenterLiftOffSwann", 0);
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "CommandCenterLandSwann", 0);
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "UpgradeToOrbitalSwann", 0);
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "UpgradeToPlanetaryFortressSwann", 0);
            libE0EAE146_gf_AllowAbilityCommandsIfPresent(lp_player, "TerranBuildSwann", 31);
        }
        if (lp_commander == "Nova") {
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "CommandCenterNova");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "CommandCenterNovaFlying");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "OrbitalCommandNova");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "OrbitalCommandNovaFlying");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "PlanetaryFortressNova");
            libE0EAE146_gf_AllowUnitIfPresent(lp_player, "SCVNova");
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "CommandCenterTrainNova", 0);
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "CommandCenterLiftOffNova", 0);
            libE0EAE146_gf_AllowAbilityIfPresent(lp_player, "CommandCenterLandNova", 0);
