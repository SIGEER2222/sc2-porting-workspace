// XMFinal split module: runtime initialization safety helpers.

string libE0EAE146_gf_CodexTestPrimaryCommander () {
    return libE0EAE146_gf_CodexPrimaryCommanderName();
}

string libE0EAE146_gf_RuntimePrimaryCommander () {
    string lv_primaryCommander;

    lv_primaryCommander = libE0EAE146_gf_CodexTestPrimaryCommander();
    if (lv_primaryCommander != "") {
        if (lv_primaryCommander == "Alenger3") {
            return "Alenger3";
        }
        return lv_primaryCommander;
    }

    lv_primaryCommander = BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "PrimaryCommander");
    if (lv_primaryCommander != "") {
        if (lv_primaryCommander == "Alenger3") {
            return "Alenger3";
        }
        return lv_primaryCommander;
    }

    lv_primaryCommander = BankValueGetAsString(BankLastCreated(), "Ach", "Commander");
    if (lv_primaryCommander == "Alenger3") {
        return "Alenger3";
    }
    return lv_primaryCommander;
}

void libE0EAE146_gf_RuntimeLog (int lp_level, string lp_category, string lp_event, int lp_player, string lp_valueA, string lp_valueB, int lp_valueInt) {
    string lv_category;
    string lv_event;
    string lv_prefix;
    int lv_count;

    lv_category = lp_category;
    if (lv_category == "") {
        lv_category = "General";
    }
    lv_event = lp_event;
    if (lv_event == "") {
        lv_event = "Unnamed";
    }

    lv_prefix = ("XMRuntimeLog_" + lv_category + "_" + lv_event);
    lv_count = (DataTableGetInt(true, (lv_prefix + "_Count")) + 1);
    DataTableSetInt(true, (lv_prefix + "_Count"), lv_count);
    DataTableSetInt(true, (lv_prefix + "_Level"), lp_level);
    DataTableSetInt(true, (lv_prefix + "_Player"), lp_player);
    DataTableSetString(true, (lv_prefix + "_ValueA"), lp_valueA);
    DataTableSetString(true, (lv_prefix + "_ValueB"), lp_valueB);
    DataTableSetInt(true, (lv_prefix + "_ValueInt"), lp_valueInt);

    if ((lp_level >= 3) || (lv_count <= 3) || (ModI(lv_count, 10) == 0)) {
        BankLoad("CampaignXCore", 1);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeLog", "LastCategory", lv_category);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeLog", "LastEvent", lv_event);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeLog", "LastLevel", lp_level);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeLog", "LastPlayer", lp_player);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeLog", "LastValueA", lp_valueA);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeLog", "LastValueB", lp_valueB);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeLog", "LastValueInt", lp_valueInt);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeLog", (lv_category + "_" + lv_event + "_Count"), lv_count);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeLog", "RunId", BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "TestRunId"));
        BankValueSetFromString(BankLastCreated(), "XMRuntimeLog", "Commander", libE0EAE146_gv_commander);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeLog", "MapId", libE0EAE146_gv_currentMapId);
        BankSave(BankLastCreated());
    }
}

void libE0EAE146_gf_SeedDefaultCommanderBankIfEmpty (string lp_defaultCommander) {
    string lv_testRunId;
    string lv_primaryCommander;

    if (lp_defaultCommander == "") {
        return;
    }

    BankLoad("CampaignXCore", 1);
    lv_testRunId = BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "TestRunId");
    lv_primaryCommander = libE0EAE146_gf_RuntimePrimaryCommander();
    if ((lv_testRunId != "") && (lv_primaryCommander != "")) {
        BankValueSetFromString(BankLastCreated(), "Ach", "Commander", lv_primaryCommander);
        BankSave(BankLastCreated());
    }
    else if (BankValueGetAsString(BankLastCreated(), "Ach", "Commander") == "") {
        BankValueSetFromString(BankLastCreated(), "Ach", "Commander", lp_defaultCommander);
        BankSave(BankLastCreated());
    }
}

void libE0EAE146_gf_RuntimeCheckpoint (string lp_phase) {
    libE0EAE146_gf_RuntimeLog(1, "Checkpoint", lp_phase, 1, libE0EAE146_gv_commander, libE0EAE146_gv_currentMapId, 0);
    BankLoad("CampaignXCore", 1);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "LastPhase", lp_phase);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "Commander", libE0EAE146_gv_commander);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "RunId", BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "TestRunId"));
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "PrimaryCommander", BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "PrimaryCommander"));
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "AchCommander", BankValueGetAsString(BankLastCreated(), "Ach", "Commander"));
    BankSave(BankLastCreated());
}

void libE0EAE146_gf_RuntimeVisualProbe (string lp_source, int lp_player, string lp_valueA, string lp_valueB, int lp_valueInt) {
    string lv_keyBase;
    int lv_count;
    int lv_playerColor;

    lv_keyBase = ("XMRuntimeVisualProbe_" + lp_source);
    lv_count = (DataTableGetInt(true, (lv_keyBase + "_Count")) + 1);
    DataTableSetInt(true, (lv_keyBase + "_Count"), lv_count);
    DataTableSetString(true, (lv_keyBase + "_ValueA"), lp_valueA);
    DataTableSetString(true, (lv_keyBase + "_ValueB"), lp_valueB);
    DataTableSetInt(true, (lv_keyBase + "_ValueInt"), lp_valueInt);
    DataTableSetInt(true, (lv_keyBase + "_Player"), lp_player);
    libE0EAE146_gf_RuntimeLog(1, "VisualProbe", lp_source, lp_player, lp_valueA, lp_valueB, lp_valueInt);
    lv_playerColor = -1;
    if (lp_player >= 0) {
        lv_playerColor = PlayerGetColorIndex(lp_player, false);
    }
    DataTableSetInt(true, (lv_keyBase + "_PlayerColor"), lv_playerColor);
    if ((lv_count <= 8) || (ModI(lv_count, 25) == 0)) {
        BankLoad("CampaignXCore", 1);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeVisualProbe", "LastSource", lp_source);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeVisualProbe", (lp_source + "_Count"), lv_count);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeVisualProbe", (lp_source + "_Player"), lp_player);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeVisualProbe", (lp_source + "_PlayerColor"), lv_playerColor);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeVisualProbe", (lp_source + "_ValueA"), lp_valueA);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeVisualProbe", (lp_source + "_ValueB"), lp_valueB);
        BankValueSetFromInt(BankLastCreated(), "XMRuntimeVisualProbe", (lp_source + "_ValueInt"), lp_valueInt);
        BankValueSetFromString(BankLastCreated(), "XMRuntimeVisualProbe", "RunId", BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "TestRunId"));
        BankValueSetFromString(BankLastCreated(), "XMRuntimeVisualProbe", "Commander", libE0EAE146_gv_commander);
        BankSave(BankLastCreated());
    }
}

int libE0EAE146_gf_RuntimeUnitTypeCount (string lp_unitType) {
    if (lp_unitType == "") {
        return 0;
    }

    return UnitGroupCount(UnitGroup(lp_unitType, 1, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0), c_unitCountAlive);
}

void libE0EAE146_gf_RuntimeBaseCheckpoint (string lp_phase, string lp_townHallUnit, string lp_workerUnit, string lp_secondUnit) {
    BankLoad("CampaignXCore", 1);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "LastPhase", lp_phase);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "Commander", libE0EAE146_gv_commander);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "RunId", BankValueGetAsString(BankLastCreated(), "XMRuntimeControl", "TestRunId"));
