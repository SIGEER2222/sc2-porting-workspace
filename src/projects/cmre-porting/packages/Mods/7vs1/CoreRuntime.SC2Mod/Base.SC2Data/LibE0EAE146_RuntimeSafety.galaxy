    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "AchCommander", BankValueGetAsString(BankLastCreated(), "Ach", "Commander"));
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "TownHallUnit", lp_townHallUnit);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "WorkerUnit", lp_workerUnit);
    BankValueSetFromString(BankLastCreated(), "XMRuntimeDebug", "SecondUnit", lp_secondUnit);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "TownHallCount", libE0EAE146_gf_RuntimeUnitTypeCount(lp_townHallUnit));
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeDebug", "WorkerCount", libE0EAE146_gf_RuntimeUnitTypeCount(lp_workerUnit));
