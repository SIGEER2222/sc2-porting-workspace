}

bool XMChallenge_ShouldTrackUnit (unit lp_unit, int lp_player) {
    if (lp_unit == null) {
        return false;
    }
    if (UnitGetOwner(lp_unit) != lp_player) {
        return false;
    }
    if (!UnitFilterMatch(lp_unit, lp_player, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))))) {
        return false;
    }
    return true;
}

bool XMChallenge_IsWorkerUnit (unit lp_unit, int lp_player) {
    if (lp_unit == null) {
        return false;
    }
    return UnitFilterMatch(lp_unit, lp_player, UnitFilter((1 << c_targetFilterWorker), 0, 0, 0));
}

bool XMChallenge_IsLoneHeroForbiddenUnit (unit lp_unit, int lp_player) {
    string lv_unitType;

    if (!XMChallenge_ShouldTrackUnit(lp_unit, lp_player)) {
        return false;
    }
    lv_unitType = UnitGetType(lp_unit);
    if (UnitTypeTestAttribute(lv_unitType, c_unitAttributeStructure)) {
        return false;
    }
    if (XMChallenge_IsWorkerUnit(lp_unit, lp_player)) {
        return false;
    }
    if (UnitTypeTestAttribute(lv_unitType, c_unitAttributeHeroic)) {
        return false;
    }
    if (UnitTypeTestAttribute(lv_unitType, c_unitAttributeSummoned)) {
        return false;
    }
    if (UnitWeaponCount(lp_unit) <= 0) {
        return false;
    }
    return true;
}

int XMChallenge_CountCombatUnits (int lp_player, bool lp_mechanicalOnly) {
    unitgroup lv_units;
    unit lv_unit;
    int lv_count;
    string lv_unitType;

    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
    lv_unit = UnitGroupUnit(lv_units, 1);
    lv_count = 0;
    while (lv_unit != null) {
        lv_unitType = UnitGetType(lv_unit);
        if (!UnitTypeTestAttribute(lv_unitType, c_unitAttributeStructure) && !XMChallenge_IsWorkerUnit(lv_unit, lp_player) && (UnitWeaponCount(lv_unit) > 0)) {
            if (!lp_mechanicalOnly || UnitTypeTestAttribute(lv_unitType, c_unitAttributeMechanical)) {
                lv_count += 1;
            }
        }
        UnitGroupRemove(lv_units, lv_unit);
        lv_unit = UnitGroupUnit(lv_units, 1);
    }
    return lv_count;
}

bool libE0EAE146_gt_XMChallengeUnitCreated_Func (bool testConds, bool runActions) {
    int lv_player;
    unit lv_unit;

    lv_unit = EventUnitCreatedUnit();
    lv_player = UnitGetOwner(lv_unit);
    if (testConds) {
        if ((lv_player < 1) || (lv_player > 8)) {
            return false;
        }
        if (!libE0EAE146_gv_xmChallengeRuntimeReady[lv_player]) {
            return false;
        }
        if (XMChallenge_Active(lv_player) != "ChallengeLoneHero") {
            return false;
        }
        if (!XMChallenge_IsLoneHeroForbiddenUnit(lv_unit, lv_player)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    libE0EAE146_gv_xmChallengeLoneHeroFailed[lv_player] = true;
    return true;
}

