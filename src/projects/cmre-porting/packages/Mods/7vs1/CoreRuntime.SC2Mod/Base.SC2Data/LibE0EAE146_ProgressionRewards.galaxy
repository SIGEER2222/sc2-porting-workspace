}

void libE0EAE146_gf_XMProgression_EnsureTriggers () {
    if (libE0EAE146_gv_xmProgressionTriggersReady) {
        return;
    }
    libE0EAE146_gv_xmProgressionTriggersReady = true;
    libE0EAE146_gt_XMProgressionPhaseRepair = TriggerCreate("libE0EAE146_gt_XMProgressionPhaseRepair_Func");
    TriggerAddEventTimePeriodic(libE0EAE146_gt_XMProgressionPhaseRepair, 2.0, c_timeGame);
    TriggerEnable(libE0EAE146_gt_XMProgressionPhaseRepair, false);
    libE0EAE146_gt_XMProgressionCreepRegen = TriggerCreate("libE0EAE146_gt_XMProgressionCreepRegen_Func");
    TriggerAddEventTimePeriodic(libE0EAE146_gt_XMProgressionCreepRegen, 2.0, c_timeGame);
    TriggerEnable(libE0EAE146_gt_XMProgressionCreepRegen, false);
    libE0EAE146_gt_XMChallengeUnitCreated = TriggerCreate("libE0EAE146_gt_XMChallengeUnitCreated_Func");
    TriggerAddEventUnitCreated(libE0EAE146_gt_XMChallengeUnitCreated, null, null, null);
    TriggerEnable(libE0EAE146_gt_XMChallengeUnitCreated, true);
    libE0EAE146_gt_XMChallengeUnitTrainComplete = TriggerCreate("libE0EAE146_gt_XMChallengeUnitTrainComplete_Func");
    TriggerAddEventUnitTrainProgress(libE0EAE146_gt_XMChallengeUnitTrainComplete, null, c_unitProgressStageComplete);
    TriggerEnable(libE0EAE146_gt_XMChallengeUnitTrainComplete, true);
    libE0EAE146_gt_XMChallengeUnitConstructComplete = TriggerCreate("libE0EAE146_gt_XMChallengeUnitConstructComplete_Func");
    TriggerAddEventUnitConstructProgress(libE0EAE146_gt_XMChallengeUnitConstructComplete, null, c_unitProgressStageComplete);
    TriggerEnable(libE0EAE146_gt_XMChallengeUnitConstructComplete, true);
    libE0EAE146_gt_XMChallengeUnitMorphComplete = TriggerCreate("libE0EAE146_gt_XMChallengeUnitMorphComplete_Func");
    TriggerAddEventUnitAbility(libE0EAE146_gt_XMChallengeUnitMorphComplete, null, null, c_abilMorphStageUnitEnd, false);
    TriggerEnable(libE0EAE146_gt_XMChallengeUnitMorphComplete, true);
}

void XMProgression_Init (int lp_player) {
    libE0EAE146_gf_XMProgression_EnsureTriggers();
    XMBlessing_LoadSelected(lp_player);
    XMChallenge_LoadActive(lp_player);
    XMChallenge_ResetRuntimeState(lp_player);
}

void XMBlessing_ApplySelected (int lp_player) {
    string lv_selected;

    libE0EAE146_gf_XMProgression_EnsureTriggers();
    lv_selected = XMBlessing_Selected(lp_player);
    TriggerEnable(libE0EAE146_gt_XMProgressionPhaseRepair, false);
    TriggerEnable(libE0EAE146_gt_XMProgressionCreepRegen, false);

    if (lv_selected == "BlessingPhaseRepair") {
        TriggerEnable(libE0EAE146_gt_XMProgressionPhaseRepair, true);
    }
    else if (lv_selected == "BlessingCreepRegeneration") {
        TriggerEnable(libE0EAE146_gt_XMProgressionCreepRegen, true);
    }

    if (libE0EAE146_gv_xmProgressionRunBlessingApplied[lp_player]) {
        return;
    }
    libE0EAE146_gv_xmProgressionRunBlessingApplied[lp_player] = true;

    if (lv_selected == "BlessingResourceRich") {
        libE0EAE146_gf_XMProgression_AddPlayerResources(lp_player, 500, 200);
    }
    else if (lv_selected == "BlessingGoldenMinerals") {
        libE0EAE146_gf_XMProgression_AddPlayerResources(lp_player, 1000, 0);
    }
    else if (lv_selected == "BlessingGuardianShell") {
        libE0EAE146_gf_XMProgression_GuardianShellBuffer(lp_player);
    }
}

void XMChallenge_RecordEvent (int lp_player, string lp_eventId, int lp_value) {
    XMAchievement_AddProgress(lp_player, lp_eventId, lp_value);
}

void XMChallenge_EvaluateOnVictoryEx (int lp_player, string lp_mapId, string lp_commanderId, int lp_bonusScore, int lp_heroDeaths) {
    string lv_challenge;
    string lv_key;
    int lv_clearTime;
    int lv_bestTime;

    lv_challenge = XMChallenge_Active(lp_player);
    if (lv_challenge == "") {
        return;
    }

    lv_key = lv_challenge + ":" + lp_mapId;
    lv_clearTime = FixedToInt(AIGetTime());
    lv_bestTime = libE0EAE146_gf_XMProgression_BankInt(lp_player, "ChallengeBest", lv_key);
    BankLoad("CampaignXCore", lp_player);
    if ((lv_bestTime <= 0) || (lv_clearTime < lv_bestTime)) {
        BankValueSetFromInt(BankLastCreated(), "ChallengeBest", lv_key, lv_clearTime);
    }
    BankSave(BankLastCreated());

    if (lv_challenge == "ChallengeResourceScarce") {
        XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_RESOURCE_SCARCE_CLEAR");
        XMBlessing_Unlock(lp_player, "BlessingResourceRich");
        XMReward_Unlock(lp_player, "RewardResourceRich");
        XMUnlock_Bonus(lp_player, "RichResources");
    }
    else if (lv_challenge == "ChallengeSpeedClear") {
        XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_SPEED_CLEAR");
        XMBlessing_Unlock(lp_player, "BlessingGoldenMinerals");
        XMReward_Unlock(lp_player, "RewardGoldenMinerals");
        XMUnlock_Bonus(lp_player, "DoubleMinerals");
    }
    else if (lv_challenge == "ChallengeFullBonus") {
        if (lp_bonusScore >= 3) {
            XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_FULL_BONUS_CLEAR");
            XMUnlock_Bonus(lp_player, "CreepRegeneration");
        }
    }
    else if (lv_challenge == "ChallengeNoHeroDeath") {
        if (lp_heroDeaths <= 0) {
            XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_NO_HERO_DEATH_CLEAR");
            XMUnlock_Bonus(lp_player, "MechanicalRepair");
        }
    }
    else if (lv_challenge == "ChallengeLoneHero") {
        if (!libE0EAE146_gv_xmChallengeLoneHeroFailed[lp_player]) {
            XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_LONE_HERO_CLEAR");
            XMBlessing_Unlock(lp_player, "BlessingGuardianShell");
            XMReward_Unlock(lp_player, "RewardGuardianShell");
            XMUnlock_Bonus(lp_player, "GuardianShell");
        }
    }
    else if (lv_challenge == "ChallengeSteelTorrent") {
        if (XMChallenge_CountCombatUnits(lp_player, true) >= 20) {
            XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_STEEL_TORRENT_CLEAR");
            XMUnlock_Bonus(lp_player, "MechanicalRepair");
        }
    }
    else if (lv_challenge == "ChallengeFirepowerCoverage") {
        if (XMChallenge_CountCombatUnits(lp_player, false) >= 35) {
            XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_FIREPOWER_COVERAGE_CLEAR");
            XMUnlock_Bonus(lp_player, "RichResources");
        }
    }
}

void XMChallenge_EvaluateOnVictory (int lp_player, string lp_mapId, string lp_commanderId) {
    XMChallenge_EvaluateOnVictoryEx(lp_player, lp_mapId, lp_commanderId, 0, 0);
}

void XMProgression_RecordVictory (int lp_player, string lp_mapId, string lp_commanderId, int lp_bonusScore, int lp_heroDeaths) {
    string lv_key;
    string lv_bonusKey;
    int lv_totalWins;
    int lv_clearTime;
    int lv_bestTime;
    int lv_bestBonus;

    lv_key = lp_commanderId + ":" + lp_mapId;
    lv_bonusKey = lv_key;
    lv_totalWins = libE0EAE146_gf_XMProgression_BankInt(lp_player, "Progression", "TotalWins") + 1;
    lv_clearTime = FixedToInt(AIGetTime());
    lv_bestTime = libE0EAE146_gf_XMProgression_BankInt(lp_player, "MapBest", lp_mapId);
    lv_bestBonus = libE0EAE146_gf_XMProgression_BankInt(lp_player, "CommanderBonus", lv_bonusKey);

    BankLoad("CampaignXCore", lp_player);
    BankValueSetFromInt(BankLastCreated(), "Progression", "TotalWins", lv_totalWins);
    BankValueSetFromInt(BankLastCreated(), "Progression", "LastClearTime", lv_clearTime);
    BankValueSetFromString(BankLastCreated(), "Progression", "LastCommander", lp_commanderId);
    BankValueSetFromString(BankLastCreated(), "Progression", "LastMap", lp_mapId);
    BankValueSetFromInt(BankLastCreated(), "MapClear", lp_mapId, 1);
    BankValueSetFromInt(BankLastCreated(), "CommanderClear", lv_key, 1);
    if ((lv_bestTime <= 0) || (lv_clearTime < lv_bestTime)) {
        BankValueSetFromInt(BankLastCreated(), "MapBest", lp_mapId, lv_clearTime);
    }
    if (lp_bonusScore > lv_bestBonus) {
        BankValueSetFromInt(BankLastCreated(), "CommanderBonus", lv_bonusKey, lp_bonusScore);
    }
    BankValueSetFromInt(BankLastCreated(), "Reward", "RewardVictoryArchive", 1);
    BankSave(BankLastCreated());

    XMAchievement_Unlock(lp_player, "ACH_CLEAR_ANY_MISSION");
    XMAchievement_Unlock(lp_player, "ACH_CLEAR_" + lp_mapId);
    if (lp_commanderId != "") {
        XMAchievement_Unlock(lp_player, "ACH_COMMANDER_" + lp_commanderId + "_CLEAR");
    }
    if (lp_bonusScore >= 3) {
        XMAchievement_Unlock(lp_player, "ACH_FULL_BONUS_CLEAR");
    }
    if (lp_heroDeaths <= 0) {
        XMAchievement_Unlock(lp_player, "ACH_NO_HERO_DEATH_CLEAR");
    }
    if (lv_totalWins >= 5) {
        XMAchievement_Unlock(lp_player, "ACH_CLEAR_5_MISSIONS");
        XMBlessing_Unlock(lp_player, "BlessingGuardianShell");
        XMReward_Unlock(lp_player, "RewardGuardianShell");
        XMUnlock_Bonus(lp_player, "GuardianShell");
    }
    XMChallenge_EvaluateOnVictoryEx(lp_player, lp_mapId, lp_commanderId, lp_bonusScore, lp_heroDeaths);
}

void XMProgression_Save (int lp_player) {
    libE0EAE146_gf_XMProgression_SaveBank(lp_player);
}

void XMProgression_DebugUnlockFirstBatch (int lp_player) {
    XMBlessing_Unlock(lp_player, "BlessingResourceRich");
    XMBlessing_Unlock(lp_player, "BlessingGoldenMinerals");
    XMBlessing_Unlock(lp_player, "BlessingGuardianShell");
    XMBlessing_Unlock(lp_player, "BlessingPhaseRepair");
    XMBlessing_Unlock(lp_player, "BlessingCreepRegeneration");
    XMUnlock_Bonus(lp_player, "RichResources");
    XMUnlock_Bonus(lp_player, "DoubleMinerals");
    XMUnlock_Bonus(lp_player, "GuardianShell");
    XMUnlock_Bonus(lp_player, "MechanicalRepair");
    XMUnlock_Bonus(lp_player, "CreepRegeneration");
    XMAchievement_Unlock(lp_player, "ACH_ARTANIS_CLEAR_KEY_MISSION");
    XMAchievement_Unlock(lp_player, "ACH_KARAX_CLEAR_KEY_MISSION");
    XMAchievement_Unlock(lp_player, "ACH_KERRIGAN_CREEP_CLEAR");
    XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_RESOURCE_SCARCE_CLEAR");
    XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_SPEED_CLEAR");
}
