void libE0EAE146_gf_XMProgression_HealPlayerUnits (int lp_player, bool lp_mechanicalOnly, bool lp_biologicalOnly, fixed lp_amount, string lp_event) {
    unitgroup lv_units;
    unit lv_unit;
    fixed lv_life;
    fixed lv_lifeMax;
    bool lv_valid;

    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_unit = UnitGroupUnit(lv_units, 1);
    while (lv_unit != null) {
        lv_valid = true;
        if (lp_mechanicalOnly && !UnitTypeTestAttribute(UnitGetType(lv_unit), c_unitAttributeMechanical)) {
            lv_valid = false;
        }
        if (lp_biologicalOnly && !UnitTypeTestAttribute(UnitGetType(lv_unit), c_unitAttributeBiological)) {
            lv_valid = false;
        }
        if (lv_valid) {
            lv_life = UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent);
            lv_lifeMax = UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropCurrent);
            if ((lv_life > 0.0) && (lv_life < lv_lifeMax)) {
                lv_life = lv_life + lp_amount;
                if (lv_life > lv_lifeMax) {
                    lv_life = lv_lifeMax;
                }
                UnitSetPropertyFixed(lv_unit, c_unitPropLife, lv_life);
            }
        }
        UnitGroupRemove(lv_units, lv_unit);
        lv_unit = UnitGroupUnit(lv_units, 1);
    }
}

void libE0EAE146_gf_XMProgression_AddPlayerResources (int lp_player, int lp_minerals, int lp_vespene) {
    if (lp_minerals != 0) {
        PlayerModifyPropertyInt(lp_player, c_playerPropMinerals, c_playerPropOperAdd, lp_minerals);
    }
    if (lp_vespene != 0) {
        PlayerModifyPropertyInt(lp_player, c_playerPropVespene, c_playerPropOperAdd, lp_vespene);
    }
}

void libE0EAE146_gf_XMProgression_GuardianShellBuffer (int lp_player) {
    unitgroup lv_units;
    unit lv_unit;
    fixed lv_life;
    fixed lv_lifeMax;
    fixed lv_shields;
    fixed lv_shieldsMax;

    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_unit = UnitGroupUnit(lv_units, 1);
    while (lv_unit != null) {
        lv_life = UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent);
        lv_lifeMax = UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropCurrent);
        if ((lv_life > 0.0) && (lv_life < lv_lifeMax)) {
            UnitSetPropertyFixed(lv_unit, c_unitPropLife, MinF(lv_lifeMax, lv_life + 25.0));
        }

        lv_shields = UnitGetPropertyFixed(lv_unit, c_unitPropShields, c_unitPropCurrent);
        lv_shieldsMax = UnitGetPropertyFixed(lv_unit, c_unitPropShieldsMax, c_unitPropCurrent);
        if ((lv_shieldsMax > 0.0) && (lv_shields < lv_shieldsMax)) {
            UnitSetPropertyFixed(lv_unit, c_unitPropShields, MinF(lv_shieldsMax, lv_shields + 25.0));
        }

        UnitGroupRemove(lv_units, lv_unit);
        lv_unit = UnitGroupUnit(lv_units, 1);
    }
}

