    libE0EAE146_kc_hexTalentUpgrade[libE0EAE146_kc_hexTalentBit_spellDamageLeech] = "TNX_0113";
    libE0EAE146_kc_hexTalentUpgrade[libE0EAE146_kc_hexTalentBit_berserker] = "TNX_0114";
