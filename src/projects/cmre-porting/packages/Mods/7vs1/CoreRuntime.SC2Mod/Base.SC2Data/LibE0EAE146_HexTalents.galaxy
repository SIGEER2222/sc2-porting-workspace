//--------------------------------------------------------------------------------------------------
void libE0EAE146_hexTalents_InitVariables () {
    int lv_i;

    lv_i = 0;
    while (lv_i <= 15) {
        libE0EAE146_gv_hexTalents_startMask[lv_i] = 0;
        lv_i += 1;
    }

    lv_i = 0;
    while (lv_i <= 31) {
        libE0EAE146_kc_hexTalentUpgrade[lv_i] = "";
        lv_i += 1;
    }

    libE0EAE146_kc_hexTalentUpgrade[libE0EAE146_kc_hexTalentBit_healthBonus] = "TNX_012";
    libE0EAE146_kc_hexTalentUpgrade[libE0EAE146_kc_hexTalentBit_damageBonus] = "TNX_00";
