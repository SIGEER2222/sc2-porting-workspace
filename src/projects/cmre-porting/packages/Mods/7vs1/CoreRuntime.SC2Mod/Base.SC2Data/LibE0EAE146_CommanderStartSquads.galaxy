            libDF8E6945_gf_InitializeDehakaEvent(lp_player, UnitLastCreated());
            BankLoad("CampaignXCore", lp_player);
            if ((lib67C0F0E7_gf_BitMaskTrueIndexIs(libE0EAE146_gf_CommanderPowerPrestigeMask("Dehaka"), 2) == true)) {
                libDF8E6945_gf_DehakaBroodbrother();
            }
        }
        return;
    }
    if (lv_commander == "Nova") {
        if (lp_point != null) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "NovaCoop", 0, lp_player, lp_point);
            lib0940FFB7_gf_NovaTrigger(UnitLastCreated());
        }
        UnitCargoCreate(lp_container, "HellbatBlackOps", 2);
        return;
    }
    if (lv_commander == "Mengsk") {
        UnitCargoCreate(lp_container, "TrooperMengskFlamethrower", 6);
        return;
    }
    if (lv_commander == "Swann") {
        UnitCargoCreate(lp_container, "PredatorSwann", 4);
        return;
    }
    if (lv_commander == "Stetmann") {
        UnitCargoCreate(lp_container, "LurkerStetmann", 3);
        return;
    }
    if (lv_commander == "Stukov") {
        if (lp_kind == "hero") {
            libE0EAE146_gt_CommanderHeroDied_Init();
            UnitCargoCreate(lp_container, "InfestedStukovCoop", 1);
            UnitCargoCreate(lp_container, "StukovInfestedDiamondBack", 2);
            return;
        }
        UnitCargoCreate(lp_container, "StukovInfestedDiamondBack", 2);
        return;
    }

    UnitCargoCreate(lp_container, "Firebat", 3);
    UnitCargoCreate(lp_container, "Medic", 2);
}
