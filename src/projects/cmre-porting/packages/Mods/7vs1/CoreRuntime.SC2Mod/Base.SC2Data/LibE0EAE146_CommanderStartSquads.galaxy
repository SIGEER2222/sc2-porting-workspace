// XMFinal split module: commander panel init and map start squads.
void libE0EAE146_gf_CommanderPanelInit (string lp_casterUnit, string lp_gpCommander) {
    libNtve_gf_CreateUnitsWithDefaultFacing(1, lp_casterUnit, c_unitCreateIgnorePlacement, 1, RegionGetBoundsMin(RegionEntireMap()));
    lib67C0F0E7_gf_CU_GPInit(1, lp_gpCommander, UnitLastCreated(), null);
    lib67C0F0E7_gf_CU_GPShowHide(true, 1, c_transitionDurationDefault);
    lib67C0F0E7_gf_ShowChooseButton();
}
// Per-commander CreateMapStartSquad/CreateCargoSquad functions migrated to each CommanderUnits_* runtime file (Task 7).

string libE0EAE146_gf_CommanderStartSquadsResolveUnit4 (string lp_primary, string lp_fallbackA, string lp_fallbackB, string lp_fallbackC) {
    string lv_unitType;

    lv_unitType = libE0EAE146_gf_CatalogUnitOrEmpty(lp_primary);
    if (lv_unitType != "") {
        return lv_unitType;
    }

    lv_unitType = libE0EAE146_gf_CatalogUnitOrEmpty(lp_fallbackA);
    if (lv_unitType != "") {
        return lv_unitType;
    }

    lv_unitType = libE0EAE146_gf_CatalogUnitOrEmpty(lp_fallbackB);
    if (lv_unitType != "") {
        return lv_unitType;
    }

    return libE0EAE146_gf_CatalogUnitOrEmpty(lp_fallbackC);
}

void libE0EAE146_gf_CommanderStartSquadsCreateUnitsResolved4 (int lp_count, string lp_primary, string lp_fallbackA, string lp_fallbackB, string lp_fallbackC, int lp_player, point lp_point) {
    string lv_unitType;

    lv_unitType = libE0EAE146_gf_CommanderStartSquadsResolveUnit4(lp_primary, lp_fallbackA, lp_fallbackB, lp_fallbackC);
    if (lv_unitType == "") {
        return;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(lp_count, lv_unitType, 0, lp_player, lp_point);
}

