// Presets
// Functions
int libKMIS_gf_PingTypeFromObjectiveType (bool lp_objectiveType) {
    // Automatic Variable Declarations
    // Implementation
    if ((lp_objectiveType == true)) {
        return libKMIS_ge_ObjectivePingType_Primary;
    }

    return libKMIS_ge_ObjectivePingType_Secondary;
}

trigger auto_libKMIS_gf_AttentionGrabbingObjectivePing_Trigger = null;
point auto_libKMIS_gf_AttentionGrabbingObjectivePing_lp_pingLocation;

void libKMIS_gf_AttentionGrabbingObjectivePing (point lp_pingLocation) {
    auto_libKMIS_gf_AttentionGrabbingObjectivePing_lp_pingLocation = lp_pingLocation;

    if (auto_libKMIS_gf_AttentionGrabbingObjectivePing_Trigger == null) {
        auto_libKMIS_gf_AttentionGrabbingObjectivePing_Trigger = TriggerCreate("auto_libKMIS_gf_AttentionGrabbingObjectivePing_TriggerFunc");
    }

    TriggerExecute(auto_libKMIS_gf_AttentionGrabbingObjectivePing_Trigger, false, false);
}

bool auto_libKMIS_gf_AttentionGrabbingObjectivePing_TriggerFunc (bool testConds, bool runActions) {
    point lp_pingLocation = auto_libKMIS_gf_AttentionGrabbingObjectivePing_lp_pingLocation;

    // Variable Declarations
    int lv_scaleIter;
    fixed lv_pingScale;
    int lv_spiningShrinkingPing;

    // Automatic Variable Declarations
    const int autoE898793D_ae = 20;
    const int autoE898793D_ai = -1;

    // Variable Initialization
    lv_spiningShrinkingPing = c_invalidPingId;

    // Implementation
    libKMIS_gf_CreatePingFacingAngleCoop(PlayerGroupAll(), lp_pingLocation, 270.0, "PingObjective", ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 4.0);
    lv_spiningShrinkingPing = PingLastCreated();
    PingSetScale(lv_spiningShrinkingPing, 3.0);
    lv_scaleIter = 40;
    for ( ; ( (autoE898793D_ai >= 0 && lv_scaleIter <= autoE898793D_ae) || (autoE898793D_ai < 0 && lv_scaleIter >= autoE898793D_ae) ) ; lv_scaleIter += autoE898793D_ai ) {
        lv_pingScale = (lv_scaleIter * 0.1);
        PingSetScale(lv_spiningShrinkingPing, lv_pingScale);
        PingSetRotation(lv_spiningShrinkingPing, (360 - (ModF(lv_scaleIter, 10.0) * 36)));
        Wait(0.1, c_timeReal);
    }
    libKMIS_gf_DestroyPingCoop(lv_spiningShrinkingPing);
    return true;
}

void libKMIS_gf_CreateObjectivePing (bool lp_objectiveType, point lp_position, text lp_tooltip) {
    // Automatic Variable Declarations
    // Deprecated
    libKMIS_gf_CreateObjectivePingAC(libKMIS_gf_PingTypeFromObjectiveType(lp_objectiveType), lp_position, lp_tooltip);
}

void libKMIS_gf_CreateObjectivePingAC (int lp_objectiveType, point lp_position, text lp_tooltip) {
    // Variable Declarations
    color lv_color;
    fixed lv_scale;
    string lv_model;
    fixed lv_angle;

    // Automatic Variable Declarations
    int auto7500AD90_val;

    // Variable Initialization
    lv_color = Color(0,0,0);

    // Implementation
    auto7500AD90_val = lp_objectiveType;
    if (auto7500AD90_val == libKMIS_ge_ObjectivePingType_Primary) {
        lv_color = Color(0.00, 100.00, 0.00);
        lv_scale = 1.0;
        lv_model = "PingObjective";
        lv_angle = 270.0;
    }
    else if (auto7500AD90_val == libKMIS_ge_ObjectivePingType_Secondary) {
        lv_color = Color(100.00, 100.00, 0.00);
        lv_scale = 0.4;
        lv_model = "PingTriangle";
        lv_angle = 90.0;
    }
    else if (auto7500AD90_val == libKMIS_ge_ObjectivePingType_POI) {
        lv_color = Color(0.00, 100.00, 0.00);
        lv_scale = 0.4;
        lv_model = "PingSimple";
        lv_angle = 90.0;
    }
    else {
    }
    libKMIS_gf_CreatePingFacingAngleCoop(PlayerGroupAll(), lp_position, lv_angle, lv_model, lv_color, 0.0);
    PingSetScale(PingLastCreated(), lv_scale);
    PingSetTooltip(PingLastCreated(), lp_tooltip);
    TriggerExecute(libKMIS_gt_VoidPingSound, true, false);
}

