void libKMIS_gf_CM_Resources_FindWork (unit lp_worker, unit lp_townHall, fixed lp_workRadius) {
    // Variable Declarations
    region lv_workregion;
    unitgroup lv_nearbyminerals;
    unitgroup lv_nearbygeysers;
