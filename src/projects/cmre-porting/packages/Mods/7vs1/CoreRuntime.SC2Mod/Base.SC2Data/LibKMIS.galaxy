bool libKMIS_InitLib_completed = false;

void libKMIS_InitLib () {
    if (libKMIS_InitLib_completed) {
        return;
    }

    libKMIS_InitLib_completed = true;

    libKMIS_InitLibraries();
    libKMIS_InitVariables();
    libKMIS_InitTriggers();
}

