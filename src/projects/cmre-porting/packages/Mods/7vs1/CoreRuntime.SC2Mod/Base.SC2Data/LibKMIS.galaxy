string libKMIS_gf_BankVoicePackSelection (int lp_player) {
    BankLoad("CampaignXCore", lp_player);
    BankValueSetFromInt(BankLastCreated(), "XMRuntimeVoicePack", "SelectionReadPlayer", lp_player);
    if (!BankSectionExists(BankLastCreated(), "Cosmetics")) {
        BankValueSetFromString(BankLastCreated(), "XMRuntimeVoicePack", "SelectionReadResult", "MissingCosmetics");
        BankSave(BankLastCreated());
        return "";
    }
    if (!BankKeyExists(BankLastCreated(), "Cosmetics", "VoicePack")) {
        BankValueSetFromString(BankLastCreated(), "XMRuntimeVoicePack", "SelectionReadResult", "MissingVoicePack");
        BankSave(BankLastCreated());
        return "";
    }
    BankValueSetFromString(BankLastCreated(), "XMRuntimeVoicePack", "SelectionReadResult", BankValueGetAsString(BankLastCreated(), "Cosmetics", "VoicePack"));
    BankSave(BankLastCreated());
    return BankValueGetAsString(BankLastCreated(), "Cosmetics", "VoicePack");
}

string libKMIS_gf_VoicePackRewardForCommanderRace (string lp_voicePack, string lp_commander) {
    string lv_racePrefix;
    string lv_commanderRace;
    int lv_index;
    string lv_reward;

    if ((lp_voicePack == "") || (lp_voicePack == "Default")) {
        return "";
    }
    lv_commanderRace = libKCOR_gf_CC_CommanderRace(lp_commander);
    if (lv_commanderRace == "Terr") {
        lv_racePrefix = "Terran";
    }
    else if (lv_commanderRace == "Prot") {
        lv_racePrefix = "Protoss";
    }
    else if (lv_commanderRace == "Zerg") {
        lv_racePrefix = "Zerg";
    }
    else {
        return "";
    }

    for (lv_index = 1; lv_index <= CatalogEntryCount(c_gameCatalogReward); lv_index += 1) {
        lv_reward = CatalogEntryGet(c_gameCatalogReward, lv_index);
        if (CatalogEntryScope(c_gameCatalogReward, lv_reward) != "CRewardVoicePack") {
            continue;
        }
        if (CatalogFieldValueGet(c_gameCatalogReward, lv_reward, "VoicePack", c_playerAny) != lp_voicePack) {
            continue;
        }
        if (CatalogFieldValueGet(c_gameCatalogReward, lv_reward, "Race", c_playerAny) == lv_commanderRace) {
            return lv_reward;
        }
    }
    return "";
}

bool libKMIS_gf_VoicePackSelectionApply (int lp_player) {
    string lv_voicePack;
