        if (!((libNtve_gf_UnitCanCreateEffectOnUnit(lv_caster, "ObserverTargetLockCPOrderValidate", lv_target) == true))) {
            return false;
        }

        if (!((UnitOrderIsValid(lv_caster, OrderSetAutoCast(AbilityCommand("ObserverTargetLock", 0), true)) == false))) {
