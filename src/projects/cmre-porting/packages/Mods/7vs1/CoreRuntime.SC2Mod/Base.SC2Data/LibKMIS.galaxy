    libKMIS_gt_CM_Abathur_BiomassScaler = TriggerCreate("libKMIS_gt_CM_Abathur_BiomassScaler_Func");
    TriggerEnable(libKMIS_gt_CM_Abathur_BiomassScaler, false);
    TriggerAddEventUnitBehaviorChange(libKMIS_gt_CM_Abathur_BiomassScaler, null, "BiomassBuff1", c_unitBehaviorChangeIncrease);
    TriggerAddEventUnitBehaviorChange(libKMIS_gt_CM_Abathur_BiomassScaler, null, "BiomassBuff10", c_unitBehaviorChangeIncrease);
    TriggerAddEventUnitBehaviorChange(libKMIS_gt_CM_Abathur_BiomassScaler, null, "BiomassBuff100", c_unitBehaviorChangeIncrease);
}



