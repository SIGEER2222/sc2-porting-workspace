            }
        }

        lv_lastseenmoraleindex = lv_moraleindex;
        if ((lv_globalcasterenergy >= 100.0)) {
            if ((lv_moralecapped == false) && (TimerGetRemaining(lv_moralecappedreminder) <= 0.0)) {
