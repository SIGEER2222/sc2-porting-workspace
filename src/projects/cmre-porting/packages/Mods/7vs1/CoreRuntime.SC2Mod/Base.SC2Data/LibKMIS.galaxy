    libKMIS_gt_CM_Abathur_BiomassRefund = TriggerCreate("libKMIS_gt_CM_Abathur_BiomassRefund_Func");
    TriggerEnable(libKMIS_gt_CM_Abathur_BiomassRefund, false);
    TriggerAddEventUnitDied(libKMIS_gt_CM_Abathur_BiomassRefund, null);
}

//--------------------------------------------------------------------------------------------------
// Trigger: CM_DebugAbathurBiomassLost
//--------------------------------------------------------------------------------------------------
bool libKMIS_gt_CM_DebugAbathurBiomassLost_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventUnit()) != "Locust") && (UnitGetType(EventUnit()) != "BiomassPickup") && (libKCOR_gf_ActiveCommanderForPlayer(UnitGetOwner(EventUnit())) == "ZergAbathur") && (UnitFilterMatch(EventUnit(), 1, UnitFilter(0, 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterHidden - 32)))) == true)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
