    // Automatic Variable Declarations
    // Implementation
    if ((lp_player <= 0)) {
        return null;
    }

    if (((UnitIsAlive(libKMIS_gv_cM_PrimaryTownHall[lp_player]) == false) || (UnitFilterMatch(libKMIS_gv_cM_PrimaryTownHall[lp_player], lp_player, UnitFilter((1 << c_targetFilterGround), 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)))) == false))) {
