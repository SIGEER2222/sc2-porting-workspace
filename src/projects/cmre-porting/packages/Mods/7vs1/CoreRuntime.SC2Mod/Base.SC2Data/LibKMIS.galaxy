    lv_radiusMinimum = 2.0;
    lv_radiusMaximum = 10.0;
    lv_targetPoint = EventPlayerEffectUsedPoint(c_effectLocationTargetPoint);
    lv_masteryBonusPerPoint = 0.02;
    lv_masteryBonusTotal = 1.0;
    lv_shotCount = 100.0;

