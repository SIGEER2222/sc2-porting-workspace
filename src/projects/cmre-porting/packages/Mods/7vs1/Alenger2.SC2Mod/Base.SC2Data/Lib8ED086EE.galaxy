bool lib8ED086EE_gt_E7A791E68A80E6A091_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((TechTreeUnitIsAllowed(1, "6zhanglang") == true)) {
        TechTreeUpgradeAllow(1, "6fushinianye", true);
    }

    if ((TechTreeUnitIsAllowed(1, "6buyuchonghou") == true)) {
        TechTreeUnitAllow(1, "6jizhenpachong", true);
        TechTreeUnitAllow(1, "6baozipachong", true);
        TechTreeUnitAllow(1, "6juduzhongliu", true);
        TechTreeUpgradeAllow(1, "6shengzhangcuihuaji", true);
        TechTreeUpgradeAllow(1, "6genxilianjie", true);
    }

    if ((TechTreeUnitIsAllowed(1, "6huozhanglang") == true)) {
        TechTreeUpgradeAllow(1, "6ercpenyong", true);
    }

    if ((TechTreeUnitIsAllowed(1, "Mutalisk2") == true)) {
        TechTreeUpgradeAllow(1, "6zuzhikuozeng", true);
    }

    if ((TechTreeUnitIsAllowed(1, "6chongqunsuzhu") == true)) {
        TechTreeUnitAllow(1, "6danzhipensheti", true);
        TechTreeUnitAllow(1, "6baowenchaoxue", true);
        TechTreeUpgradeAllow(1, "6jiayaxianti", true);
    }

    return true;
}

