include "TriggerLibs/NativeLib"

include "LibA3ADAPTER_h"
include "LibA3ADAPTER_Catalog"

//--------------------------------------------------------------------------------------------------
// Library: Alenger3Adapter
// 专门对接地图的 adapter 层，独立于 7v1 框架（不依赖 CoopZeroPop）。
// 在 MapInit 时执行：
//   1. 为玩家1调用 LibDE538C36 的两个 TechTreeUpgradeAddLevel 函数（超标/常规强制强度）
//   2. 为所有人类玩家解锁 3jianzao1/3jianzao2 的所有 Restricted Build 选项
//   3. 为所有人类玩家解锁全部自定义能力（训练/升空/变形/效果/运输等）
//   4. 周期性重解锁（5 秒×8 次，覆盖 40 秒）以覆盖 CMRE DevStartupFinish 时机
// 这样避免 ApplyOriginal7V1OpenerTech 没有 Alenger3 分支导致的建造选项不完整问题。
//
// 7v1 地图：封锁在 MapInit 早期发生，3 秒 Wait 已够；
// 亡者之夜（CMRE 框架）：封锁在 CMUIX_ReadyBeginCountdown 倒计时结束后触发
// （通常 10-15 秒），3 秒 Wait 不足，需要周期性重解锁覆盖。
//
// 升级和建造许可列表由 LibA3ADAPTER_Catalog.galaxy 数据驱动提供
// (生成自 Shared/Alenger3/adapter-data.json)。
//--------------------------------------------------------------------------------------------------

//--------------------------------------------------------------------------------------------------
// 提取解锁逻辑为独立函数，便于延时重新调用。
// 7vs1 框架可能在 MapInit 后重新禁用能力，需在 Wait 后再次解锁。
//--------------------------------------------------------------------------------------------------
void libA3ADAPTER_gf_UnlockAllAbilities (int lp_player) {
    int lv_i;
    string lv_abil;
    int lv_cmd;

    // 1. 解锁所有 Build 选项（数据驱动）
    lv_i = 1;
    for ( ; ( lv_i <= libA3ADAPTER_gv_buildAllowCount ) ; lv_i += 1 ) {
        lv_abil = libA3ADAPTER_gf_BuildAllowAbil(lv_i);
        lv_cmd = libA3ADAPTER_gf_BuildAllowCmd(lv_i);
        if ((lv_abil != "") && (lv_cmd >= 0)) {
            TechTreeAbilityAllow(lp_player, AbilityCommand(lv_abil, lv_cmd), true);
        }
    }

    // 2. 解锁所有 Alenger3 自定义能力（训练/研究/变异/升空/单位技能）
    for (lv_i = 0; lv_i <= 31; lv_i += 1) {
        // 训练
        TechTreeAbilityAllow(lp_player, AbilityCommand("3xunlian1", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3xunlian2A", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3xunlian2B", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3xunlian3A", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3xunlian3B", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3xunlian4A", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3xunlian4B", lv_i), true);
        // 升空/降落
        TechTreeAbilityAllow(lp_player, AbilityCommand("3shengkong1", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3shengkong2", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3shengkong3", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3shengkong4", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhuolu1", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhuolu2", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhuolu3", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhuolu4", lv_i), true);
        // 变形/模式切换
        TechTreeAbilityAllow(lp_player, AbilityCommand("3jijiamoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhanjimoshiS", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhanjimoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3paojimoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3guanbipaojimoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3gongchengmoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3quxiaogongchengmoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3chongfengduigongchengmoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3chongfengduiquxiaogongchengmoshi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhandouzhengzhao", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3laodongzhengzhao", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3shangjiaowuqi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3zhuangbeihuoyanpensheqi", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3bianxingweihuangjiayaosai", lv_i), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("3bianxingweidiguozhihuizhongxin", lv_i), true);
