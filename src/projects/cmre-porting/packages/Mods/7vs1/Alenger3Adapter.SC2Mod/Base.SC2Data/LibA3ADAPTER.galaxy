//--------------------------------------------------------------------------------------------------
// Trigger: MapInit - 执行 Alenger3 解锁逻辑
//--------------------------------------------------------------------------------------------------
bool libA3ADAPTER_gt_MapInit_Func (bool testConds, bool runActions) {
    int lp_player;
    int lv_player;
    int lv_i;
    int lv_retry;
    string lv_upgradeId;
    int lv_upgradeLevel;
    playergroup autoA3ADAPTER_g;

    lp_player = 1;

    // Conditions
    if (testConds) {
        return true;
    }

    // Actions
    if (!runActions) {
        return true;
    }

    // -------- 1. 为玩家1升级全部科技（超标强制强度，数据驱动）--------
    lv_i = 1;
    for ( ; ( lv_i <= libA3ADAPTER_gv_overloadUpgradeCount ) ; lv_i += 1 ) {
        lv_upgradeId = libA3ADAPTER_gf_OverloadUpgradeId(lv_i);
        lv_upgradeLevel = libA3ADAPTER_gf_OverloadUpgradeLevel(lv_i);
        if ((lv_upgradeId != "")) {
            TechTreeUpgradeAddLevel(lp_player, lv_upgradeId, lv_upgradeLevel);
        }
    }

    // -------- 2. 为玩家1升级全部科技（常规强制强度，数据驱动）--------
    lv_i = 1;
    for ( ; ( lv_i <= libA3ADAPTER_gv_standardUpgradeCount ) ; lv_i += 1 ) {
        lv_upgradeId = libA3ADAPTER_gf_StandardUpgradeId(lv_i);
        lv_upgradeLevel = libA3ADAPTER_gf_StandardUpgradeLevel(lv_i);
        if ((lv_upgradeId != "")) {
            TechTreeUpgradeAddLevel(lp_player, lv_upgradeId, lv_upgradeLevel);
        }
    }

    // -------- 3. 第一次解锁所有能力和单位 --------
    autoA3ADAPTER_g = PlayerGroupAll();
    lv_player = -1;
    while (true) {
        lv_player = PlayerGroupNextPlayer(autoA3ADAPTER_g, lv_player);
        if (lv_player < 0) { break; }
        if ((PlayerType(lv_player) == c_playerTypeUser)) {
            libA3ADAPTER_gf_UnlockAllAbilities(lv_player);
        }
    }

    // -------- 4. 周期性重解锁，覆盖 CMRE DevStartupFinish 的封锁 --------
    // 7vs1 框架的封锁在 MapInit 早期发生，3 秒 Wait 已够；
    // 亡者之夜（CMRE 框架）的封锁在 CMUIX_ReadyBeginCountdown 倒计时结束后
    // 触发（通常 10-15 秒），3 秒 Wait 不足以覆盖。改为 5 秒一次，共 8 次
    // （覆盖 40 秒），确保 CMRE 封锁后能再次解锁。
    // TechTreeAbilityAllow 是幂等操作，重复调用 true 无副作用，对 7v1 地图安全。
    // 注意：galaxy 的 Wait 是协程式的，不会阻塞其他触发器。
    for (lv_retry = 0; lv_retry < 8; lv_retry += 1) {
        Wait(5.0, c_timeReal);
        autoA3ADAPTER_g = PlayerGroupAll();
        lv_player = -1;
        while (true) {
            lv_player = PlayerGroupNextPlayer(autoA3ADAPTER_g, lv_player);
            if (lv_player < 0) { break; }
            if ((PlayerType(lv_player) == c_playerTypeUser)) {
                libA3ADAPTER_gf_UnlockAllAbilities(lv_player);
            }
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void libA3ADAPTER_InitTriggers () {
    libA3ADAPTER_gt_MapInit = TriggerCreate("libA3ADAPTER_gt_MapInit_Func");
    TriggerAddEventMapInit(libA3ADAPTER_gt_MapInit);
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libA3ADAPTER_InitLib_completed = false;

void libA3ADAPTER_InitLib () {
    if (libA3ADAPTER_InitLib_completed) {
        return;
    }

    libA3ADAPTER_InitLib_completed = true;

    libA3ADAPTER_InitTriggers();
}
