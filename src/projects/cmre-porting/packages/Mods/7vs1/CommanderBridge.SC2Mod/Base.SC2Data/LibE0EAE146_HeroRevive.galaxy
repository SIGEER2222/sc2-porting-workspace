    }
    else if (lp_commander == "Alarak") {
        return "AlarakReviveBeacon";
    }
    else if (lp_commander == "Artanis") {
        return "ArtanisReviveBeacon";
    }
    else if (lp_commander == "Vorazun") {
        return "ArtanisReviveBeacon";
    }
    else if (lp_commander == "Zeratul") {
        return "ZeratulCoopReviveBeacon";
    }
    else if (lp_commander == "Raynor") {
        return "NovaReviveBeacon";
    }
    else if (lp_commander == "RaynorX") {
