}

void libE0EAE146_gf_CM_SoATargetingModeExit (int lp_player) {
    libE0EAE146_gv_cM_SoATargetingPhase[lp_player] = libE0EAE146_ge_CM_SoATargetingPhaseType_None;
    while (!((libE0EAE146_gv_cM_SoATargetingTransitioning[lp_player] == false))) {
        Wait(0.0625, c_timeGame);
    }
    libE0EAE146_gv_cM_SoATargetingTransitioning[lp_player] = true;
    if ((libE0EAE146_gv_cM_SoAExitInstantly == true)) {
        CameraSetValue(lp_player, c_cameraValueDistance, 34.0, 0.0, -1, 10.0);
        CameraSetValue(lp_player, c_cameraValuePitch, 56.0, 0.0, -1, 10.0);
    }
    else {
        CameraSetValue(lp_player, c_cameraValueDistance, 34.0, 0.5, -1, 10.0);
        CameraSetValue(lp_player, c_cameraValuePitch, 56.0, 0.5, -1, 10.0);
    }
    CameraSetData(PlayerGroupSingle(lp_player), "Dflt");
    if ((libE0EAE146_gv_cM_SoAExitInstantly == true)) {
        VisResetFoWAlpha(lp_player);
        libKCUI_gf_PU_TargetingUI_EnterTargetingMode(false, true, lp_player);
    }
    else {
        libE0EAE146_gf_CM_ResetFogAlphaOverTime(0.5, lp_player);
        libKCUI_gf_PU_TargetingUI_EnterTargetingMode(false, false, lp_player);
    }
    libNtve_gf_RestoreUnitSelection(lp_player);
    libE0EAE146_gv_cM_SoATargetingActivateAbility[lp_player] = null;
    libE0EAE146_gv_cM_SoATargetingTransitioning[lp_player] = false;
    libE0EAE146_gv_cM_SoATargetingUsageCount -= 1;
    if ((libE0EAE146_gv_cM_SoATargetingUsageCount == 0)) {
        TriggerEnable(libE0EAE146_gt_CM_SoATargetingCancel, false);
        TriggerEnable(libE0EAE146_gt_CM_SoATargetingPointChosen, false);
        TriggerEnable(libE0EAE146_gt_CM_SoATargetingDirectionChosen, false);
    }
}

void libE0EAE146_gf_CM_SoATargetingCleanupActorsAndUnits (int lp_player) {
    int lv_index;
    const int autoA7000234_ae = libE0EAE146_gv_cMC_SOATARGETCOUNTMAX;
    const int autoA7000234_ai = 1;

    lv_index = 1;
    for ( ; ( (autoA7000234_ai >= 0 && lv_index <= autoA7000234_ae) || (autoA7000234_ai < 0 && lv_index >= autoA7000234_ae) ) ; lv_index += autoA7000234_ai ) {
        if ((libE0EAE146_gv_cM_SoATargetingActors[lv_index][lp_player] != null)) {
            ActorSend(libE0EAE146_gv_cM_SoATargetingActors[lv_index][lp_player], "Signal Destroy");
            libE0EAE146_gv_cM_SoATargetingActors[lv_index][lp_player] = null;
        }

        if ((libE0EAE146_gv_cM_SoATargetingUnit[lv_index][lp_player] != null)) {
            UnitRemove(libE0EAE146_gv_cM_SoATargetingUnit[lv_index][lp_player]);
            libE0EAE146_gv_cM_SoATargetingUnit[lv_index][lp_player] = null;
        }

    }
}

