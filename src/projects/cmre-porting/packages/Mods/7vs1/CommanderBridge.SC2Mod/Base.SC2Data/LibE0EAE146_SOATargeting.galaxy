bool auto_libE0EAE146_gf_CM_ResetFogAlphaOverTime_TriggerFunc (bool testConds, bool runActions) {
    fixed lp_duration = auto_libE0EAE146_gf_CM_ResetFogAlphaOverTime_lp_duration;
    int lp_player = auto_libE0EAE146_gf_CM_ResetFogAlphaOverTime_lp_player;

    fixed lv_currentAlpha;
    fixed lv_alphaIncrement;
    fixed lv_incrementFrequency;
    int lv_increments;
    fixed lv_targetAlpha;

    int auto26F5891F_n;
    int auto26F5891F_i;

    lv_incrementFrequency = 0.05;
    lv_currentAlpha = VisGetFoWAlpha(lp_player);
    VisResetFoWAlpha(lp_player);
    lv_targetAlpha = VisGetFoWAlpha(lp_player);
    lv_increments = AbsI(FixedToInt((lp_duration / lv_incrementFrequency)));
    lv_alphaIncrement = ((lv_targetAlpha-lv_currentAlpha)/IntToFixed(lv_increments));
    VisSetFoWAlpha(lp_player, lv_currentAlpha);
    auto26F5891F_n = lv_increments;
    for (auto26F5891F_i = 1; auto26F5891F_i <= auto26F5891F_n; auto26F5891F_i += 1) {
        Wait(lv_incrementFrequency, c_timeGame);
        lv_currentAlpha += lv_alphaIncrement;
        VisSetFoWAlpha(lp_player, lv_currentAlpha);
    }
    VisResetFoWAlpha(lp_player);
    return true;
}

void libE0EAE146_gf_CM_SoATargetingCancel (int lp_player) {
    string lv_cost;
    string lv_costField;

    lv_cost = "";
    lv_costField = "";

    UnitIssueOrder(libE0EAE146_gv_cM_SoACasterUnit[lp_player], Order(AbilityCommand("stop", 0)), c_orderQueueReplace);
    libE0EAE146_gv_cM_SoATargetingAlreadyCanceled[lp_player] = true;
    libE0EAE146_gf_CM_SoATargetingCleanupActorsAndUnits(lp_player);
    if ((libE0EAE146_gv_cM_SoATargetingUnitType[lp_player] != null) && (libE0EAE146_gv_cM_SoATargetingPhase[lp_player] == libE0EAE146_ge_CM_SoATargetingPhaseType_Direction)) {
        libE0EAE146_gv_cM_SoATargetingChargesSpent[lp_player] -= 1;
    }

    if ((libE0EAE146_gv_cM_SoATargetingChargesSpent[lp_player] == 0) && (libE0EAE146_gv_cM_SoATargetingUnrefundableStageEntered[lp_player] == false)) {
        libNtve_gf_UnitAbilityRemoveCooldown(libE0EAE146_gv_cM_SoACasterUnit[lp_player], libE0EAE146_gv_cM_SoATargetingActivateAbility[lp_player], libE0EAE146_gv_cM_SoATargetingCooldown[lp_player]);
        lv_costField = ("Cost[0].Vital[" + "Energy" + "]");
        lv_cost = CatalogFieldValueGet(c_gameCatalogAbil, libE0EAE146_gv_cM_SoATargetingActivateAbility[lp_player], (lv_costField), lp_player);
        UnitSetPropertyFixed(libE0EAE146_gv_cM_SoACasterUnit[lp_player], c_unitPropEnergy, (UnitGetPropertyFixed(libE0EAE146_gv_cM_SoACasterUnit[lp_player], c_unitPropEnergy, c_unitPropCurrent) + StringToFixed(lv_cost)));
        if ((TechTreeUpgradeCount(lp_player, "NovaCommander", c_techCountCompleteOnly) == 1)) {
            PlayerModifyPropertyInt(lp_player, c_playerPropMinerals, c_playerPropOperAdd, libE0EAE146_gv_cM_NovaGriffinBombingRunCost[lp_player]);
        }

    }

    UnitBehaviorRemove(libE0EAE146_gv_cM_SoACasterUnit[lp_player], libE0EAE146_gv_cM_SoATargetingBehavior[lp_player], 1);
    libE0EAE146_gv_cM_SoATargetingUnrefundableStageEntered[lp_player] = true;
    UISetTargetingOrder(PlayerGroupSingle(lp_player), libE0EAE146_gv_cM_SoACasterGroup[lp_player], null, false);
    UISetTargetingOrder(PlayerGroupSingle(lp_player), libE0EAE146_gv_cM_SoATargetingDirectionGroup[lp_player], null, false);
    libE0EAE146_gv_cM_SoATargetingChargesSpent[lp_player] = 0;
    if ((libE0EAE146_gv_cM_SoATargetingPhase[lp_player] != libE0EAE146_ge_CM_SoATargetingPhaseType_None)) {
        libE0EAE146_gf_CM_SoATargetingModeExit(lp_player);
    }
}

void libE0EAE146_gf_CM_SoATimeFreezeApply (int lp_castingPlayer) {
    PlayerCreateEffectPoint(lp_castingPlayer, "SOATimeFreezeVisual", Point(PointGetX(CameraGetTarget(lp_castingPlayer)), PointGetY(CameraGetTarget(lp_castingPlayer))));
    libKCOR_gf_CC_TimeAITemporarySet(true);
