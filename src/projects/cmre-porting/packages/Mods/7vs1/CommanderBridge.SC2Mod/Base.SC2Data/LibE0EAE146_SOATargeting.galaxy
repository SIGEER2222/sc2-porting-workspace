    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_SoATargetingDeactivated, null, "SOAGravitonBombActivate", c_unitBehaviorChangeDeactivate);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_SoATargetingDeactivated, null, "SOAThermalLanceActivate", c_unitBehaviorChangeDeactivate);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_SoATargetingDeactivated, null, "SOAStrafeAttackActivate", c_unitBehaviorChangeDeactivate);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_SoATargetingDeactivated, null, "NovaGriffinBombingRunActivate", c_unitBehaviorChangeDeactivate);
    TriggerAddEventUnitBehaviorChange(libE0EAE146_gt_CM_SoATargetingDeactivated, null, "HornerAirFleetActivate", c_unitBehaviorChangeDeactivate);
}

//--------------------------------------------------------------------------------------------------
// Trigger: CM_SoATargetingPointChosen
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_CM_SoATargetingPointChosen_Func (bool testConds, bool runActions) {
    point lv_targetPoint;
    int lv_casterPlayer;

    if (testConds) {
        if (!((PlayerGroupHasPlayer(libE0EAE146_gf_CommanderPlayers(), EventPlayer()) == true))) {
