// Trigger: CM_SoATargetingDirectionChosen
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_CM_SoATargetingDirectionChosen_Func (bool testConds, bool runActions) {
    point lv_targetPoint;
    int lv_casterPlayer;

    if (testConds) {
        if (!((PlayerGroupHasPlayer(libE0EAE146_gf_CommanderPlayers(), EventPlayer()) == true))) {
            return false;
        }

        if (!((libE0EAE146_gv_cM_SoATargetingPhase[EventPlayer()] == libE0EAE146_ge_CM_SoATargetingPhaseType_Direction))) {
            return false;
        }
    }

    if (!runActions) {
        return true;
    }

    lv_casterPlayer = EventPlayer();
    libE0EAE146_gv_cM_SoATargetingCycling[lv_casterPlayer] = true;
    lv_targetPoint = OrderGetTargetPoint(EventUnitOrder());
    libE0EAE146_gv_cM_SoATargetingUnrefundableStageEntered[lv_casterPlayer] = true;
    libNtve_gf_CreateActorAtPoint("SOATargetingModeConfirmationSound", lv_targetPoint);
    ActorSend(libE0EAE146_gv_cM_SoATargetingActors[libE0EAE146_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]][lv_casterPlayer], "Signal Destroy");
    if ((UnitIsValid(libE0EAE146_gv_cM_SoATargetingUnit[libE0EAE146_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]][lv_casterPlayer]) == false)) {
        return true;
    }

    libNtve_gf_MakeUnitFacePoint(libE0EAE146_gv_cM_SoATargetingUnit[libE0EAE146_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]][lv_casterPlayer], lv_targetPoint, 0.0);
    libE0EAE146_gf_CU_TargetingSetCharges((libE0EAE146_gv_cM_SoATargetingChargesTotal[lv_casterPlayer]-libE0EAE146_gv_cM_SoATargetingChargesSpent[lv_casterPlayer]), libE0EAE146_gv_cM_SoATargetingChargesTotal[lv_casterPlayer], lv_casterPlayer);
    if ((libE0EAE146_gv_cM_SoATargetingChargesSpent[lv_casterPlayer] == libE0EAE146_gv_cM_SoATargetingChargesTotal[lv_casterPlayer])) {
        UnitBehaviorRemove(libE0EAE146_gv_cM_SoACasterUnit[lv_casterPlayer], libE0EAE146_gv_cM_SoATargetingBehavior[lv_casterPlayer], 1);
        Wait(0.1, c_timeGame);
    }
    else {
        libE0EAE146_gf_CU_TargetingSetInstructionText(libE0EAE146_gv_cM_SoATargetingInstructionsPrimary[lv_casterPlayer], lv_casterPlayer);
        Wait(0.1, c_timeGame);
        if ((libE0EAE146_gv_cM_SoATargetingAlreadyCanceled[lv_casterPlayer] == false)) {
