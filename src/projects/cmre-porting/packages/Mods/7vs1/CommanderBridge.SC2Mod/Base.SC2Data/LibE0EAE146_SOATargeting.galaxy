        }

        libE0EAE146_gv_cM_SoATargetingPhase[lv_casterPlayer] = libE0EAE146_ge_CM_SoATargetingPhaseType_Location;
    }
    libE0EAE146_gv_cM_SoATargetingCycling[lv_casterPlayer] = false;
    return true;
}

