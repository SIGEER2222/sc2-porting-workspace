    libE0EAE146_gv_cM_SoATargetingAlreadyCanceled[lp_player] = false;
    while (!((libE0EAE146_gv_cM_SoATargetingTransitioning[lp_player] == false))) {
        Wait(0.0625, c_timeGame);
    }
    TriggerEnable(libE0EAE146_gt_CM_SoATargetingCancel, true);
    libE0EAE146_gv_cM_SoAExitInstantly = false;
    libE0EAE146_gv_cM_SoATargetingUsageCount += 1;
    libE0EAE146_gv_cM_SoATargetingChargesSpent[lp_player] = 0;
    libE0EAE146_gf_CU_TargetingSetCharges(libE0EAE146_gv_cM_SoATargetingChargesTotal[lp_player], libE0EAE146_gv_cM_SoATargetingChargesTotal[lp_player], lp_player);
