    }

    lv_casterPlayer = UnitGetOwner(EventUnit());
    UISetTargetingOrder(PlayerGroupSingle(lv_casterPlayer), libE0EAE146_gv_cM_SoACasterGroup[lv_casterPlayer], null, false);
    libE0EAE146_gv_cM_SoATargetingChargesSpent[lv_casterPlayer] = 0;
    libE0EAE146_gf_CM_SoATargetingModeExit(lv_casterPlayer);
    return true;
}

