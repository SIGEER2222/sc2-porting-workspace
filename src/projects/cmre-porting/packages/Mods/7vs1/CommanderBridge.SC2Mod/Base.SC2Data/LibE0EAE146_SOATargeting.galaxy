        libE0EAE146_gv_cM_SoATargetingPhase[lp_player] = libE0EAE146_ge_CM_SoATargetingPhaseType_Location;
    }
    else {
        libE0EAE146_gv_cM_SoATargetingPhase[lp_player] = libE0EAE146_ge_CM_SoATargetingPhaseType_None;
    }
    libE0EAE146_gv_cM_SoATargetingTransitioning[lp_player] = true;
    libKCUI_gf_PU_TargetingUI_EnterTargetingMode(true, false, lp_player);
    libE0EAE146_gf_CU_TargetingSetInstructionText(libE0EAE146_gv_cM_SoATargetingInstructionsPrimary[lp_player], lp_player);
    libE0EAE146_gf_CM_SetFogAlphaOverTime(100.0, 0.5, lp_player);
    CameraSetValue(lp_player, c_cameraValueDistance, 50.0, 1.0, -1, 10.0);
    CameraSetValue(lp_player, c_cameraValuePitch, 70.0, 1.0, -1, 10.0);
    CameraSetData(PlayerGroupSingle(lp_player), "SOATargetingModeCamera");
    libE0EAE146_gv_cM_SoATargetingTransitioning[lp_player] = false;
