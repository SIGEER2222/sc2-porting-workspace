//--------------------------------------------------------------------------------------------------
// Trigger: CM_SoATargetingForceOff
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_CM_SoATargetingForceOff_Func (bool testConds, bool runActions) {
    int lv_indexPlayer;
    playergroup autoDA5C7614_g;

    if (!runActions) {
        return true;
    }

    TriggerEnable(libE0EAE146_gt_CM_SoATargetingCancel, false);
    TriggerEnable(libE0EAE146_gt_CM_SoATargetingPointChosen, false);
    TriggerEnable(libE0EAE146_gt_CM_SoATargetingDirectionChosen, false);
    libE0EAE146_gv_cM_SoAExitInstantly = true;
    autoDA5C7614_g = libE0EAE146_gf_CommanderPlayers();
    lv_indexPlayer = -1;
    while (true) {
        lv_indexPlayer = PlayerGroupNextPlayer(autoDA5C7614_g, lv_indexPlayer);
        if (lv_indexPlayer < 0) { break; }
        if ((libE0EAE146_gv_cM_SoATargetingPhase[lv_indexPlayer] != libE0EAE146_ge_CM_SoATargetingPhaseType_None)) {
            libE0EAE146_gv_cM_SoATargetingTransitioning[lv_indexPlayer] = false;
            UISetTargetingOrder(PlayerGroupSingle(lv_indexPlayer), libE0EAE146_gv_cM_SoACasterGroup[lv_indexPlayer], null, false);
            libE0EAE146_gf_CM_SoATargetingCancel(lv_indexPlayer);
        }

    }
    libE0EAE146_gv_cM_SoATargetingUsageCount = 0;
    return true;
}

void libE0EAE146_gt_CM_SoATargetingForceOff_Init () {
    libE0EAE146_gt_CM_SoATargetingForceOff = TriggerCreate("libE0EAE146_gt_CM_SoATargetingForceOff_Func");
    TriggerAddEventGeneric(libE0EAE146_gt_CM_SoATargetingForceOff, "CinematicModeOn");
}

