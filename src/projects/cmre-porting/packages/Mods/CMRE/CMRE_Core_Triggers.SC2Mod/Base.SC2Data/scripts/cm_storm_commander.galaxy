// CM Storm Commander shared systems.

const fixed CMSC_HERO_FIRST_WAVE_TIME = 0.0;
const int CMSC_PANEL_ABILITY_MAX = 4;
const int CMSC_NOVA_ABILITY_DEFENSIVE_DRONE = 1;
const int CMSC_NOVA_ABILITY_GRIFFIN_AIRSTRIKE = 2;
const int CMSC_NOVA_ABILITY_GRIFFIN_TRANSPORT = 3;
const int CMSC_NOVA_ABILITY_RAPID_RECOVERY = 4;
const int CMSC_PANEL_STATE_NONE = 0;
const int CMSC_PANEL_STATE_LOCKED = 1;
const int CMSC_PANEL_STATE_COOLING = 2;
const int CMSC_PANEL_STATE_READY = 3;

int CMSC_gv_CommanderOwner = 0;
string CMSC_gv_HeroUnitType = "";
unit CMSC_gv_HeroUnit = null;
unit CMSC_gv_PanelCaster = null;
bool CMSC_gv_PanelAbilitiesLoaded = false;
bool CMSC_gv_RapidRecoveryPending = false;
string[5] CMSC_gv_PanelAbility;
fixed[5] CMSC_gv_PanelAbilityUnlockTime;
fixed[5] CMSC_gv_PanelAbilityMinimumUseInterval;
fixed[5] CMSC_gv_PanelAbilityChargeRecoveryTime;
fixed[5] CMSC_gv_PanelAbilityActivationDelay;
fixed[5] CMSC_gv_PanelAbilityNextUseTime;
fixed[5] CMSC_gv_PanelAbilityNextChargeTime;
int[5] CMSC_gv_PanelAbilityCharges;
int[5] CMSC_gv_PanelAbilityMaximumCharges;
int CMSC_gv_PanelUI = c_invalidDialogControlId;
int[5] CMSC_gv_PanelUISlot;
int[5] CMSC_gv_PanelUIIcon;
int[5] CMSC_gv_PanelUICooldownMask;
int[5] CMSC_gv_PanelUICooldownFinishedImage;
int[5] CMSC_gv_PanelUIChargeLabel;
int[5] CMSC_gv_PanelUIPreviousState;
int[5] CMSC_gv_PanelUIPreviousCharges;
int CMSC_gv_PanelUIPreviousWaveTimerCount = -1;
trigger CMSC_gt_AttackWave = null;
trigger CMSC_gt_NovaUnitDamaged = null;
trigger CMSC_gt_NovaHeroDied = null;
trigger CMSC_gt_PanelUIUpdate = null;

bool CMSC_gf_PlayerIsValid (int lp_player) {
    return ((lp_player >= 1) && (lp_player <= 16));
}

bool CMSC_gf_AICommanderCanOwnStormSystems (string lp_aiCommander) {
    string lv_baseCommander;

    if (((lp_aiCommander == null)
        || (lp_aiCommander == "")
        || (lp_aiCommander == "None")
        || (lp_aiCommander == "[Default]"))) {
        return false;
    }
    if ((UserDataGetUserInstance(
        "CoopAICommanders", lp_aiCommander, "Faction", 1
    ) != "EnemyCommander")) {
        return false;
    }

    lv_baseCommander = UserDataGetUserInstance(
        "CoopAICommanders", lp_aiCommander, "BaseCommander", 1
    );
    return ((lv_baseCommander != null)
        && (lv_baseCommander != "")
        && (lv_baseCommander != "None")
        && (lv_baseCommander != "[Default]"));
}

int CMSC_CommanderOwner () {
    int lv_player;
    string lv_aiCommander;

    if ((CMSC_gv_CommanderOwner != 0)) {
        return CMSC_gv_CommanderOwner;
    }

    lv_player = 3;
    while ((lv_player <= libCOMI_gv_cMC_CoopAI_HighestPlayerIndex)) {
        lv_aiCommander = libCOMI_gv_cM_CoopAIPlayer_Commander[lv_player];
        if (((PlayerType(lv_player) == c_playerTypeComputer)
            && (CMSC_gf_AICommanderCanOwnStormSystems(lv_aiCommander) == true))) {
            CMSC_gv_CommanderOwner = lv_player;
            return lv_player;
        }
        lv_player += 1;
    }
    return 0;
}

bool CMSC_gf_LoadPanelAbilities () {
    int lv_owner;
    int lv_slot;
    int lv_initialCharges;
    string lv_aiCommander;
    string lv_ability;

    if ((CMSC_gv_PanelAbilitiesLoaded == true)) {
        return true;
    }

    lv_owner = CMSC_CommanderOwner();
    if ((lv_owner == 0)) {
        return false;
    }
    lv_aiCommander = libCOMI_gv_cM_CoopAIPlayer_Commander[lv_owner];
    if (((lv_aiCommander == null) || (lv_aiCommander == "") || (lv_aiCommander == "None"))) {
        return false;
    }

    lv_slot = 1;
    while ((lv_slot <= CMSC_PANEL_ABILITY_MAX)) {
        lv_ability = UserDataGetUserInstance(
            "CoopAICommanders",
            lv_aiCommander,
            "AIAbility",
            lv_slot
        );
        CMSC_gv_PanelAbility[lv_slot] = lv_ability;
        if (((lv_ability != null) && (lv_ability != "") && (lv_ability != "[Default]"))) {
            CMSC_gv_PanelAbilityUnlockTime[lv_slot] = UserDataGetFixed(
                "CoopAIAbilities", lv_ability, "UnlockTime", 1
            );
            CMSC_gv_PanelAbilityMinimumUseInterval[lv_slot] = UserDataGetFixed(
                "CoopAIAbilities", lv_ability, "MinimumUseInterval", 1
            );
            CMSC_gv_PanelAbilityChargeRecoveryTime[lv_slot] = UserDataGetFixed(
                "CoopAIAbilities", lv_ability, "ChargeRecoveryTime", 1
            );
            CMSC_gv_PanelAbilityActivationDelay[lv_slot] = UserDataGetFixed(
                "CoopAIAbilities", lv_ability, "ActivationDelay", 1
            );
            CMSC_gv_PanelAbilityMaximumCharges[lv_slot] = MaxI(
                UserDataGetInt("CoopAIAbilities", lv_ability, "MaximumCharges", 1),
                1
            );
            lv_initialCharges = UserDataGetInt(
                "CoopAIAbilities", lv_ability, "InitialCharges", 1
            );
            CMSC_gv_PanelAbilityCharges[lv_slot] = MinI(
                MaxI(lv_initialCharges, 0),
                CMSC_gv_PanelAbilityMaximumCharges[lv_slot]
            );
        }
        lv_slot += 1;
    }

    CMSC_gv_PanelAbilitiesLoaded = true;
    return true;
}

bool CMSC_PanelAbilityExists (int lp_slot) {
    if (((lp_slot < 1) || (lp_slot > CMSC_PANEL_ABILITY_MAX))) {
        return false;
    }
    if ((CMSC_gf_LoadPanelAbilities() == false)) {
        return false;
    }
    return ((CMSC_gv_PanelAbility[lp_slot] != null)
        && (CMSC_gv_PanelAbility[lp_slot] != "")
        && (CMSC_gv_PanelAbility[lp_slot] != "[Default]"));
}

unit CMSC_PanelCaster () {
    int lv_owner;
    int lv_slot;
    bool lv_hasAbility;

    if ((CMSC_gf_LoadPanelAbilities() == false)) {
        return null;
    }
    if (((CMSC_gv_PanelCaster != null)
        && (UnitIsValid(CMSC_gv_PanelCaster) == true)
        && (UnitIsAlive(CMSC_gv_PanelCaster) == true))) {
        return CMSC_gv_PanelCaster;
    }

    lv_hasAbility = false;
    lv_slot = 1;
    while ((lv_slot <= CMSC_PANEL_ABILITY_MAX)) {
        if ((CMSC_PanelAbilityExists(lv_slot) == true)) {
            lv_hasAbility = true;
            break;
        }
        lv_slot += 1;
    }
    if ((lv_hasAbility == false)) {
        return null;
    }

    lv_owner = CMSC_CommanderOwner();
    libNtve_gf_CreateUnitsWithDefaultFacing(
        1,
        "CMStormCommanderPanelCaster",
        c_unitCreateIgnorePlacement,
        lv_owner,
        Point(0.0, 0.0)
    );
    CMSC_gv_PanelCaster = UnitLastCreated();
    AISetUnitScriptControlled(CMSC_gv_PanelCaster, true);
    return CMSC_gv_PanelCaster;
}

void CMSC_gf_PanelAbilityUpdateCharges (int lp_slot) {
    fixed lv_missionTime;

    if ((CMSC_PanelAbilityExists(lp_slot) == false)) {
        return;
    }
    if ((CMSC_gv_PanelAbilityCharges[lp_slot]
        >= CMSC_gv_PanelAbilityMaximumCharges[lp_slot])) {
        CMSC_gv_PanelAbilityNextChargeTime[lp_slot] = 0.0;
        return;
    }
    if ((CMSC_gv_PanelAbilityNextChargeTime[lp_slot] <= 0.0)) {
        return;
    }

    lv_missionTime = GameGetMissionTime();
    while (((CMSC_gv_PanelAbilityCharges[lp_slot]
        < CMSC_gv_PanelAbilityMaximumCharges[lp_slot])
        && (lv_missionTime >= CMSC_gv_PanelAbilityNextChargeTime[lp_slot]))) {
        CMSC_gv_PanelAbilityCharges[lp_slot] += 1;
        if ((CMSC_gv_PanelAbilityCharges[lp_slot]
            < CMSC_gv_PanelAbilityMaximumCharges[lp_slot])) {
            CMSC_gv_PanelAbilityNextChargeTime[lp_slot]
                += CMSC_gv_PanelAbilityChargeRecoveryTime[lp_slot];
        }
        else {
            CMSC_gv_PanelAbilityNextChargeTime[lp_slot] = 0.0;
        }
    }
}

bool CMSC_PanelAbilityCanUse (int lp_player, int lp_slot) {
    if ((lp_player != CMSC_CommanderOwner())) {
        return false;
    }
    if ((CMSC_PanelAbilityExists(lp_slot) == false)) {
        return false;
    }

    CMSC_gf_PanelAbilityUpdateCharges(lp_slot);
    if ((GameGetMissionTime() < CMSC_gv_PanelAbilityUnlockTime[lp_slot])) {
        return false;
    }
    if ((GameGetMissionTime() < CMSC_gv_PanelAbilityNextUseTime[lp_slot])) {
        return false;
    }
    return CMSC_gv_PanelAbilityCharges[lp_slot] > 0;
}

void CMSC_gf_PanelAbilityPlayUseVoice (int lp_slot) {
    string lv_soundId;

    if ((CMSC_PanelAbilityExists(lp_slot) == false)) {
        return;
    }
    lv_soundId = UserDataGetSound(
        "CoopAIAbilities",
        CMSC_gv_PanelAbility[lp_slot],
        "UseVoice",
        1
    );
    if (((lv_soundId == null) || (lv_soundId == ""))) {
        return;
    }

    SoundPlayForPlayer(
        SoundLink(lv_soundId, c_soundIndexAny),
        1,
        libCOOC_gf_CommanderPlayers(),
        100.0,
        0.0
    );
}

bool CMSC_PanelAbilityConsume (int lp_player, int lp_slot) {
    fixed lv_missionTime;

    if ((CMSC_PanelAbilityCanUse(lp_player, lp_slot) == false)) {
        return false;
    }

    lv_missionTime = GameGetMissionTime();
    CMSC_gv_PanelAbilityCharges[lp_slot] -= 1;
    CMSC_gv_PanelAbilityNextUseTime[lp_slot]
        = lv_missionTime + CMSC_gv_PanelAbilityMinimumUseInterval[lp_slot];
    if (((CMSC_gv_PanelAbilityCharges[lp_slot]
        < CMSC_gv_PanelAbilityMaximumCharges[lp_slot])
        && (CMSC_gv_PanelAbilityNextChargeTime[lp_slot] <= 0.0)
        && (CMSC_gv_PanelAbilityChargeRecoveryTime[lp_slot] > 0.0))) {
        CMSC_gv_PanelAbilityNextChargeTime[lp_slot]
            = lv_missionTime + CMSC_gv_PanelAbilityChargeRecoveryTime[lp_slot];
    }
    if ((lp_slot != CMSC_NOVA_ABILITY_RAPID_RECOVERY)) {
        CMSC_gf_PanelAbilityPlayUseVoice(lp_slot);
    }
    return true;
}

int CMSC_PanelAbilityCharges (int lp_slot) {
    CMSC_gf_PanelAbilityUpdateCharges(lp_slot);
    if ((CMSC_PanelAbilityExists(lp_slot) == false)) {
        return 0;
    }
    return CMSC_gv_PanelAbilityCharges[lp_slot];
}

fixed CMSC_PanelAbilityActivationDelay (int lp_slot) {
    if ((CMSC_PanelAbilityExists(lp_slot) == false)) {
        return 0.0;
    }
    return CMSC_gv_PanelAbilityActivationDelay[lp_slot];
}

bool CMSC_gf_PanelUIHookup () {
    int lv_slot;

    if ((CMSC_gv_PanelUI != c_invalidDialogControlId)) {
        return true;
    }

    CMSC_gv_PanelUI = DialogControlHookupStandard(
        c_triggerControlTypePanel,
        "UIContainer/ConsoleUIContainer/StormCommanderAbilityPanel"
    );
    if ((CMSC_gv_PanelUI == c_invalidDialogControlId)) {
        return false;
    }

    lv_slot = 1;
    while ((lv_slot <= CMSC_PANEL_ABILITY_MAX)) {
        CMSC_gv_PanelUISlot[lv_slot] = DialogControlHookup(
            CMSC_gv_PanelUI,
            c_triggerControlTypePanel,
            "Ability" + IntToString(lv_slot)
        );
        CMSC_gv_PanelUIIcon[lv_slot] = DialogControlHookup(
            CMSC_gv_PanelUISlot[lv_slot],
            c_triggerControlTypeImage,
            "Icon"
        );
        CMSC_gv_PanelUICooldownMask[lv_slot] = DialogControlHookup(
            CMSC_gv_PanelUISlot[lv_slot],
            c_triggerControlTypeImage,
            "CooldownMask"
        );
        CMSC_gv_PanelUICooldownFinishedImage[lv_slot] = DialogControlHookup(
            CMSC_gv_PanelUISlot[lv_slot],
            c_triggerControlTypeImage,
            "CooldownFinishedImage"
        );
        libNtve_gf_SetDialogItemAnimationDuration(
            CMSC_gv_PanelUICooldownMask[lv_slot],
            1.0,
            PlayerGroupAll()
        );
        CMSC_gv_PanelUIChargeLabel[lv_slot] = DialogControlHookup(
            CMSC_gv_PanelUISlot[lv_slot],
            c_triggerControlTypeLabel,
            "ChargeLabel"
        );
        lv_slot += 1;
    }
    return true;
}

void CMSC_gf_PanelUIUpdatePosition () {
    int lv_activeWindowCount;
    int lv_relativeControl;
    int lv_yOffset;

    lv_activeWindowCount = MinI(
        libCOUI_gv_cU_WaveTimerActiveCount,
        libCOUI_gv_cUC_WAVETIMERWINDOWMAX
    );
    if ((lv_activeWindowCount == CMSC_gv_PanelUIPreviousWaveTimerCount)) {
        return;
    }

    if ((libCOUI_gv_cU_WaveTimerWindows[1] == c_invalidDialogControlId)) {
        return;
    }
    if ((lv_activeWindowCount <= 0)) {
        lv_relativeControl = libCOUI_gv_cU_WaveTimerWindows[1];
        lv_yOffset = 0;
        DialogControlSetPositionRelative(
            CMSC_gv_PanelUI,
            PlayerGroupAll(),
            c_anchorTopRight,
            lv_relativeControl,
            c_anchorTopRight,
            0,
            lv_yOffset
        );
    }
    else {
        lv_relativeControl = libCOUI_gv_cU_WaveTimerWindows[lv_activeWindowCount];
        lv_yOffset = 10;
        DialogControlSetPositionRelative(
            CMSC_gv_PanelUI,
            PlayerGroupAll(),
            c_anchorTopRight,
            lv_relativeControl,
            c_anchorBottomRight,
            0,
            lv_yOffset
        );
    }
    CMSC_gv_PanelUIPreviousWaveTimerCount = lv_activeWindowCount;
}

int CMSC_gf_PanelAbilityState (int lp_slot) {
    fixed lv_missionTime;

    if ((CMSC_PanelAbilityExists(lp_slot) == false)) {
        return CMSC_PANEL_STATE_NONE;
    }

    CMSC_gf_PanelAbilityUpdateCharges(lp_slot);
    lv_missionTime = GameGetMissionTime();
    if ((lv_missionTime < CMSC_gv_PanelAbilityUnlockTime[lp_slot])) {
        return CMSC_PANEL_STATE_LOCKED;
    }
    if (((CMSC_gv_PanelAbilityCharges[lp_slot] <= 0)
        || (lv_missionTime < CMSC_gv_PanelAbilityNextUseTime[lp_slot]))) {
        return CMSC_PANEL_STATE_COOLING;
    }
    return CMSC_PANEL_STATE_READY;
}

fixed CMSC_gf_PanelAbilityRemainingTime (int lp_slot, int lp_state) {
    fixed lv_endTime;
    fixed lv_missionTime;

    lv_missionTime = GameGetMissionTime();
    if ((lp_state == CMSC_PANEL_STATE_LOCKED)) {
        lv_endTime = CMSC_gv_PanelAbilityUnlockTime[lp_slot];
    }
    else {
        if ((CMSC_gv_PanelAbilityCharges[lp_slot] <= 0)) {
            lv_endTime = CMSC_gv_PanelAbilityNextChargeTime[lp_slot];
        }
        else {
            lv_endTime = CMSC_gv_PanelAbilityNextUseTime[lp_slot];
        }
    }
    return MaxF(lv_endTime - lv_missionTime, 0.0);
}

fixed CMSC_gf_PanelAbilityCooldownProgress (int lp_slot, int lp_state) {
    fixed lv_remaining;
    fixed lv_total;

    if ((lp_state == CMSC_PANEL_STATE_READY)) {
        return 1.0;
    }

    lv_remaining = CMSC_gf_PanelAbilityRemainingTime(lp_slot, lp_state);
    if ((lp_state == CMSC_PANEL_STATE_LOCKED)) {
        lv_total = CMSC_gv_PanelAbilityUnlockTime[lp_slot];
    }
    else {
        if ((CMSC_gv_PanelAbilityCharges[lp_slot] <= 0)) {
            lv_total = CMSC_gv_PanelAbilityChargeRecoveryTime[lp_slot];
        }
        else {
            lv_total = CMSC_gv_PanelAbilityMinimumUseInterval[lp_slot];
        }
    }
    if ((lv_total <= 0.0)) {
        return 0.0;
    }
    return MinF(MaxF(1.0 - (lv_remaining / lv_total), 0.0), 1.0);
}

text CMSC_gf_PanelAbilityStatusText (int lp_slot) {
    fixed lv_missionTime;
    fixed lv_remaining;

    CMSC_gf_PanelAbilityUpdateCharges(lp_slot);
    lv_missionTime = GameGetMissionTime();
    if ((lv_missionTime < CMSC_gv_PanelAbilityUnlockTime[lp_slot])) {
        lv_remaining = CMSC_gv_PanelAbilityUnlockTime[lp_slot] - lv_missionTime;
        return StringExternal("CM/StormCommanderAbility/StatusLocked")
            + TextTimeFormat(
                StringToText("<mintotal/>:<sec2/>"),
                FixedToInt(Ceiling(lv_remaining))
            );
    }
    if ((CMSC_gv_PanelAbilityCharges[lp_slot] <= 0)) {
        lv_remaining = MaxF(
            CMSC_gv_PanelAbilityNextChargeTime[lp_slot] - lv_missionTime,
            0.0
        );
        return StringExternal("CM/StormCommanderAbility/StatusRecharging")
            + TextTimeFormat(
                StringToText("<mintotal/>:<sec2/>"),
                FixedToInt(Ceiling(lv_remaining))
            );
    }
    if ((lv_missionTime < CMSC_gv_PanelAbilityNextUseTime[lp_slot])) {
        lv_remaining = CMSC_gv_PanelAbilityNextUseTime[lp_slot] - lv_missionTime;
        return StringExternal("CM/StormCommanderAbility/StatusCooling")
            + TextTimeFormat(
                StringToText("<mintotal/>:<sec2/>"),
                FixedToInt(Ceiling(lv_remaining))
            );
    }
    return StringExternal("CM/StormCommanderAbility/StatusReady");
}

text CMSC_gf_PanelAbilityTooltip (int lp_slot) {
    string lv_ability;
    text lv_name;
    text lv_description;
    text lv_status;

    lv_ability = CMSC_gv_PanelAbility[lp_slot];
    lv_name = UserDataGetText("CoopAIAbilities", lv_ability, "Name", 1);
    lv_description = UserDataGetText("CoopAIAbilities", lv_ability, "Description", 1);
    lv_status = CMSC_gf_PanelAbilityStatusText(lp_slot);
    return StringToText("<s val=\"@@@StandardTooltipHeader\">") + lv_name
        + StringToText("</s><n/><s val=\"@@@StandardTooltip\">") + lv_description
        + StringToText("<n/><n/>") + lv_status
        + StringExternal("CM/StormCommanderAbility/ChargeStatus")
        + IntToText(CMSC_gv_PanelAbilityCharges[lp_slot])
        + StringToText("/")
        + IntToText(CMSC_gv_PanelAbilityMaximumCharges[lp_slot])
        + StringToText("</s>");
}

void CMSC_gf_PanelAbilityNotify (int lp_slot, int lp_previousState, int lp_previousCharges, int lp_state) {
    bool lv_shouldNotify;
    int lv_recoveredCharges;
    string lv_soundId;
    text lv_message;
    text lv_name;

    lv_recoveredCharges = CMSC_gv_PanelAbilityCharges[lp_slot] - lp_previousCharges;
    lv_name = UserDataGetText(
        "CoopAIAbilities",
        CMSC_gv_PanelAbility[lp_slot],
        "Name",
        1
    );
    lv_shouldNotify = false;
    lv_message = StringToText("");

    if (((lp_previousState == CMSC_PANEL_STATE_LOCKED)
        && (lp_state != CMSC_PANEL_STATE_LOCKED))) {
        lv_message = StringExternal("CM/StormCommanderAbility/Prefix")
            + StringToText(" ")
            + lv_name;
        if ((lp_state == CMSC_PANEL_STATE_READY)) {
            lv_message = lv_message + StringExternal("CM/StormCommanderAbility/UnlockedReady");
        }
        else {
            lv_message = lv_message + StringExternal("CM/StormCommanderAbility/Unlocked");
        }
        lv_shouldNotify = true;
    }
    else {
        if ((lv_recoveredCharges > 0)) {
            lv_message = StringExternal("CM/StormCommanderAbility/Prefix")
                + StringToText(" ")
                + lv_name;
            if ((lp_state == CMSC_PANEL_STATE_READY)) {
                lv_message = lv_message
                    + StringExternal("CM/StormCommanderAbility/ChargeRecoveredReady");
            }
            else {
                lv_message = lv_message
                    + StringExternal("CM/StormCommanderAbility/ChargeRecovered");
            }
            lv_shouldNotify = true;
        }
        else {
            if (((lp_previousState == CMSC_PANEL_STATE_COOLING)
                && (lp_state == CMSC_PANEL_STATE_READY))) {
                lv_message = StringExternal("CM/StormCommanderAbility/Prefix")
                    + StringToText(" ")
                    + lv_name
                    + StringExternal("CM/StormCommanderAbility/Ready");
                lv_shouldNotify = true;
            }
        }
    }

    if ((lv_shouldNotify == true)) {
        lv_message = lv_message + StringExternal("CM/StormCommanderAbility/ChargeCountOpen")
            + IntToText(CMSC_gv_PanelAbilityCharges[lp_slot])
            + StringToText("/")
            + IntToText(CMSC_gv_PanelAbilityMaximumCharges[lp_slot])
            + StringExternal("CM/StormCommanderAbility/ChargeCountClose");
    }

    if ((lv_shouldNotify == false)) {
        return;
    }

    libCOUI_gf_CU_MutatorListShowNotification(lv_message);
    UIDisplayMessage(libCOOC_gf_CommanderPlayers(), c_messageAreaChat, lv_message);
    lv_soundId = UserDataGetSound(
        "CoopAIAbilities",
        CMSC_gv_PanelAbility[lp_slot],
        "ReadySound",
        1
    );
    if (((lv_soundId != null) && (lv_soundId != ""))) {
        SoundPlayForPlayer(
            SoundLink(lv_soundId, c_soundIndexAny),
            c_maxPlayers,
            libCOOC_gf_CommanderPlayers(),
            100.0,
            0.0
        );
    }
}

void CMSC_gf_PanelUIUpdateSlot (int lp_slot) {
    fixed lv_cooldownProgress;
    int lv_previousCharges;
    int lv_previousState;
    int lv_state;
    string lv_stateName;

    if ((CMSC_PanelAbilityExists(lp_slot) == false)) {
        DialogControlSetVisible(
            CMSC_gv_PanelUISlot[lp_slot],
            PlayerGroupAll(),
            false
        );
        return;
    }

    DialogControlSetVisible(
        CMSC_gv_PanelUISlot[lp_slot],
        PlayerGroupAll(),
        true
    );
    lv_previousState = CMSC_gv_PanelUIPreviousState[lp_slot];
    lv_previousCharges = CMSC_gv_PanelUIPreviousCharges[lp_slot];
    lv_state = CMSC_gf_PanelAbilityState(lp_slot);

    if ((lv_state == CMSC_PANEL_STATE_READY)) {
        lv_stateName = "Ready";
    }
    else {
        if ((lv_state == CMSC_PANEL_STATE_LOCKED)) {
            lv_stateName = "Locked";
        }
        else {
            lv_stateName = "Cooling";
        }
    }
    lv_cooldownProgress = CMSC_gf_PanelAbilityCooldownProgress(lp_slot, lv_state);

    DialogControlSetAnimationState(
        CMSC_gv_PanelUISlot[lp_slot],
        PlayerGroupAll(),
        "AbilityState",
        lv_stateName
    );
    DialogControlSetVisible(
        CMSC_gv_PanelUICooldownMask[lp_slot],
        PlayerGroupAll(),
        (lv_state != CMSC_PANEL_STATE_READY)
    );
    if (((lv_previousState != CMSC_PANEL_STATE_NONE)
        && (lv_previousState != CMSC_PANEL_STATE_READY)
        && (lv_state == CMSC_PANEL_STATE_READY))) {
        DialogControlSetVisible(
            CMSC_gv_PanelUICooldownFinishedImage[lp_slot],
            PlayerGroupAll(),
            true
        );
    }
    else {
        if ((lv_state != CMSC_PANEL_STATE_READY)) {
            DialogControlSetVisible(
                CMSC_gv_PanelUICooldownFinishedImage[lp_slot],
                PlayerGroupAll(),
                false
            );
        }
    }
    libNtve_gf_SetDialogItemAnimationTime(
        CMSC_gv_PanelUICooldownMask[lp_slot],
        lv_cooldownProgress,
        PlayerGroupAll()
    );
    if ((CMSC_gv_PanelAbilityMaximumCharges[lp_slot] > 1)) {
        libNtve_gf_SetDialogItemText(
            CMSC_gv_PanelUIChargeLabel[lp_slot],
            IntToText(CMSC_gv_PanelAbilityCharges[lp_slot]),
            PlayerGroupAll()
        );
    }
    else {
        libNtve_gf_SetDialogItemText(
            CMSC_gv_PanelUIChargeLabel[lp_slot],
            StringToText(""),
            PlayerGroupAll()
        );
    }
    libNtve_gf_SetDialogItemTooltip(
        CMSC_gv_PanelUISlot[lp_slot],
        CMSC_gf_PanelAbilityTooltip(lp_slot),
        PlayerGroupAll()
    );

    if ((lv_previousState != CMSC_PANEL_STATE_NONE)) {
        CMSC_gf_PanelAbilityNotify(
            lp_slot,
            lv_previousState,
            lv_previousCharges,
            lv_state
        );
    }
    CMSC_gv_PanelUIPreviousState[lp_slot] = lv_state;
    CMSC_gv_PanelUIPreviousCharges[lp_slot] = CMSC_gv_PanelAbilityCharges[lp_slot];
}

bool CMSC_gt_PanelUIUpdate_Func (bool testConds, bool runActions) {
    bool lv_hasAbility;
    int lv_slot;

    if ((runActions == false)) {
        return true;
    }
    if (((CMSC_gf_LoadPanelAbilities() == false)
        || (CMSC_gf_PanelUIHookup() == false))) {
        return true;
    }
    CMSC_gf_PanelUIUpdatePosition();

    lv_hasAbility = false;
    lv_slot = 1;
    while ((lv_slot <= CMSC_PANEL_ABILITY_MAX)) {
        if ((CMSC_PanelAbilityExists(lv_slot) == true)) {
            if ((CMSC_gv_PanelUIPreviousState[lv_slot] == CMSC_PANEL_STATE_NONE)) {
                libNtve_gf_SetDialogItemImage(
                    CMSC_gv_PanelUIIcon[lv_slot],
                    UserDataGetImagePath(
                        "CoopAIAbilities",
                        CMSC_gv_PanelAbility[lv_slot],
                        "Icon",
                        1
                    ),
                    PlayerGroupAll()
                );
            }
            lv_hasAbility = true;
        }
        CMSC_gf_PanelUIUpdateSlot(lv_slot);
        lv_slot += 1;
    }
    DialogControlSetVisible(CMSC_gv_PanelUI, PlayerGroupAll(), lv_hasAbility);
    return true;
}

bool CMSC_RegisterHero (int lp_player, string lp_unitType) {
    if ((CMSC_gf_PlayerIsValid(lp_player) == false)) {
        return false;
    }
    if (((lp_unitType == null) || (lp_unitType == ""))) {
        return false;
    }
    if (((CMSC_CommanderOwner() != 0)
        && (CMSC_CommanderOwner() != lp_player))) {
        return false;
    }
    if (((CMSC_gv_HeroUnitType != "")
        && (CMSC_gv_HeroUnitType != lp_unitType))) {
        return false;
    }

    CMSC_gv_CommanderOwner = lp_player;
    CMSC_gv_HeroUnitType = lp_unitType;
    return true;
}

bool CMSC_RegisterAIHero (int lp_player) {
    string lv_aiCommander;
    string lv_heroUnitType;

    if ((CMSC_gf_PlayerIsValid(lp_player) == false)) {
        return false;
    }

    lv_aiCommander = libCOMI_gv_cM_CoopAIPlayer_Commander[lp_player];
    if (((lv_aiCommander == null) || (lv_aiCommander == ""))) {
        return false;
    }

    lv_heroUnitType = UserDataGetGameLink(
        "CoopAICommanders",
        lv_aiCommander,
        "AIHero",
        1
    );
    if (((lv_heroUnitType == null) || (lv_heroUnitType == ""))) {
        return false;
    }
    return CMSC_RegisterHero(lp_player, lv_heroUnitType);
}

string CMSC_HeroUnitType (int lp_player) {
    if (((CMSC_gf_PlayerIsValid(lp_player) == false)
        || (lp_player != CMSC_CommanderOwner()))) {
        return "";
    }
    return CMSC_gv_HeroUnitType;
}

unit CMSC_HeroUnit (int lp_player) {
    if (((CMSC_gf_PlayerIsValid(lp_player) == false)
        || (lp_player != CMSC_CommanderOwner()))) {
        return null;
    }
    return CMSC_gv_HeroUnit;
}

void CMSC_gf_RestoreHero (unit lp_hero) {
    if ((lp_hero == null)) {
        return;
    }

    UnitSetPropertyFixed(lp_hero, c_unitPropLifePercent, 100.0);
    UnitSetPropertyFixed(lp_hero, c_unitPropShieldsPercent, 100.0);
    UnitSetPropertyFixed(lp_hero, c_unitPropEnergyPercent, 100.0);
    UnitClearCooldowns(lp_hero, true);
}

unit CMSC_gf_CreateHero (int lp_player, point lp_spawnPoint) {
    unit lv_hero;

    libNtve_gf_CreateUnitsWithDefaultFacing(
        1,
        CMSC_gv_HeroUnitType,
        c_unitCreateIgnorePlacement,
        lp_player,
        lp_spawnPoint
    );
    lv_hero = UnitLastCreated();
    CMSC_gv_HeroUnit = lv_hero;
    CMSC_gf_RestoreHero(lv_hero);
    return lv_hero;
}

unit CMSC_gf_ReviveHero (int lp_player, point lp_spawnPoint) {
    unit lv_hero;

    lv_hero = CMSC_gv_HeroUnit;
    UnitRevive(lv_hero);
    UnitSetPosition(lv_hero, lp_spawnPoint, false);
    CMSC_gf_RestoreHero(lv_hero);
    return lv_hero;
}

unit CMSC_gf_HeroForAttackWave (int lp_player, point lp_spawnPoint) {
    unit lv_hero;

    if ((GameGetMissionTime() < CMSC_HERO_FIRST_WAVE_TIME)) {
        return null;
    }
    if ((CMSC_gf_PlayerIsValid(lp_player) == false)) {
        return null;
    }
    if ((lp_player != CMSC_CommanderOwner())) {
        return null;
    }
    if (((CMSC_gv_HeroUnitType == "")
        && (CMSC_RegisterAIHero(lp_player) == false))) {
        return null;
    }
    if ((lp_spawnPoint == null)) {
        return null;
    }

    lv_hero = CMSC_gv_HeroUnit;
    if ((lv_hero == null)) {
        return CMSC_gf_CreateHero(lp_player, lp_spawnPoint);
    }
    if (((UnitIsAlive(lv_hero) == false)
        && (CMSC_gv_RapidRecoveryPending == true))) {
        return null;
    }
    if ((UnitIsAlive(lv_hero) == false)) {
        return CMSC_gf_ReviveHero(lp_player, lp_spawnPoint);
    }
    return lv_hero;
}

bool CMSC_gf_NovaUnitIsArmy (unit lp_unit, bool lp_includeHero) {
    string lv_unitType;

    if (((lp_unit == null) || (UnitIsAlive(lp_unit) == false))) {
        return false;
    }
    lv_unitType = UnitGetType(lp_unit);
    if (((lv_unitType == "HellbatBlackOps")
        || (lv_unitType == "HellionBlackOps")
        || (lv_unitType == "Liberator_BlackOps")
        || (lv_unitType == "LiberatorAG_BlackOps")
        || (lv_unitType == "Marauder_BlackOps")
        || (lv_unitType == "Marine_BlackOps")
        || (lv_unitType == "Goliath_BlackOps")
        || (lv_unitType == "Ghost_BlackOps")
        || (lv_unitType == "GhostFemale_BlackOps")
        || (lv_unitType == "Raven_BlackOps")
        || (lv_unitType == "Banshee_BlackOps")
        || (lv_unitType == "SiegeTankSieged_BlackOps")
        || (lv_unitType == "SiegeTank_BlackOps"))) {
        return true;
    }
    return ((lp_includeHero == true) && (lv_unitType == "NovaCoop"));
}

bool CMSC_gf_NovaIsActive () {
    int lv_owner;

    lv_owner = CMSC_CommanderOwner();
    if ((lv_owner == 0)) {
        return false;
    }
    return libCOMI_gv_cM_CoopAIPlayer_Commander[lv_owner] == "TerranNova";
}

unitgroup CMSC_gf_NovaArmyGroupAt (point lp_center, fixed lp_radius, bool lp_includeHero) {
    int lv_owner;
    int lv_index;
    unit lv_unit;
    unitgroup lv_units;

    lv_owner = CMSC_CommanderOwner();
    lv_units = UnitGroupAlliance(
        lv_owner,
        c_unitAllianceAlly,
        RegionCircle(lp_center, lp_radius),
        UnitFilter(
            0,
            0,
            ((1 << c_targetFilterStructure) | (1 << c_targetFilterMissile)),
            ((1 << (c_targetFilterDead - 32))
                | (1 << (c_targetFilterHidden - 32))
                | (1 << (c_targetFilterInvulnerable - 32)))
        ),
        0
    );
    lv_index = UnitGroupCount(lv_units, c_unitCountAll);
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnit(lv_units, lv_index);
        if ((CMSC_gf_NovaUnitIsArmy(lv_unit, lp_includeHero) == false)) {
            UnitGroupRemove(lv_units, lv_unit);
        }
        lv_index -= 1;
    }
    return lv_units;
}

fixed CMSC_gf_NovaArmyAverageLife (unitgroup lp_units) {
    int lv_count;
    int lv_index;
    fixed lv_totalLife;

    lv_count = UnitGroupCount(lp_units, c_unitCountAlive);
    if ((lv_count <= 0)) {
        return 100.0;
    }

    lv_totalLife = 0.0;
    lv_index = 1;
    while ((lv_index <= lv_count)) {
        lv_totalLife += UnitGetPropertyFixed(
            UnitGroupUnit(lp_units, lv_index),
            c_unitPropLifePercent,
            c_unitPropCurrent
        );
        lv_index += 1;
    }
    return lv_totalLife / IntToFixed(lv_count);
}

bool CMSC_gf_NovaUnitBelongsToEnemyAI (unit lp_unit) {
    int lv_owner;

    if ((CMSC_gf_NovaUnitIsArmy(lp_unit, true) == false)) {
        return false;
    }
    lv_owner = CMSC_CommanderOwner();
    return PlayerGroupHasPlayer(
        PlayerGroupAlliance(c_playerGroupAlly, lv_owner),
        UnitGetOwner(lp_unit)
    );
}

bool CMSC_gt_NovaUnitDamaged_Func (bool testConds, bool runActions) {
    int lv_owner;
    int lv_targetPlayer;
    int lv_index;
    int lv_count;
    int lv_attempt;
    unit lv_damagedUnit;
    unit lv_damageSource;
    unit lv_targetUnit;
    unit lv_unit;
    unit lv_caster;
    unit lv_airstrikeTargeter;
    unit lv_griffin;
    unitgroup lv_nearbyArmy;
    unitgroup lv_transportUnits;
    unitgroup lv_targetUnits;
    unitgroup lv_visibleTargetUnits;
    point lv_startPoint;
    point lv_destination;
    point lv_unitDestination;
    fixed lv_distance;
    fixed lv_angle;

    if ((runActions == false)) {
        return true;
    }
    if ((CMSC_gf_NovaIsActive() == false)) {
        return true;
    }

    lv_owner = CMSC_CommanderOwner();
    lv_damagedUnit = EventUnit();
    if ((CMSC_gf_NovaUnitBelongsToEnemyAI(lv_damagedUnit) == false)) {
        return true;
    }

    lv_caster = CMSC_PanelCaster();
    if ((lv_caster == null)) {
        return true;
    }
    lv_nearbyArmy = CMSC_gf_NovaArmyGroupAt(UnitGetPosition(lv_damagedUnit), 12.0, true);

    if (((CMSC_PanelAbilityCanUse(lv_owner, CMSC_NOVA_ABILITY_DEFENSIVE_DRONE) == true)
        && (CMSC_gf_NovaArmyAverageLife(lv_nearbyArmy) <= 90.0)
        && (UnitCountAlliance(
            lv_owner,
            c_unitAllianceEnemy,
            RegionCircle(UnitGetPosition(lv_damagedUnit), 12.0),
            UnitFilter(0, 0, (1 << c_targetFilterMissile),
                ((1 << (c_targetFilterDead - 32))
                    | (1 << (c_targetFilterHidden - 32))
                    | (1 << (c_targetFilterInvulnerable - 32)))),
            0
        ) >= 1))) {
        if ((CMSC_PanelAbilityConsume(lv_owner, CMSC_NOVA_ABILITY_DEFENSIVE_DRONE) == true)) {
            UnitCreateEffectPoint(lv_caster, "NovaDefensiveMatrixDrone", UnitGetPosition(lv_damagedUnit));
            if (((TechTreeUpgradeCount(1, "SuperCommanderEnable", c_techCountQueuedOrBetter) == 1)
                || (TechTreeUpgradeCount(2, "SuperCommanderEnable", c_techCountQueuedOrBetter) == 1))) {
                if ((GameGetMissionTime() >= 720.0)) {
                    UnitCreateEffectPoint(lv_caster, "NovaGadgetDefensiveDroneSummonCU", UnitGetPosition(lv_damagedUnit));
                }
                if ((GameGetMissionTime() >= 1200.0)) {
                    UnitCreateEffectPoint(lv_caster, "NovaStunDrone", UnitGetPosition(lv_damagedUnit));
                }
            }
        }
    }

    lv_damageSource = EventUnitDamageSourceUnit();
    if (((lv_damageSource != null)
        && (UnitIsAlive(lv_damageSource) == true)
        && (CMSC_PanelAbilityCanUse(lv_owner, CMSC_NOVA_ABILITY_GRIFFIN_AIRSTRIKE) == true)
        && (UnitCountAlliance(
            lv_owner,
            c_unitAllianceEnemy,
            RegionCircle(UnitGetPosition(lv_damageSource), 12.0),
            UnitFilter(0, 0, (1 << c_targetFilterMissile),
                ((1 << (c_targetFilterDead - 32))
                    | (1 << (c_targetFilterHidden - 32))
                    | (1 << (c_targetFilterInvulnerable - 32)))),
            0
        ) >= 3))) {
        if ((CMSC_PanelAbilityConsume(lv_owner, CMSC_NOVA_ABILITY_GRIFFIN_AIRSTRIKE) == true)) {
            lv_startPoint = PointWithOffsetPolar(
                UnitGetPosition(lv_damageSource),
                -6.0,
                UnitGetFacing(lv_damageSource) + RandomFixed(0.0, 90.0)
            );
            UnitCreate(
                1,
                "NovaGriffinBombingRunTargeter",
                c_unitCreateIgnorePlacement,
                lv_owner,
                lv_startPoint,
                AngleBetweenPoints(lv_startPoint, UnitGetPosition(lv_damageSource))
            );
            lv_airstrikeTargeter = UnitLastCreated();
            UnitCreateEffectPoint(
                lv_airstrikeTargeter,
                "NovaGriffinBombingRunInitialSet",
                UnitGetPosition(lv_damageSource)
            );
        }
    }

    if (((CMSC_PanelAbilityCanUse(lv_owner, CMSC_NOVA_ABILITY_GRIFFIN_TRANSPORT) == false)
        || (CMSC_gf_NovaArmyAverageLife(lv_nearbyArmy) > 90.0)
        || (UnitGroupCount(lv_nearbyArmy, c_unitCountAlive) < 3)
        || (RandomInt(1, 5) != 1))) {
        return true;
    }

    lv_targetPlayer = EventUnitDamageSourcePlayer();
    if ((PlayerGroupHasPlayer(libCOOC_gf_CommanderPlayers(), lv_targetPlayer) == false)) {
        return true;
    }
    lv_targetUnits = UnitGroup(
        null,
        lv_targetPlayer,
        RegionPlayableMap(),
        UnitFilter(0, 0, ((1 << c_targetFilterStructure) | (1 << c_targetFilterMissile)),
            ((1 << (c_targetFilterDead - 32))
                | (1 << (c_targetFilterHidden - 32))
                | (1 << (c_targetFilterInvulnerable - 32)))),
        0
    );
    lv_visibleTargetUnits = UnitGroupEmpty();
    lv_count = UnitGroupCount(lv_targetUnits, c_unitCountAlive);
    lv_index = 1;
    while ((lv_index <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_targetUnits, lv_index);
        if (((lv_unit != null)
            && (libNtve_gf_UnitIsVisibleToPlayer(lv_unit, lv_owner) == true))) {
            UnitGroupAdd(lv_visibleTargetUnits, lv_unit);
        }
        lv_index += 1;
    }
    lv_targetUnit = UnitGroupRandomUnit(lv_visibleTargetUnits, c_unitCountAlive);
    if ((lv_targetUnit == null)) {
        return true;
    }

    lv_startPoint = UnitGetPosition(lv_damagedUnit);
    lv_destination = null;
    lv_attempt = 1;
    while ((lv_attempt <= 8)) {
        lv_unitDestination = RegionRandomPoint(
            RegionCircle(UnitGetPosition(lv_targetUnit), 6.0)
        );
        if (((PointPathingPassable(lv_unitDestination) == true)
            && (VisIsVisibleForPlayer(lv_owner, lv_unitDestination) == true))) {
            lv_destination = lv_unitDestination;
            break;
        }
        lv_attempt += 1;
    }
    if ((lv_destination == null)) {
        return true;
    }
    lv_transportUnits = CMSC_gf_NovaArmyGroupAt(lv_startPoint, 13.0, false);
    if ((UnitGroupCount(lv_transportUnits, c_unitCountAlive) < 3)) {
        return true;
    }
    if ((CMSC_PanelAbilityConsume(lv_owner, CMSC_NOVA_ABILITY_GRIFFIN_TRANSPORT) == false)) {
        return true;
    }

    lv_angle = AngleBetweenPoints(lv_startPoint, lv_destination);
    UnitCreate(
        1,
        "NovaGriffinTransportUnit",
        c_unitCreateIgnorePlacement,
        lv_owner,
        lv_startPoint,
        lv_angle
    );
    lv_griffin = UnitLastCreated();
    libCOMI_gf_PingMinimapCampaign(PlayerGroupAll(), lv_destination, 2.0, Color(0.00, 100.00, 100.00));
    Wait(CMSC_PanelAbilityActivationDelay(CMSC_NOVA_ABILITY_GRIFFIN_TRANSPORT), c_timeGame);
    lv_distance = DistanceBetweenPoints(lv_startPoint, lv_destination);
    if (((lv_griffin != null) && (UnitIsAlive(lv_griffin) == true))) {
        UnitBehaviorAddPlayer(lv_griffin, "Griffin_TeleportOut_COOP", lv_owner, 1);
        UnitSetPosition(lv_griffin, lv_destination, false);
    }
    lv_count = UnitGroupCount(lv_transportUnits, c_unitCountAll);
    lv_index = 1;
    while ((lv_index <= lv_count)) {
        lv_unit = UnitGroupUnit(lv_transportUnits, lv_index);
        if (((lv_unit != null) && (UnitIsAlive(lv_unit) == true))) {
            lv_unitDestination = PointWithOffsetPolar(UnitGetPosition(lv_unit), lv_distance, lv_angle);
            if ((PointPathingPassable(lv_unitDestination) == false)) {
                lv_unitDestination = lv_destination;
            }
            UnitSetPosition(lv_unit, lv_unitDestination, false);
            UnitSetPropertyFixed(
                lv_unit,
                c_unitPropLifePercent,
                MinF(UnitGetPropertyFixed(lv_unit, c_unitPropLifePercent, c_unitPropCurrent) + 10.0, 100.0)
            );
            UnitBehaviorAddPlayer(lv_unit, "GhostMengskSuperCloak", lv_owner, 1);
            UnitCreateEffectUnit(lv_unit, "NovaGriffinTransportUnhideUnitsSet", lv_unit);
        }
        lv_index += 1;
    }
    Wait(0.667, c_timeGame);
    if (((lv_griffin != null) && (UnitIsAlive(lv_griffin) == true))) {
        UnitBehaviorAddPlayer(
            lv_griffin,
            "NovaGriffinTransportUnloadUnitsDespawnDelay",
            lv_owner,
            1
        );
    }
    return true;
}

bool CMSC_gt_NovaHeroDied_Func (bool testConds, bool runActions) {
    int lv_owner;
    unit lv_hero;
    unitgroup lv_nearbyArmy;

    if ((runActions == false)) {
        return true;
    }
    if ((CMSC_gf_NovaIsActive() == false)) {
        return true;
    }

    lv_owner = CMSC_CommanderOwner();
    lv_hero = EventUnit();
    if (((lv_hero == null)
        || (lv_hero != CMSC_gv_HeroUnit)
        || (UnitGetOwner(lv_hero) != lv_owner))) {
        return true;
    }
    lv_nearbyArmy = CMSC_gf_NovaArmyGroupAt(UnitGetPosition(lv_hero), 12.0, false);
    if ((UnitGroupCount(lv_nearbyArmy, c_unitCountAlive) < 1)) {
        return true;
    }
    if ((CMSC_PanelAbilityConsume(lv_owner, CMSC_NOVA_ABILITY_RAPID_RECOVERY) == false)) {
        return true;
    }

    CMSC_gv_RapidRecoveryPending = true;
    Wait(CMSC_PanelAbilityActivationDelay(CMSC_NOVA_ABILITY_RAPID_RECOVERY), c_timeGame);
    if ((UnitIsAlive(lv_hero) == false)) {
        CMSC_gf_PanelAbilityPlayUseVoice(CMSC_NOVA_ABILITY_RAPID_RECOVERY);
        SoundPlayAtPoint(
            SoundLink("NovaAC_Instant_Revive", c_soundIndexAny),
            PlayerGroupAll(),
            UnitGetPosition(lv_hero),
            0.0,
            100.0,
            0.0
        );
        SoundPlayAtPoint(
            SoundLink("NovaAC_Instant_Revive_High", c_soundIndexAny),
            PlayerGroupAll(),
            UnitGetPosition(lv_hero),
            0.0,
            100.0,
            0.0
        );
        SoundPlayAtPoint(
            SoundLink("NovaAC_Instant_Revive_Low", c_soundIndexAny),
            PlayerGroupAll(),
            UnitGetPosition(lv_hero),
            0.0,
            100.0,
            0.0
        );
        SoundPlayAtPoint(
            SoundLink("NovaAC_Instant_Revive_Rear", c_soundIndexAny),
            PlayerGroupAll(),
            UnitGetPosition(lv_hero),
            0.0,
            100.0,
            0.0
        );
        UnitBehaviorAdd(lv_hero, "TargetedRevive", CMSC_PanelCaster(), 1);
        UnitRevive(lv_hero);
        CMSC_gf_RestoreHero(lv_hero);
        AISetUnitScriptControlled(lv_hero, false);
    }
    CMSC_gv_RapidRecoveryPending = false;
    return true;
}

bool CMSC_AttackWaveAddHero (
    int lp_attackingPlayer,
    unitgroup lp_attackForce,
    point lp_spawnPoint,
    int lp_attackTargetType
) {
    int lv_player;
    point lv_spawnPoint;
    unit lv_hero;

    lv_player = CMSC_CommanderOwner();
    if ((lv_player == 0)) {
        return false;
    }
    if ((PlayerGroupHasPlayer(
        PlayerGroupAlliance(c_playerGroupAlly, lv_player),
        lp_attackingPlayer
    ) == false)) {
        return false;
    }
    if ((lp_attackTargetType == libCOMI_ge_CM_CoopAI_WaveAttackTargetType_Special)) {
        return false;
    }
    if ((lp_attackForce == null)) {
        return false;
    }

    lv_spawnPoint = lp_spawnPoint;
    if (((lv_spawnPoint == null)
        && (UnitGroupCount(lp_attackForce, c_unitCountAlive) > 0))) {
        lv_spawnPoint = UnitGetPosition(UnitGroupUnit(lp_attackForce, 1));
    }
    if ((lv_spawnPoint == null)) {
        lv_spawnPoint = PlayerStartLocation(lv_player);
    }
    lv_hero = CMSC_gf_HeroForAttackWave(lv_player, lv_spawnPoint);
    if ((lv_hero == null)) {
        return false;
    }

    AISetUnitScriptControlled(lv_hero, false);
    UnitGroupAdd(lp_attackForce, lv_hero);
    return true;
}

bool CMSC_gt_AttackWave_Func (bool testConds, bool runActions) {
    if ((runActions == false)) {
        return true;
    }

    CMSC_AttackWaveAddHero(
        libCOMU_gf_CM_AttackWaveHookAttackForce2(),
        libCOMU_gf_CM_AttackWaveHookAttackForce(),
        libCOMU_gf_CM_AttackWaveHookSpawnLocation(),
        libCOMU_gf_CM_AttackWaveHookAttackTargetType()
    );
    return true;
}

void CMSC_Init () {
    if ((CMSC_gt_AttackWave != null)) {
        return;
    }
    CMSC_gt_AttackWave = TriggerCreate("CMSC_gt_AttackWave_Func");
    libCOMU_gf_CM_AttackWaveHook(CMSC_gt_AttackWave);
    CMSC_gt_NovaUnitDamaged = TriggerCreate("CMSC_gt_NovaUnitDamaged_Func");
    TriggerAddEventUnitDamaged(
        CMSC_gt_NovaUnitDamaged,
        null,
        c_unitDamageTypeAny,
        c_unitDamageEither,
        null
    );
    CMSC_gt_NovaHeroDied = TriggerCreate("CMSC_gt_NovaHeroDied_Func");
    TriggerAddEventUnitDied(CMSC_gt_NovaHeroDied, null);
    CMSC_gt_PanelUIUpdate = TriggerCreate("CMSC_gt_PanelUIUpdate_Func");
    TriggerAddEventTimePeriodic(CMSC_gt_PanelUIUpdate, 0.25, c_timeGame);
}
