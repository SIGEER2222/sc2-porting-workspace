include "TriggerLibs/natives"
include "LibMapModBridge_h"

// === LibMapModBridge: 通用 map-mod 桥接层实现 ===
// 通用 API 实现，不依赖任何特定 mod 库
// 各 mod adapter 在合适时机调用这些 API

// ==== BEGIN VIBE_KERNEL_003_HANDLE_CACHE (mirror of LibVibeKernel) ====
// InitMap 同步阶段 BankLoad 可能返回 null；若每次无条件 BankLoad 会把已拿到的
// 有效 handle 覆盖成 null，并且 BankLastCreated() 会回退到最近一次成功加载的
// bank（常是内核的 GalaxyVibe），导致 CMRERebornDebug 标记静默丢失/误写别处。
// 改用专属缓存 handle + BankWait，与 LibVibeKernel 完全一致。缓存语义自带重试：
// handle 为 null 时每次调用都会再 BankLoad，所以早期拿不到≠永远拿不到。
void libMapModBridge_gf_EnsureDebugBankLoaded() {
    if (libMapModBridge_gv_debugBankHandle == null) {
        libMapModBridge_gv_debugBankHandle = BankLoad("CMRERebornDebug", 1);
        if (libMapModBridge_gv_debugBankHandle != null) {
            BankWait(libMapModBridge_gv_debugBankHandle);
        }
    }
}
// ==== END VIBE_KERNEL_003_HANDLE_CACHE ====

void libMapModBridge_gf_WriteDebugBank(string key, int value) {
    libMapModBridge_gf_EnsureDebugBankLoaded();
    if (libMapModBridge_gv_debugBankHandle == null) { return; }
    BankValueSetFromInt(libMapModBridge_gv_debugBankHandle, "debug", key, value);
    BankSave(libMapModBridge_gv_debugBankHandle);
}

int libMapModBridge_gf_AliveUnitCount(string unitType, int player) {
    unitgroup lv_units;
    if ((unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, unitType))) { return 0; }
    lv_units = UnitGroup(unitType, player, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    return UnitGroupCount(lv_units, c_unitCountAlive);
}

void libMapModBridge_gf_CreateStartingUnits(int player, string structureType, string workerType, int workerCount) {
    point lv_start = PlayerStartLocation(player);
    point lv_base = null;
    unitgroup lv_structures;
    unit lv_structure;
    int lv_i = 0;
    int lv_existingStructures = 0;
    int lv_existingWorkers = 0;
    int lv_workersToCreate = 0;
    int lv_removedVanilla = 0;
    int lv_reused = 0;
    if (lv_start == null) { return; }
    if (workerCount <= 0) { workerCount = 5; }

    // CMRE/Reborn maps may already have a melee opening when the adapter runs.
    // Remove only the six canonical base/worker types when replacing them with a
    // commander-specific opening; mission units and production remain untouched.
    if (structureType != "CommandCenter") { lv_removedVanilla += libMapModBridge_gf_RemoveAllUnitsOfType(player, "CommandCenter"); }
    if (structureType != "Nexus") { lv_removedVanilla += libMapModBridge_gf_RemoveAllUnitsOfType(player, "Nexus"); }
    if (structureType != "Hatchery") { lv_removedVanilla += libMapModBridge_gf_RemoveAllUnitsOfType(player, "Hatchery"); }
    if (workerType != "SCV") { lv_removedVanilla += libMapModBridge_gf_RemoveAllUnitsOfType(player, "SCV"); }
    if (workerType != "Probe") { lv_removedVanilla += libMapModBridge_gf_RemoveAllUnitsOfType(player, "Probe"); }
    if (workerType != "Drone") { lv_removedVanilla += libMapModBridge_gf_RemoveAllUnitsOfType(player, "Drone"); }

    lv_existingStructures = libMapModBridge_gf_AliveUnitCount(structureType, player);
    if (lv_existingStructures > 0) {
        lv_reused = 1;
        lv_structures = UnitGroup(structureType, player, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile),
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_structure = UnitGroupUnit(lv_structures, 1);
        if (lv_structure != null) { lv_base = UnitGetPosition(lv_structure); }
    }
    if (lv_base == null) { lv_base = lv_start; }

    // Create the commander base only when the expected base is absent.
    if (lv_existingStructures == 0) {
        UnitCreate(1, structureType, c_unitCreateIgnorePlacement, player, lv_base, 270.0);
    }

    // Top up the expected worker count instead of creating a second opening.
    lv_existingWorkers = libMapModBridge_gf_AliveUnitCount(workerType, player);
    lv_workersToCreate = workerCount - lv_existingWorkers;
    for (lv_i = 0; lv_i < lv_workersToCreate; lv_i += 1) {
        UnitCreate(1, workerType, c_unitCreateIgnorePlacement, player,
            PointWithOffsetPolar(lv_base, 3.0, (IntToFixed(lv_existingWorkers + lv_i) * 30.0)), 270.0);
    }

    libMapModBridge_gf_WriteDebugBank("bridge_starting_units_removed_vanilla_p" + IntToString(player), lv_removedVanilla);
    libMapModBridge_gf_WriteDebugBank("bridge_starting_units_reused_p" + IntToString(player), lv_reused);
    if (player == 1) {
        libMapModBridge_gv_startingUnitsCreatedP1 = 1;
        libMapModBridge_gf_WriteDebugBank("bridge_starting_units_created_p1", 1);
    } else if (player == 2) {
        libMapModBridge_gv_startingUnitsCreatedP2 = 1;
        libMapModBridge_gf_WriteDebugBank("bridge_starting_units_created_p2", 1);
    }
}

void libMapModBridge_gf_EnsurePreventDefeat(int player, string structureType) {
    point lv_start = null;
    // 检查是否已有 PreventDefeat 单位（避免重复创建）
    unitgroup lv_existing = UnitGroup(null, player, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterPreventDefeat), 0, 0,
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    if (UnitGroupCount(lv_existing, c_unitCountAlive) > 0) {
        // 已有 PreventDefeat 单位，记录状态并跳过
        if (player == 1) {
            libMapModBridge_gv_preventDefeatEnsuredP1 = 1;
            libMapModBridge_gf_WriteDebugBank("bridge_prevent_defeat_p1", 1);
        } else if (player == 2) {
            libMapModBridge_gv_preventDefeatEnsuredP2 = 1;
            libMapModBridge_gf_WriteDebugBank("bridge_prevent_defeat_p2", 1);
        }
        return;
    }

    // CreateStartingUnits may have just ensured the requested commander base.
    // Do not place a second base at the same start location merely because the
    // catalog unit does not carry PreventDefeat in this map composition.
    if (libMapModBridge_gf_AliveUnitCount(structureType, player) > 0) {
        if (player == 1) {
            libMapModBridge_gv_preventDefeatEnsuredP1 = 1;
            libMapModBridge_gf_WriteDebugBank("bridge_prevent_defeat_p1", 1);
        } else if (player == 2) {
            libMapModBridge_gv_preventDefeatEnsuredP2 = 1;
            libMapModBridge_gf_WriteDebugBank("bridge_prevent_defeat_p2", 1);
        }
        return;
    }

    // 没有 PreventDefeat 单位，创建一个
    lv_start = PlayerStartLocation(player);
    if (lv_start == null) { return; }
    UnitCreate(1, structureType, c_unitCreateIgnorePlacement, player, lv_start, 270.0);

    if (player == 1) {
        libMapModBridge_gv_preventDefeatEnsuredP1 = 1;
        libMapModBridge_gf_WriteDebugBank("bridge_prevent_defeat_created_p1", 1);
    } else if (player == 2) {
        libMapModBridge_gv_preventDefeatEnsuredP2 = 1;
        libMapModBridge_gf_WriteDebugBank("bridge_prevent_defeat_created_p2", 1);
    }
}

int libMapModBridge_gf_RemoveAllUnitsOfType(int player, string unitType) {
    unitgroup lv_units;
    int lv_count;
    int lv_i;
    if (unitType == "") { return 0; }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, unitType)) { return 0; }
    lv_units = UnitGroup(unitType, player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    lv_count = UnitGroupCount(lv_units, c_unitCountAll);
    for (lv_i = lv_count; lv_i >= 1; lv_i -= 1) {
        UnitRemove(UnitGroupUnit(lv_units, lv_i));
    }
    return lv_count;
}

void libMapModBridge_InitLib() {
    if (libMapModBridge_gv_initialized) { return; }
    libMapModBridge_gv_startingUnitsCreatedP1 = 0;
    libMapModBridge_gv_startingUnitsCreatedP2 = 0;
    libMapModBridge_gv_preventDefeatEnsuredP1 = 0;
    libMapModBridge_gv_preventDefeatEnsuredP2 = 0;
    libMapModBridge_gv_heartbeat = 0;
    libMapModBridge_gv_initialized = true;
}

// === 心跳触发器 ===
// 每 2 秒（实时）递增心跳计数器并写入银行
// 使用 c_timeReal，即使游戏暂停（GameSetMissionTimePaused(true)）也会递增
// launcher 通过读取心跳值判断 Galaxy 脚本是否正在运行
// 如果心跳不变 → 脚本卡住（可能崩溃或死锁）
// 如果心跳递增 + world_cover_dialog_visible_p1=1 → 黑屏（世界覆盖层可见）
// 如果心跳递增 + world_cover_dialog_visible_p1=0 → 正常
bool libMapModBridge_gt_Heartbeat_Func(bool testConds, bool runActions) {
    if (testConds) { return true; }
    if (!runActions) { return true; }
    while (true) {
        libMapModBridge_gv_heartbeat = libMapModBridge_gv_heartbeat + 1;
        libMapModBridge_gf_WriteDebugBank("bridge_heartbeat", libMapModBridge_gv_heartbeat);
        Wait(2.0, c_timeReal);
    }
    return true;
}

void libMapModBridge_gf_StartHeartbeat() {
    if (libMapModBridge_gt_Heartbeat != null) { return; }
    libMapModBridge_gt_Heartbeat = TriggerCreate("libMapModBridge_gt_Heartbeat_Func");
    TriggerExecute(libMapModBridge_gt_Heartbeat, false, true);
    libMapModBridge_gf_WriteDebugBank("bridge_heartbeat_started", 1);
}
