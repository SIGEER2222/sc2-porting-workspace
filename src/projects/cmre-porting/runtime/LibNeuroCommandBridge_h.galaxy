// CMRE command bridge for NeuroIntegration Bank IPC.
//
// The action is intentionally map-agnostic: a caller supplies a player-one
// unit type, an ability id, and a whitespace-separated target point ("x y").
// This lets Neuro issue normal move/attack/build/cast point orders without
// requiring the official SC2 API websocket.

include "TriggerLibs/natives"
include "LibEFA54406_h"

void libNeuroCommandBridge_InitLib();
