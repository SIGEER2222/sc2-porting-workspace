{
  "vm": "vibe-debug/1",
  "mode": "debug",
  "steps": [
    {
      "op": "call",
      "fn": "vibe.unit.spawn_group",
      "args": {"unit_type": "Marine", "count": 3, "player": 1},
      "save": "squad"
    },
    {
      "op": "assert",
      "source": "$vars.squad",
      "path": "created",
      "equals": 3
    },
    {
      "op": "foreach",
      "source": "$vars.squad.unit_tags",
      "item": "unit_tag",
      "steps": [
        {
          "op": "call",
          "fn": "vibe.unit.add_behavior",
          "args": {
            "unit_tag": "$vars.unit_tag",
            "behavior": "Conjoined",
            "stacks": 1
          }
        },
        {
          "op": "assert",
          "source": "$last",
          "path": "count",
          "equals": 1
        }
      ]
    },
    {
      "op": "call",
      "fn": "vibe.unit.query_behavior",
      "args": {
        "unit_tag": "$vars.unit_tag",
        "behavior": "Conjoined"
      },
      "save": "last_behavior"
    },
    {
      "op": "assert",
      "source": "$vars.last_behavior",
      "path": "has_behavior",
      "equals": true
    }
  ]
}
