{
  "schemaVersion": 1,
  "id": "cmre-porting",
  "goal": "Decompose the CMRE development package into maintainable commander, shared runtime, map-series, map, and commander-map packages without changing source behavior.",
  "sources": [
    {
      "sourceId": "cmre-dev-package",
      "path": ".",
      "role": "read-only-source-package"
    }
  ],
  "target": {
    "map": "all-cmre-mission-maps",
    "commander": "all-cmre-commanders",
    "series": "cmre-coop-missions"
  },
  "currentStage": "15-ai-ally-vibe-application",
  "writeScope": [
    "src/projects/cmre-porting/project.json",
    "src/projects/cmre-porting/stages/14-vibe-operator-workflow/**",
    "src/projects/cmre-porting/stages/15-ai-ally-vibe-application/**",
    "src/projects/cmre-porting/vibe/**",
    "tools/galaxy-vibe/vibe.ps1",
    "tools/galaxy-vibe/workflow_status.py",
    "tools/galaxy-vibe/run-all-validation.ps1",
    "tools/galaxy-vibe/galaxy_repl.py",
    "tools/galaxy-vibe/launch-galaxy-vibe.ps1",
    "tools/galaxy-vibe/evidence_bundle.py",
    "tools/galaxy-vibe/summarize_verdict.py",
    "tools/launchers/launch-cmre-alenger.ps1",
    "tools/launchers/lib/cmre-on-demand-overlay.ps1",
    "tools/launchers/overlays/cmre-alenger/startup/**",
    "tools/launchers/tests/test_launch_cmre_alenger_static.py",
    ".agents/skills/**",
    "artifacts/projects/cmre-porting/stage14-vibe-operator-workflow/**",
    "artifacts/projects/cmre-porting/stage15-ai-ally-vibe-application/**",
    "artifacts/galaxy-vibe/**"
  ],
  "acceptance": [
    "Every source map and mod has a stable logical owner and declared dependency chain.",
    "Commander-specific Catalog and Galaxy content is separated from reusable runtime behavior.",
    "Mission-owned initialization, objectives, rewards, and scripting remain map-owned.",
    "Every extracted composition passes static validation and required in-game runtime validation."
  ]
}
