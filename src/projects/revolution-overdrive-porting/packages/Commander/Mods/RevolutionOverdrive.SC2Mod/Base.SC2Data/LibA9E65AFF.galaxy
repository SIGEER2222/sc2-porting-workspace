//--------------------------------------------------------------------------------------------------
// Trigger: Global Salvage
//--------------------------------------------------------------------------------------------------
bool libA9E65AFF_gt_GlobalSalvage_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((TechTreeUpgradeCount(libA9E65AFF_gv_player01, "WarpStabilizers", c_techCountQueuedOrBetter) == 1)) {
        PlayerModifyPropertyFixed(1, c_playerPropMinerals, c_playerPropOperAdd, (UnitTypeGetCost(EventPlayerEffectUsedUnitType(c_effectUnitCaster), c_unitCostMinerals) * 1.0));
        PlayerModifyPropertyFixed(1, c_playerPropVespene, c_playerPropOperAdd, (UnitTypeGetCost(EventPlayerEffectUsedUnitType(c_effectUnitCaster), c_unitCostVespene) * 1.0));
    }
    else {
        PlayerModifyPropertyFixed(1, c_playerPropMinerals, c_playerPropOperAdd, (UnitTypeGetCost(EventPlayerEffectUsedUnitType(c_effectUnitCaster), c_unitCostMinerals) * 0.5));
        PlayerModifyPropertyFixed(1, c_playerPropVespene, c_playerPropOperAdd, (UnitTypeGetCost(EventPlayerEffectUsedUnitType(c_effectUnitCaster), c_unitCostVespene) * 0.5));
    }
    return true;
}

