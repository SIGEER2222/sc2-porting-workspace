bool libA9E65AFF_gt_BankCheats_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((EventChatMessage(false) == "-DeleteAll")) {
        UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
        UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/lib_A9E65AFF_C7E5C55F"));
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_forlornCommandCenterInvestigatedString, false);
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_kMCSchematicsString, false);
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_junkerCalldownImprovementsString, false);
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_rangedRepairString, false);
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_autoRefineryString, false);
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_techReactorString, false);
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_safeHavenCompleteString, false);
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_havensFallCompleteString, false);
        BankSave(libA9E65AFF_gv_bonusBank);
        TriggerSendEvent("EndGameBackup");
