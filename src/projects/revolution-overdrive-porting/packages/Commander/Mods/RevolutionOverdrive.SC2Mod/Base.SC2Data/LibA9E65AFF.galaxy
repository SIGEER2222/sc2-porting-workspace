//--------------------------------------------------------------------------------------------------
// Trigger: Open Upgrade Bank
//--------------------------------------------------------------------------------------------------
bool libA9E65AFF_gt_OpenUpgradeBank_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad(libA9E65AFF_gv_bankName, 1);
    libA9E65AFF_gv_bonusBank = BankLastCreated();
    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_forlornCommandCenterInvestigatedString) == false)) {
        BankRestore(libA9E65AFF_gv_bonusBank, 1, BankBackupGetLatestId(libA9E65AFF_gv_bonusBank));
    }

    Wait(1.0, c_timeGame);
    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_forlornCommandCenterInvestigatedString) == true)) {
        TechTreeUpgradeAddLevel(1, "AdvancedConstruction", 1);
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_blinkSuitsString) == true)) {
        TechTreeUpgradeAddLevel(1, "BlinkSuitsReal", 1);
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_rangedRepairString) == true)) {
        TechTreeUpgradeAddLevel(1, "RangedRepair", 1);
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_junkerCalldownImprovementsString) == true)) {
        TechTreeUpgradeAddLevel(1, "JunkerCalldownImprovements", 1);
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_kMCSchematicsString) == true)) {
        TechTreeUpgradeAddLevel(1, "FireSuppressionSystems", 1);
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_autoRefineryString) == true)) {
        TechTreeUpgradeAddLevel(1, "AutoHarvester", 1);
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_techReactorString) == true)) {
        TechTreeUpgradeAddLevel(1, "TechReactor", 1);
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_herolessModeEnabledString) == true) && (libWoLC_gf_CurrentMap() != "TValerian01")) {
        TechTreeUpgradeAddLevel(1, "HerolessMode", 1);
    }

    BankBackup(libA9E65AFF_gv_bonusBank, 1);
    BankSave(libA9E65AFF_gv_bonusBank);
    return true;
}

