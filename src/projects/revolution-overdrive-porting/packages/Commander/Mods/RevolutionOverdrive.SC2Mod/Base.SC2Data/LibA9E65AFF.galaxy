//--------------------------------------------------------------------------------------------------
// Trigger: Hero Charges Init
//--------------------------------------------------------------------------------------------------
bool libA9E65AFF_gt_HeroChargesInit_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    PlayerModifyPropertyInt(1, c_playerPropTerrazine, c_playerPropOperAdd, 1);
    TechTreeAbilityAllow(1, AbilityCommand("TValerian02aHeroCommonAbil2", 0), false);
    TechTreeAbilityAllow(1, AbilityCommand("TValerian02aHeroCommonAbil3", 0), false);
    TechTreeAbilityAllow(1, AbilityCommand("TValerian02aHeroCommonAbil4", 0), false);
    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_herolessModeEnabledString) == true)) {
        PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 215);
    }

    if ((libWoLC_gf_NumberOfMissions(libWoLC_ge_MissionCountOptions_Completed) >= 9)) {
        PlayerModifyPropertyInt(1, c_playerPropTerrazine, c_playerPropOperAdd, 1);
        if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_herolessModeEnabledString) == true)) {
            PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 230);
        }

    }

    if ((libWoLC_gf_NumberOfMissions(libWoLC_ge_MissionCountOptions_Completed) >= 16)) {
        PlayerModifyPropertyInt(1, c_playerPropTerrazine, c_playerPropOperAdd, 1);
        if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_herolessModeEnabledString) == true)) {
            PlayerModifyPropertyInt(1, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 250);
        }

    }

    Wait(2.0, c_timeGame);
    if ((TechTreeUpgradeCount(libA9E65AFF_gv_player01, "HerolessMode", c_techCountQueuedOrBetter) >= 1) && (TechTreeUpgradeCount(libA9E65AFF_gv_player01, "TemplarTrainingNew", c_techCountQueuedOrBetter) >= 1)) {
        PlayerModifyPropertyInt(1, c_playerPropTerrazine, c_playerPropOperAdd, 1);
        TechTreeUpgradeAddLevel(1, "TemplarTrainingHeroless", 1);
    }

    if ((TechTreeUpgradeCount(libA9E65AFF_gv_player01, "HerolessMode", c_techCountQueuedOrBetter) >= 1) && (TechTreeUpgradeCount(libA9E65AFF_gv_player01, "NerazimInsight", c_techCountQueuedOrBetter) >= 1)) {
        TechTreeUpgradeAddLevel(1, "NerazimInsightHeroless", 1);
    }

    return true;
}

