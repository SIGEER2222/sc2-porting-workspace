    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_customTransmissionsString) == true)) {
        libNtve_gf_SendTransmissionSimple(TransmissionSourceFromModel(lp_portraitModel), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), null, SoundLengthSync(lp_audio), c_transmissionDurationAdd, false);
        TransmissionSendForPlayerSelect(PlayerGroupAll(), TransmissionSource(), c_invalidPortraitId, "", "", null, lp_sender, lp_message, SoundLengthSync(lp_audio), c_transmissionDurationSet, false, c_maxPlayers, false);
    }
    else {
        libNtve_gf_SendTransmissionSimple(TransmissionSourceFromModel(lp_portraitModel), libNtve_gf_CinematicPortrait(libNtve_ge_CinematicPortraitPosition_CenterLeft), lp_audio, SoundLengthSync(lp_audio), c_transmissionDurationAdd, false);
