//--------------------------------------------------------------------------------------------------
// Trigger: Reveal Intro Dialog
//--------------------------------------------------------------------------------------------------
bool libA9E65AFF_gt_RevealIntroDialog_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventDialogControl() == libA9E65AFF_gv_openButton))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libA9E65AFF_gt_GenerateIntroDialog, true, false);
    DialogDestroy(libA9E65AFF_gv_tipDialog);
    return true;
}

//--------------------------------------------------------------------------------------------------
