//--------------------------------------------------------------------------------------------------
// Trigger: Script-Builts
//--------------------------------------------------------------------------------------------------
bool libA9E65AFF_gt_ScriptBuilts_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGroupHasUnit(libA9E65AFF_gv_scriptBuildingsWaves, EventUnit()) == true) || (UnitGroupHasUnit(libA9E65AFF_gv_scriptBuildingsSuicide, EventUnit()) == true)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupHasUnit(libA9E65AFF_gv_scriptBuildingsWaves, EventUnit()) == true)) {
        libNtve_gf_AICast(EventUnitProgressUnit(), OrderTargetingPoint(AbilityCommand("attack", 0), PlayerStartLocation(UnitGetOwner(EventUnitProgressUnit()))));
        AIAttackWaveUseUnit(UnitGetOwner(EventUnitProgressUnit()), EventUnitProgressUnit());
        return true;
    }

    if ((UnitGroupHasUnit(libA9E65AFF_gv_scriptBuildingsSuicide, EventUnit()) == true)) {
        AISetUnitSuicide(EventUnitProgressUnit(), true);
    }

    return true;
}

