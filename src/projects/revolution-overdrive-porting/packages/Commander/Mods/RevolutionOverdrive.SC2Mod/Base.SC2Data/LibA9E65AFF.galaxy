    libA9E65AFF_gt_RevealIntroDialog = TriggerCreate("libA9E65AFF_gt_RevealIntroDialog_Func");
    TriggerAddEventDialogControl(libA9E65AFF_gt_RevealIntroDialog, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Generate Intro Dialog
//--------------------------------------------------------------------------------------------------
bool libA9E65AFF_gt_GenerateIntroDialog_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    GameSetSpeedValue(c_gameSpeedSlower);
    GameSetSpeedValue(c_gameSpeedSlower);
    GameSetSpeedValue(c_gameSpeedSlower);
    DialogCreate(700, 800, c_anchorTop, 50, 50, true);
    libA9E65AFF_gv_infoDialog = DialogLastCreated();
    DialogSetVisible(libA9E65AFF_gv_infoDialog, PlayerGroupAll(), true);
    libNtve_gf_CreateDialogItemLabel(libA9E65AFF_gv_infoDialog, 625, 600, c_anchorTop, 0, 50, libA9E65AFF_gv_dialogContent, ColorWithAlpha(0,0,0,0), true, 2.0);
    DialogControlSetVisible(DialogControlLastCreated(), PlayerGroupAll(), true);
    libNtve_gf_CreateDialogItemButton(libA9E65AFF_gv_infoDialog, 200, 50, c_anchorBottom, 0, 50, StringExternal("Param/Value/lib_A9E65AFF_86F4C1C4"), StringExternal("Param/Value/lib_A9E65AFF_E98B7811"), "");
    libA9E65AFF_gv_closeButton = DialogControlLastCreated();
    DialogControlSetVisible(libA9E65AFF_gv_closeButton, PlayerGroupAll(), true);
    return true;
}

