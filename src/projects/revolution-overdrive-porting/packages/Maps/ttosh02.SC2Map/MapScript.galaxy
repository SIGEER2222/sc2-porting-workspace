void gt_SCViskilledwhileharvesting_Init () {
    gt_SCViskilledwhileharvesting = TriggerCreate("gt_SCViskilledwhileharvesting_Func");
    TriggerAddEventUnitDied(gt_SCViskilledwhileharvesting, null);
}

