//--------------------------------------------------------------------------------------------------
// Trigger: Objective - Relic Update
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveRelicUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "ProtossRelic"))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnitTargetUnit()) == gv_p1_USER))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libWCMI_gf_DisplayMissionObjectiveRewardFloatingText(UnitGetPosition(EventUnit()), "TTosh02_3");
    UnitKill(EventUnit());
    TriggerExecute(gt_ObjectiveRelicsCreateQ, true, false);
    gv_bonusObjectiveCollectRelicsFound += 1;
    libWCMI_gf_SetMissionObjectiveProgress("TTosh02_3", gv_bonusObjectiveCollectRelicsFound);
    if ((gv_bonusObjectiveCollectRelicsFound == 2)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "BlindingFlare", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/474CAA16"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_bonusObjectiveCollectRelicsFound == gv_bonusObjectiveCollectRelicsNeeded)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "WardenAOEMissiles", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/2495575F"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
        libWCMI_gf_ZS_SetMissionObjectiveState("TTosh02_3", libWoLC_ge_MissionObjectiveState_Completed);
    }

    return true;
}

