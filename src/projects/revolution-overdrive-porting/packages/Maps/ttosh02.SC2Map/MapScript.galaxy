//--------------------------------------------------------------------------------------------------
// Trigger: Wave Shadow FX
//--------------------------------------------------------------------------------------------------
bool gt_WaveShadowFX_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((UnitGetOwner(EventUnit()) == gv_p10_VOIDSHADESRIGHT) || (UnitGetOwner(EventUnit()) == gv_p11_VOIDSHADESLEFT) || (UnitGetOwner(EventUnit()) == gv_p12_VOIDSHADESTOP) || (UnitGetOwner(EventUnit()) == gv_p13_VOIDSHADESDEVOURER)))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), EventPlayer(), UnitFilter((1 << c_targetFilterMissile), 0, 0, 0)) == false))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "VoidRiftUnselectable"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "VoidThrasher"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_ApplyShadowManifestationFX(EventUnit());
    return true;
}

