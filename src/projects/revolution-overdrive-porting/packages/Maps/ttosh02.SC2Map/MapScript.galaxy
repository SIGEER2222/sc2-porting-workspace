    VisRevealArea(1, RegionCircle(UnitGetPosition(UnitFromId(404560428)), 1.0), 4.0, false);
    VisRevealArea(1, RegionCircle(UnitGetPosition(UnitFromId(1785924948)), 1.0), 4.0, false);
