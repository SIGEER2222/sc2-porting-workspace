//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    AICampaignStart(gv_p2_PROTOSS_EAST_ATTACKERS);
    gf_AscendantBehaviour(UnitFromId(267105522));
    gf_AscendantBehaviour(UnitFromId(1785924948));
    gf_AscendantBehaviour(UnitFromId(404560428));
    gf_StaticVoidThrasherAINew(UnitFromId(1513155442), 0);
    AICampaignStart(gv_p3_PROTOSS_SCRIPTED);
    AICampaignStart(gv_p4_PROTOSS_WEST_ESCORTS);
    AICampaignStart(gv_p6_FORWARDGUARD);
    AICampaignStart(gv_p7_DEATHFLEET);
    AICampaignStart(gv_p8_TOSH);
    AICampaignStart(gv_p10_VOIDSHADESRIGHT);
    AICampaignStart(gv_p11_VOIDSHADESLEFT);
    AICampaignStart(gv_p12_VOIDSHADESTOP);
    AICampaignStart(gv_p13_VOIDSHADESDEVOURER);
    TriggerExecute(libA9E65AFF_gt_UpgradeController, true, false);
    TriggerExecute(libA9E65AFF_gt_RunProtossAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(gt_P2AttackWaves, true, false);
    TriggerExecute(gt_P3PatrolWaves, true, false);
    TriggerExecute(gt_P6AttackWaves, true, false);
    TriggerExecute(gt_P7AttackWaves, true, false);
    TriggerExecute(gt_NorthernVoidRiftHarass, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    TriggerExecute(gt_AITerrazineSealingI, true, false);
    AIAttackWaveSetGatherPoint(gv_p4_PROTOSS_WEST_ESCORTS, PointFromId(272));
    return true;
}

