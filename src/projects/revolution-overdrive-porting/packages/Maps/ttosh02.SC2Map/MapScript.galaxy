    gt_WaveShadowFX = TriggerCreate("gt_WaveShadowFX_Func");
    TriggerAddEventUnitRegion(gt_WaveShadowFX, null, RegionPlayableMap(), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Terrazine Guardian Destroyed
//--------------------------------------------------------------------------------------------------
bool gt_TerrazineGuardianDestroyed_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_ascendant;
    unit lv_shrine;
    unit lv_voidRift;

    // Automatic Variable Declarations
    unit auto91897392_val;
    unitgroup autoCDC0EE8C_g;
    int autoCDC0EE8C_u;
    unit autoCDC0EE8C_var;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!(((UnitGetType(EventPlayerEffectUsedUnit(c_effectUnitCaster)) == "TerrazineTempleNESW") || (UnitGetType(EventPlayerEffectUsedUnit(c_effectUnitCaster)) == "TerrazineTempleNWSE")))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    Wait(0.0625, c_timeAI);
    TriggerEnable(TriggerGetCurrent(), true);
    PingDestroy(libHots_gf_PingStoredForUnit(EventPlayerEffectUsedUnit(c_effectUnitCaster), 1));
    UnitKill(EventPlayerEffectUsedUnit(c_effectUnitCaster));
    auto91897392_val = EventPlayerEffectUsedUnit(c_effectUnitCaster);
    if (auto91897392_val == UnitFromId(214927422)) {
        lv_ascendant = UnitFromId(404560428);
        lv_voidRift = UnitFromId(1707844490);
    }
    else if (auto91897392_val == UnitFromId(302874827)) {
        lv_ascendant = UnitFromId(267105522);
        lv_voidRift = UnitFromId(192627442);
    }
    else if (auto91897392_val == UnitFromId(973666062)) {
        lv_ascendant = UnitFromId(1785924948);
        lv_voidRift = UnitFromId(1774824596);
    }
    else {
    }
    AISetUnitScriptControlled(lv_ascendant, true);
    Wait(0.0625, c_timeAI);
    UnitKill(lv_ascendant);
    Wait(2.0, c_timeGame);
    VisRevealArea(1, RegionCircle(UnitGetPosition(lv_voidRift), 5.0), 8.0, false);
    MinimapPing(PlayerGroupAll(), UnitGetPosition(lv_voidRift), 5.0, Color(100.00, 0.00, 0.00));
    UnitKill(lv_voidRift);
    autoCDC0EE8C_g = UnitGroup(null, UnitGetOwner(lv_voidRift), RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoCDC0EE8C_u = UnitGroupCount(autoCDC0EE8C_g, c_unitCountAll);
    for (;; autoCDC0EE8C_u -= 1) {
        autoCDC0EE8C_var = UnitGroupUnitFromEnd(autoCDC0EE8C_g, autoCDC0EE8C_u);
        if (autoCDC0EE8C_var == null) { break; }
        if ((UnitHasBehavior2(autoCDC0EE8C_var, "VoidShade") == true)) {
            UnitKill(autoCDC0EE8C_var);
        }

    }
    return true;
}

