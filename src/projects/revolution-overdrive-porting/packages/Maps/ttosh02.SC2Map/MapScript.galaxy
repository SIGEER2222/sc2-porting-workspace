    if (!runActions) {
        return true;
    }

    CinematicFade(false, 0.0, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, false);
    libNtve_gf_CinematicMode(true, PlayerGroupAll(), 0.0);
    libNtve_gf_GlobalCinematicSetting(true);
    libWCMI_gf_SendActorMessageToDoodadsInRegion("Signal WorkStart", "Slayn_TerrazineGeyser", RegionEntireMap());
    gv_waypointArrayAttackers[0] = PointFromId(922334820);
    gv_waypointArrayAttackers[1] = PointFromId(1290727763);
    gv_waypointArrayAttackers[2] = PointFromId(1285273766);
    TriggerExecute(libA9E65AFF_gt_GenerateTopBar, true, true);
    TriggerExecute(gt_StartAI, true, false);
    Wait(0.1, c_timeGame);
    libWCMI_gf_SetWorkerRallyPointforNexus2(UnitFromId(9));
    libWCMI_gf_StartingWorkersAutoHarvest(RegionFromId(46), RegionFromId(25));
    UIAlertPoint("Trigger", gv_p1_USER, StringExternal("Param/Value/20E5CE1C"), null, PointFromId(10));
    libNtve_gf_CinematicMode(false, PlayerGroupAll(), 1.5);
    libNtve_gf_GlobalCinematicSetting(false);
    libNtve_gf_SwooshCamera(gv_p1_USER, ((CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance)) + 8.0), CameraInfoGetValue(CameraInfoDefault(), c_cameraValueDistance), PlayerStartLocation(gv_p1_USER), 1.5);
    CinematicFade(true, 1.5, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, true);
    TriggerEnable(gt_ToshSetup, true);
    TriggerEnable(gt_ToshExpo, true);
    TriggerEnable(gt_PlayerExpo, true);
    TriggerEnable(gt_ToshExpo2, true);
    TriggerExecute(gt_StartGame, true, false);
    return true;
}

