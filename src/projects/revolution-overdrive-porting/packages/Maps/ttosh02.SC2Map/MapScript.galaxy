    gt_ProtosssealingterrazineQ = TriggerCreate("gt_ProtosssealingterrazineQ_Func");
    TriggerAddEventUnitAbility(gt_ProtosssealingterrazineQ, null, AbilityCommand("ProbeHarvest", 0), c_abilHarvestStageHarvest, false);
}

