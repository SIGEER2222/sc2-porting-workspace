    libA9E65AFF_gf_GenerateTipPopup(StringExternal("Param/Value/FB1AC6CA"));
    Wait(3.0, c_timeReal);
    TriggerExecute(gt_PrimaryObjectiveCollectTerrazineCreateQ, true, true);
    Wait(8.0, c_timeReal);
    TriggerExecute(gt_GoliathandGatherTerrazineTipsQ, true, false);
    Wait(4.0, c_timeGame);
    TriggerExecute(gt_ObjectiveRelicsCreateQ, true, true);
    Wait(8.0, c_timeReal);
    TriggerExecute(gt_ObjectiveDevourerCreateQ, true, true);
    return true;
}

