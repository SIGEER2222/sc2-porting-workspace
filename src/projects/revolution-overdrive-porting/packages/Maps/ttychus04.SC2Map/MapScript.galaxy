//--------------------------------------------------------------------------------------------------
// Trigger: Research Objective Protoss Relics Update
//--------------------------------------------------------------------------------------------------
bool gt_ResearchObjectiveProtossRelicsUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "ProtossRelic"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_ResearchObjectiveProtossRelicsCreateQ, true, false);
    libWCMI_gf_DisplayMissionObjectiveRewardFloatingText(UnitGetPosition(EventUnit()), "TTychus04_3");
    UnitKill(EventUnit());
    gv_protossRelicsFound += 1;
    libWCMI_gf_SetMissionObjectiveProgress("TTychus04_3", gv_protossRelicsFound);
    if ((gv_protossRelicsFound == 2)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "SHAREDPROCESSINGMODULE", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/6215212D"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_protossRelicsFound == gv_protossRelicsTotal)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "H9TargetingModule", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/ED85DCF1"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
        TriggerExecute(gt_ResearchObjectiveProtossRelicsComplete, true, false);
    }

    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/BCF087BC"));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ResearchObjectiveProtossRelicsUpdate_Init () {
    gt_ResearchObjectiveProtossRelicsUpdate = TriggerCreate("gt_ResearchObjectiveProtossRelicsUpdate_Func");
    TriggerAddEventUnitAbility(gt_ResearchObjectiveProtossRelicsUpdate, null, AbilityCommand("Pickup", 0), c_unitAbilStageExecute, false);
}

