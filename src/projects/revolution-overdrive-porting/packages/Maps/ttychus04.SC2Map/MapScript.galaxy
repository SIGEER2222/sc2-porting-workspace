    libA9E65AFF_gf_SendFlexibleAttackWave("Zealot", 300, 8, lv_aI, 60, true);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddUnits4(8, 8, 10, 12, "Zealot");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Oracle");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Adept");
        AIAttackWaveAddUnits4(2, 2, 3, 3, "SentryAiur");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "DarkArchon");
        libA9E65AFF_gf_SendFlexibleAttackWave("Zealot", 240, 8, lv_aI, 90, true);
        AIAttackWaveAddUnits4(8, 8, 10, 12, "Zealot");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Oracle");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "StalkerShakuras");
        AIAttackWaveAddUnits4(2, 2, 3, 3, "SentryAiur");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "DarkArchon");
        libA9E65AFF_gf_SendFlexibleAttackWave("Zealot", 240, 8, lv_aI, 90, true);
        AIAttackWaveAddUnits4(1, 1, 2, 3, "HighArchonTemplar");
        AIAttackWaveAddUnits4(2, 2, 3, 3, "SentryAiur");
        AIAttackWaveAddUnits4(5, 5, 6, 8, "Archon");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Oracle");
        libA9E65AFF_gf_SendFlexibleAttackWave("Zealot", 300, 8, lv_aI, 60, true);
    }
    return true;
}

