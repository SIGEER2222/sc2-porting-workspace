        PlayerSetState(auto610FB68C_var, c_playerStateVespeneCostIgnored, true);
        TechTreeAbilityAllow(auto610FB68C_var, AbilityCommand("UpgradeToWarpGate", 0), false);
    }
    libNtve_gf_SetPlayerGroupAlliance(libA9E65AFF_gv_enemyPlayers, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    AISetGeneralRebuildCount(libNtve_gf_DifficultyValueInt(99, 99, 99, 99), true, gv_pLAYER02_FLEET);
    AISetGeneralRebuildCount(libNtve_gf_DifficultyValueInt(99, 99, 99, 99), false, gv_pLAYER02_FLEET);
    libNtve_gf_SetAlliance(gv_pLAYER01_USER, gv_pLAYER08_DEATHSUN, libNtve_ge_AllianceSetting_EnemyWithSharedVision);
    libWCMI_gf_WM_DetectionUpgradesApply();
    return true;
}

