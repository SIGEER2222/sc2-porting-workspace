    libNtve_gf_PlayerApplySkinReplacingExistingUnit(gv_pLAYER03_FORWARDGUARD, "TaldarimCampaignSkin", true);
    libNtve_gf_PlayerApplySkinReplacingExistingUnit(gv_pLAYER04_PHASESMITHS, "TaldarimCampaignSkin", true);
