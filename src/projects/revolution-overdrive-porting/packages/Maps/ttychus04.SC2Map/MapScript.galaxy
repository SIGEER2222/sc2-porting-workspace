//--------------------------------------------------------------------------------------------------
// Trigger: Worsen Weather over time
//--------------------------------------------------------------------------------------------------
bool gt_WorsenWeatherovertime_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    gv_residueCount += 20;
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    gv_residueCount += 20;
    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    gv_residueCount += 20;
    Wait(300.0, c_timeGame);
    gv_residueCount += 20;
    return true;
}

