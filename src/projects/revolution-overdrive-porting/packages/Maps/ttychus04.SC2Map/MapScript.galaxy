        if (auto9286583A_var == null) { break; }
        UnitSetPropertyFixed(auto9286583A_var, c_unitPropEnergyPercent, 100.0);
    }
    UIAlertPoint("Trigger", gv_pLAYER01_USER, StringExternal("Param/Value/3A99EA37"), null, PointFromId(13));
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeResourcePanel, true);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeSupply, true);
    UnitBehaviorAddPlayer(gv_artifactVault, "InvulnerabilityShield", gv_pLAYER02_FLEET, 1);
    auto07443E28_g = gv_artifactGuardianGroup;
    auto07443E28_u = UnitGroupCount(auto07443E28_g, c_unitCountAll);
    for (;; auto07443E28_u -= 1) {
        auto07443E28_var = UnitGroupUnitFromEnd(auto07443E28_g, auto07443E28_u);
        if (auto07443E28_var == null) { break; }
        libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingSimple", UnitGetPosition(auto07443E28_var), ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
        PingSetScale(PingLastCreated(), 0.7);
        PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/D36A1886"));
        PingSetUnit(PingLastCreated(), auto07443E28_var);
        libHots_gf_StorePingForUnit(auto07443E28_var, 1, PingLastCreated());
    }
    TriggerExecute(libA9E65AFF_gt_UpgradeController, true, false);
    TriggerEnable(gt_DefeatBaseDead, true);
    TriggerEnable(gt_ArtifactProtectionRemover, true);
    TriggerEnable(gt_RemoveResources, true);
    TriggerEnable(gt_MainTimerExpires, true);
    TriggerEnable(gt_BonusTimerExpires, true);
    Wait(3.0, c_timeGame);
    TriggerExecute(gt_ObjectiveDestroytheArtifactVaultCreateQ, true, false);
    TriggerExecute(gt_ArtifactVaultPing, true, false);
    TriggerExecute(gt_SolarStormSpawns, true, false);
    TriggerExecute(gt_BurningResidueSpawns, true, false);
    TriggerExecute(gt_MassEjectionSpawns, true, false);
    TriggerExecute(gt_WorsenWeatherovertime, true, false);
    Wait(8.0, c_timeGame);
    TimerStart(gv_vaultDestructionTimer, gv_mainQuestTimeLimit, false, c_timeGame);
    gv_vaultDestructionTimer = TimerLastStarted();
    libWCUI_gf_TimerWindowCreate(TimerLastStarted(), StringExternal("Param/Value/16F3802C"), true, false);
    TimerWindowSetColor(TimerWindowLastCreated(), c_timerWindowColorBackground, Color(0.00, 50.20, 0.00), 0.0);
