    PlayerGroupAdd(libA9E65AFF_gv_enemyPlayers, gv_pLAYER03_FORWARDGUARD);
    PlayerGroupAdd(libA9E65AFF_gv_enemyPlayers, gv_pLAYER04_PHASESMITHS);
    PlayerGroupAdd(libA9E65AFF_gv_enemyPlayers, gv_pLAYER07_SCIONS);
    PlayerGroupAdd(libA9E65AFF_gv_enemyPlayers, gv_pLAYER09_BULLIES);
    auto610FB68C_g = libA9E65AFF_gv_enemyPlayers;
    auto610FB68C_var = -1;
    while (true) {
        auto610FB68C_var = PlayerGroupNextPlayer(auto610FB68C_g, auto610FB68C_var);
        if (auto610FB68C_var < 0) { break; }
        libNtve_gf_SetAlliance(auto610FB68C_var, libA9E65AFF_gv_player01, libNtve_ge_AllianceSetting_Enemy);
        libNtve_gf_SetAlliance(auto610FB68C_var, gv_pLAYER08_DEATHSUN, libNtve_ge_AllianceSetting_Enemy);
