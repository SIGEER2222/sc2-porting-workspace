//--------------------------------------------------------------------------------------------------
// Trigger: Victory
//--------------------------------------------------------------------------------------------------
bool gt_Victory_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_bonusComplete == true)) {
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_autoRefineryString, true);
    }

    BankSave(libA9E65AFF_gv_bonusBank);
    TriggerSendEvent("EndGameBackup");
    if ((ObjectiveGetState(gv_objectiveOvermindTendrils) == c_objectiveStateCompleted) && (ObjectiveGetState(gv_objectivePowerTheObelisks) == c_objectiveStateCompleted)) {
        libWoLC_gf_CampaignAwardAchievement("TZeratul03_1");
    }

    if ((libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1) && (UnitGetPropertyFixed(gv_zeratul, c_unitPropKills, c_unitPropCurrent) >= 50.0)) {
        libWoLC_gf_CampaignAwardAchievement("TZeratul03_2");
    }

    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1) && (TimerGetRemaining(gv_achievementHardTimer) != 0.0)) {
        libWoLC_gf_CampaignAwardAchievement("TZeratul03_3");
    }

    VictoryPanelAddAchievement("TZeratul03_1");
    VictoryPanelAddAchievement("TZeratul03_2");
    VictoryPanelAddAchievement("TZeratul03_3");
    VictoryPanelAddTrackedStatistic("UnitsKilledCount");
    VictoryPanelAddTrackedStatistic("UnitsTotalCount");
    VictoryPanelAddTrackedStatistic("UnitsLostCount");
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/58FF8B12"), IntToText(gv_allyKills));
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/AA8F352E"), (IntToText(gv_obelisksPowered) + StringExternal("Param/Value/4757F4D8") + StringExternal("Param/Value/BDB2696E")));
    libWCMI_gf_EndCampaignMission(gv_p01_USER, c_gameOverVictory);
    return true;
}

