//--------------------------------------------------------------------------------------------------
// Trigger: Handle Zeratul Death
//--------------------------------------------------------------------------------------------------
bool gt_HandleZeratulDeath_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_duration;
    unit lv_nexus;
    unit lv_beacon;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_duration = 60;
    lv_nexus = UnitGroupClosestToPoint(UnitGroup(null, gv_p01_USER, RegionEntireMap(), UnitFilter((1 << c_targetFilterPreventReveal), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), PointFromId(24));

    // Conditions
    if (testConds) {
        if (!((libNtve_gf_TriggeringProgressUnitType() == "Zeratul"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_zeratul = EventUnitProgressUnit();
    Kit_UIHeroPanel_SetHeroUnit(0, gv_zeratul, "Assets\\Textures\\zeratul_ingame_heroportrait.dds");
    libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Warning, StringExternal("Param/Value/EB1FF18F"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_HandleZeratulDeath_Init () {
    gt_HandleZeratulDeath = TriggerCreate("gt_HandleZeratulDeath_Func");
    TriggerAddEventUnitTrainProgress(gt_HandleZeratulDeath, null, c_unitProgressStageComplete);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Rain Cycling
//--------------------------------------------------------------------------------------------------
bool gt_RainCycling_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    while (true) {
        Wait(RandomFixed(180.0, 240.0), c_timeGame);
        libNtve_gf_PlayAnimationOnDoodadsInRegion(RegionEntireMap(), "RainEmitterMedium", c_animNameDefault, "Death", c_animFlagPlayForever | c_animFlagNonLooping, c_animTimeDefault);
        gv_rainOn = false;
        Wait(RandomFixed(180.0, 240.0), c_timeGame);
        libNtve_gf_PlayAnimationOnDoodadsInRegion(RegionEntireMap(), "RainEmitterMedium", c_animNameDefault, "Stand", 0, c_animTimeDefault);
        gv_rainOn = true;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_RainCycling_Init () {
    gt_RainCycling = TriggerCreate("gt_RainCycling_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Change Owner of Zeratul
//--------------------------------------------------------------------------------------------------
bool gt_ChangeOwnerofZeratul_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "VoidSeeker"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(gv_zeratul, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1520)), c_orderQueueReplace);
    Wait(0.5, c_timeGame);
    UnitSetOwner(gv_zeratul, gv_p01_USER, true);
    UnitFlashSelection(gv_zeratul, 1.0);
    UnitSelect(gv_zeratul, gv_p01_USER, true);
    UnitIssueOrder(gv_zeratul, OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(1520)), c_orderQueueReplace);
