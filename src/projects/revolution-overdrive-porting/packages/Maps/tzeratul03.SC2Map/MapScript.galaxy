//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libA9E65AFF_gt_RunProtossAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    AICampaignStart(gv_p02_ZERG_LOW_GROUND_AI);
    AICampaignStart(gv_p03_ZERG_NORTH);
    AICampaignStart(gv_p04_ZERG_EAST);
    AICampaignStart(gv_p07_INFESTED);
    AICampaignStart(gv_p09_Frenzied);
    AICampaignStart(gv_p14_LIBRARIANS);
    return true;
}

