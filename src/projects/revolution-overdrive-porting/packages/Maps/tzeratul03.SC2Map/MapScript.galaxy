    TechTreeUpgradeAddLevel(gv_p03_ZERG_NORTH, lp_upgrade, lp_qty);
    TechTreeUpgradeAddLevel(gv_p04_ZERG_EAST, lp_upgrade, lp_qty);
    TechTreeUpgradeAddLevel(gv_p05_ZERG_LOW_GROUND_NOAI, lp_upgrade, lp_qty);
}

