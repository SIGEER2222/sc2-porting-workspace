// Trigger: Apply Pacify to Zeratul
//--------------------------------------------------------------------------------------------------
bool gt_ApplyPacifytoZeratul_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
