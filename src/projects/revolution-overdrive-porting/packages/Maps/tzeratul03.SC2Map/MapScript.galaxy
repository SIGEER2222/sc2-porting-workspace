bool gt_Init01Technology_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("CyberneticsCoreResearch", 6), false);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("UpgradeToWarpGate", 0), false);
    TechTreeUnitAllow(gv_p01_USER, "Zealot", true);
    TechTreeUnitAllow(gv_p01_USER, "HighTemplar", true);
    TechTreeUnitAllow(gv_p01_USER, "Archon", true);
    TechTreeUnitAllow(gv_p01_USER, "DarkTemplar", true);
    TechTreeUnitAllow(gv_p01_USER, "Stalker", true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("Blink", 0), true);
    TechTreeUnitAllow(gv_p01_USER, "Sentry", true);
    TechTreeUpgradeAddLevel(gv_p01_USER, "VoidSentryShieldRepair", 1);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("VoidSentryShieldRepair", 0), true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ForceField", 0), true);
    libWoLC_gf_EnableCampaignTechUnit(true, "Zeratul", 1);
    if ((TechTreeUpgradeCount(libA9E65AFF_gv_player01, "HerolessMode", c_techCountQueuedOrBetter) != 1)) {
        TechTreeUpgradeAddLevel(gv_p01_USER, "WisdomoftheNerazim", 1);
        libA9E65AFF_gf_UpdateCommandCard("Zeratul");
    }
    else {
        TechTreeAbilityAllow(1, AbilityCommand("HeroSelection", 15), false);
    }
    TechTreeUnitAllow(gv_p01_USER, "Immortal", true);
    TechTreeUnitAllow(gv_p01_USER, "Observer", true);
    TechTreeUnitAllow(gv_p01_USER, "Colossus", true);
    TechTreeUpgradeAddLevel(gv_p01_USER, "ExtendedThermalLance", 1);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ForgeResearch", 6), true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ForgeResearch", 0), true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ForgeResearch", 3), true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ForgeResearch", 7), true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ForgeResearch", 1), true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ForgeResearch", 4), true);
    TechTreeAbilityAllow(gv_p01_USER, AbilityCommand("ProtossBuild", 24), false);
    TechTreeAbilityAllow(gv_p10_ABANDONED_STRUCTURES, AbilityCommand("SummonMercenaries", 13), false);
    gf_AddUpgradeForEnemies(1, "Burrow");
    gf_AddUpgradeForEnemies(1, "overlordtransport");
    TechTreeUpgradeAddLevel(gv_p02_ZERG_LOW_GROUND_AI, "overlordspeed", 1);
    TechTreeUpgradeAddLevel(gv_p03_ZERG_NORTH, "overlordspeed", 1);
    TechTreeUpgradeAddLevel(gv_p04_ZERG_EAST, "overlordspeed", 1);
    TechTreeUpgradeAddLevel(11, "SOAAutoAssimilator", 1);
    return true;
}

