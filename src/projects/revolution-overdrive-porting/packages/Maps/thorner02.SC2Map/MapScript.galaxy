//--------------------------------------------------------------------------------------------------
// Trigger: Nuke Cycling
//--------------------------------------------------------------------------------------------------
bool gt_NukeCycling_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(60.0, c_timeGame);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("THorner02Orlan00013", 0)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner02Orlan00013", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    Wait(5.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(0, gv_p04_DOMINION, true);
    Wait(240.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(0, gv_p04_DOMINION, true);
    Wait(240.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(libNtve_gf_DifficultyValueInt(0, 0, 0, 1), gv_p04_DOMINION, true);
    Wait(240.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(libNtve_gf_DifficultyValueInt(0, 0, 1, 1), gv_p04_DOMINION, true);
    Wait(240.0, c_timeGame);
    while (true) {
        libA9E65AFF_gf_UseNukesRandom(libNtve_gf_DifficultyValueInt(0, 0, 1, 2), gv_p04_DOMINION, true);
        Wait(240.0, c_timeGame);
    }
    return true;
}

