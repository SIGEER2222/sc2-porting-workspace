//--------------------------------------------------------------------------------------------------
// Trigger: Create Contract Window
//--------------------------------------------------------------------------------------------------
bool gt_CreateContractWindow_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    DialogControlHookupStandard(c_triggerControlTypePanel, "UIContainer/ConsoleUIContainer/ContractWindow");
    gv_contractWindowRoot = DialogControlLastCreated();
    DialogControlHookup(gv_contractWindowRoot, c_triggerControlTypeLabel, "NameLabel");
    gv_contractWindowTitle = DialogControlLastCreated();
    TextExpressionSetToken("Param/Expression/F04E335C", "A", IntToText(gv_mERC_CONTRACT_PRICE));
    libNtve_gf_SetDialogItemText(gv_contractWindowTitle, TextExpressionAssemble("Param/Expression/F04E335C"), PlayerGroupAll());
    DialogControlHookup(gv_contractWindowRoot, c_triggerControlTypeImage, "RaynorBarImage");
    gv_contractWindowRaynorBar = DialogControlLastCreated();
    DialogControlHookup(gv_contractWindowRoot, c_triggerControlTypeLabel, "RaynorBarLabel");
    gv_contractWindowRaynorLabel = DialogControlLastCreated();
    DialogControlHookup(gv_contractWindowRoot, c_triggerControlTypeImage, "OrlanBarImage");
    gv_contractWindowOrlanBar = DialogControlLastCreated();
    DialogControlHookup(gv_contractWindowRoot, c_triggerControlTypeLabel, "OrlanBarLabel");
    gv_contractWindowOrlanLabel = DialogControlLastCreated();
    TriggerExecute(gt_UpdateContractWindow, true, true);
    DialogControlSetVisible(gv_contractWindowRoot, PlayerGroupAll(), true);
    SoundPlay(SoundLink("TUI_StarmapMenuPopup", -1), PlayerGroupAll(), 100.0, 0.0);
    TriggerEnable(gt_OrlanMineralCount, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_CreateContractWindow_Init () {
    gt_CreateContractWindow = TriggerCreate("gt_CreateContractWindow_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Update Contract Window
//--------------------------------------------------------------------------------------------------
bool gt_UpdateContractWindow_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_height;
    int lv_maxWidth;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_height = 20;
    lv_maxWidth = 280;

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TextExpressionSetToken("Param/Expression/8CF71F2C", "A", IntToText(PlayerGetPropertyInt(gv_p01_USER, c_playerPropMinerals)));
    libNtve_gf_SetDialogItemText(gv_contractWindowRaynorLabel, TextExpressionAssemble("Param/Expression/8CF71F2C"), PlayerGroupAll());
    TextExpressionSetToken("Param/Expression/CE70FF53", "A", IntToText(gv_oRLANS_MINERAL_COUNT));
    libNtve_gf_SetDialogItemText(gv_contractWindowOrlanLabel, TextExpressionAssemble("Param/Expression/CE70FF53"), PlayerGroupAll());
    if ((PlayerGetPropertyInt(gv_p01_USER, c_playerPropMinerals) > 0)) {
        DialogControlSetVisible(gv_contractWindowRaynorBar, PlayerGroupAll(), true);
        DialogControlSetSize(gv_contractWindowRaynorBar, PlayerGroupAll(), libNtve_gf_ArithmeticIntClamp(FixedToInt((lv_maxWidth * (PlayerGetPropertyFixed(gv_p01_USER, c_playerPropMinerals) / gv_mERC_CONTRACT_PRICE))), 1, lv_maxWidth), lv_height);
    }
    else {
        DialogControlSetVisible(gv_contractWindowRaynorBar, PlayerGroupAll(), false);
    }
    if ((gv_oRLANS_MINERAL_COUNT > 0)) {
        DialogControlSetVisible(gv_contractWindowOrlanBar, PlayerGroupAll(), true);
        DialogControlSetSize(gv_contractWindowOrlanBar, PlayerGroupAll(), libNtve_gf_ArithmeticIntClamp(FixedToInt((lv_maxWidth * (IntToFixed(gv_oRLANS_MINERAL_COUNT) / gv_mERC_CONTRACT_PRICE))), 1, lv_maxWidth), lv_height);
    }
    else {
        DialogControlSetVisible(gv_contractWindowOrlanBar, PlayerGroupAll(), false);
    }
    return true;
}

