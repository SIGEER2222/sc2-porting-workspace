//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto486E08F9_g;
    int auto486E08F9_var;
    unitgroup auto4801D79A_g;
    int auto4801D79A_u;
    unit auto4801D79A_var;

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(libA9E65AFF_gt_UpgradeController, true, false);
    auto486E08F9_g = libA9E65AFF_gv_enemyPlayers;
    auto486E08F9_var = -1;
    while (true) {
        auto486E08F9_var = PlayerGroupNextPlayer(auto486E08F9_g, auto486E08F9_var);
        if (auto486E08F9_var < 0) { break; }
        auto4801D79A_g = UnitGroup("Bunker", auto486E08F9_var, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        auto4801D79A_u = UnitGroupCount(auto4801D79A_g, c_unitCountAll);
        for (;; auto4801D79A_u -= 1) {
            auto4801D79A_var = UnitGroupUnitFromEnd(auto4801D79A_g, auto4801D79A_u);
            if (auto4801D79A_var == null) { break; }
            UnitCargoCreate(auto4801D79A_var, "Marine", 4);
            UnitCargoCreate(auto4801D79A_var, "Marauder", 1);
        }
    }
    AICampaignStart(gv_p02_ORLAN_ENEMY);
    AICampaignStart(gv_p03_MIRA_HAN);
    AICampaignStart(gv_p04_DOMINION);
    AICampaignStart(gv_p11_SCRAPPERS);
    AICampaignStart(gv_p12_RAIDERS);
    AICampaignStart(gv_p13_DEMOLISHERS);
    AICampaignStart(gv_p14_ARSONISTS);
    TriggerExecute(gt_OrlanP02InitialAttackWaves, true, false);
    TriggerExecute(gt_OrlanBonusSCVs, true, false);
    TriggerExecute(gt_P11AttackWaves, true, false);
    TriggerExecute(gt_P12AttackWaves, true, false);
    return true;
}

