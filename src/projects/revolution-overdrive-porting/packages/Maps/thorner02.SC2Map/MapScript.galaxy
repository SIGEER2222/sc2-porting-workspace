//--------------------------------------------------------------------------------------------------
bool gt_BottomRightGate_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_bridgeToExtend;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bridgeToExtend = UnitFromId(1998239941);

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitIsAlive(UnitFromId(957219431)) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libNtve_gf_PauseUnit(lv_bridgeToExtend, false);
    Wait(1.0, c_timeGame);
    MinimapPing(PlayerGroupAll(), UnitGetPosition(lv_bridgeToExtend), 6.0, Color(100.00, 0.00, 0.00));
    UnitIssueOrder(lv_bridgeToExtend, Order(AbilityCommand("DefensiveWall45GateEast", 0)), c_orderQueueReplace);
    UnitKill(UnitFromId(1998239941));
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/BFEBD25C"));
    return true;
}

