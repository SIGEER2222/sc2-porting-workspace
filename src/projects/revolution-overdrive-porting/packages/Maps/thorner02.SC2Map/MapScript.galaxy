    if ((UnitGroupCount(UnitGroup(lp_salvageType, gv_p05_SCRAP, lp_salvageRegion, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
