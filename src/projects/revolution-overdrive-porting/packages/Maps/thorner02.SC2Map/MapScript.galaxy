    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(lv_player, lv_bullyRegion, true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Barracks", lv_player, lv_bullyRegion, AbilityCommand("BarracksTrain", 5), libA9E65AFF_gv_scriptBuildingsWaves);
    return true;
}

