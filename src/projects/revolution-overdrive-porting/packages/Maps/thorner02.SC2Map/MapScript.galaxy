bool auto_gf_MakeGhostNuke_TriggerFunc (bool testConds, bool runActions) {
    unit lp_ghost = auto_gf_MakeGhostNuke_lp_ghost;

    // Variable Declarations
    unit lv_ghost;
    unitgroup lv_silos;
    unitgroup lv_closestTargets;
    unit lv_closestTarget;
    point lv_nukePoint;
    unitgroup lv_availableTargetsLocal;

    // Automatic Variable Declarations
    unitgroup autoF3FAE593_g;
    int autoF3FAE593_u;
    unit autoF3FAE593_var;

    // Variable Initialization
    lv_silos = UnitGroupEmpty();
    lv_closestTargets = UnitGroupEmpty();
    lv_availableTargetsLocal = UnitGroupEmpty();

    // Implementation
    lv_ghost = lp_ghost;
    UnitAbilityEnable(lv_ghost, "EMP", false);
    UnitAbilityEnable(lv_ghost, "ChannelSnipe", false);
    UnitAbilityEnable(lv_ghost, "Snipe", false);
    UnitGroupAdd(gv_nukers, lp_ghost);
    AISetUnitScriptControlled(lv_ghost, true);
    UnitGroupAddUnitGroup(lv_silos, UnitGroup("GhostAcademy", gv_p04_DOMINION, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0));
    autoF3FAE593_g = lv_silos;
    autoF3FAE593_u = UnitGroupCount(autoF3FAE593_g, c_unitCountAll);
    for (;; autoF3FAE593_u -= 1) {
        autoF3FAE593_var = UnitGroupUnitFromEnd(autoF3FAE593_g, autoF3FAE593_u);
        if (autoF3FAE593_var == null) { break; }
        UnitMagazineArm(autoF3FAE593_var, AbilityCommand("ArmSiloWithNuke", 0), 1);
    }
    libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, UnitGetPosition(lv_ghost), libNtve_gf_ConvertUnitToUnitGroup(lv_ghost), true, gv_p04_DOMINION);
    UnitIssueOrder(lv_ghost, Order(AbilityCommand("GhostCloak", 0)), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    lv_availableTargetsLocal = gv_availableTargets;
    lv_closestTarget = UnitGroupClosestToPoint(lv_availableTargetsLocal, UnitGetPosition(lp_ghost));
    UnitGroupAdd(lv_closestTargets, lv_closestTarget);
    UnitIssueOrder(lv_ghost, OrderTargetingPoint(AbilityCommand("TacNukeStrike", 0), RegionRandomPoint(RegionCircle(UnitGetPosition(UnitGroupRandomUnit(lv_closestTargets, c_unitCountAlive)), 1.0))), c_orderQueueReplace);
    Wait(1.0, c_timeGame);
    while (!(((UnitIsAlive(lv_ghost) == false) || (UnitOrderHasAbil(lv_ghost, "TacNukeStrike") == false)))) {
        Wait(0.5, c_timeGame);
    }
    UnitIssueOrder(lv_ghost, Order(AbilityCommand("TacNukeStrike", 1)), c_orderQueueReplace);
    UnitGroupRemove(gv_nukers, lp_ghost);
    Wait(0.75, c_timeGame);
    UnitIssueOrder(lv_ghost, Order(AbilityCommand("GhostCloak", 1)), c_orderQueueReplace);
    AISetUnitScriptControlled(lv_ghost, false);
    return true;
}

