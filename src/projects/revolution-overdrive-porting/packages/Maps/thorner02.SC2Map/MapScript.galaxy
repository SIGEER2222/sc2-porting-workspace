//--------------------------------------------------------------------------------------------------
// Trigger: Mira Expo 1
//--------------------------------------------------------------------------------------------------
bool gt_MiraExpo1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_bullyRegion;
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bullyRegion = RegionFromId(77);
    lv_player = gv_p03_MIRA_HAN;

    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(lv_player, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 0))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(lv_player, lv_bullyRegion, true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Barracks", lv_player, lv_bullyRegion, AbilityCommand("BarracksTrain", 1), libA9E65AFF_gv_scriptBuildingsWaves);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MiraExpo1_Init () {
    gt_MiraExpo1 = TriggerCreate("gt_MiraExpo1_Func");
    TriggerEnable(gt_MiraExpo1, false);
    TriggerAddEventTimePeriodic(gt_MiraExpo1, 5.0, c_timeGame);
}

