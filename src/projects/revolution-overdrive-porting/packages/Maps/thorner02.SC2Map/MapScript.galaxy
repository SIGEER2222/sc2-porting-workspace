}

trigger auto_gf_DropNuke_Trigger = null;
point auto_gf_DropNuke_lp_cHOSEN_POINT;

void gf_DropNuke (point lp_cHOSEN_POINT) {
    auto_gf_DropNuke_lp_cHOSEN_POINT = lp_cHOSEN_POINT;

    if (auto_gf_DropNuke_Trigger == null) {
        auto_gf_DropNuke_Trigger = TriggerCreate("auto_gf_DropNuke_TriggerFunc");
    }

    TriggerExecute(auto_gf_DropNuke_Trigger, false, false);
}

bool auto_gf_DropNuke_TriggerFunc (bool testConds, bool runActions) {
    point lp_cHOSEN_POINT = auto_gf_DropNuke_lp_cHOSEN_POINT;

    // Variable Declarations
    actor lv_dropEffect;
    sound lv_nukeSound;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    libNtve_gf_CreateModelAtPoint("GhostNukeIndicator", lp_cHOSEN_POINT);
    gv_nukeActor = libNtve_gf_ActorLastCreated();
    lv_dropEffect = libNtve_gf_ActorLastCreated();
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingWarning", lp_cHOSEN_POINT, ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/4718DA15"));
    UIAlertPoint("Trigger", gv_p01_USER, StringExternal("Param/Value/7EA9D213"), null, lp_cHOSEN_POINT);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryCombat, 20.0, 0.0);
    SoundPlay(SoundLink("Alert_TerranCalldownLaunch", -1), PlayerGroupAll(), 100.0, 0.0);
    SoundWait(SoundLastPlayed(), 0.0, c_soundOffsetEnd);
    SoundChannelSetVolume(PlayerGroupAll(), c_soundCategoryCombat, 100.0, 0.0);
    VisRevealArea(gv_p01_USER, RegionCircle(lp_cHOSEN_POINT, 10.0), 16.0, true);
    SoundPlay(SoundLink("Ghost_NukeSeek", -1), PlayerGroupAll(), 100.0, 0.0);
    lv_nukeSound = SoundLastPlayed();
    Wait(12.5, c_timeAI);
    libNtve_gf_KillModel(lv_dropEffect);
    PingDestroy(PingLastCreated());
    Wait(0.5, c_timeAI);
    UnitCreateEffectPoint(UnitFromId(2033231236), "NukeDetonate", lp_cHOSEN_POINT);
    SoundStop(lv_nukeSound, true);
    return true;
}

void gf_ShowKeypad (bool lp_isPassword) {
    // Variable Declarations
    string lv_result;
    const int lv_leftMargin = 30;
    const int lv_topMargin = 50;
    const int lv_bottomMargin = 80;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_result = "";

    // Implementation
    if ((gv_numpad.lv_window == c_invalidDialogId)) {
        DialogCreate(210, 380, c_anchorTopRight, 150, 150, false);
        gv_numpad.lv_window = DialogLastCreated();
        DialogControlCreate(gv_numpad.lv_window, c_triggerControlTypeButton);
        gv_numpad.lv_display = DialogControlLastCreated();
        DialogControlSetSize(gv_numpad.lv_display, PlayerGroupAll(), 150, 50);
        libNtve_gf_SetDialogItemToggled(gv_numpad.lv_display, true, PlayerGroupAll());
        libNtve_gf_SetDialogItemAcceptMouse(gv_numpad.lv_display, false, PlayerGroupAll());
        DialogControlSetPosition(gv_numpad.lv_display, PlayerGroupAll(), c_anchorTopLeft, lv_leftMargin, lv_topMargin);
        DialogControlCreate(gv_numpad.lv_window, c_triggerControlTypePanel);
        gv_numpad.lv_keysArea = DialogControlLastCreated();
        DialogControlSetSize(gv_numpad.lv_keysArea, PlayerGroupAll(), 150, 200);
        DialogControlSetPosition(gv_numpad.lv_keysArea, PlayerGroupAll(), c_anchorBottomLeft, lv_leftMargin, lv_bottomMargin);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 0, c_keyNumPad0);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 1, c_keyNumPad1);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 2, c_keyNumPad2);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 3, c_keyNumPad3);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 4, c_keyNumPad4);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 5, c_keyNumPad5);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 6, c_keyNumPad6);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 7, c_keyNumPad7);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 8, c_keyNumPad8);
        gf_ServicesDialogNumpadCreateNumButton(gv_numpad.lv_keysArea, 9, c_keyNumPad9);
        libNtve_gf_CreateDialogItemButton(gv_numpad.lv_window, 70, 50, c_anchorBottomLeft, lv_leftMargin, 30, StringToText(""), gf_ServicesDialogButtonsFormatCaption(StringExternal("Param/Value/E13D6B44")), "");
        gf_NumpadHotKeysBind(DialogControlLastCreated(), c_keyEnter, gt_NumpadOKButtonClick);
        libNtve_gf_CreateDialogItemButton(gv_numpad.lv_window, 70, 50, c_anchorBottomLeft, (lv_leftMargin + 80), 30, StringToText(""), gf_ServicesDialogButtonsFormatCaption(StringExternal("Param/Value/B953BF7E")), "");
        gf_NumpadHotKeysBind(DialogControlLastCreated(), c_keyEscape, gt_NumpadCancelButtonClick);
    }

    gv_numpad.lv_isPassword = lp_isPassword;
    DialogSetVisible(gv_numpad.lv_window, PlayerGroupAll(), true);
    TriggerExecute(gt_NumpadShown, true, false);
    while (!((DialogIsVisible(gv_numpad.lv_window, gv_p01_USER) == false))) {
        Wait(1.0, c_timeReal);
    }
    lv_result = gv_numpad.lv_value;
    gv_numpad.lv_value = "";
    libNtve_gf_SetDialogItemEditorValue(gv_numpad.lv_display, "", PlayerGroupAll());
}

void gf_ServicesDialogNumpadCreateNumButton (int lp_owner, int lp_value, int lp_hotKey) {
    // Variable Declarations
    int lv_result;
    int lv_slot;

    // Automatic Variable Declarations
    int auto083E37B4_val;

    // Variable Initialization
    lv_result = c_invalidDialogControlId;

    // Implementation
    DialogControlCreateInPanel(lp_owner, c_triggerControlTypeButton);
    lv_result = DialogControlLastCreated();
    DialogControlSetSize(lv_result, PlayerGroupAll(), 50, 50);
    libNtve_gf_SetDialogItemEditorValue(lv_result, IntToString(lp_value), PlayerGroupAll());
    auto083E37B4_val = lp_value;
    if (auto083E37B4_val == 0) {
        DialogControlSetPosition(lv_result, PlayerGroupAll(), c_anchorBottomLeft, 0, 0);
        DialogControlSetSize(lv_result, PlayerGroupAll(), 100, 50);
    }
    else if (auto083E37B4_val == 1) {
        DialogControlSetPosition(lv_result, PlayerGroupAll(), c_anchorBottomLeft, gf_ServicesDialogNumpadGetMargin(1), gf_ServicesDialogNumpadGetMargin(2));
    }
    else if (auto083E37B4_val == 2) {
