        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == gv_p01_USER))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "CommandCenter"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    autoE8678206_g = gv_playerSCVs;
    autoE8678206_u = UnitGroupCount(autoE8678206_g, c_unitCountAll);
    for (;; autoE8678206_u -= 1) {
        autoE8678206_var = UnitGroupUnitFromEnd(autoE8678206_g, autoE8678206_u);
