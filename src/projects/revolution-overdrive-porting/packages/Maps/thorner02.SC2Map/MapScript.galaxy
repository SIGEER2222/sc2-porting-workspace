//--------------------------------------------------------------------------------------------------
// Trigger: Vault Beacon Activated
//--------------------------------------------------------------------------------------------------
bool gt_VaultBeaconActivated_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((UnitFilterMatch(EventUnit(), 1, UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterAir) | (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32)))) == true))) {
            return false;
        }

        if (!((gv_vaultNumpadActive == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_vaultNumpadActive = true;
    gv_junkerCacheTriggeringUnit = EventUnit();
    gf_ShowKeypad(true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_VaultBeaconActivated_Init () {
    gt_VaultBeaconActivated = TriggerCreate("gt_VaultBeaconActivated_Func");
    TriggerEnable(gt_VaultBeaconActivated, false);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Vault Beacon Deactivated
//--------------------------------------------------------------------------------------------------
bool gt_VaultBeaconDeactivated_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((EventUnit() == gv_junkerCacheTriggeringUnit))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
