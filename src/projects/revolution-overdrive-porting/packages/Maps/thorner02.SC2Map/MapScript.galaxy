//--------------------------------------------------------------------------------------------------
// Trigger: Objective Buy Contract Failed Q
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveBuyContractFailedQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto78B71C8D_g;
    int auto78B71C8D_var;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerExecute(gt_ObjectiveBuyContractCreateQ, true, false);
    Wait(libWCMI_gv_campaignObjectiveDelay, c_timeReal);
    libWCMI_gf_ZS_SetMissionObjectiveState("THorner02_1", libWoLC_ge_MissionObjectiveState_Failed);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("THorner02Han00004", 0)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner02Han00007", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    auto78B71C8D_g = libA9E65AFF_gv_enemyPlayers;
    auto78B71C8D_var = -1;
    while (true) {
        auto78B71C8D_var = PlayerGroupNextPlayer(auto78B71C8D_g, auto78B71C8D_var);
        if (auto78B71C8D_var < 0) { break; }
        libNtve_gf_SetAlliance(gv_p03_MIRA_HAN, auto78B71C8D_var, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
        PlayerSetState(auto78B71C8D_var, c_playerStateFoodIgnored, true);
        PlayerSetState(auto78B71C8D_var, c_playerStateMineralCostIgnored, true);
        PlayerSetState(auto78B71C8D_var, c_playerStateVespeneCostIgnored, true);
    }
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p03_MIRA_HAN, libNtve_ge_AllianceSetting_Enemy);
    return true;
}

