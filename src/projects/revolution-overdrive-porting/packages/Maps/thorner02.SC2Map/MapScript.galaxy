//--------------------------------------------------------------------------------------------------
// Trigger: Nuke Cycle
//--------------------------------------------------------------------------------------------------
bool gt_NukeCycle_Func (bool testConds, bool runActions) {
    // Variable Declarations
    timer lv_nukeTimer;
    int lv_nukeTimerWindow;
    int lv_i;
    int lv_ghostCycle;
    int lv_nukeCycle;

    // Automatic Variable Declarations
    int auto1623C00C_val;
    int auto97F5E915_n;
    int auto97F5E915_i;
    unitgroup auto357843E6_g;
    int auto357843E6_u;
    unit auto357843E6_var;

    // Variable Initialization
    lv_nukeTimer = TimerCreate();
    lv_nukeTimerWindow = c_timerWindowNone;
    lv_ghostCycle = 1;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_nukeIntensity = 1;
    while ((UnitIsAlive(UnitFromId(255689982)) == true)) {
        while (true) {
            auto1623C00C_val = RandomInt(0, 2);
            if (auto1623C00C_val == 0) {
                SoundPlayForPlayer(SoundLink("Ghost_NuclearStrikeVO", -1), c_maxPlayers, PlayerGroupAll(), 110.0, 0.0);
            }
            else if (auto1623C00C_val == 1) {
                SoundPlayForPlayer(SoundLink("Ghost_Ready", -1), c_maxPlayers, PlayerGroupAll(), 110.0, 0.0);
            }
            else if (auto1623C00C_val == 2) {
                SoundPlayForPlayer(SoundLink("Ghost_Yes", -1), c_maxPlayers, PlayerGroupAll(), 110.0, 0.0);
            }
            else {
            }
            auto97F5E915_n = gv_nukeIntensity;
            for (auto97F5E915_i = 1; auto97F5E915_i <= auto97F5E915_n; auto97F5E915_i += 1) {
                gv_availableTargets = UnitGroupAlliance(gv_p02_ORLAN_ENEMY, c_unitAllianceEnemy, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure) | (1 << c_targetFilterVisible), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0);
                auto357843E6_g = gv_availableTargets;
                auto357843E6_u = UnitGroupCount(auto357843E6_g, c_unitCountAll);
                for (;; auto357843E6_u -= 1) {
                    auto357843E6_var = UnitGroupUnitFromEnd(auto357843E6_g, auto357843E6_u);
                    if (auto357843E6_var == null) { break; }
                    if (((UnitGetType(auto357843E6_var) == "CreepTumor") || (UnitGetType(auto357843E6_var) == "CreepTumorBurrowed") || (UnitGetType(auto357843E6_var) == "CreepTumorQueen") || (UnitGetType(auto357843E6_var) == "CreepTumorUsed"))) {
                        UnitGroupRemove(gv_availableTargets, auto357843E6_var);
                    }

                }
                libNtve_gf_CreateUnitsWithDefaultFacing(1, "Ghost", 0, gv_p04_DOMINION, RegionRandomPoint(gv_ghostSpawnRegions));
                gf_MakeGhostNuke(UnitLastCreated());
                Wait((10.0 / gv_nukeIntensity), c_timeAI);
            }
            Wait(gv_nukeDelay, c_timeAI);
        }
    }
    return true;
}

