void gt_SpawnReinforcements_Init () {
    gt_SpawnReinforcements = TriggerCreate("gt_SpawnReinforcements_Func");
    TriggerAddEventTimePeriodic(gt_SpawnReinforcements, 0.5, c_timeGame);
}

