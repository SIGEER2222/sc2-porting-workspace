//--------------------------------------------------------------------------------------------------
// Trigger: Objective Find Contraband Update
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveFindContrabandUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "ProtossRelic"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_contrabandRelicsFound += 1;
    TriggerExecute(gt_ObjectiveFindContrabandCreateQ, true, false);
    UIAlertPoint("Trigger", gv_p01_USER, StringExternal("Param/Value/D16B38BA"), null, UnitGetPosition(EventUnit()));
    libWCMI_gf_DisplayMissionObjectiveRewardFloatingText(UnitGetPosition(EventUnit()), "THorner02_3");
    UnitKill(EventUnit());
    libWCMI_gf_SetMissionObjectiveProgress("THorner02_3", gv_contrabandRelicsFound);
    if ((gv_contrabandRelicsFound == 2)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "BloodisFuel", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/C44B6BC3"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_contrabandRelicsFound == gv_contrabandRelicsTotal)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "PhasingModule", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/AC498397"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
        TriggerExecute(gt_ObjectiveFindContrabandComplete, true, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ObjectiveFindContrabandUpdate_Init () {
    gt_ObjectiveFindContrabandUpdate = TriggerCreate("gt_ObjectiveFindContrabandUpdate_Func");
    TriggerAddEventUnitAbility(gt_ObjectiveFindContrabandUpdate, null, AbilityCommand("Pickup", 0), c_unitAbilStageExecute, false);
}

