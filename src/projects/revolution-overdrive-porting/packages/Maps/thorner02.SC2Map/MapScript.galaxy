    gt_UpdateContractWindow = TriggerCreate("gt_UpdateContractWindow_Func");
    TriggerAddEventTimePeriodic(gt_UpdateContractWindow, 0.25, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Player Buys Contract
//--------------------------------------------------------------------------------------------------
bool gt_PlayerBuysContract_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto42D8E479_g;
    int auto42D8E479_var;

    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!((gv_miraHanContractBought == false))) {
            return false;
        }

        if (!((PlayerGetPropertyInt(gv_p01_USER, c_playerPropMinerals) >= gv_mERC_CONTRACT_PRICE))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_MiraGoesHostile, false);
    TriggerEnable(gt_PlayerAttacksMira, false);
    gv_miraHanContractBought = true;
    UISetRestartLoadingScreen(ConversationDataStateText("Maps|THorner02", "Loading Screen Restart 2"));
    AIAttackWaveSetTargetPlayer(gv_p03_MIRA_HAN, gv_miraTargets);
    TriggerEnable(gt_TopRightGate, false);
    TriggerEnable(gt_TopleftGate, false);
    TriggerEnable(gt_MiddleGate, false);
    TriggerEnable(gt_BottomRightGate, false);
    TriggerEnable(gt_BottomLeftGate, false);
    TriggerEnable(gt_OrlanMineralCount, false);
    TriggerEnable(gt_MiraHanDestroyed, false);
    TriggerStop(gt_OrlanMineralCount);
    TriggerStop(gt_MiraHanDestroyed);
    TriggerStop(gt_OrlanP02InitialAttackWaves);
    TriggerEnable(gt_UpdateContractWindow, false);
    TriggerEnable(gt_AchievementNoSCVTraining, false);
    TriggerExecute(gt_OrlanPostContractAttackWaves, true, false);
    TriggerExecute(gt_P4AttackWaves, true, false);
    TriggerExecute(gt_MiraAttackWaves, true, false);
    TriggerExecute(gt_P13AttackWaves, true, false);
    TriggerExecute(gt_P14AttackWaves, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    TriggerExecute(gt_NukeCycling, true, false);
    PingDestroy(gv_pingCommandCenterSW);
    PingDestroy(gv_pingCommandCenterSE);
    PingDestroy(gv_pingCommandCenterNE);
    UnitClearInfoText(UnitFromId(893));
    UnitClearInfoText(UnitFromId(894));
    UnitClearInfoText(UnitFromId(767));
    DialogControlSetVisible(gv_contractWindowRoot, PlayerGroupAll(), false);
    SoundPlay(SoundLink("UI_TechConsole_Purchase", -1), PlayerGroupAll(), 100.0, 0.0);
    PlayerModifyPropertyInt(gv_p01_USER, c_playerPropMinerals, c_playerPropOperSubtract, gv_mERC_CONTRACT_PRICE);
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p03_MIRA_HAN, libNtve_ge_AllianceSetting_AllyWithSharedVision);
    libA9E65AFF_gf_ScriptBuildingProduction(UnitFromId(1971266350), AbilityCommand("BarracksTrain", 0), libA9E65AFF_gv_scriptBuildingsWaves);
    TriggerExecute(gt_ObjectiveBuyContractComplete, true, false);
    Wait(libWCMI_gv_campaignObjectiveDelay, c_timeGame);
    auto42D8E479_g = libA9E65AFF_gv_enemyPlayers;
    auto42D8E479_var = -1;
    while (true) {
        auto42D8E479_var = PlayerGroupNextPlayer(auto42D8E479_g, auto42D8E479_var);
        if (auto42D8E479_var < 0) { break; }
        libNtve_gf_SetAlliance(gv_p03_MIRA_HAN, auto42D8E479_var, libNtve_ge_AllianceSetting_Enemy);
        PlayerSetState(auto42D8E479_var, c_playerStateFoodIgnored, true);
        PlayerSetState(auto42D8E479_var, c_playerStateMineralCostIgnored, true);
        PlayerSetState(auto42D8E479_var, c_playerStateVespeneCostIgnored, true);
    }
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p03_MIRA_HAN, libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    VisRevealerCreate(1, RegionCircle(UnitGetPosition(UnitFromId(2039718014)), 3.0));
    VisRevealerCreate(1, RegionCircle(UnitGetPosition(UnitFromId(593936074)), 3.0));
    VisRevealerCreate(1, RegionCircle(UnitGetPosition(UnitFromId(285847159)), 3.0));
    VisRevealerCreate(1, RegionCircle(UnitGetPosition(UnitFromId(1998239941)), 3.0));
    VisRevealerCreate(1, RegionCircle(UnitGetPosition(UnitFromId(641505969)), 3.0));
    Wait(2.0, c_timeGame);
    UnitKill(UnitFromId(2039718014));
    UnitKill(UnitFromId(593936074));
    UnitKill(UnitFromId(285847159));
    UnitKill(UnitFromId(1998239941));
    UnitKill(UnitFromId(641505969));
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/E52C95E7"));
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    // Transmission - SoundLink("THorner02Raynor00011", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner02Raynor00011", -1), c_transmissionDurationAdd, 0.0, true);
    // Transmission - SoundLink("THorner02Han00022", 0)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner02Han00022", -1), c_transmissionDurationAdd, 0.0, true);
    // Transmission - SoundLink("THorner02Orlan00012", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner02Orlan00012", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    TriggerEnable(gt_MiraExpo1, true);
    TriggerEnable(gt_MiraExpo2, true);
    TriggerEnable(gt_MiraExpo3, true);
    TriggerEnable(gt_MiraExpo4, true);
    TriggerEnable(gt_MiraStrikeFighters, true);
    return true;
}

