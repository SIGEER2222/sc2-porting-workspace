//--------------------------------------------------------------------------------------------------
// Trigger: Spawn Reinforcements
//--------------------------------------------------------------------------------------------------
bool gt_SpawnReinforcements_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_targetPoint;
    unitgroup lv_generatedUnits;

    // Automatic Variable Declarations
    int auto2D0B45AC_n;
    int auto2D0B45AC_i;
    unitgroup autoC75CE03A_g;
    int autoC75CE03A_u;
    unit autoC75CE03A_var;

    // Variable Initialization
    lv_generatedUnits = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((UnitGetPropertyFixed(gv_orlansFortress, c_unitPropLifePercent, c_unitPropCurrent) <= 60.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupCount(UnitGroupAlliance(gv_p02_ORLAN_ENEMY, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_orlansFortress), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) >= 1)) {
        TriggerEnable(TriggerGetCurrent(), false);
        auto2D0B45AC_n = libNtve_gf_DifficultyValueInt(1, 1, 1, 2);
        for (auto2D0B45AC_i = 1; auto2D0B45AC_i <= auto2D0B45AC_n; auto2D0B45AC_i += 1) {
            lv_targetPoint = RegionRandomPoint(RegionCircle(UnitGetPosition(gv_orlansFortress), 15.0));
            UnitCreate(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "Reaper", 0, gv_p02_ORLAN_ENEMY, lv_targetPoint, 270.0);
            UnitGroupAddUnitGroup(lv_generatedUnits, UnitLastCreatedGroup());
            libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_targetPoint, UnitLastCreatedGroup(), false, 2);
            UnitCreate(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "Goliath", 0, gv_p02_ORLAN_ENEMY, lv_targetPoint, 270.0);
            UnitGroupAddUnitGroup(lv_generatedUnits, UnitLastCreatedGroup());
            libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_targetPoint, UnitLastCreatedGroup(), false, 2);
            UnitCreate(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "Marauder", 0, gv_p02_ORLAN_ENEMY, lv_targetPoint, 270.0);
            UnitGroupAddUnitGroup(lv_generatedUnits, UnitLastCreatedGroup());
            libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_targetPoint, UnitLastCreatedGroup(), false, 2);
            Wait(4.0, c_timeGame);
            autoC75CE03A_g = lv_generatedUnits;
            autoC75CE03A_u = UnitGroupCount(autoC75CE03A_g, c_unitCountAll);
            for (;; autoC75CE03A_u -= 1) {
                autoC75CE03A_var = UnitGroupUnitFromEnd(autoC75CE03A_g, autoC75CE03A_u);
                if (autoC75CE03A_var == null) { break; }
                AISetUnitSuicide(autoC75CE03A_var, true);
            }
        }
        Wait(50.0, c_timeGame);
        TriggerEnable(TriggerGetCurrent(), true);
    }

    return true;
}

