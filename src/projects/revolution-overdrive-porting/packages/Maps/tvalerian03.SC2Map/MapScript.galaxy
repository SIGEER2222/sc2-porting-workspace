//--------------------------------------------------------------------------------------------------
// Trigger: Trickle Pods
//--------------------------------------------------------------------------------------------------
bool gt_TricklePods_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gf_TrickleDropPod(RegionRandomPoint(RegionFromId(48)));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(RegionFromId(49)));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(RegionFromId(46)));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    if ((GameGetMissionTime() >= 600.0)) {
        gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
        Wait(2.0, c_timeGame);
    }

    if ((GameGetMissionTime() >= 1200.0)) {
        gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
        Wait(2.0, c_timeGame);
    }

    if ((GameGetMissionTime() >= 1800.0)) {
        gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
        Wait(2.0, c_timeGame);
    }

    if ((gv_finalCountdownStarted == true)) {
        gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
        if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
            gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
            Wait(2.0, c_timeGame);
        }

        Wait(2.0, c_timeGame);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TricklePods_Init () {
    gt_TricklePods = TriggerCreate("gt_TricklePods_Func");
    TriggerAddEventTimePeriodic(gt_TricklePods, 60.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Frenzy Timer
//--------------------------------------------------------------------------------------------------
bool gt_FrenzyTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_frenzyTimer, 180.0, true, c_timeGame);
    TimerWindowCreate(TimerLastStarted(), StringExternal("Param/Value/7A17F8AA"), true, false);
    gv_frenzyTimerWindow = TimerWindowLastCreated();
    libWCUI_gf_SetTimerWindowDangerThreshold(30.0);
    TimerWindowSetAnchor(TimerWindowLastCreated(), c_anchorTop, 0, 25);
    TimerWindowShow(TimerWindowLastCreated(), PlayerGroupAll(), true);
    TriggerQueueEnter();
    if ((gv_gameOver == true)) {
        return true;
    }

    SoundPlay(SoundLink("TUIWarningPing", 0), PlayerGroupAll(), 100.0, 0.0);
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingTriangle", UnitGetPosition(UnitFromId(1357744924)), ColorWithAlpha(100.00, 50.20, 25.10, 0.00), 0.0, 270.0);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/EACA2A50"));
    PingSetScale(PingLastCreated(), 0.8);
    PingSetUnit(PingLastCreated(), UnitFromId(1357744924));
    libHots_gf_StorePingForUnit(UnitFromId(1357744924), 1, PingLastCreated());
    Wait(1.0, c_timeGame);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "TValerian03MusicEventD", c_soundtrackCueAny, c_soundtrackIndexAny, false);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian02ATychus00077", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_FrenzyTimer_Init () {
    gt_FrenzyTimer = TriggerCreate("gt_FrenzyTimer_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Mass Frenzy
//--------------------------------------------------------------------------------------------------
bool gt_MassFrenzy_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto4DBAB8A6_g;
    int auto4DBAB8A6_var;
    unitgroup autoCCCE1C7E_g;
    int autoCCCE1C7E_u;
    unit autoCCCE1C7E_var;

    // Actions
    if (!runActions) {
        return true;
    }

    SoundPlayForPlayer(SoundLink("Brutalisk_Roar", 0), c_maxPlayers, PlayerGroupAll(), 400.0, 0.0);
    SoundPlay(SoundLink("InfestedTerranReady", 0), PlayerGroupAll(), 150.0, 0.0);
    SoundPlay(SoundLink("InfestedTerran_Yes", 1), PlayerGroupAll(), 150.0, 0.0);
    SoundPlay(SoundLink("Baneling_Yes", 5), PlayerGroupAll(), 150.0, 0.0);
    SoundPlay(SoundLink("Hydralisk_Ready", 2), PlayerGroupAll(), 150.0, 0.0);
    SoundPlay(SoundLink("Roach_Ready", 0), PlayerGroupAll(), 150.0, 0.0);
    SoundPlay(SoundLink("Infestor_Ready", 0), PlayerGroupAll(), 150.0, 0.0);
    SoundPlay(SoundLink("Ultralisk_Roar", 0), PlayerGroupAll(), 150.0, 0.0);
    auto4DBAB8A6_g = libA9E65AFF_gv_enemyPlayers;
    auto4DBAB8A6_var = -1;
    while (true) {
        auto4DBAB8A6_var = PlayerGroupNextPlayer(auto4DBAB8A6_g, auto4DBAB8A6_var);
        if (auto4DBAB8A6_var < 0) { break; }
        autoCCCE1C7E_g = UnitGroup(null, auto4DBAB8A6_var, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterAir) | (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterSummoned - 32)) | (1 << (c_targetFilterMapBoss - 32))), 0);
        autoCCCE1C7E_u = UnitGroupCount(autoCCCE1C7E_g, c_unitCountAll);
        for (;; autoCCCE1C7E_u -= 1) {
            autoCCCE1C7E_var = UnitGroupUnitFromEnd(autoCCCE1C7E_g, autoCCCE1C7E_u);
            if (autoCCCE1C7E_var == null) { break; }
            UnitBehaviorAdd(autoCCCE1C7E_var, "BroodmothersFrenzy", autoCCCE1C7E_var, 1);
        }
    }
    return true;
}

