    gt_BroodmothersVenom = TriggerCreate("gt_BroodmothersVenom_Func");
    TriggerAddEventTimePeriodic(gt_BroodmothersVenom, 0.5, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Leviathan Drop Harass
//--------------------------------------------------------------------------------------------------
bool gt_LeviathanDropHarass_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_dropTargets;
    unitgroup lv_dropPodGroup;
    point lv_dropPoint;

    // Automatic Variable Declarations
    unitgroup auto78D80FFF_g;
    int auto78D80FFF_u;
    unit auto78D80FFF_var;
    unitgroup auto19B60A2F_g;
    int auto19B60A2F_u;
    unit auto19B60A2F_var;
    unitgroup autoF4AE0D58_g;
    int autoF4AE0D58_u;
    unit autoF4AE0D58_var;
    unitgroup auto2CE67CE2_g;
    int auto2CE67CE2_u;
    unit auto2CE67CE2_var;
    int auto74CDE73E_n;
    int auto74CDE73E_i;

    // Variable Initialization
    lv_dropTargets = UnitGroupEmpty();
    lv_dropPodGroup = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_leviathanKilledString) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
