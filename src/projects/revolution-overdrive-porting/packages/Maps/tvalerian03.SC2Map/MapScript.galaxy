//--------------------------------------------------------------------------------------------------
bool gt_ReinforceRegionsWithBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(300.0, c_timeGame);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(112), true);
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(113), true);
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(114), true);
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(115), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(118), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(119), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(120), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(121), true);
    Wait(300.0, c_timeGame);
    gv_trickleIntensity += 1;
    gv_kerriganEscortNumber += 1;
    gv_dropCount += 1;
    Wait(300.0, c_timeGame);
    gv_kerriganMaxHP += 500.0;
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(116), true);
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(117), true);
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(126), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(122), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(123), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(124), true);
    Wait(300.0, c_timeGame);
    gv_trickleIntensity += 1;
    gv_kerriganEscortNumber += 2;
    Wait(300.0, c_timeGame);
    gv_dropCount += 1;
    AIToggleBulliesInRegion(gv_p13_MOEBIUS, RegionFromId(125), true);
    AIToggleBulliesInRegion(gv_p12_DOMINIONFORWARD, RegionFromId(126), true);
    Wait(300.0, c_timeGame);
    gv_trickleIntensity += 1;
    gv_kerriganMaxHP += 500.0;
    gv_kerriganEscortNumber += 1;
    Wait(300.0, c_timeGame);
    gv_dropCount += 1;
    gv_kerriganEscortNumber += 1;
    while (true) {
        Wait(300.0, c_timeGame);
        Wait(300.0, c_timeGame);
    }
    return true;
}

