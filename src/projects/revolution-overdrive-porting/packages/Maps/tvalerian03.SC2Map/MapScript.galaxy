        gf_SpawnAerialSwarm(PointFromId(2143295288), ge_AirWaveStrength_Moderate);
    }

    Wait(45.0, c_timeGame);
    gf_SpawnNydusWorm(1, gv_baseNydusRegions);
    Wait(2.0, c_timeGame);
    gf_SpawnNydusWorm(1, gv_baseNydusRegions);
    Wait(2.0, c_timeGame);
    gf_SpawnNydusWorm(1, gv_baseNydusRegions);
