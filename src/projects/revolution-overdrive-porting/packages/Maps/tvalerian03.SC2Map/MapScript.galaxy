    TriggerAddEventUnitDamaged(gt_KerriganHitWithArtifact, UnitRefFromVariable("gv_kerrigan"), c_unitDamageTypeAny, c_unitDamageEither, "EnergyNovaDamage");
    TriggerAddEventUnitDamaged(gt_KerriganHitWithArtifact, UnitRefFromVariable("gv_kerrigan"), c_unitDamageTypeAny, c_unitDamageEither, "EnergyNovaDoTDamage");
}

