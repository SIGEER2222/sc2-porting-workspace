    lv_i = 1;
    for ( ; ( (autoAD293901_ai >= 0 && lv_i <= autoAD293901_ae) || (autoAD293901_ai < 0 && lv_i >= autoAD293901_ae) ) ; lv_i += autoAD293901_ai ) {
        if ((CreepIsPresent(PointWithOffsetPolar(lp_point, 1.0, (IntToFixed(lv_i) * 90.0))) == false)) {
