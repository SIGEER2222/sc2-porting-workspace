//--------------------------------------------------------------------------------------------------
// Trigger: Test Final Timer
//--------------------------------------------------------------------------------------------------
bool gt_TestFinalTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_siphonersBuilt += 1;
    TriggerExecute(gt_ObjectivePlaceSiphonersUpdate, true, false);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "HiveMindSiphoner", c_unitCreateIgnorePlacement, 1, RegionGetCenter(gv_grendelSiphonerRegion));
    gv_grendelSiphoner = UnitLastCreated();
    gv_siphonersBuilt += 1;
    TriggerExecute(gt_ObjectivePlaceSiphonersUpdate, true, false);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "HiveMindSiphoner", c_unitCreateIgnorePlacement, 1, RegionGetCenter(gv_blightspreaderSiphonerRegion));
    gv_blightspreaderSiphoner = UnitLastCreated();
    gv_siphonersBuilt += 1;
    TriggerExecute(gt_ObjectivePlaceSiphonersUpdate, true, false);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "HiveMindSiphoner", c_unitCreateIgnorePlacement, 1, RegionGetCenter(gv_leviathanSiphonerRegion));
    gv_leviathanSiphoner = UnitLastCreated();
    gv_siphonersBuilt += 1;
    TriggerExecute(gt_ObjectivePlaceSiphonersUpdate, true, false);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "HiveMindSiphoner", c_unitCreateIgnorePlacement, 1, RegionGetCenter(gv_jormungandSiphonerRegion));
    gv_jormungandSiphoner = UnitLastCreated();
    return true;
}

