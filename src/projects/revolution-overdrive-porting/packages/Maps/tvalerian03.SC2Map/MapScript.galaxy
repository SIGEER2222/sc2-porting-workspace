//--------------------------------------------------------------------------------------------------
bool gt_KerriganAttacks_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(480.0, c_timeGame);
    TriggerExecute(gt_SpawnKerriganWave, true, false);
    Wait(480.0, c_timeGame);
    TriggerExecute(gt_SpawnKerriganWave, true, false);
    Wait(480.0, c_timeGame);
    TriggerExecute(gt_SpawnKerriganWave, true, false);
    Wait(480.0, c_timeGame);
    TriggerExecute(gt_SpawnKerriganWave, true, false);
    Wait(480.0, c_timeGame);
    TriggerExecute(gt_SpawnKerriganWave, true, false);
    while (true) {
        Wait(480.0, c_timeGame);
        TriggerExecute(gt_SpawnKerriganWave, true, false);
    }
    return true;
}

