//--------------------------------------------------------------------------------------------------
// Trigger: Kerrigan Hit With Artifact
//--------------------------------------------------------------------------------------------------
bool gt_KerriganHitWithArtifact_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_random;

    // Automatic Variable Declarations
    int autoBD4EB661_val;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    lv_random = RandomInt(0, 1);
    TriggerQueueEnter();
    if ((gv_gameOver == true)) {
        return true;
    }

    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    autoBD4EB661_val = lv_random;
    if (autoBD4EB661_val == 0) {
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Kerrigan00005", -1), c_transmissionDurationAdd, 0.0, true);
    }
    else if (autoBD4EB661_val == 1) {
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian03Kerrigan00012", -1), c_transmissionDurationAdd, 0.0, true);
    }
    else {
    }
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    Wait(30.0, c_timeGame);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

