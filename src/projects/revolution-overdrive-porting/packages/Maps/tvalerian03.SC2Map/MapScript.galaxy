    gf_SpawnAerialSwarm(PointFromId(2143295288), ge_AirWaveStrength_Weak);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_SpawnAerialSwarm(PointFromId(1280189237), ge_AirWaveStrength_Weak);
    }

    Wait(30.0, c_timeGame);
    TriggerExecute(gt_SpawnKerriganWave, true, false);
    Wait(30.0, c_timeGame);
    gf_SpawnNydusWorm(1, gv_baseNydusRegions);
    gf_SpawnNydusWorm(1, gv_baseNydusRegions);
    gf_SpawnNydusWorm(1, gv_farNydusRegions);
    TriggerExecute(gt_AirQ, true, false);
    gf_SpawnAerialSwarm(PointFromId(1974076111), ge_AirWaveStrength_Severe);
    gf_SpawnAerialSwarm(PointFromId(1280189237), ge_AirWaveStrength_Weak);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_SpawnAerialSwarm(PointFromId(1565982876), ge_AirWaveStrength_Moderate);
    }

    Wait(30.0, c_timeGame);
    auto497AA012_g = UnitGroup(null, gv_p02_SWARMGUARD, RegionFromId(132), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto497AA012_u = UnitGroupCount(auto497AA012_g, c_unitCountAll);
    for (;; auto497AA012_u -= 1) {
        auto497AA012_var = UnitGroupUnitFromEnd(auto497AA012_g, auto497AA012_u);
        if (auto497AA012_var == null) { break; }
        AISetUnitScriptControlled(auto497AA012_var, false);
        UnitIssueOrder(auto497AA012_var, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(gv_artifact)), c_orderQueueAddToEnd);
    }
    while (true) {
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
        Wait(2.0, c_timeGame);
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
        Wait(2.0, c_timeGame);
        gf_SpawnNydusWorm(1, gv_farNydusRegions);
        Wait(2.0, c_timeGame);
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
        Wait(30.0, c_timeGame);
        TriggerExecute(gt_AirQ, true, false);
        gf_SpawnAerialSwarm(PointFromId(1974076111), ge_AirWaveStrength_Severe);
        gf_SpawnAerialSwarm(PointFromId(1280189237), ge_AirWaveStrength_Weak);
        if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
            gf_SpawnAerialSwarm(PointFromId(1565982876), ge_AirWaveStrength_Moderate);
        }

        Wait(30.0, c_timeGame);
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
        gf_SpawnNydusWorm(1, gv_closeNydusRegions);
        Wait(2.0, c_timeGame);
        gf_SpawnNydusWorm(1, gv_farNydusRegions);
        Wait(2.0, c_timeGame);
        Wait(30.0, c_timeGame);
        TriggerExecute(gt_AirQ, true, false);
        gf_SpawnAerialSwarm(PointFromId(1974076111), ge_AirWaveStrength_Severe);
        gf_SpawnAerialSwarm(PointFromId(1280189237), ge_AirWaveStrength_Weak);
        if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
            gf_SpawnAerialSwarm(PointFromId(1565982876), ge_AirWaveStrength_Moderate);
        }

        Wait(30.0, c_timeGame);
    }
    return true;
}

