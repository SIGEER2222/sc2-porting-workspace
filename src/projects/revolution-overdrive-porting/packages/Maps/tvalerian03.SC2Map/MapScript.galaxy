//--------------------------------------------------------------------------------------------------
// Trigger: Briefing Zerg Attacks Major
//--------------------------------------------------------------------------------------------------
bool gt_BriefingZergAttacksMajor_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Ultralisk", 0, gv_p02_SWARMGUARD, PointFromId(713));
    UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(527)), c_orderQueueReplace);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "Ultralisk", 0, gv_p02_SWARMGUARD, PointFromId(714));
    UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(528)), c_orderQueueReplace);
    while (true) {
        if ((RandomInt(1, 3) == 1)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Hydralisk", 0, gv_p02_SWARMGUARD, PointFromId(713));
        }
        else {
            libNtve_gf_CreateUnitsWithDefaultFacing(4, "Zergling", 0, gv_p02_SWARMGUARD, PointFromId(713));
        }
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(527)), c_orderQueueReplace);
        if ((RandomInt(1, 3) == 1)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Hydralisk", 0, gv_p02_SWARMGUARD, PointFromId(714));
        }
        else {
            libNtve_gf_CreateUnitsWithDefaultFacing(4, "Zergling", 0, gv_p02_SWARMGUARD, PointFromId(714));
        }
        UnitGroupIssueOrder(UnitLastCreatedGroup(), OrderTargetingPoint(AbilityCommand("attack", 0), PointFromId(528)), c_orderQueueReplace);
        Wait(RandomFixed(0.5, 1.0), c_timeReal);
    }
    return true;
}

