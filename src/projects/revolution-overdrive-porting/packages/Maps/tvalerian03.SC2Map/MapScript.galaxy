    PlayerCreateEffectPoint(1, "EnergyNovaAiur06Set", PointFromId(151901779));
    PlayerCreateEffectPoint(1, "EnergyNovaAiur06Set", PointFromId(255024910));
    if ((UnitIsAlive(gv_grendelSiphoner) == true)) {
        PlayerCreateEffectPoint(1, "EnergyNovaAiur06Set", UnitGetPosition(gv_grendelSiphoner));
    }

    if ((UnitIsAlive(gv_blightspreaderSiphoner) == true)) {
        PlayerCreateEffectPoint(1, "EnergyNovaAiur06Set", UnitGetPosition(gv_blightspreaderSiphoner));
    }

    if ((UnitIsAlive(gv_leviathanSiphoner) == true)) {
        PlayerCreateEffectPoint(1, "EnergyNovaAiur06Set", UnitGetPosition(gv_leviathanSiphoner));
    }

    if ((UnitIsAlive(gv_jormungandSiphoner) == true)) {
        PlayerCreateEffectPoint(1, "EnergyNovaAiur06Set", UnitGetPosition(gv_jormungandSiphoner));
    }

    return true;
}

