//--------------------------------------------------------------------------------------------------
// Trigger: P4 Grendel Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_P4GrendelAttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 4;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(1241599256));
    Wait(120.0, c_timeGame);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddWaypoint(lv_aI, gv_waypointArrayGrendel[RandomInt(0, 2)], false);
        AIAttackWaveAddUnits4(8, 8, 10, 12, "HotSRaptor");
