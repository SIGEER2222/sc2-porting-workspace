//--------------------------------------------------------------------------------------------------
// Trigger: Tier 2 Intensity
//--------------------------------------------------------------------------------------------------
bool gt_Tier2Intensity_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!(((GameGetMissionTime() >= 760.0)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_attackIntensity = 2;
    return true;
}

