                gf_SpawnNydusWorm(1, gv_farNydusRegions);
                Wait(2.0, c_timeAI);
            }

        }
        return true;
    }

    if ((GameGetMissionTime() <= 1980.0)) {
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
        Wait(2.0, c_timeAI);
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
        Wait(2.0, c_timeAI);
        gf_SpawnNydusWorm(1, gv_baseNydusRegions);
