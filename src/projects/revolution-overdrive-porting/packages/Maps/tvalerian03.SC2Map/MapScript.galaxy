//--------------------------------------------------------------------------------------------------
// Trigger: Final Onslaught
//--------------------------------------------------------------------------------------------------
bool gt_FinalOnslaught_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto497AA012_g;
    int auto497AA012_u;
    unit auto497AA012_var;

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeGame);
    TriggerExecute(gt_GrendelFinaleWaves, true, false);
    TriggerExecute(gt_BlightspreaderFinalWaves, true, false);
    TriggerExecute(gt_JormungandFinalWaves, true, false);
    TriggerExecute(gt_LeviathanFinalWaves, true, false);
    TriggerExecute(gt_SwarmguardFinalWaves, true, false);
    Wait(15.0, c_timeAI);
    gf_SpawnNydusWorm(1, gv_baseNydusRegions);
    Wait(2.0, c_timeGame);
    gf_SpawnNydusWorm(1, gv_baseNydusRegions);
    Wait(2.0, c_timeGame);
    gf_SpawnNydusWorm(1, gv_closeNydusRegions);
    Wait(2.0, c_timeGame);
    gf_SpawnNydusWorm(1, gv_closeNydusRegions);
    Wait(2.0, c_timeGame);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_SpawnNydusWorm(1, gv_farNydusRegions);
    }

    Wait(30.0, c_timeGame);
    TriggerExecute(gt_AirQ, true, false);
    gf_SpawnAerialSwarm(PointFromId(1974076111), ge_AirWaveStrength_High);
    gf_SpawnAerialSwarm(PointFromId(1280189237), ge_AirWaveStrength_Weak);
    gf_SpawnAerialSwarm(PointFromId(1268981275), ge_AirWaveStrength_Weak);
