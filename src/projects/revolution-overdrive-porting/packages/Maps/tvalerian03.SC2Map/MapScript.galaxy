    libNtve_gf_SetUpgradeLevelForPlayer(gv_p02_SWARMGUARD, "KerriganPassiveBoost2", 1);
    libWCUI_gf_ShowHideProgressBar(false);
    TimerStart(gv_finalTimer, 360.0, false, c_timeGame);
