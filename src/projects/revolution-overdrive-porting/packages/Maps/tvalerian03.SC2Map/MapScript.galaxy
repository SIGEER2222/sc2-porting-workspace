//--------------------------------------------------------------------------------------------------
// Trigger: Place Grendel Siphoner
//--------------------------------------------------------------------------------------------------
bool gt_PlaceGrendelSiphoner_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "SCV"))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_siphonersBuilt += 1;
    TriggerExecute(gt_ObjectivePlaceSiphonersUpdate, true, false);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "HiveMindSiphoner", c_unitCreateIgnorePlacement, 1, RegionGetCenter(gv_grendelSiphonerRegion));
    gv_grendelSiphoner = UnitLastCreated();
    gf_CreateWarpInEffect(gv_grendelSiphoner);
    gv_artifactChargeCurrent += 450.0;
    PingSetVisible(gv_grendelPing, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_PlaceGrendelSiphoner_Init () {
    gt_PlaceGrendelSiphoner = TriggerCreate("gt_PlaceGrendelSiphoner_Func");
    TriggerAddEventUnitRegion(gt_PlaceGrendelSiphoner, null, RegionCircle(UnitGetPosition(UnitFromId(553916477)), 2.0), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Grendel Siphoner Dies
//--------------------------------------------------------------------------------------------------
bool gt_GrendelSiphonerDies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_finalCountdownStarted == true)) {
        TriggerExecute(gt_ObjectiveDefendSiphonersUpdate, true, false);
        TimerStart(gv_finalTimer, (TimerGetRemaining(gv_finalTimer) + 60.0), false, c_timeGame);
    }
    else {
        TriggerEnable(gt_PlaceGrendelSiphoner, true);
        gv_artifactChargeCurrent -= 450.0;
        gv_siphonersBuilt -= 1;
        TriggerExecute(gt_ObjectivePlaceSiphonersUpdate, true, false);
        PingSetVisible(gv_grendelPing, true);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_GrendelSiphonerDies_Init () {
    gt_GrendelSiphonerDies = TriggerCreate("gt_GrendelSiphonerDies_Func");
    TriggerAddEventUnitDied(gt_GrendelSiphonerDies, UnitRefFromVariable("gv_grendelSiphoner"));
}

