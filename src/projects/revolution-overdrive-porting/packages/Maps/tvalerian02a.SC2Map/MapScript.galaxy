//--------------------------------------------------------------------------------------------------
// Trigger: Achievement - Betty Kill
//--------------------------------------------------------------------------------------------------
bool gt_AchievementBettyKill_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(libNtve_gf_KillingUnit()) == "FlamingBetty"))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != 1))) {
            return false;
        }

        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_flamingBettyKills += 1;
    if ((libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1)) {
        libWoLC_gf_SetAchievementTermQuantityCampaign("Anniversary_TValerian02A", gv_flamingBettyKills);
        TextExpressionSetToken("Param/Expression/E821EAA3", "A", IntToText(gv_flamingBettyKills));
        TriggerDebugOutput(1, TextExpressionAssemble("Param/Expression/E821EAA3"), false);
    }

    return true;
}

