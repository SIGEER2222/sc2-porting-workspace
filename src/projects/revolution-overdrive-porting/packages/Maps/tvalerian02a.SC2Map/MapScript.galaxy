//--------------------------------------------------------------------------------------------------
// Trigger: Dominion Forward 1
//--------------------------------------------------------------------------------------------------
bool gt_DominionForward1_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_bullyRegion;
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bullyRegion = RegionFromId(20);
    lv_player = gv_p4_DOMINIONALLIES;

    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(lv_player, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 0))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(lv_player, lv_bullyRegion, true);
    libA9E65AFF_gf_ScriptBuildingProduction(UnitFromId(2034449465), AbilityCommand("BarracksTrain", 2), libA9E65AFF_gv_scriptBuildingsWaves);
    libCamp_gf_CreateMissionAutosavePoint((StringExternal("Param/Value/9245BF9C")));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DominionForward1_Init () {
    gt_DominionForward1 = TriggerCreate("gt_DominionForward1_Func");
    TriggerEnable(gt_DominionForward1, false);
    TriggerAddEventTimePeriodic(gt_DominionForward1, 5.0, c_timeGame);
}

