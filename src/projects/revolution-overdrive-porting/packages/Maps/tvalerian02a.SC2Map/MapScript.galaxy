        AIAttackWaveAddUnits4(5, 5, 6, 8, "HotSRaptor");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 2, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "Hunterling");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 3, libNtve_gf_DifficultyValueInt(1, 1, 2, 2), "LurkerMP");
        AIAttackWaveAddUnits4(12, 12, 15, 20, "HotSRaptor");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Hunterling");
        AIAttackWaveAddUnits4(1, 1, 2, 3, "LurkerMP");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 2, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "Hunterling");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 3, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "HotSTorrasque");
        libA9E65AFF_gf_SendFlexibleAttackWave("HotSRaptor", 220, 15, lv_aI, 40, true);
        AIAttackWaveAddUnits4(1, 1, 1, 2, "HotSTorrasque");
        AIAttackWaveAddUnits4(3, 3, 3, 4, "Hydralisk");
        AIAttackWaveAddUnits4(10, 10, 12, 15, "HotSRaptor");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 2, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "DefilerMP");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 3, libNtve_gf_DifficultyValueInt(1, 1, 2, 2), "HunterKiller");
        libA9E65AFF_gf_SendFlexibleAttackWave("HotSRaptor", 240, 15, lv_aI, 60, true);
        AIAttackWaveAddUnits4(1, 1, 1, 2, "HotSTorrasque");
        AIAttackWaveAddUnits4(12, 12, 15, 20, "HotSRaptor");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "HunterKiller");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Choker");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 2, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "DefilerMP");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 3, libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "HotSTorrasque");
        libA9E65AFF_gf_SendFlexibleAttackWave("HotSRaptor", 240, 15, lv_aI, 60, true);
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Hunterling");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "Hydralisk");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "LurkerMP");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 2, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "DefilerMP");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 3, libNtve_gf_DifficultyValueInt(1, 1, 1, 1), "Brutalisk");
