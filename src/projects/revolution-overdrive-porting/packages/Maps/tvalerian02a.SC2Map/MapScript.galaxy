    // Conditions
    if (testConds) {
        if (!((UnitCount(null, gv_p1_USER, RegionFromId(21), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0) >= 1))) {
            return false;
        }

        if (!((UnitIsAlive(UnitFromId(70773483)) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "HotSRaptor", 0, gv_p9_BROODMOTHER, gv_broodmotherCaveSpawnPoints[RandomInt(0, 3)], PointFromId(872847906));
    AISetGroupSuicide(UnitLastCreatedGroup(), true);
    Wait(2.0, c_timeGame);
    libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "HotSRaptor", 0, gv_p9_BROODMOTHER, gv_broodmotherCaveSpawnPoints[RandomInt(0, 3)], PointFromId(872847906));
    AISetGroupSuicide(UnitLastCreatedGroup(), true);
    Wait(2.0, c_timeGame);
    libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "RoachVile", 0, gv_p9_BROODMOTHER, gv_broodmotherCaveSpawnPoints[RandomInt(0, 3)], PointFromId(872847906));
    AISetGroupSuicide(UnitLastCreatedGroup(), true);
    Wait(2.0, c_timeGame);
    libNtve_gf_UnitCreateFacingPoint(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "Hydralisk", 0, gv_p9_BROODMOTHER, gv_broodmotherCaveSpawnPoints[RandomInt(0, 3)], PointFromId(872847906));
    AISetGroupSuicide(UnitLastCreatedGroup(), true);
