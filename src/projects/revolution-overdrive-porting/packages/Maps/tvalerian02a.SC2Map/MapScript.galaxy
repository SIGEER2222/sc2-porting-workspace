// Trigger: Zerg Reinforce 1
//--------------------------------------------------------------------------------------------------
bool gt_ZergReinforce1_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!(((GameGetMissionTime() >= 900.0) || (gv_chargesPlanted >= 1)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(gv_p5_GRENDEL, RegionFromId(42), true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Larva", gv_p5_GRENDEL, RegionFromId(42), AbilityCommand("LarvaTrain", 3), libA9E65AFF_gv_scriptBuildingsWaves);
    AIToggleBulliesInRegion(gv_p2_JORMUNGAND, RegionFromId(44), true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Larva", gv_p2_JORMUNGAND, RegionFromId(44), AbilityCommand("LarvaTrainSwarm", 0), libA9E65AFF_gv_scriptBuildingsWaves);
    AIToggleBulliesInRegion(gv_p6_BLIGHSPREADERS, RegionFromId(23), true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Larva", gv_p6_BLIGHSPREADERS, RegionFromId(23), AbilityCommand("LarvaTrainSwarm", 22), libA9E65AFF_gv_scriptBuildingsWaves);
    return true;
}

