//--------------------------------------------------------------------------------------------------
bool gt_BunkerRefill_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((libNtve_gf_TriggeringProgressUnitType() == "Bunker"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitCargoCreate(EventUnitProgressUnit(), "MengskMarine", 4);
