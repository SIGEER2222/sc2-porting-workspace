//--------------------------------------------------------------------------------------------------
// Trigger: Plant Seismic Charges Update
//--------------------------------------------------------------------------------------------------
bool gt_PlantSeismicChargesUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_chargesPlanted += 1;
    gv_caveIntensity += 1;
    libWCMI_gf_SetMissionObjectiveProgress("TValerian02A_1", gv_chargesPlanted);
    if ((gv_chargesPlanted >= 3)) {
        gv_gameOver = true;
        TriggerExecute(gt_ObjectivesComplete, true, false);
        TriggerEnable(gt_DefeatBaseDead, false);
        libWCMI_gf_RunMissionVictorySequence(gt_VictoryQ);
    }

    TriggerExecute(gt_EnvironmentalUpdate, true, false);
    return true;
}

