//--------------------------------------------------------------------------------------------------
// Trigger: 1 Start Game
//--------------------------------------------------------------------------------------------------
bool gt__1StartGame_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto7DA73A80_g;
    int auto7DA73A80_u;
    unit auto7DA73A80_var;

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeReal);
    gv_northCaveSpawnPoints[0] = PointFromId(238949824);
    gv_northCaveSpawnPoints[1] = PointFromId(952850033);
    gv_northCaveSpawnPoints[2] = PointFromId(1502145884);
    gv_northCaveSpawnPoints[3] = PointFromId(908390624);
    gv_sECaveSpawnPoints[0] = PointFromId(1201836748);
    gv_sECaveSpawnPoints[1] = PointFromId(1154213353);
    gv_sECaveSpawnPoints[2] = PointFromId(1310823477);
    gv_sECaveSpawnPoints[3] = PointFromId(840355533);
    gv_sWCaveSpawnPoints[0] = PointFromId(674963210);
    gv_sWCaveSpawnPoints[1] = PointFromId(200867708);
    gv_sWCaveSpawnPoints[2] = PointFromId(1372359935);
    gv_sWCaveSpawnPoints[3] = PointFromId(632187434);
    gv_broodmotherCaveSpawnPoints[0] = PointFromId(872847906);
    gv_broodmotherCaveSpawnPoints[1] = PointFromId(686021162);
    gv_broodmotherCaveSpawnPoints[2] = PointFromId(1791663751);
    gv_broodmotherCaveSpawnPoints[3] = PointFromId(676365757);
    TriggerEnable(gt_DefeatBaseDead, true);
    TriggerExecute(gt_ObjectivePlantSeismicChargesCreateQ, true, false);
    auto7DA73A80_g = UnitGroup("Beacon_Terran", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto7DA73A80_u = UnitGroupCount(auto7DA73A80_g, c_unitCountAll);
    for (;; auto7DA73A80_u -= 1) {
        auto7DA73A80_var = UnitGroupUnitFromEnd(auto7DA73A80_g, auto7DA73A80_u);
        if (auto7DA73A80_var == null) { break; }
        libNtve_gf_ShareVisionofUnit(auto7DA73A80_var, true, 1);
        libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingObjective", UnitGetPosition(auto7DA73A80_var), ColorWithAlpha(0.00, 100.00, 0.00, 0.00), 0.0, 270.0);
        PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/037C95CA"));
        libHots_gf_StorePingForUnit(auto7DA73A80_var, 1, PingLastCreated());
    }
    Wait(3.5, c_timeReal);
    libA9E65AFF_gf_GenerateTipPopup(StringExternal("Param/Value/14348D27"));
    SoundPlay(SoundLink("UI_TerranPing", -1), PlayerGroupAll(), 100.0, 0.0);
    Wait(3.0, c_timeReal);
    TriggerExecute(gt__1OpeningDialogueQ, true, false);
    TriggerExecute(gt__1TipStoryModeQ, true, false);
    TriggerEnable(gt_DominionForward1, true);
    TriggerEnable(gt_DominionForward2, true);
    TriggerEnable(gt_DominionForward3, true);
    Wait(60.0, c_timeGame);
    TriggerExecute(gt_DominionRevealedQ, true, false);
    Wait(30.0, c_timeGame);
    TriggerExecute(gt_ObjectiveKillNaishaCreateQ, true, false);
    AIAttackWaveSetTargetPatrol(gv_p9_BROODMOTHER, 0);
    AIAttackWaveUseUnit(gv_p9_BROODMOTHER, UnitFromId(70773483));
    AIAttackWaveAddWaypoint(gv_p9_BROODMOTHER, PointFromId(24290690), false);
    AIAttackWaveAddWaypoint(gv_p9_BROODMOTHER, PointFromId(523908396), false);
    AIAttackWaveAddWaypoint(gv_p9_BROODMOTHER, PointFromId(886917208), false);
    AIAttackWaveAddWaypoint(gv_p9_BROODMOTHER, PointFromId(1194905020), false);
    AIAttackWaveSend(gv_p9_BROODMOTHER, 10, true);
    Wait(210.0, c_timeGame);
    TimerStart(gv_caveTimer, gv_caveAngerLevel, false, c_timeGame);
    TimerWindowCreate(gv_caveTimer, StringExternal("Param/Value/8C76988C"), true, false);
    TimerWindowSetAnchor(gv_caveTimerWindow, c_anchorTop, 0, 35);
    TimerWindowShow(gv_caveTimerWindow, PlayerGroupAll(), true);
    TriggerEnable(gt_PeriodicCaveSpawns, true);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TValerian02ARaynor00032", 0), c_transmissionDurationAdd, 0.0, true);
    TransmissionWait(TransmissionLastSent(), 0.0);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    return true;
}

