//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto71ED18DF_g;
    int auto71ED18DF_u;
    unit auto71ED18DF_var;

    // Actions
    if (!runActions) {
        return true;
    }

    CampaignInitAI();
    TriggerExecute(libA9E65AFF_gt_UpgradeController, true, false);
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(gt_P5GrendelAttackWaves, true, false);
    TriggerExecute(gt_P3GarmAttackWaves, true, false);
    TriggerExecute(gt_P2JormungandAttackWaves, true, false);
    TriggerExecute(gt_P6BlightspreaderAttackWaves, true, false);
    TriggerExecute(gt_P7RavagerAttackWaves, true, false);
    TriggerExecute(gt_P8AbathurAttackWaves, true, false);
    TriggerExecute(gt_P4DominionAttacks, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    auto71ED18DF_g = UnitGroup("Bunker", gv_p4_DOMINIONALLIES, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto71ED18DF_u = UnitGroupCount(auto71ED18DF_g, c_unitCountAll);
    for (;; auto71ED18DF_u -= 1) {
        auto71ED18DF_var = UnitGroupUnitFromEnd(auto71ED18DF_g, auto71ED18DF_u);
        if (auto71ED18DF_var == null) { break; }
        UnitCargoCreate(auto71ED18DF_var, "MengskMarine", 4);
        UnitCargoCreate(auto71ED18DF_var, "MengskMarauder", 1);
    }
    return true;
}

