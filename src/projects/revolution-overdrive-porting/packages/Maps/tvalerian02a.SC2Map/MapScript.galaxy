//--------------------------------------------------------------------------------------------------
// Trigger: Broodmother's Venom
//--------------------------------------------------------------------------------------------------
bool gt_BroodmothersVenom_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(UnitFromId(70773483), c_unitPropLifePercent, c_unitPropCurrent) <= 95.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    while ((UnitIsAlive(UnitFromId(70773483)) == true)) {
        if ((UnitCountAlliance(gv_p9_BROODMOTHER, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(UnitFromId(70773483)), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) >= 2)) {
            UnitBehaviorAdd(UnitGroupRandomUnit(UnitGroup(null, libA9E65AFF_gv_player01, RegionCircle(UnitGetPosition(UnitFromId(70773483)), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0), c_unitCountAlive), "AcidicBlood", UnitFromId(70773483), 1);
            Wait(libNtve_gf_DifficultyValueFixed(20.0, 20.0, 15.0, 10.0), c_timeGame);
        }
        else {
            Wait(2.0, c_timeGame);
        }
    }
    return true;
}

