void gt_DefeatBaseDead_Init () {
    gt_DefeatBaseDead = TriggerCreate("gt_DefeatBaseDead_Func");
    TriggerEnable(gt_DefeatBaseDead, false);
    TriggerAddEventTimePeriodic(gt_DefeatBaseDead, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Victory
//--------------------------------------------------------------------------------------------------
bool gt_Victory_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UnitPauseAll(true);
    BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_bellyCompleteString, true);
    BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_leviathanKilledString, false);
    BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_shatterCompleteString, false);
    if ((gv_bonusComplete == true)) {
        BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_naishaKilledString, true);
    }

    BankSave(libA9E65AFF_gv_bonusBank);
    TriggerSendEvent("EndGameBackup");
    if ((ObjectiveGetState(gv_oBJPlantSeismicCharges) == c_objectiveStateCompleted) && (ObjectiveGetState(gv_oBJExfiltrate) == c_objectiveStateCompleted)) {
        libWoLC_gf_CampaignAwardAchievement("TValerian02A_1");
    }

    if ((libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1)) {
        libWoLC_gf_CampaignAwardAchievement("TValerian02A_2");
    }

    VictoryPanelAddAchievement("TValerian02A_1");
    VictoryPanelAddAchievement("TValerian02A_2");
    VictoryPanelAddAchievement("TValerian02A_3");
    VictoryPanelAddTrackedStatistic("UnitsKilledCount");
    VictoryPanelAddTrackedStatistic("UnitsTotalCount");
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/69D7946B"), IntToText(PlayerScoreValueGetAsInt(gv_p1_USER, "UnitsLostCount")));
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddTrackedStatistic("MineralsCollected");
    VictoryPanelAddTrackedStatistic("UnitsPeakCount");
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/D617830B"), IntToText(gv_allyKills));
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    libWCMI_gf_EndCampaignMission(gv_p1_USER, c_gameOverVictory);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Victory_Init () {
    gt_Victory = TriggerCreate("gt_Victory_Func");
}

