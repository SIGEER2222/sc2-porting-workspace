    // Automatic Variable Declarations
    unitgroup auto806DBDF4_g;
    int auto806DBDF4_u;
    unit auto806DBDF4_var;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto806DBDF4_g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32)) | (1 << (c_targetFilterAirUnit - 32))), 0);
    auto806DBDF4_u = UnitGroupCount(auto806DBDF4_g, c_unitCountAll);
    for (;; auto806DBDF4_u -= 1) {
        auto806DBDF4_var = UnitGroupUnitFromEnd(auto806DBDF4_g, auto806DBDF4_u);
        if (auto806DBDF4_var == null) { break; }
        if ((WorldHeight(c_heightMapGround, UnitGetPosition(auto806DBDF4_var)) <= 8.5) && (UnitGetType(auto806DBDF4_var) != "CommandCenterFlying") && (UnitGetType(auto806DBDF4_var) != "OrbitalCommandFlying") && (UnitGetType(auto806DBDF4_var) != "BarracksFlying") && (UnitGetType(auto806DBDF4_var) != "FactoryFlying")) {
            UnitBehaviorAddPlayer(auto806DBDF4_var, "LavaDamage", 15, 1);
        }

    }
    return true;
}

