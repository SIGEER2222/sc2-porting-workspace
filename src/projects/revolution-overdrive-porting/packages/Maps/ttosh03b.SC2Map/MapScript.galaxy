//--------------------------------------------------------------------------------------------------
bool gt_ShockTechRescue_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_rescueRegion;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_rescueRegion = RegionFromId(13);

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_RescueUnit2(UnitGroup(null, gv_pLAYER8_REINFORCEMENTS, lv_rescueRegion, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), 1, true);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03AMarauder00028", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    return true;
}

