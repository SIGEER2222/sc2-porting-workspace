//--------------------------------------------------------------------------------------------------
// Trigger: P1 Mineral Depot Destroyed
//--------------------------------------------------------------------------------------------------
bool gt_P1MineralDepotDestroyed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((EventUnit() == gv_p1MineralDepot))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UIDisplayMessage(PlayerGroupAll(), c_messageAreaSubtitle, StringExternal("Param/Value/967E8845"));
    TechTreeUpgradeAddLevel(1, "VulkanClassCombatSuit", 1);
    gv_objectivesDestroyed += 1;
    ActorSend(ActorFromDoodad(DoodadFromId(584)), "Signal DoodadDeath");
    Wait(2.0, c_timeGame);
    libNtve_gf_SendActorMessageToGameRegion(RegionCircle(Point(38.0, 86.0), 10.0), "Signal Nuked");
    libNtve_gf_RescueUnit(UnitFromId(1476230016), 1, true);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03BTosh00048", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    TriggerExecute(gt_ObjectiveDestroyUpdateMineralDepotQ, true, false);
    libNtve_gf_UnitCreateFacingPoint(4, "IronWarrior", 0, gv_pLAYER01_USER, PointFromId(2121225071), PointFromId(2121225071));
    libCamp_gf_CreateDropPod(libCamp_ge_DropPodRace_Terran, PointFromId(2121225071), UnitLastCreatedGroup(), true);
    libNtve_gf_UnitCreateFacingPoint(1, "VanguardGhost", 0, gv_pLAYER01_USER, PointFromId(2121225071), PointFromId(2121225071));
    libCamp_gf_CreateDropPod(libCamp_ge_DropPodRace_Terran, PointFromId(2121225071), UnitLastCreatedGroup(), true);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TRaynor01Raynor00039", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    if ((gv_objectivesDestroyed >= 3)) {
        libNtve_gf_MakeUnitInvulnerable(gv_nova, true);
        TriggerEnable(gt_GameOver, false);
        libNtve_gf_StopTimer(gv_voodooDollTimer);
        Wait(2.0, c_timeReal);
        gv_gameOver = true;
        TriggerExecute(gt_ObjectiveSurviveComplete, true, false);
        libWCMI_gf_RunMissionVictorySequence(gt_VictoryQ);
    }

    return true;
}

