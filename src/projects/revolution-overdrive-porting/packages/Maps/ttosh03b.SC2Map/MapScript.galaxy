    gt_StartAcidCycling = TriggerCreate("gt_StartAcidCycling_Func");
    TriggerAddEventUnitRegion(gt_StartAcidCycling, null, RegionFromId(4), true);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Acid Cycling
//--------------------------------------------------------------------------------------------------
bool gt_AcidCycling_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    while ((libWoLC_gf_MissionObjectiveStateCheck("TTosh03B_2", libWoLC_ge_MissionObjectiveState_Completed) == false)) {
        CameraShakeStart(1, c_cameraPositionTarget, c_cameraDirectionZ, 0.1, 2.0, 100.0, 4.0);
        SoundPlayForPlayer(SoundLink("Event_EarthquakeRumble", 0), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
        SoundPlayForPlayer(SoundLink("UI_TerranKlaxonAlert", 0), c_maxPlayers, PlayerGroupAll(), 150.0, 0.0);
        Wait(4.0, c_timeGame);
        CameraShakeStart(1, c_cameraPositionTarget, c_cameraDirectionZ, 0.06, 2.0, 100.0, 2.0);
        SoundPlay(SoundLink("TUILavaRising", -1), PlayerGroupAll(), 100.0, 0.0);
        WaterSetState("CharAcid|Alternate Setting", 6.0, c_wtcLinear);
        Wait(4.0, c_timeGame);
        TriggerEnable(gt_AcidDamage, true);
        Wait(10.0, c_timeGame);
        SoundPlay(SoundLink("TUILavaRising", -1), PlayerGroupAll(), 100.0, 0.0);
        WaterSetState("CharAcid|[Default]", 4.0, c_wtcLinear);
        Wait(2.0, c_timeGame);
        TriggerEnable(gt_AcidDamage, false);
        Wait(libNtve_gf_DifficultyValueFixed(25.0, 25.0, 20.0, 20.0), c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_AcidCycling_Init () {
    gt_AcidCycling = TriggerCreate("gt_AcidCycling_Func");
}

