//--------------------------------------------------------------------------------------------------
// Trigger: Init 06 Difficulties
//--------------------------------------------------------------------------------------------------
bool gt_Init06Difficulties_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto1EB222C5_g;
    int auto1EB222C5_u;
    unit auto1EB222C5_var;

    // Actions
    if (!runActions) {
        return true;
    }

    gv_timeLimit = libNtve_gf_DifficultyValueFixed(3600.0, 3600.0, 3300.0, 3000.0);
    auto1EB222C5_g = UnitGroup("HoldingPen", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    auto1EB222C5_u = UnitGroupCount(auto1EB222C5_g, c_unitCountAll);
    for (;; auto1EB222C5_u -= 1) {
        auto1EB222C5_var = UnitGroupUnitFromEnd(auto1EB222C5_g, auto1EB222C5_u);
        if (auto1EB222C5_var == null) { break; }
        UnitSetPropertyFixed(auto1EB222C5_var, c_unitPropLifeMax, libNtve_gf_DifficultyValueFixed(600.0, 600.0, 900.0, 1200.0));
        UnitSetPropertyFixed(auto1EB222C5_var, c_unitPropLifePercent, 100.0);
    }
    return true;
}

