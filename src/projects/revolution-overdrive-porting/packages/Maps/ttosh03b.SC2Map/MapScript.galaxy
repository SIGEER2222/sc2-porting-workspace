//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Q
//--------------------------------------------------------------------------------------------------
bool gt_StartGameQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup autoDA7719A8_g;
    int autoDA7719A8_var;

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(3.0, c_timeReal);
    autoDA7719A8_g = libA9E65AFF_gv_enemyPlayers;
    autoDA7719A8_var = -1;
    while (true) {
        autoDA7719A8_var = PlayerGroupNextPlayer(autoDA7719A8_g, autoDA7719A8_var);
        if (autoDA7719A8_var < 0) { break; }
        AISetDefenseRadii(autoDA7719A8_var, 12.0, 14.0, 14.0);
    }
    libA9E65AFF_gf_GenerateTipPopup(StringExternal("Param/Value/7B25AB90"));
    PlayerModifyPropertyFixed(1, c_playerPropTerrazine, c_playerPropOperSubtract, 1.0);
    TriggerExecute(gt_ObjectiveDestroyDiscoverQ, true, true);
    Wait(4.0, c_timeReal);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("TTosh03BRaynor00016", 0)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03BRaynor00016", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03BNova00002", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerExecute(gt_ObjectiveSurviveDiscoverQ, true, false);
    TriggerExecute(gt_TipStoryModeQ, true, false);
    TriggerQueueExit();
    return true;
}

