    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TimerStart(gv_voodooDollTimer, gv_timeLimit, false, c_timeGame);
    gv_voodooDollTimer = TimerLastStarted();
    libWCUI_gf_TimerWindowCreate(TimerLastStarted(), StringExternal("Param/Value/C6EAAFC9"), true, false);
    gv_voodooDollTimerWindow = TimerWindowLastCreated();
    TimerWindowShow(TimerWindowLastCreated(), PlayerGroupAll(), true);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03BTosh00022", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    return true;
}

