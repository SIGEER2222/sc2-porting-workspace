    auto_gf_SpawnZergFromPens_lp_pen = lp_pen;
    auto_gf_SpawnZergFromPens_lp_spawnPoint = lp_spawnPoint;

    if (auto_gf_SpawnZergFromPens_Trigger == null) {
        auto_gf_SpawnZergFromPens_Trigger = TriggerCreate("auto_gf_SpawnZergFromPens_TriggerFunc");
    }

    TriggerExecute(auto_gf_SpawnZergFromPens_Trigger, false, false);
}

bool auto_gf_SpawnZergFromPens_TriggerFunc (bool testConds, bool runActions) {
    unit lp_pen = auto_gf_SpawnZergFromPens_lp_pen;
    point lp_spawnPoint = auto_gf_SpawnZergFromPens_lp_spawnPoint;

    // Variable Declarations
    int lv_zergPlayer;
    int lv_rNG;

    // Automatic Variable Declarations
    int auto8FDE71BB_val;

    // Variable Initialization
    lv_zergPlayer = gv_pLAYER05_ULTRA;

    // Implementation
    while ((UnitIsAlive(lp_pen) == true)) {
        if ((UnitHasBehavior2(lp_pen, "PsiHijack") == false) && (UnitHasBehavior2(lp_pen, "Lockdown") == false)) {
            lv_rNG = RandomInt(0, 7);
            auto8FDE71BB_val = lv_rNG;
            if (auto8FDE71BB_val == 0) {
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(5, 5, 6, 8), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
            }
            else if (auto8FDE71BB_val == 1) {
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "RoachVile", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
            }
            else if (auto8FDE71BB_val == 2) {
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "Hydralisk", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
            }
            else if (auto8FDE71BB_val == 3) {
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(1, 1, 1, 1), "Ravager", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(2, 2, 2, 2), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
            }
            else if (auto8FDE71BB_val == 4) {
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(0, 0, 1, 1), "Hydralisk", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
            }
            else if (auto8FDE71BB_val == 5) {
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(2, 2, 2, 3), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(1, 1, 1, 1), "RoachCorpser", 0, lv_zergPlayer, lp_spawnPoint);
                UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
            }
            else if (auto8FDE71BB_val == 6) {
                if ((gv_sENDMORE == true)) {
                    libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(5, 6, 8, 4), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                    UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                    libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(0, 0, 0, 1), "Ultralisk", 0, lv_zergPlayer, lp_spawnPoint);
                    UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                }
                else {
                    libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                    UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                }
            }
            else if (auto8FDE71BB_val == 7) {
                if ((gv_sENDMORE == true)) {
                    libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(3, 3, 4, 4), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                    UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                    libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "RoachCorpser", 0, lv_zergPlayer, lp_spawnPoint);
                    UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                }
                else {
                    libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(4, 4, 5, 6), "HotSRaptor", 0, lv_zergPlayer, lp_spawnPoint);
                    UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                    libNtve_gf_CreateUnitsWithDefaultFacing(libNtve_gf_DifficultyValueInt(0, 0, 1, 1), "RoachVile", 0, lv_zergPlayer, lp_spawnPoint);
                    UnitGroupAddUnitGroup(gv_aggroGroup, UnitLastCreatedGroup());
                }
            }
            else {
            }
            if ((gv_sENDMORE == true)) {
                Wait(libNtve_gf_DifficultyValueFixed(10.0, 10.0, 8.0, 6.0), c_timeGame);
            }
            else {
                Wait(libNtve_gf_DifficultyValueFixed(12.0, 12.0, 10.0, 8.0), c_timeGame);
            }
        }
        else {
            Wait(1.0, c_timeGame);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Trigger: Initialization
//--------------------------------------------------------------------------------------------------
bool gt_Initialization_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libWoLC_gf_ULoadCampaignData("TTosh03B");
    TriggerExecute(gt_Init01Technology, true, true);
    TriggerExecute(gt_Init02Players, true, true);
    TriggerExecute(gt_Init03Units, true, true);
    TriggerExecute(gt_Init04Music, true, true);
    TriggerExecute(gt_Init05Environment, true, true);
    TriggerExecute(gt_Init06Difficulties, true, true);
    TriggerExecute(gt_Init07Objectives, true, true);
    TriggerExecute(gt_Init08Help, true, true);
    libWoLC_gf_RegisterFootageRecording(gt_BriefingQ);
    TriggerExecute(gt_IntroSequence, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Initialization_Init () {
    gt_Initialization = TriggerCreate("gt_Initialization_Func");
    TriggerAddEventMapInit(gt_Initialization);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Init 01 Technology
//--------------------------------------------------------------------------------------------------
bool gt_Init01Technology_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TechTreeAbilityAllow(gv_pLAYER01_USER, AbilityCommand("Yamato", 0), true);
    TriggerEnable(libA9E65AFF_gt_HerolessHeroPassiveUnitSpawns, false);
    TechTreeAbilityAllow(gv_pLAYER01_USER, AbilityCommand("ArmSiloWithNuke", 0), false);
    TechTreeUpgradeAddLevel(gv_pLAYER02_TOSH, "SiegeTech", 1);
    TechTreeUpgradeAddLevel(gv_pLAYER02_TOSH, "BansheeCloak", 1);
    TechTreeUpgradeAddLevel(gv_pLAYER02_TOSH, "YamatoCannon", 1);
    TechTreeUpgradeAddLevel(gv_pLAYER02_TOSH, "JackhammerConcussionGrenades", 1);
    TechTreeUpgradeAddLevel(gv_pLAYER01_USER, "SpecialForces", 1);
    TechTreeUpgradeAddLevel(gv_pLAYER01_USER, "ExpandedHullHerc", 1);
    TechTreeUpgradeAddLevel(gv_pLAYER01_USER, "EmergencyBoosters", 1);
    libA9E65AFF_gf_UpdateCommandCard("NovaPlayerHero");
    TechTreeAbilityAllow(gv_pLAYER02_TOSH, AbilityCommand("Obliterate", 0), true);
    TechTreeAbilityAllow(gv_pLAYER02_TOSH, AbilityCommand("UltrasonicPulse", 0), true);
    TechTreeAbilityAllow(gv_pLAYER01_USER, AbilityCommand("ArmSiloWithNuke", 0), false);
    TechTreeAbilityAllow(gv_pLAYER02_TOSH, AbilityCommand("RogueGhostCloak", 0), false);
    TechTreeAbilityAllow(gv_pLAYER01_USER, AbilityCommand("HeroSelection", 18), false);
