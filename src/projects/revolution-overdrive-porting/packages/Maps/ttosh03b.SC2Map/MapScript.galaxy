    UnitSetFacing(gv_nova, PointGetFacing(PointFromId(285)), 0.0);
    libNtve_gf_PauseUnit(gv_nova, false);
    libNtve_gf_CreateUnitsAtPoint2(1, "Marine", 0, gv_pLAYER02_TOSH, PointFromId(236));
