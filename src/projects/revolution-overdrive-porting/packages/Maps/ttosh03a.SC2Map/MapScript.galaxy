    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    PingDestroy(gv_cellBlock_C_Ping);
    TriggerExecute(gt_ObjectiveCellBlock_CCreateQ, true, false);
    if ((gv_cellBlocksFreed == 2)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "PermanentCloakSpectre", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/0A749141"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_cellBlocksFreed == 3)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "TerrazineFury", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/8B9B16AE"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    libWCMI_gf_ZS_SetMissionObjectiveState("TTosh03A_5", libWoLC_ge_MissionObjectiveState_Completed);
    Wait(libWCMI_gv_campaignObjectiveDelay, c_timeReal);
    return true;
}

