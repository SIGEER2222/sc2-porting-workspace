    libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, PointFromId(1943078184), UnitLastCreatedGroup(), true, gv_p2_RAYNOR_LIGHTBLUE);
    AISetGroupScriptControlled(lv_reinforceGroup, false);
    return true;
