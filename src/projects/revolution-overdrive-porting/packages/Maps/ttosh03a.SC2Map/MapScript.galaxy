//--------------------------------------------------------------------------------------------------
// Trigger: Init 06 Difficulties
//--------------------------------------------------------------------------------------------------
bool gt_Init06Difficulties_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto45497D82_g;
    int auto45497D82_var;
    playergroup autoB6AD81FD_g;
    int autoB6AD81FD_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto45497D82_g = gv_dominionPlayers;
    auto45497D82_var = -1;
    while (true) {
        auto45497D82_var = PlayerGroupNextPlayer(auto45497D82_g, auto45497D82_var);
        if (auto45497D82_var < 0) { break; }
        libNtve_gf_SetTacticalAIThink(auto45497D82_var, "Ghost", "GhostAI", false);
    }
    autoB6AD81FD_g = gv_raynorsRaiders;
    autoB6AD81FD_var = -1;
    while (true) {
        autoB6AD81FD_var = PlayerGroupNextPlayer(autoB6AD81FD_g, autoB6AD81FD_var);
        if (autoB6AD81FD_var < 0) { break; }
        libNtve_gf_SetTacticalAIThink(autoB6AD81FD_var, "Medic", "MedicAI", false);
    }
    if (((PlayerDifficulty(1) == 3 || PlayerDifficulty(1) == 4) == true)) {
        AISetDifficulty(gv_p3_DOMINION_RED, c_diffPressForward, true);
    }

    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        TriggerEnable(gt_ENEMYRavensActivateArea03Approached, true);
    }

    CatalogFieldValueSet(c_gameCatalogUnit, "NovaHero", "LifeStart", gv_p14_NOVA, FixedToString(libNtve_gf_DifficultyValueFixed(1250.0, 1250.0, 1500.0, 2000.0), c_fixedPrecisionAny));
    CatalogFieldValueSet(c_gameCatalogUnit, "NovaHero", "LifeMax", gv_p14_NOVA, FixedToString(libNtve_gf_DifficultyValueFixed(1250.0, 1250.0, 1500.0, 2000.0), c_fixedPrecisionAny));
    return true;
}

