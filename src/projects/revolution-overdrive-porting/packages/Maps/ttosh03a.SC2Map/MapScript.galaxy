        if (!((UnitGroupCount(UnitGroupAlliance(lv_player, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 0))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(lv_player, lv_bullyRegion, true);
    AIToggleBulliesInRegion(gv_p6_DOMINION_ORANGE, lv_bullyRegion, false);
    gv_topLaneCheckpoint1Cleared = true;
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    // Transmission - SoundLink("TTosh03ARaynor00006", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTosh03ARaynor00003", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/42EE12F2"));
    libNtve_gf_UnitCreateFacingPoint(5, "Marine", 0, gv_p2_RAYNOR_LIGHTBLUE, PointFromId(1486796035), PointFromId(5));
    UnitGroupAddUnitGroup(lv_reinforceGroup, UnitLastCreatedGroup());
    libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, PointFromId(1486796035), UnitLastCreatedGroup(), true, gv_p2_RAYNOR_LIGHTBLUE);
    libNtve_gf_UnitCreateFacingPoint(2, "SiegeTank", 0, gv_p2_RAYNOR_LIGHTBLUE, PointFromId(1259821276), PointFromId(5));
    UnitGroupAddUnitGroup(lv_reinforceGroup, UnitLastCreatedGroup());
    libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, PointFromId(1259821276), UnitLastCreatedGroup(), true, gv_p2_RAYNOR_LIGHTBLUE);
    AISetGroupScriptControlled(lv_reinforceGroup, false);
    return true;
}

