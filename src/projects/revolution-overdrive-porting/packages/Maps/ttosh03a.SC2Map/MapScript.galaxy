    // Automatic Variable Declarations
    playergroup auto687E6912_g;
    int auto687E6912_var;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
