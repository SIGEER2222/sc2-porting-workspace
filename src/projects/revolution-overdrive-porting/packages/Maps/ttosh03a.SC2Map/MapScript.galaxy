        TechTreeUpgradeAddLevel(auto687E6912_var, "MaelstromRounds", 1);
    }
    libWCMI_gf_ZS_SetMissionObjectiveState("TTosh03A_3", libWoLC_ge_MissionObjectiveState_Completed);
