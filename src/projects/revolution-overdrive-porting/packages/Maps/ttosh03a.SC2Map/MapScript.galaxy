//--------------------------------------------------------------------------------------------------
// Trigger: Stat - Enemies Killed By Nukes
//--------------------------------------------------------------------------------------------------
bool gt_StatEnemiesKilledByNukes_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }

        if (!(((UnitGetOwner(EventUnit()) == gv_p3_DOMINION_RED) || (UnitGetOwner(EventUnit()) == gv_p4_DOMINION_PURPLE) || (UnitGetOwner(EventUnit()) == gv_p5_DOMINION_GREY) || (UnitGetOwner(EventUnit()) == gv_p6_DOMINION_ORANGE) || (UnitGetOwner(EventUnit()) == gv_p10_DOMINIONWrecker) || (UnitGetOwner(EventUnit()) == gv_p13_DOMINIONCONSCRIPTS) || (UnitGetOwner(EventUnit()) == gv_p14_NOVA)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_enemiesKilledByNukes += 1;
    if ((libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1)) {
        libWoLC_gf_SetAchievementTermQuantityCampaign("Anniversary_TTosh03A", gv_enemiesKilledByNukes);
        TextExpressionSetToken("Param/Expression/80B7A938", "A", IntToText(gv_enemiesKilledByNukes));
        TriggerDebugOutput(1, TextExpressionAssemble("Param/Expression/80B7A938"), false);
    }

    return true;
}

