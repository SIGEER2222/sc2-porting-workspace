        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    if ((GameGetMissionTime() >= 600.0)) {
        libNtve_gf_UnitCreateFacingPoint(2, "VikingFighter", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
        libNtve_gf_UnitCreateFacingPoint(2, "Firebat", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    if ((GameGetMissionTime() >= 900.0) && (lv_scienceVesselRNG >= 4)) {
        libNtve_gf_UnitCreateFacingPoint(1, "ScienceVessel", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    if ((GameGetMissionTime() >= 1080.0)) {
        libNtve_gf_UnitCreateFacingPoint(2, "SiegeTank", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
        libNtve_gf_UnitCreateFacingPoint(1, "Banshee", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    if ((GameGetMissionTime() >= 1500.0)) {
        libNtve_gf_UnitCreateFacingPoint(2, "MengskMarine", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    if ((GameGetMissionTime() >= 1800.0)) {
        libNtve_gf_UnitCreateFacingPoint(1, "Thor", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    if ((GameGetMissionTime() >= 2100.0)) {
        libNtve_gf_UnitCreateFacingPoint(2, "MengskMarine", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    if ((GameGetMissionTime() >= 2400.0)) {
        libNtve_gf_UnitCreateFacingPoint(1, "Battlecruiser", 0, lp_player, lv_spawnPoint, lv_spawnPoint);
        UnitGroupAddUnitGroup(lv_attackWaveGroup, UnitLastCreatedGroup());
        libWCMI_gf_CreateDropPod(libWCMI_ge_DropPodRace_Terran, lv_spawnPoint, UnitLastCreatedGroup(), false, lp_player);
    }

    auto51CE92F3_g = lv_attackWaveGroup;
    auto51CE92F3_u = UnitGroupCount(auto51CE92F3_g, c_unitCountAll);
    for (;; auto51CE92F3_u -= 1) {
        auto51CE92F3_var = UnitGroupUnitFromEnd(auto51CE92F3_g, auto51CE92F3_u);
        if (auto51CE92F3_var == null) { break; }
        AISetGroupScriptControlled(lv_attackWaveGroup, false);
    }
    Wait(5.0, c_timeGame);
    AIAttackWaveUseGroup(lp_player, lv_attackWaveGroup);
    AIAttackWaveSend(lp_player, 1, true);
    return true;
}

void gf_GhostAI (int lp_owner, unit lp_ghost, unitgroup lp_candidates) {
    // Variable Declarations
    order lv_snipeOrder;
    marker lv_snipeMarker;
    aifilter lv_snipeFilter;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_snipeMarker = null;
    lv_snipeFilter = AIFilter(lp_owner);

    // Implementation
    if ((((PlayerDifficulty(1) == 1 || PlayerDifficulty(1) == 2) == true) || (UnitGetPropertyFixed(gv_tosh, c_unitPropLife, c_unitPropCurrent) < libNtve_gf_DifficultyValueFixed(250.0, 250.0, 250.0, 200.0)))) {
        UnitGroupRemove(lp_candidates, gv_tosh);
    }

    AISetFilterAlliance(lv_snipeFilter, c_playerGroupEnemy);
    AISetFilterBits(lv_snipeFilter, libNtve_gf_ConvertTargetFilterStringToUnitFilter(CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "TargetFilters[" + IntToString(0) + "]", lp_owner)));
    AISetFilterRange(lv_snipeFilter, lp_ghost, (StringToFixed(CatalogFieldValueGet(c_gameCatalogAbil, "Snipe", "Range[" + IntToString(0) + "]", lp_owner)) + 1.0));
    AISetFilterLifePerMarker(lv_snipeFilter, StringToFixed(CatalogFieldValueGet(c_gameCatalogEffect, "SnipeDamage", "Amount", lp_owner)), lv_snipeMarker);
    lp_candidates = AIGetFilterGroup(lv_snipeFilter, lp_candidates);
    lv_snipeOrder = OrderTargetingUnit(AbilityCommand("Snipe", 0), UnitGroupUnit(lp_candidates, 1));
    if ((UnitOrderIsValid(lp_ghost, lv_snipeOrder) == true)) {
        AICast(lp_ghost, lv_snipeOrder, lv_snipeMarker, false);
    }

}

void gf_MedicAI (int lp_owner, unit lp_medic, unitgroup lp_candidates) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitGetPropertyFixed(gv_tosh, c_unitPropLifePercent, c_unitPropCurrent) < 100.0) && (DistanceBetweenPoints(UnitGetPosition(gv_tosh), UnitGetPosition(lp_medic)) <= 6.0)) {
        libNtve_gf_AICast(lp_medic, OrderTargetingUnit(AbilityCommand("heal", 0), gv_tosh));
    }

}

//--------------------------------------------------------------------------------------------------
// Trigger: Open Bank
//--------------------------------------------------------------------------------------------------
bool gt_OpenBank_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(1.0, c_timeGame);
    TriggerExecute(libA9E65AFF_gt_OpenUpgradeBank, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_OpenBank_Init () {
    gt_OpenBank = TriggerCreate("gt_OpenBank_Func");
    TriggerAddEventMapInit(gt_OpenBank);
    TriggerAddEventLoadGameDone(gt_OpenBank);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Initialization
//--------------------------------------------------------------------------------------------------
bool gt_Initialization_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libWoLC_gf_ULoadCampaignData("TTosh03A");
    TriggerExecute(gt_Init01Technology, true, true);
    TriggerExecute(gt_Init02Players, true, true);
    TriggerExecute(gt_Init03Units, true, true);
    TriggerExecute(gt_Init04Music, true, true);
    TriggerExecute(gt_Init05Environment, true, true);
    TriggerExecute(gt_Init06Difficulties, true, true);
    TriggerExecute(gt_Init07Help, true, true);
    libWoLC_gf_RegisterFootageRecording(gt_BriefingQ);
    TriggerExecute(gt_IntroSequence, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
