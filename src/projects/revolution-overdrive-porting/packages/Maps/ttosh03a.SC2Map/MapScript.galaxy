    gt_StatEnemiesKilledByNukes = TriggerCreate("gt_StatEnemiesKilledByNukes_Func");
    TriggerAddEventUnitDamaged(gt_StatEnemiesKilledByNukes, null, c_unitDamageTypeAny, c_unitDamageFatal, "SpectreNukeDamage");
}

