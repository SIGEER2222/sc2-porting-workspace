//--------------------------------------------------------------------------------------------------
// Trigger: ALLY Attack Waves - Cell Block A
//--------------------------------------------------------------------------------------------------
bool gt_ALLYAttackWavesCellBlockA_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoCF6BBBEF_g;
    int autoCF6BBBEF_u;
    unit autoCF6BBBEF_var;

    // Actions
    if (!runActions) {
        return true;
    }

    libNtve_gf_RescueUnit(UnitGroupUnit(UnitGroup("Diamondback", 0, RegionFromId(18), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), 1), gv_p11_RAYNOR_TOP, true);
    autoCF6BBBEF_g = UnitGroup("Diamondback", gv_p11_RAYNOR_TOP, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoCF6BBBEF_u = UnitGroupCount(autoCF6BBBEF_g, c_unitCountAll);
    for (;; autoCF6BBBEF_u -= 1) {
        autoCF6BBBEF_var = UnitGroupUnitFromEnd(autoCF6BBBEF_g, autoCF6BBBEF_u);
        if (autoCF6BBBEF_var == null) { break; }
        UnitSetState(autoCF6BBBEF_var, c_unitStateTargetable, true);
        UnitSetState(autoCF6BBBEF_var, c_unitStateStatusBar, true);
        UnitSetState(autoCF6BBBEF_var, c_unitStateInvulnerable, false);
    }
    gf_SetWaypoints(gv_p11_RAYNOR_TOP, 8, gv_waypointCount);
    AIAttackWaveAddUnits4(1, 1, 1, 1, "Diamondback");
    AIAttackWaveSend(gv_p11_RAYNOR_TOP, 0, false);
    return true;
}

