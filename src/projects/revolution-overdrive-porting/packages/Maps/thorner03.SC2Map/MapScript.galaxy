//--------------------------------------------------------------------------------------------------
// Trigger: Objective Devourer Sample Update
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveDevourerSampleUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "DevourerTissueSampleTube"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_devourerSamplesFound += 1;
    TriggerExecute(gt_ObjectiveDevourerSamplesCreateQ, true, false);
    UIAlertPoint("Trigger", gv_p01_USER, StringExternal("Param/Value/FAEB47D8"), null, UnitGetPosition(EventUnit()));
    libWCMI_gf_DisplayMissionObjectiveRewardFloatingText(UnitGetPosition(EventUnit()), "THorner03_6");
    UnitKill(EventUnit());
    libWCMI_gf_SetMissionObjectiveProgress("THorner03_6", gv_devourerSamplesFound);
    if ((gv_devourerSamplesFound == 2)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "VulcanClassMunitions", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/767A9FAF"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_devourerSamplesFound == gv_devourerSamplesTotal)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "V3RocketryServos", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/AF0DF3C2"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
        TriggerExecute(gt_ObjectiveCerebrateSamplesComplete, true, true);
    }

    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/98DA56FF"));
    TriggerExecute(gt_TransmissionFindCerebrateSamplesQ, true, false);
    return true;
}

