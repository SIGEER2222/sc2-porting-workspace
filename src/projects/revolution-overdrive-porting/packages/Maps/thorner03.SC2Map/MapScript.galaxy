void gt_LokiBombardmentLines_Init () {
    gt_LokiBombardmentLines = TriggerCreate("gt_LokiBombardmentLines_Func");
    TriggerAddEventTimePeriodic(gt_LokiBombardmentLines, 0.5, c_timeGame);
}

