    int auto3735A43F_u;
    unit auto3735A43F_var;
    unitgroup auto63649A21_g;
    int auto63649A21_u;
    unit auto63649A21_var;

    // Actions
    if (!runActions) {
        return true;
    }

    CampaignInitAI();
    gv_waypointArrayAlphaSquadron[0] = ge_AttackWaypoints_OdinTop;
    gv_waypointArrayAlphaSquadron[1] = ge_AttackWaypoints_Right;
    gv_waypointArrayAlphaSquadron[2] = ge_AttackWaypoints_OdinBottom;
    gv_waypointArraySpecOps[0] = ge_AttackWaypoints_Right;
    gv_waypointArraySpecOps[1] = ge_AttackWaypoints_MainDrop;
    gv_waypointArraySpecOps[2] = ge_AttackWaypoints_OdinBottom;
    gv_waypointArrayEliteGuard[0] = ge_AttackWaypoints_Odin;
    gv_waypointArrayEliteGuard[1] = ge_AttackWaypoints_LeftExpo;
    gv_waypointArrayHellriders[0] = ge_AttackWaypoints_OdinBottom;
    gv_waypointArrayHellriders[1] = ge_AttackWaypoints_MainDrop;
    gv_waypointArrayInfantry[0] = ge_AttackWaypoints_Odin;
    gv_waypointArrayInfantry[1] = ge_AttackWaypoints_Right;
    TriggerExecute(libA9E65AFF_gt_UpgradeController, true, false);
    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        TriggerExecute(gt_P4EliteAttacks, true, false);
    }

    TriggerExecute(gt_P5AlphaSquadronAttacks, true, false);
    TriggerExecute(gt_P6HellriderAttacks, true, false);
    TriggerExecute(gt_P7SpecOpsAttacks, true, false);
    TriggerExecute(gt_P8InfantryAttacks, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        TriggerExecute(gt_P7Nukes, true, false);
    }

    autoDAD48022_g = UnitGroup("Bunker", gv_p04_ELITEGUARD, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    autoDAD48022_u = UnitGroupCount(autoDAD48022_g, c_unitCountAll);
    for (;; autoDAD48022_u -= 1) {
        autoDAD48022_var = UnitGroupUnitFromEnd(autoDAD48022_g, autoDAD48022_u);
        if (autoDAD48022_var == null) { break; }
        UnitCargoCreate(autoDAD48022_var, "MengskMarine", libNtve_gf_DifficultyValueInt(4, 4, 4, 4));
        UnitCargoCreate(autoDAD48022_var, "MengskMarauder", libNtve_gf_DifficultyValueInt(1, 1, 1, 1));
    }
    auto9F4D6911_g = UnitGroup("Bunker", gv_p08_INFANTRY, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    auto9F4D6911_u = UnitGroupCount(auto9F4D6911_g, c_unitCountAll);
    for (;; auto9F4D6911_u -= 1) {
        auto9F4D6911_var = UnitGroupUnitFromEnd(auto9F4D6911_g, auto9F4D6911_u);
        if (auto9F4D6911_var == null) { break; }
        UnitCargoCreate(auto9F4D6911_var, "Marine", libNtve_gf_DifficultyValueInt(4, 4, 4, 4));
        UnitCargoCreate(auto9F4D6911_var, "MengskMarauder", libNtve_gf_DifficultyValueInt(1, 1, 1, 1));
    }
    autoB7DE9CB8_g = UnitGroup("Bunker", gv_p06_HELLRIDERS, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    autoB7DE9CB8_u = UnitGroupCount(autoB7DE9CB8_g, c_unitCountAll);
    for (;; autoB7DE9CB8_u -= 1) {
        autoB7DE9CB8_var = UnitGroupUnitFromEnd(autoB7DE9CB8_g, autoB7DE9CB8_u);
        if (autoB7DE9CB8_var == null) { break; }
        UnitCargoCreate(autoB7DE9CB8_var, "Marine", libNtve_gf_DifficultyValueInt(4, 4, 4, 4));
        UnitCargoCreate(autoB7DE9CB8_var, "Reaper", libNtve_gf_DifficultyValueInt(1, 1, 1, 2));
    }
    auto3735A43F_g = UnitGroup("Bunker", gv_p05_ALPHASQUADRON, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    auto3735A43F_u = UnitGroupCount(auto3735A43F_g, c_unitCountAll);
    for (;; auto3735A43F_u -= 1) {
        auto3735A43F_var = UnitGroupUnitFromEnd(auto3735A43F_g, auto3735A43F_u);
        if (auto3735A43F_var == null) { break; }
        UnitCargoCreate(auto3735A43F_var, "MengskMarine", libNtve_gf_DifficultyValueInt(3, 3, 3, 3));
        UnitCargoCreate(auto3735A43F_var, "Reaper", libNtve_gf_DifficultyValueInt(1, 1, 1, 2));
    }
    auto63649A21_g = UnitGroup("Bunker", gv_p07_SHADOWOPS, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    auto63649A21_u = UnitGroupCount(auto63649A21_g, c_unitCountAll);
    for (;; auto63649A21_u -= 1) {
        auto63649A21_var = UnitGroupUnitFromEnd(auto63649A21_g, auto63649A21_u);
        if (auto63649A21_var == null) { break; }
        UnitCargoCreate(auto63649A21_var, "Ghost", libNtve_gf_DifficultyValueInt(3, 3, 3, 3));
    }
    return true;
}

