        AIAttackWaveAddUnits4(6, 6, 7, 8, "HellionTank");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Cyclone");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Goliath");
