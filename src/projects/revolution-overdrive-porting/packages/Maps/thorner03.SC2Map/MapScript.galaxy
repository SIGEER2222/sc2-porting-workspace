//--------------------------------------------------------------------------------------------------
// Trigger: Loki Bombardment Lines
//--------------------------------------------------------------------------------------------------
bool gt_LokiBombardmentLines_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(gv_loki, c_unitPropLifePercent, c_unitPropCurrent) <= 85.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    while (true) {
        if ((UnitCountAlliance(gv_p10_DOMINION_LOKI, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_loki), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) >= 3)) {
            UnitIssueOrder(UnitFromId(654715208), OrderTargetingPoint(AbilityCommand("TitanMechBombardment", 0), UnitGetPosition(UnitGroupRandomUnit(UnitGroupAlliance(gv_p10_DOMINION_LOKI, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_loki), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive))), c_orderQueueReplace);
            Wait(2.0, c_timeGame);
            if ((UnitGetPropertyFixed(gv_loki, c_unitPropLifePercent, c_unitPropCurrent) <= 55.0)) {
                UnitIssueOrder(UnitFromId(659862629), OrderTargetingPoint(AbilityCommand("TitanMechBombardment", 0), UnitGetPosition(UnitGroupRandomUnit(UnitGroupAlliance(gv_p10_DOMINION_LOKI, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_loki), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive))), c_orderQueueReplace);
            }

            Wait(2.0, c_timeGame);
            if ((UnitGetPropertyFixed(gv_loki, c_unitPropLifePercent, c_unitPropCurrent) <= 35.0) && (libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
                UnitIssueOrder(UnitFromId(1932358965), OrderTargetingPoint(AbilityCommand("TitanMechBombardment", 0), UnitGetPosition(UnitGroupRandomUnit(UnitGroupAlliance(gv_p10_DOMINION_LOKI, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_loki), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive))), c_orderQueueReplace);
            }

            Wait(libNtve_gf_DifficultyValueFixed(28.0, 28.0, 24.0, 18.0), c_timeGame);
        }
        else {
            Wait(2.0, c_timeGame);
        }
    }
    return true;
}

