bool gt_P6HellriderAttacks_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = 6;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(131));
    Wait(180.0, c_timeGame);
    AIAttackWaveAddWaypoint(lv_aI, PointFromId(1823866753), false);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Vulture");
    AIAttackWaveAddUnits4(2, 2, 3, 4, "MengskMarine");
    libA9E65AFF_gf_SendFlexibleAttackWave("Marine", 120, 5, lv_aI, 40, true);
    gf_SetAttackWaypoints(gv_waypointArrayHellriders[RandomInt(0, 1)], lv_aI);
