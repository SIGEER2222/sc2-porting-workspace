//--------------------------------------------------------------------------------------------------
// Trigger: Increment Scrap Count
//--------------------------------------------------------------------------------------------------
bool gt_IncrementScrapCount_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    string autoCC561197_val;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!(((UnitGetType(EventUnit()) == "ScrapSmall") || (UnitGetType(EventUnit()) == "ScrapLarge")))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    autoCC561197_val = UnitGetType(EventUnit());
    if (autoCC561197_val == "ScrapSmall") {
        gv_scrapCollected += 1;
        libNtve_gf_SetBehaviorCount(gv_odin, "OdinStatScaling", gv_odin, gv_scrapCollected);
        SoundPlayForPlayer(SoundLink("UI_ResourcePickup", -1), c_maxPlayers, PlayerGroupAll(), 110.0, 0.0);
        TextTagCreate(StringExternal("Param/Value/6FE3CA68"), 24, UnitGetPosition(EventUnit()), 2.0, true, false, PlayerGroupAll());
        TextTagSetVelocity(TextTagLastCreated(), 0.7, 90.0);
        TextTagSetBackgroundImage(TextTagLastCreated(), "Assets\\Textures\\blank.dds", true);
        TextTagShowBackground(TextTagLastCreated(), true);
        TextTagSetTime(TextTagLastCreated(), c_textTagTimeDuration, 3.0);
        TriggerExecute(gt_ObjectiveCollectScrapUpdate, true, false);
    }
    else if (autoCC561197_val == "ScrapLarge") {
        gv_scrapCollected += 5;
        libNtve_gf_SetBehaviorCount(gv_odin, "OdinStatScaling", gv_odin, gv_scrapCollected);
        SoundPlayForPlayer(SoundLink("UI_ResourcePickup", -1), c_maxPlayers, PlayerGroupAll(), 110.0, 0.0);
        TextTagCreate(StringExternal("Param/Value/B88F0B48"), 24, UnitGetPosition(EventUnit()), 2.0, true, false, PlayerGroupAll());
        TextTagSetVelocity(TextTagLastCreated(), 0.7, 90.0);
        TextTagSetBackgroundImage(TextTagLastCreated(), "Assets\\Textures\\blank.dds", true);
        TextTagShowBackground(TextTagLastCreated(), true);
        TextTagSetTime(TextTagLastCreated(), c_textTagTimeDuration, 3.0);
        TriggerExecute(gt_ObjectiveCollectScrapUpdate, true, false);
    }
    else {
    }
    return true;
}

