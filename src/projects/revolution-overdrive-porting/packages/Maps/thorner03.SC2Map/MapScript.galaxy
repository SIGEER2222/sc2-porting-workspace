//--------------------------------------------------------------------------------------------------
// Trigger: Odin Rampage Begins
//--------------------------------------------------------------------------------------------------
bool gt_OdinRampageBegins_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_inCinematic == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    UnitBehaviorRemove(gv_odin, "AFK", 1);
    TriggerEnable(gt_Odin80ScrapUpgrade, false);
    TriggerEnable(gt_Odin40ScrapUpgrade, false);
    TriggerEnable(gt_Odin160ScrapUpgrade, false);
    TriggerEnable(gt_Odin200ScrapUpgrade, false);
    TriggerEnable(gt_Odin120ScrapUpgrade, false);
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/1EF6E14D"));
    TimerWindowDestroy(gv_odinTimerWindow);
    TriggerExecute(gt_ObjectiveCollectScrapComplete, true, false);
    UnitIssueOrder(UnitFromId(609964978), Order(AbilityCommand("HybridDoorsWideRightLowered", 0)), c_orderQueueReplace);
    TriggerEnable(gt_IncrementScrapCount, false);
    TriggerEnable(gt_TransmissionTychusTakesBreakAfterP04BaseQ, false);
    TriggerEnable(gt_TransmissionTychusTakesBreakAfterP08BaseQ, false);
    TriggerEnable(gt_TransmissionTychusTakesBreakAfterP06BaseQ, false);
    libNtve_gf_StopTimer(gv_warningTimer1);
    libNtve_gf_StopTimer(gv_warningTimer2);
    libNtve_gf_StopTimer(gv_warningTimer3);
    Wait(5.0, c_timeGame);
    TriggerExecute(gt_ObjectiveDestroytheLokiCreate, true, false);
    Wait(90.0, c_timeGame);
    TriggerQueueEnter();
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(UnitFromId(2), SoundLink("THorner03Tychus00019", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    TriggerEnable(gt_TransmissionTychusNoticesRaynorsUnitsQ, true);
    while (true) {
        Wait(10.0, c_timeGame);
        libNtve_gf_MakeUnitInvulnerable(gv_odin, false);
        UnitIssueOrder(gv_odin, OrderTargetingPoint(AbilityCommand("attack", 0), UnitGetPosition(UnitFromId(835))), c_orderQueueReplace);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_OdinRampageBegins_Init () {
    gt_OdinRampageBegins = TriggerCreate("gt_OdinRampageBegins_Func");
    TriggerAddEventTimer(gt_OdinRampageBegins, gv_odinTimer);
}

