//--------------------------------------------------------------------------------------------------
bool gt_P7Nukes_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(900.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(0, gv_p07_SHADOWOPS, true);
    Wait(300.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(libNtve_gf_DifficultyValueInt(0, 0, 0, 1), gv_p07_SHADOWOPS, true);
    Wait(300.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(libNtve_gf_DifficultyValueInt(0, 0, 1, 1), gv_p07_SHADOWOPS, true);
    Wait(240.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(libNtve_gf_DifficultyValueInt(0, 0, 1, 1), gv_p07_SHADOWOPS, true);
    Wait(240.0, c_timeGame);
    libA9E65AFF_gf_UseNukesRandom(libNtve_gf_DifficultyValueInt(0, 0, 1, 1), gv_p07_SHADOWOPS, true);
