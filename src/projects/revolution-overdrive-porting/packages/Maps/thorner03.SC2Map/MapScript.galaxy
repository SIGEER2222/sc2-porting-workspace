//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoDAD48022_g;
    int autoDAD48022_u;
    unit autoDAD48022_var;
    unitgroup auto9F4D6911_g;
    int auto9F4D6911_u;
    unit auto9F4D6911_var;
    unitgroup autoB7DE9CB8_g;
    int autoB7DE9CB8_u;
    unit autoB7DE9CB8_var;
