void gf_SetAttackWaypoints (int lp_attackRoute, int lp_player) {
    // Automatic Variable Declarations
    int autoCFAFA10D_val;

    // Implementation
    autoCFAFA10D_val = lp_attackRoute;
    if (autoCFAFA10D_val == ge_AttackWaypoints_LeftExpo) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(2093248170), true);
    }
    else if (autoCFAFA10D_val == ge_AttackWaypoints_Odin) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(663496393), true);
    }
    else if (autoCFAFA10D_val == ge_AttackWaypoints_OdinBottom) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(294265029), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1312442856), false);
    }
    else if (autoCFAFA10D_val == ge_AttackWaypoints_OdinTop) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1188539215), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(663496393), false);
    }
    else if (autoCFAFA10D_val == ge_AttackWaypoints_Right) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1823866753), false);
    }
    else if (autoCFAFA10D_val == ge_AttackWaypoints_MainDrop) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1563158071), true);
    }
    else {
    }
}

void gf_AddWaypointToExpansion (int lp_p) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitGroupCount(UnitGroup(null, gv_p01_USER, RegionFromId(31), UnitFilter((1 << c_targetFilterPreventReveal), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 1), c_unitCountAlive) > 0)) {
        if ((lp_p == gv_p05_ALPHASQUADRON)) {
            AIAttackWaveAddWaypoint(lp_p, PointFromId(211), false);
        }

        AIAttackWaveAddWaypoint(lp_p, PointFromId(206), false);
    }

}

//--------------------------------------------------------------------------------------------------
// Trigger: Open Bank
//--------------------------------------------------------------------------------------------------
bool gt_OpenBank_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(1.0, c_timeGame);
    TriggerExecute(libA9E65AFF_gt_OpenUpgradeBank, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_OpenBank_Init () {
    gt_OpenBank = TriggerCreate("gt_OpenBank_Func");
    TriggerAddEventMapInit(gt_OpenBank);
    TriggerAddEventLoadGameDone(gt_OpenBank);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Initialization
//--------------------------------------------------------------------------------------------------
bool gt_Initialization_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    libWoLC_gf_ULoadCampaignData("THorner03");
    TriggerExecute(gt_Init01Technology, true, true);
    TriggerExecute(gt_Init02Players, true, true);
    TriggerExecute(gt_Init03Units, true, true);
    TriggerExecute(gt_Init04Music, true, true);
    TriggerExecute(gt_Init05Environment, true, true);
    TriggerExecute(gt_Init06Difficulty, true, true);
    TriggerExecute(gt_Init07Help, true, true);
    libWoLC_gf_RegisterFootageRecording(gt_BriefingQ);
    TriggerExecute(gt_IntroSequence, true, false);
    return true;
}

