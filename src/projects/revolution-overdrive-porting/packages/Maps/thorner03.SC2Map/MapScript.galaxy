    gf_SetAttackWaypoints(gv_waypointArrayHellriders[RandomInt(0, 1)], lv_aI);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Diamondback");
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Banshee");
    AIAttackWaveAddUnits4(1, 1, 2, 2, "Wraith");
    libA9E65AFF_gf_SendFlexibleAttackWave("Vulture", 240, 5, lv_aI, 60, true);
    gf_SetAttackWaypoints(gv_waypointArrayHellriders[RandomInt(0, 1)], lv_aI);
    AIAttackWaveAddUnits4(4, 4, 5, 6, "Cyclone");
    AIAttackWaveAddUnits4(5, 5, 6, 8, "MengskHellion");
    AIAttackWaveAddUnits4(5, 5, 6, 8, "MengskMarine");
    AIAttackWaveAddUnits4(1, 1, 1, 1, "ScienceVessel");
    libA9E65AFF_gf_SendFlexibleAttackWave("Vulture", 240, 5, lv_aI, 60, true);
    while (true) {
        Wait(1.0, c_timeGame);
