//--------------------------------------------------------------------------------------------------
// Trigger: Objective Kill Cerberus Complete
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveCerebrateSamplesComplete2_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitCount("Hive", gv_p11_Zerg, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterBuried) | (1 << c_targetFilterCloaked), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) == 0))) {
            return false;
        }

        if (!((UnitCount("Hatchery", gv_p11_Zerg, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterBuried) | (1 << c_targetFilterCloaked), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) == 0))) {
            return false;
        }

        if (!((UnitCount("Lair", gv_p11_Zerg, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile) | (1 << c_targetFilterBuried) | (1 << c_targetFilterCloaked), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_bonusComplete = true;
    PingDestroy(gv_cerberusPing);
    TriggerExecute(gt_ObjectiveKillCerberusCreate, true, false);
    libWCMI_gf_ZS_SetMissionObjectiveState("THorner03_7", libWoLC_ge_MissionObjectiveState_Completed);
    Wait(libWCMI_gv_campaignObjectiveDelay, c_timeGame);
    return true;
}

