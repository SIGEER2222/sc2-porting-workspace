//--------------------------------------------------------------------------------------------------
// Trigger: Briefing Zerg Respawn
//--------------------------------------------------------------------------------------------------
bool gt_BriefingZergRespawn_Func (bool testConds, bool runActions) {
    // Variable Declarations
    point lv_randomSpot;
    int lv_i;
    int lv_index;

    // Automatic Variable Declarations
    const int auto6EBA6C19_ae = 4;
    const int auto6EBA6C19_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == gv_p02_LEVIATHANBROOD))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_i = 1;
    for ( ; ( (auto6EBA6C19_ai >= 0 && lv_i <= auto6EBA6C19_ae) || (auto6EBA6C19_ai < 0 && lv_i >= auto6EBA6C19_ae) ) ; lv_i += auto6EBA6C19_ai ) {
        if ((UnitGroupHasUnit(gv_briefingSlaughterAreas[lv_i].lv_zergGroup, EventUnit()) == true)) {
            lv_index = lv_i;
            break;
        }

    }
    if ((lv_index == 0)) {
        return true;
    }

    if ((lv_index <= 2)) {
        UnitCreate(1, UnitGetType(EventUnit()), 0, gv_p02_LEVIATHANBROOD, PointFromId(1377), 135.0);
    }
    else {
        if ((RandomInt(1, 2) == 1)) {
            UnitCreate(1, UnitGetType(EventUnit()), 0, gv_p02_LEVIATHANBROOD, PointFromId(13), 225.0);
        }
        else {
            UnitCreate(1, UnitGetType(EventUnit()), 0, gv_p02_LEVIATHANBROOD, PointFromId(1378), 225.0);
        }
    }
    lv_randomSpot = RegionRandomPoint(gv_briefingSlaughterAreas[lv_index].lv_zergRegion);
    UnitSetCustomValue(UnitLastCreated(), 0, PointGetX(lv_randomSpot));
    UnitSetCustomValue(UnitLastCreated(), 1, PointGetY(lv_randomSpot));
    UnitGroupAdd(gv_briefingSlaughterAreas[lv_index].lv_zergGroup, UnitLastCreated());
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BriefingZergRespawn_Init () {
    gt_BriefingZergRespawn = TriggerCreate("gt_BriefingZergRespawn_Func");
    TriggerEnable(gt_BriefingZergRespawn, false);
    TriggerAddEventUnitDied(gt_BriefingZergRespawn, null);
}

