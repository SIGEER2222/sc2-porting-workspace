//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoD329579A_g;
    int autoD329579A_u;
    unit autoD329579A_var;
    unitgroup auto938263C5_g;
    int auto938263C5_u;
    unit auto938263C5_var;

    // Actions
    if (!runActions) {
        return true;
    }

    AICampaignStart(gv_p02_LEVIATHANBROOD);
    AICampaignStart(gv_p05_GARMBROOD);
    AICampaignStart(gv_p06_GRENDELBROOD);
    AICampaignStart(gv_p07_RAVAGING);
    AICampaignStart(gv_p10_JORMUNGAND);
    AICampaignStart(gv_p13_FIRETEAMRAVEN);
    AICampaignStart(gv_p14_FIRETEAMZULU);
    AICampaignStart(gv_p15_ZAGARA);
    AICampaignStart(gv_p12_MOEBIUS);
    AICampaignStart(gv_p11_ZERG_YELLOWSPORECANNON);
    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    TriggerExecute(gt_AllyUpgradesChar, true, false);
    autoD329579A_g = UnitGroup("Bunker", gv_p13_FIRETEAMRAVEN, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoD329579A_u = UnitGroupCount(autoD329579A_g, c_unitCountAll);
    for (;; autoD329579A_u -= 1) {
        autoD329579A_var = UnitGroupUnitFromEnd(autoD329579A_g, autoD329579A_u);
        if (autoD329579A_var == null) { break; }
        UnitCargoCreate(autoD329579A_var, "MengskMarine", 4);
        UnitCargoCreate(autoD329579A_var, "MengskMarauder", 1);
    }
    auto938263C5_g = UnitGroup("Bunker", gv_p14_FIRETEAMZULU, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto938263C5_u = UnitGroupCount(auto938263C5_g, c_unitCountAll);
    for (;; auto938263C5_u -= 1) {
        auto938263C5_var = UnitGroupUnitFromEnd(auto938263C5_g, auto938263C5_u);
        if (auto938263C5_var == null) { break; }
        UnitCargoCreate(auto938263C5_var, "MengskMarine", 4);
        UnitCargoCreate(auto938263C5_var, "MengskMarauder", 1);
    }
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        TriggerExecute(gt_BrutalEnemyUpgrades, true, false);
    }
    else if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 0) == 1)) {
        TriggerExecute(gt_HardEnemyUpgrades, true, false);
    }
    else if ((libNtve_gf_DifficultyValueInt(1, 1, 0, 0) == 1)) {
        TriggerExecute(gt_NormalEnemyUpgrades, true, false);
    }
    Wait(600.0, c_timeGame);
    RegionAddRegion(gv_trickleDropRegions, RegionFromId(119));
    RegionAddRegion(gv_trickleDropRegions, RegionFromId(120));
    TriggerEnable(gt_TricklePods, true);
    Wait(600.0, c_timeGame);
    gv_trickleIntensity += 1;
    Wait(600.0, c_timeGame);
    gv_trickleIntensity += 1;
    return true;
}

