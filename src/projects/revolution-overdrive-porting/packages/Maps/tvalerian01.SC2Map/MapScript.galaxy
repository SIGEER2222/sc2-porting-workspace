    Wait(0.2, c_timeGame);
    autoC4FACED6_g = UnitGroup(null, gv_p14_FIRETEAMZULU, null, UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
