    TimerStart(gv_dropPodTimer, 120.0, false, c_timeGame);
    gf_PrepareRescuableDrop(2, "SiegeTank");
    gf_PrepareRescuableDrop(4, "Marine");
    gv_dropPodsRemaining = (gv_dropPodsRemaining - 1);
