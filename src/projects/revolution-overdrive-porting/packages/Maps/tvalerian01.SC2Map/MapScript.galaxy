//--------------------------------------------------------------------------------------------------
// Trigger: Trickle Pods
//--------------------------------------------------------------------------------------------------
bool gt_TricklePods_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
    Wait(2.0, c_timeGame);
    if ((GameGetMissionTime() >= 900.0)) {
        gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
        Wait(2.0, c_timeGame);
    }

    if ((GameGetMissionTime() >= 1200.0)) {
        gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
        Wait(2.0, c_timeGame);
    }

    if ((GameGetMissionTime() >= 1800.0)) {
        gf_TrickleDropPod(RegionRandomPoint(gv_trickleDropRegions));
        Wait(2.0, c_timeGame);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_TricklePods_Init () {
    gt_TricklePods = TriggerCreate("gt_TricklePods_Func");
    TriggerEnable(gt_TricklePods, false);
    TriggerAddEventTimePeriodic(gt_TricklePods, 60.0, c_timeGame);
}

