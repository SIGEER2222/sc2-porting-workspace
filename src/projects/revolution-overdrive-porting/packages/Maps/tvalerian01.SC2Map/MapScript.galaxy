//--------------------------------------------------------------------------------------------------
// Trigger: Start Game
//--------------------------------------------------------------------------------------------------
bool gt_StartGame_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup autoF98CC240_g;
    int autoF98CC240_var;
    unitgroup auto4FE07E88_g;
    int auto4FE07E88_u;
    unit auto4FE07E88_var;
    unitgroup autoD7756694_g;
    int autoD7756694_u;
    unit autoD7756694_var;

    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeGame);
    autoF98CC240_g = libA9E65AFF_gv_enemyPlayers;
    autoF98CC240_var = -1;
    while (true) {
        autoF98CC240_var = PlayerGroupNextPlayer(autoF98CC240_g, autoF98CC240_var);
        if (autoF98CC240_var < 0) { break; }
        libNtve_gf_SetAlliance(gv_p14_FIRETEAMZULU, autoF98CC240_var, libNtve_ge_AllianceSetting_EnemyWithSharedVision);
        libNtve_gf_SetAlliance(gv_p13_FIRETEAMRAVEN, autoF98CC240_var, libNtve_ge_AllianceSetting_EnemyWithSharedVision);
    }
    TriggerExecute(gt_ObjectiveTroopSupplyCreateQ, true, false);
    TriggerExecute(gt_ObjectiveSaveMoebiusCreate, true, false);
    TriggerExecute(gt_StorymodeTipsQ, true, false);
    Wait(2.0, c_timeGame);
    TriggerExecute(gt_ObjectiveKillZagaraCreate, true, false);
    libA9E65AFF_gf_GenerateTipPopup(StringExternal("Param/Value/12BCB90A"));
    auto4FE07E88_g = UnitGroup("SporeCannon", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto4FE07E88_u = UnitGroupCount(auto4FE07E88_g, c_unitCountAll);
    for (;; auto4FE07E88_u -= 1) {
        auto4FE07E88_var = UnitGroupUnitFromEnd(auto4FE07E88_g, auto4FE07E88_u);
        if (auto4FE07E88_var == null) { break; }
        libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingCircle", UnitGetPosition(auto4FE07E88_var), ColorWithAlpha(100.00, 100.00, 0.00, 0.00), 0.0, 270.0);
        PingSetScale(PingLastCreated(), 0.6);
        PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/04CEC1E7"));
        libHots_gf_StorePingForUnit(auto4FE07E88_var, 1, PingLastCreated());
    }
    autoD7756694_g = UnitGroup("CharBileLauncher", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    autoD7756694_u = UnitGroupCount(autoD7756694_g, c_unitCountAll);
    for (;; autoD7756694_u -= 1) {
        autoD7756694_var = UnitGroupUnitFromEnd(autoD7756694_g, autoD7756694_u);
        if (autoD7756694_var == null) { break; }
        libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingCircle", UnitGetPosition(autoD7756694_var), ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
        PingSetScale(PingLastCreated(), 0.6);
        PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/DE7AD28B"));
        libHots_gf_StorePingForUnit(autoD7756694_var, 1, PingLastCreated());
    }
    TriggerExecute(gt_DialogueCommanderTacticalAnalysisTheZergGreatlyOutnumberQ, true, false);
    Wait(6.0, c_timeGame);
    TriggerEnable(gt_ZergAmbientAttackBothSidesNew, true);
    TriggerExecute(gt_DialogueKeepMeUpdatedIfWeCanReachQ, true, false);
    return true;
}

