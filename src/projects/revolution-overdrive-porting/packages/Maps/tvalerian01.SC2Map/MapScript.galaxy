    TriggerExecute(gt_DialogueSirAnotherDropPodHasArrivedNearYourPerimeterQ, true, false);
    libNtve_gf_WaitForTimer(gv_dropPodTimer, 0.0, false);
    TimerStart(gv_dropPodTimer, 120.0, false, c_timeGame);
