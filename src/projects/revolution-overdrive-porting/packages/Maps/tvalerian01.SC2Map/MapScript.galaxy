    unit auto2005B2D4_var;

    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnitDamageSourceUnit()) == 1))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != 1))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != 0))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != gv_p12_MOEBIUS))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != gv_p13_FIRETEAMRAVEN))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) != gv_p14_FIRETEAMZULU))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGetType(EventUnit()) != "LurkerMPBurrowed") && (UnitGetType(EventUnit()) != "SwarmHostBurrowedMP") && (UnitGetType(EventUnit()) != "SwarmHostMP") && (UnitGetType(EventUnit()) != "LurkerMP") && (UnitGetType(EventUnit()) != "ZaGara")) {
        AISetUnitSuicide(EventUnit(), true);
    }

    auto2005B2D4_g = UnitGroup(null, UnitGetOwner(EventUnit()), RegionCircle(UnitGetPosition(EventUnit()), 5.0), UnitFilter((1 << c_targetFilterVisible), 0, (1 << c_targetFilterStructure) | (1 << c_targetFilterWorker) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto2005B2D4_u = UnitGroupCount(auto2005B2D4_g, c_unitCountAll);
    for (;; auto2005B2D4_u -= 1) {
        auto2005B2D4_var = UnitGroupUnitFromEnd(auto2005B2D4_g, auto2005B2D4_u);
        if (auto2005B2D4_var == null) { break; }
        if ((UnitGetType(auto2005B2D4_var) != "LurkerMPBurrowed") && (UnitGetType(auto2005B2D4_var) != "SwarmHostBurrowedMP") && (UnitGetType(auto2005B2D4_var) != "SwarmHostMP") && (UnitGetType(auto2005B2D4_var) != "LurkerMP") && (UnitGetType(auto2005B2D4_var) != "ZaGara")) {
            AISetUnitSuicide(auto2005B2D4_var, true);
        }

    }
    return true;
}

