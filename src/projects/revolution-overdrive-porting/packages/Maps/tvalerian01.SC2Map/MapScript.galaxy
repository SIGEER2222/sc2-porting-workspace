//--------------------------------------------------------------------------------------------------
bool gt_ZuluRescue_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto07B47703_g;
    int auto07B47703_u;
    unit auto07B47703_var;

    // Conditions
    if (testConds) {
        if (!((TriggerGetExecCount(TriggerGetCurrent()) == 0))) {
            return false;
        }

        if (!((UnitGetOwner(EventUnit()) == 1))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerExecute(gt_ObjectiveSaveMoebiusUpdate, true, false);
    gv_zuluRescue = true;
    auto07B47703_g = UnitGroup(null, gv_p12_MOEBIUS, RegionFromId(105), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto07B47703_u = UnitGroupCount(auto07B47703_g, c_unitCountAll);
    for (;; auto07B47703_u -= 1) {
        auto07B47703_var = UnitGroupUnitFromEnd(auto07B47703_g, auto07B47703_u);
        if (auto07B47703_var == null) { break; }
        libNtve_gf_RescueUnit(auto07B47703_var, 1, true);
    }
    libNtve_gf_RescueUnit(UnitFromId(400510126), 1, true);
    libNtve_gf_RescueUnit(UnitFromId(1022242224), 1, true);
    libNtve_gf_RescueUnit(UnitFromId(1042265253), 1, true);
    libNtve_gf_RescueUnit(UnitFromId(503297392), 1, true);
    UnitMagazineArm(UnitFromId(503297392), AbilityCommand("ArmSiloWithNuke", 0), 1);
    SoundPlayForPlayer(SoundLink("Spectre_Ready", 0), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
    TriggerQueueEnter();
    if ((gv_gameOver == true)) {
        return true;
    }

    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus03Marine700017", 0), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    TriggerQueueExit();
    TriggerExecute(gt_CreateAllOutAttackButton, true, false);
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/64DA2179"));
    return true;
}

