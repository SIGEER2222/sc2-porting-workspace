    gf_CreateRescuable(ge_RescuableRegion_A, 2, 1.0);
    gf_PrepareRescuableDrop(4, "VikingAssault");
    gf_PrepareRescuableDrop(2, "Hellion");
    gv_dropPodsRemaining = (gv_dropPodsRemaining - 1);
