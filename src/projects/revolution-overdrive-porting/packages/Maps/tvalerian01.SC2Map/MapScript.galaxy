void gt_DefeatAllTroopsDead_Init () {
    gt_DefeatAllTroopsDead = TriggerCreate("gt_DefeatAllTroopsDead_Func");
    TriggerAddEventTimePeriodic(gt_DefeatAllTroopsDead, 1.0, c_timeGame);
}

