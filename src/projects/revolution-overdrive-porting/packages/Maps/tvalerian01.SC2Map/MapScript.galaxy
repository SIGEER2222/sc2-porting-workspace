//--------------------------------------------------------------------------------------------------
// Trigger: Achievement - Non Merc Combat Unit Trained
//--------------------------------------------------------------------------------------------------
bool gt_AchievementNonMercCombatUnitTrained_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) == gv_p01_USER))) {
            return false;
        }

        if (!((gv_achievementNonMercCombatUnitTrained == false))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "SCV"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "Medic"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "Medivac"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "Hercules"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "Raven"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "ScienceVessel"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "SpiderMine"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "SpiderMineBurrowed"))) {
            return false;
        }

        if (!((libNtve_gf_TriggeringProgressUnitType() != "AutoTurret"))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) != "MercCompound"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_achievementNonMercCombatUnitTrained = true;
    return true;
}

