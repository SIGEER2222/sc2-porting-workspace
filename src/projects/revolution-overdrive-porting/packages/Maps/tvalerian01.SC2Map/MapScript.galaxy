    // Automatic Variable Declarations
    unitgroup auto11736AB2_g;
    int auto11736AB2_u;
    unit auto11736AB2_var;

    // Actions
    if (!runActions) {
        return true;
    }

    auto11736AB2_g = UnitGroup("SporeCannon", gv_p06_GRENDELBROOD, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
