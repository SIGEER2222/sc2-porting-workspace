        UnitBehaviorAdd(gv_sCV02, "CarrySandbags", gv_sCV02, 1);
        gv_sandbagsSwitchRight = 5;
        gv_sandbagMovingToPlaceRight = false;
    }
    else if (auto4C90C9D8_val == 5) {
