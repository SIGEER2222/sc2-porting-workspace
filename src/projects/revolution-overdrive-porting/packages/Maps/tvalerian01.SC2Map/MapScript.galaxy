    autoBC0E916F_g = UnitGroup(null, gv_p02_LEVIATHANBROOD, RegionFromId(98), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
