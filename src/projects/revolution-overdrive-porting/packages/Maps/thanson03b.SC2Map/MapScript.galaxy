        if ((UnitIsAlive(lp_nydusWorm) == true)) {
            SoundPlayAtPointForPlayer(SoundLink("NydusWorm_Unload", -1), c_maxPlayers, PlayerGroupAll(), UnitGetPosition(lp_nydusWorm), 0.0, 100.0, 0.0);
            libNtve_gf_SendActorMessageToUnit(lp_nydusWorm, "AnimPlay Spell Spell");
            libNtve_gf_CreateUnitsWithDefaultFacing(1, lp_unitType, 0, lp_player, PointWithOffset(UnitGetPosition(lp_nydusWorm), 0.0, -1.0));
            AISetGroupSuicide(UnitLastCreatedGroup(), true);
            Wait(0.1, c_timeGame);
        }

    }
}

void gf_SetWaypointList (int lp_player, int lp_direction) {
    // Automatic Variable Declarations
    // Implementation
    if ((lp_direction == ge_AttackWaveDirections_Bottom)) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(712452757), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(453013099), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(779183667), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1774950302), false);
    }
    else if ((lp_direction == ge_AttackWaveDirections_Top)) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(87317296), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1726353671), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1945722790), false);
    }
    else if ((lp_direction == ge_AttackWaveDirections_MidTopPlayer)) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1849633308), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1354445561), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(409732903), false);
    }
    else if ((lp_direction == ge_AttackWaveDirections_MidTopToss)) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1849633308), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1354445561), false);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1420210108), false);
    }
    else if ((lp_direction == ge_AttackWaveDirections_AirRaidMid)) {
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1849633308), true);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1354445561), true);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1491071555), true);
        AIAttackWaveAddWaypoint(lp_player, PointFromId(1114720560), true);
    }
}

