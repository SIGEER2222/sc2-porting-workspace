//--------------------------------------------------------------------------------------------------
bool gt_StartGame_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto73A98547_g;
    int auto73A98547_u;
    unit auto73A98547_var;

    // Actions
    if (!runActions) {
        return true;
    }

    libWCMI_gf_SetWorkerRallyPointforNexus2(UnitFromId(163));
    libWCMI_gf_StartingWorkersAutoHarvest(RegionFromId(11), RegionFromId(12));
    libLbty_gf_OrderWorkerstoGatherNearbyResources(RegionEntireMap(), 1);
    UIAlertPoint("Trigger", gv_p01_USER, StringExternal("Param/Value/C5C06D21"), null, PointFromId(292));
    CreepSetSpeed(c_creepSpeedGrowth, 1000.0);
    auto73A98547_g = UnitGroup("Feederling", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto73A98547_u = UnitGroupCount(auto73A98547_g, c_unitCountAll);
    for (;; auto73A98547_u -= 1) {
        auto73A98547_var = UnitGroupUnitFromEnd(auto73A98547_g, auto73A98547_u);
        if (auto73A98547_var == null) { break; }
        UnitKill(auto73A98547_var);
    }
    TriggerExecute(gt_CarrionBirds, true, false);
    TriggerExecute(gt_StartPurifierTimer, true, false);
    TriggerExecute(gt_BileLauncherSpawns, true, false);
    TriggerEnable(gt_VictoryInfestationCleansedCompleted, true);
    libA9E65AFF_gf_GenerateTipPopup(StringExternal("Param/Value/48647DC3"));
    Wait(1.0, c_timeGame);
    TriggerExecute(gt_ObjectiveDestroyInfestationCreateQ, true, true);
    Wait(2.0, c_timeGame);
    TriggerExecute(gt_InitWarningPings, true, false);
    Wait(1.0, c_timeGame);
    TriggerExecute(gt_ObjectiveRaidPlanetariesCreateQ, true, true);
    TriggerExecute(gt_TransmissionMissionStartQ, true, true);
    TriggerExecute(gt_NewUnitVikingTipQ, true, false);
    TriggerExecute(gt_VirophageTipQ, true, false);
    libCamp_gf_CreateStorymodeTips();
    Wait(6.0, c_timeGame);
    CreepSetSpeed(c_creepSpeedGrowth, 100.0);
    return true;
}

