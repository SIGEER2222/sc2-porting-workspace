//--------------------------------------------------------------------------------------------------
bool gt_VirophageConstructionEnds_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_colonyIndex;
    unit lv_colonyStructure;
    unit lv_colonist;

    // Automatic Variable Declarations
    unitgroup auto6086ECAA_g;
    int auto6086ECAA_u;
