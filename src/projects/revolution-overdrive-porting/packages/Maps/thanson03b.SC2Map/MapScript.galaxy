//--------------------------------------------------------------------------------------------------
// Trigger: Reinforce Regions With Bullies
//--------------------------------------------------------------------------------------------------
bool gt_ReinforceRegionsWithBullies_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(360.0, c_timeGame);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableHut", gv_p04_ZERG_NORTH, RegionFromId(43), AbilityCommand("InfestedMonsterTrain", 0), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(44), AbilityCommand("InfestedMonsterTrain", 0), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(45), AbilityCommand("InfestedMonsterTrain", 0), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "Mutalisk", RegionFromId(47), gv_p04_ZERG_NORTH, 1, false);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "Mutalisk", RegionFromId(48), gv_p02_ZERG_EAST, 0, false);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(80), AbilityCommand("InfestedMonsterTrain", 0), libA9E65AFF_gv_scriptBuildingsSuicide);
    AIToggleBulliesInRegion(gv_p02_ZERG_EAST, RegionFromId(48), true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Larva", gv_p02_ZERG_EAST, RegionFromId(48), AbilityCommand("LarvaTrainSwarm", 6), libA9E65AFF_gv_scriptBuildingsWaves);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "Mutalisk", RegionFromId(48), gv_p02_ZERG_EAST, 0, false);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 2, 2), "Mutalisk", RegionFromId(45), gv_p08_ZERG_SOUTH, 1, true);
    Wait(420.0, c_timeGame);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(47), AbilityCommand("InfestedMonsterTrain", 0), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(48), AbilityCommand("InfestedMonsterTrain", 1), libA9E65AFF_gv_scriptBuildingsSuicide);
    AIToggleBulliesInRegion(gv_p04_ZERG_NORTH, RegionFromId(75), true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Larva", gv_p04_ZERG_NORTH, RegionFromId(75), AbilityCommand("LarvaTrain", 14), libA9E65AFF_gv_scriptBuildingsWaves);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "Hydralisk", RegionFromId(76), gv_p08_ZERG_SOUTH, 2, false);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 3, 3), "Devourer", RegionFromId(48), gv_p02_ZERG_EAST, 0, false);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 2, 2), "LurkerMP", RegionFromId(45), gv_p08_ZERG_SOUTH, 2, false);
    Wait(360.0, c_timeGame);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(49), AbilityCommand("InfestedMonsterTrain", 1), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(50), AbilityCommand("InfestedMonsterTrain", 1), libA9E65AFF_gv_scriptBuildingsSuicide);
    AIToggleBulliesInRegion(gv_p08_ZERG_SOUTH, RegionFromId(66), true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Larva", gv_p08_ZERG_SOUTH, RegionFromId(66), AbilityCommand("LarvaTrainSwarm", 6), libA9E65AFF_gv_scriptBuildingsWaves);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "Hydralisk", RegionFromId(76), gv_p08_ZERG_SOUTH, 2, false);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(2, 2, 2, 2), "Infestor", RegionFromId(47), gv_p04_ZERG_NORTH, 0, false);
    Wait(300.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p02_ZERG_EAST, RegionFromId(80), true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Larva", gv_p02_ZERG_EAST, RegionFromId(80), AbilityCommand("LarvaTrain", 18), libA9E65AFF_gv_scriptBuildingsWaves);
    libA9E65AFF_gf_MakeBullies(libNtve_gf_DifficultyValueInt(4, 4, 5, 6), "Hydralisk", RegionFromId(50), gv_p08_ZERG_SOUTH, 2, false);
    Wait(180.0, c_timeGame);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableHut", gv_p04_ZERG_NORTH, RegionFromId(51), AbilityCommand("InfestedMonsterTrain", 2), libA9E65AFF_gv_scriptBuildingsSuicide);
    Wait(180.0, c_timeGame);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(54), AbilityCommand("InfestedMonsterTrain", 2), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableHut", gv_p04_ZERG_NORTH, RegionFromId(54), AbilityCommand("InfestedMonsterTrain", 2), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableColonistHut", gv_p04_ZERG_NORTH, RegionFromId(57), AbilityCommand("InfestedMonsterTrain", 2), libA9E65AFF_gv_scriptBuildingsSuicide);
    libA9E65AFF_gf_OrderRegionScriptBuild("InfestableHut", gv_p04_ZERG_NORTH, RegionFromId(57), AbilityCommand("InfestedMonsterTrain", 2), libA9E65AFF_gv_scriptBuildingsSuicide);
    gf_CreateNydusWorm("RoachVile", "Kaboomer", "Ultralisk", libNtve_gf_DifficultyValueInt(3, 3, 4, 6), libNtve_gf_DifficultyValueInt(0, 0, 0, 1), libNtve_gf_DifficultyValueInt(0, 0, 1, 2), RegionRandomPoint(RegionFromId(77)), 180.0, 20.0, 10.0, gv_p03_VIROPHAGE);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        gf_CreateNydusWorm("HotSRaptor", "RoachCorpser", "SwarmHostMP", libNtve_gf_DifficultyValueInt(5, 5, 6, 8), libNtve_gf_DifficultyValueInt(2, 2, 3, 4), libNtve_gf_DifficultyValueInt(0, 0, 1, 2), RegionRandomPoint(RegionFromId(78)), 180.0, 20.0, 10.0, gv_p03_VIROPHAGE);
    }

    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_CreateNydusWorm("SwarmHostMP", "Kaboomer", "Guardian", libNtve_gf_DifficultyValueInt(5, 5, 6, 8), libNtve_gf_DifficultyValueInt(0, 0, 0, 1), libNtve_gf_DifficultyValueInt(2, 2, 3, 4), RegionRandomPoint(RegionFromId(79)), 180.0, 20.0, 10.0, gv_p03_VIROPHAGE);
    }

    return true;
}

