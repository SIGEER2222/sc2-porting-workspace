//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup auto8FD57004_g;
    int auto8FD57004_var;
    unitgroup autoAA038AF7_g;
    int autoAA038AF7_u;
    unit autoAA038AF7_var;

    // Actions
    if (!runActions) {
        return true;
    }

    CampaignInitAI();
    TriggerExecute(libA9E65AFF_gt_UpgradeController, true, false);
    auto8FD57004_g = gv_colonistPlayers;
    auto8FD57004_var = -1;
    while (true) {
        auto8FD57004_var = PlayerGroupNextPlayer(auto8FD57004_g, auto8FD57004_var);
        if (auto8FD57004_var < 0) { break; }
        autoAA038AF7_g = UnitGroup("Bunker", auto8FD57004_var, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        autoAA038AF7_u = UnitGroupCount(autoAA038AF7_g, c_unitCountAll);
        for (;; autoAA038AF7_u -= 1) {
            autoAA038AF7_var = UnitGroupUnitFromEnd(autoAA038AF7_g, autoAA038AF7_u);
            if (autoAA038AF7_var == null) { break; }
            UnitCargoCreate(autoAA038AF7_var, "Marine", 6);
        }
    }
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunProtossAI, true, false);
    TriggerEnable(gt_AlliedBulliesTossForward, true);
    TriggerEnable(gt_AlliedBulliesTossSouth, true);
    TriggerExecute(gt_P2LeviathanAttackWaves, true, false);
    TriggerExecute(gt_P4BlightspreaderAttackWaves, true, false);
    TriggerExecute(gt_P8GrendelAttackWaves, true, false);
    TriggerExecute(gt_P11AirPatrols, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    TriggerExecute(gt_TossBuildup, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartAI_Init () {
    gt_StartAI = TriggerCreate("gt_StartAI_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Colonists Betrayed!
//--------------------------------------------------------------------------------------------------
bool gt_ColonistsBetrayed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnitTarget()) == 1))) {
            return false;
        }

        if (!(((EventPlayer() == gv_p05_COLONIST) || (EventPlayer() == gv_p06_COLONIST) || (EventPlayer() == gv_p09_AGRIAFLEET)))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p05_COLONIST, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p06_COLONIST, libNtve_ge_AllianceSetting_Enemy);
    libNtve_gf_SetAlliance(gv_p01_USER, gv_p09_AGRIAFLEET, libNtve_ge_AllianceSetting_Enemy);
    TriggerQueueEnter();
    if ((gv_gameOver == false) && (gv_inCinematic == false)) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("THanson01Hanson00044", -1), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }

    TriggerQueueExit();
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ColonistsBetrayed_Init () {
    gt_ColonistsBetrayed = TriggerCreate("gt_ColonistsBetrayed_Func");
    TriggerAddEventUnitAttacked2(gt_ColonistsBetrayed, null, null);
}

