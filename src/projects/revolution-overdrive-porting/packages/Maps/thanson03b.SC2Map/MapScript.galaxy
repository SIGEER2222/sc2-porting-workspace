    if (!runActions) {
        return true;
    }

    Wait(360.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p10_SELENDIS, RegionFromId(29), true);
    AIToggleBulliesInRegion(gv_p10_SELENDIS, RegionFromId(30), true);
