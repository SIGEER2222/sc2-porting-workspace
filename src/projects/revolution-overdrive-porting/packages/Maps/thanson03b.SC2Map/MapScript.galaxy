    AIToggleBulliesInRegion(gv_p10_SELENDIS, RegionFromId(25), true);
    AIToggleBulliesInRegion(gv_p10_SELENDIS, RegionFromId(26), true);
    Wait(240.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p10_SELENDIS, RegionFromId(27), true);
    AIToggleBulliesInRegion(gv_p10_SELENDIS, RegionFromId(34), true);
    Wait(480.0, c_timeGame);
    AIToggleBulliesInRegion(gv_p10_SELENDIS, RegionFromId(33), true);
    return true;
}

