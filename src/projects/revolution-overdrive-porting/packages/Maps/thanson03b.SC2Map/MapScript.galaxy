//--------------------------------------------------------------------------------------------------
// Trigger: Allied Bullies - Toss Forward
//--------------------------------------------------------------------------------------------------
bool gt_AlliedBulliesTossForward_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_bullyRegion;
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bullyRegion = RegionFromId(70);
    lv_player = gv_p10_SELENDIS;

    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(lv_player, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 0))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(lv_player, lv_bullyRegion, true);
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/AFB18ECE"));
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_AlliedBulliesTossForward_Init () {
    gt_AlliedBulliesTossForward = TriggerCreate("gt_AlliedBulliesTossForward_Func");
    TriggerEnable(gt_AlliedBulliesTossForward, false);
    TriggerAddEventTimePeriodic(gt_AlliedBulliesTossForward, 5.0, c_timeGame);
}

