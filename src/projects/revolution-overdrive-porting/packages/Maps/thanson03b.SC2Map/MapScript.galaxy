//--------------------------------------------------------------------------------------------------
// Trigger: Victory Cinematic
//--------------------------------------------------------------------------------------------------
bool gt_VictoryCinematic_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_hatchery;

    // Automatic Variable Declarations
    const int auto46B2086F_n = 10;
    int auto46B2086F_i;
    const int auto3A7F419F_n = 3;
    int auto3A7F419F_i;

    // Variable Initialization

    // Actions
    if (!runActions) {
        return true;
    }

    GameSetBackground(c_backgroundFixed, "AvernusSkybox", 100.0);
    CameraApplyInfo(gv_p01_USER, CameraInfoFromId(813666575), 0.0, -1, 10, true);
    UnitIssueOrder(gv_endMothership, Order(AbilityCommand("PurifierPlanetCracker", 0)), c_orderQueueReplace);
    libNtve_gf_UnitCreateFacingPoint(3, "Marine", 0, gv_p05_COLONIST, RegionGetCenter(RegionFromId(68)), RegionGetCenter(RegionFromId(19)));
    libNtve_gf_UnitCreateFacingPoint(1, "CommandCenterFlying", 0, gv_p05_COLONIST, PointFromId(1633478015), RegionGetCenter(RegionFromId(19)));
    UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(880431123)), c_orderQueueReplace);
    libNtve_gf_UnitCreateFacingPoint(1, "BarracksFlying", 0, gv_p05_COLONIST, PointFromId(1633478015), RegionGetCenter(RegionFromId(19)));
    UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), PointFromId(880431123)), c_orderQueueReplace);
    for (auto46B2086F_i = 1; auto46B2086F_i <= auto46B2086F_n; auto46B2086F_i += 1) {
        libNtve_gf_UnitCreateFacingPoint(1, "Colonist", 0, gv_p05_COLONIST, RegionRandomPoint(RegionFromId(68)), RegionGetCenter(RegionFromId(19)));
        libNtve_gf_UnitCreateFacingPoint(1, "ColonistFemale", 0, gv_p05_COLONIST, RegionRandomPoint(RegionFromId(68)), RegionGetCenter(RegionFromId(19)));
    }
    for (auto3A7F419F_i = 1; auto3A7F419F_i <= auto3A7F419F_n; auto3A7F419F_i += 1) {
        libNtve_gf_UnitCreateFacingPoint(1, "Goliath", 0, gv_p05_COLONIST, RegionRandomPoint(RegionFromId(68)), RegionGetCenter(RegionFromId(19)));
    }
    libNtve_gf_SendActorMessageToGameRegion(RegionFromId(69), "Signal TreeFire");
    TriggerSkippableBegin(PlayerGroupAll(), 0, null, true, false);
    gv_victoryCinematicCompleted = false;
    CinematicFade(true, 1.0, c_fadeStyleNormal, ColorWithAlpha(0.00, 0.00, 0.00, 0.00), 0.0, false);
    Wait(1.0, c_timeReal);
    CameraApplyInfo(gv_p01_USER, CameraInfoFromId(280), 20.0, -1, 10, true);
    SoundtrackPlay(PlayerGroupAll(), c_soundtrackCategoryMusic, "THanson03BMusicOutro", c_soundtrackCueAny, c_soundtrackIndexAny, false);
    Wait(8.0, c_timeGame);
    // Transmission - SoundLink("THanson03BHorner00002", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THanson03BHorner00002", -1), c_transmissionDurationAdd, 1.0, true);
    // Transmission - SoundLink("THanson03BRaynor00004", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THanson03BRaynor00004", -1), c_transmissionDurationAdd, 1.0, true);
    // Transmission - SoundLink("THanson03BHorner00016", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THanson03BHorner00016", -1), c_transmissionDurationAdd, 1.0, true);
    // Transmission - SoundLink("THanson03BRaynor00022", -1)
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("THanson03BRaynor00022", -1), c_transmissionDurationAdd, 1.0, true);
    gv_victoryCinematicCompleted = true;
    return true;
}

