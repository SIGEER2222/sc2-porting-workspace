//--------------------------------------------------------------------------------------------------
// Trigger: Objective  Raid Planetaries Update
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveRaidPlanetariesUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(EventUnit()) != 1))) {
            return false;
        }

        if (!((UnitGetType(EventUnit()) == "PlanetaryFortress"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_planetaryKillCount += 1;
    PingDestroy(libHots_gf_PingStoredForUnit(EventUnit(), 1));
    libWCMI_gf_SetMissionObjectiveProgress("THanson03B_3", gv_planetaryKillCount);
    TriggerExecute(gt_PlanetaryTransmission, true, false);
    if ((gv_planetaryKillCount == 2)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "VolatileDisruption", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/E1CE2402"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_planetaryKillCount == 3)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "SpectralAmplifiers", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/D15FE909"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
        TriggerExecute(gt_ObjectiveRaidPlanetariesComplete, true, false);
    }

