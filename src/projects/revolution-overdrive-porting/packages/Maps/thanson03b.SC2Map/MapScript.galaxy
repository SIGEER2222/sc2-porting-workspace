        return true;
    }

    Wait(420.0, c_timeGame);
    gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(35)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    Wait(240.0, c_timeGame);
    gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(36)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    Wait(240.0, c_timeGame);
    gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(38)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    Wait(180.0, c_timeGame);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(39)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    }

    Wait(240.0, c_timeGame);
    gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(40)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(36)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    }

    Wait(240.0, c_timeGame);
    gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(38)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(41)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    }

    Wait(240.0, c_timeGame);
    gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(35)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(38)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        gf_CreateBileLauncher(RegionRandomPoint(RegionFromId(40)), 120.0, gv_bileLauncherInitAttackTimer, gv_bileLauncherEnragedTimer, gv_p07_ZERG_INFESTED);
    }

    return true;
}

