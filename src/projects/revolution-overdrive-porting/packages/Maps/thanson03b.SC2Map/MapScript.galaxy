//--------------------------------------------------------------------------------------------------
// Trigger: Victory
//--------------------------------------------------------------------------------------------------
bool gt_Victory_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_safeHavenCompleteString, false);
    BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_havensFallCompleteString, true);
    BankSave(libA9E65AFF_gv_bonusBank);
    TriggerSendEvent("EndGameBackup");
    if ((ObjectiveGetState(gv_objectiveDestroyInfestation) == c_objectiveStateCompleted)) {
        libWoLC_gf_CampaignAwardAchievement("THanson03B_1");
    }

    if ((gv_stat_ColoniesSaved >= 3) && (libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1)) {
        libWoLC_gf_CampaignAwardAchievement("THanson03B_2");
    }

    if ((gv_stat_ColoniesSaved >= 5) && (libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        libWoLC_gf_CampaignAwardAchievement("THanson03B_3");
    }

    VictoryPanelAddAchievement("THanson03B_1");
    VictoryPanelAddAchievement("THanson03B_2");
    VictoryPanelAddAchievement("THanson03B_3");
    VictoryPanelAddTrackedStatistic("UnitsKilledCount");
    VictoryPanelAddTrackedStatistic("UnitsTotalCount");
    VictoryPanelAddTrackedStatistic("UnitsLostCount");
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/058AC5A9"), IntToText(gv_allyKills));
    libWCMI_gf_EndCampaignMission(gv_p01_USER, c_gameOverVictory);
    return true;
}

