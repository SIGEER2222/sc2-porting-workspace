        if (autoC7ACFABD_var == null) { break; }
        libNtve_gf_PauseUnit(autoC7ACFABD_var, false);
    }
    libLbty_gf_OrderWorkerstoGatherNearbyResources(RegionEntireMap(), gv_pLAYER01_USER);
    AITimePause(true);
    GameTimeOfDayPause(true);
    libNtve_gf_SetAlliance(gv_pLAYER04_PHASESMITHS, gv_pLAYER03_COLONISTMARINES, libNtve_ge_AllianceSetting_Neutral);
    libNtve_gf_SetAlliance(gv_pLAYER04_PHASESMITHS, gv_pLAYER05_COLONISTMECHS, libNtve_ge_AllianceSetting_Enemy);
