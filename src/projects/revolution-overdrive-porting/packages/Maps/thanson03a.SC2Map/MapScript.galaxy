                libNtve_gf_CreateUnitsAtPoint2(1, "Phoenix", 0, gv_pLAYER02_PROTOSSVANGUARD, RegionRandomPoint(RegionFromId(43)));
            }
            else {
                libNtve_gf_CreateUnitsAtPoint2(1, "Scout", 0, gv_pLAYER02_PROTOSSVANGUARD, RegionRandomPoint(RegionFromId(43)));
            }
        }
        UnitIssueOrder(UnitLastCreated(), OrderTargetingPoint(AbilityCommand("move", 0), RegionRandomPoint(RegionFromId(44))), c_orderQueueReplace);
    }
    return true;
}

