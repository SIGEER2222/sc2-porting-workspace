// Trigger: Victory Purifier Destroyed
//--------------------------------------------------------------------------------------------------
bool gt_VictoryPurifierDestroyed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((UnitIsAlive(gv_purifier) == false))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_gameOver = true;
    libWCUI_gf_ShowHideSingularBossBarVoidCampaign(false);
    TriggerExecute(gt_ObjectiveDestroyPurifierComplete, true, true);
    if ((UnitIsAlive(UnitFromId(725563901)) == true)) {
        TriggerExecute(gt_ObjectiveProtectInfantryBaseComplete, true, true);
    }

    if ((UnitIsAlive(UnitFromId(1495254571)) == true)) {
        TriggerExecute(gt_ObjectiveProtectMechBaseComplete, true, true);
    }

    if ((UnitIsAlive(UnitFromId(271955589)) == true)) {
        TriggerExecute(gt_ObjectiveProtectAirBaseComplete, true, true);
    }

    libWCMI_gf_RunMissionVictorySequence(gt_VictoryQ);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_VictoryPurifierDestroyed_Init () {
    gt_VictoryPurifierDestroyed = TriggerCreate("gt_VictoryPurifierDestroyed_Func");
    TriggerAddEventUnitDied(gt_VictoryPurifierDestroyed, UnitRefFromUnit(UnitFromId(765)));
}

//--------------------------------------------------------------------------------------------------
// Trigger: Victory
//--------------------------------------------------------------------------------------------------
bool gt_Victory_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_safeHavenCompleteString, true);
    BankValueSetFromFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_havensFallCompleteString, false);
    BankSave(libA9E65AFF_gv_bonusBank);
    TriggerSendEvent("EndGameBackup");
    if ((ObjectiveGetState(gv_primaryObjectiveDestroyProtossNexus) == c_objectiveStateCompleted) && (ObjectiveGetState(gv_primaryObjectiveDestroyPurifier) == c_objectiveStateCompleted) && ((ObjectiveGetState(gv_bonusObjectiveProtectInfantryBase) == c_objectiveStateHidden) || (ObjectiveGetState(gv_bonusObjectiveProtectInfantryBase) == c_objectiveStateCompleted)) && ((ObjectiveGetState(gv_bonusObjectiveProtectMechBase) == c_objectiveStateHidden) || (ObjectiveGetState(gv_bonusObjectiveProtectMechBase) == c_objectiveStateCompleted)) && ((ObjectiveGetState(gv_bonusObjectiveProtectAirBase) == c_objectiveStateHidden) || (ObjectiveGetState(gv_bonusObjectiveProtectAirBase) == c_objectiveStateCompleted))) {
        libWoLC_gf_CampaignAwardAchievement("THanson03A_1");
    }

    if ((gv_colonyOutpostsSaved >= 3) && (libNtve_gf_DifficultyValueInt(0, 1, 1, 1) == 1)) {
        libWoLC_gf_CampaignAwardAchievement("THanson03A_2");
    }

    if ((gv_colonyOutpostsSaved >= 2) && (libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        libWoLC_gf_CampaignAwardAchievement("THanson03A_3");
    }

    VictoryPanelAddAchievement("THanson03A_1");
    VictoryPanelAddAchievement("THanson03A_2");
    VictoryPanelAddAchievement("THanson03A_3");
    VictoryPanelAddTrackedStatistic("UnitsKilledCount");
    VictoryPanelAddTrackedStatistic("UnitsTotalCount");
    VictoryPanelAddTrackedStatistic("UnitsLostCount");
    VictoryPanelAddCustomStatisticLine(StringToText(""), StringToText(""));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/0DCEB36D"), IntToText(gv_allyKills));
    VictoryPanelAddCustomStatisticLine(StringExternal("Param/Value/E7158F77"), IntToText(gv_purifierKills));
    libWCMI_gf_EndCampaignMission(gv_pLAYER01_USER, c_gameOverVictory);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_Victory_Init () {
    gt_Victory = TriggerCreate("gt_Victory_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Defeat Base Dead
//--------------------------------------------------------------------------------------------------
bool gt_DefeatBaseDead_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup(null, gv_pLAYER01_USER, null, UnitFilter((1 << c_targetFilterPreventDefeat), 0, 0, 0), 0), c_unitCountAlive) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    gv_gameOver = true;
    TriggerQueuePause(true);
    TriggerQueueClear(c_triggerQueueRemove);
    Wait(2.0, c_timeReal);
    libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_MissionFailed, StringExternal("Param/Value/BDE64F5B"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    Wait(libWCMI_gv_campaignObjectiveDelay, c_timeReal);
    TriggerExecute(gt_Defeat, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_DefeatBaseDead_Init () {
    gt_DefeatBaseDead = TriggerCreate("gt_DefeatBaseDead_Func");
    TriggerAddEventTimePeriodic(gt_DefeatBaseDead, 1.0, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Defeat Infested Wiped
//--------------------------------------------------------------------------------------------------
bool gt_DefeatInfestedWiped_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_gameOver == false))) {
            return false;
        }

        if (!((gv_infestedBuildingKillCount >= 9))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    TriggerEnable(gt_ColonistKilled, false);
    TriggerEnable(gt_Playerkillscolonists, false);
    TriggerEnable(gt_ColonistKilledIncrement, false);
    gv_gameOver = true;
    TriggerQueuePause(true);
    TriggerQueueClear(c_triggerQueueRemove);
    Wait(2.0, c_timeReal);
    TriggerExecute(gt_ObjectiveProtectInfestedFailed, true, true);
    libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_MissionFailed, StringExternal("Param/Value/C10ED23C"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    Wait(libWCMI_gv_campaignObjectiveDelay, c_timeReal);
    TriggerExecute(gt_Defeat, true, false);
    return true;
}

