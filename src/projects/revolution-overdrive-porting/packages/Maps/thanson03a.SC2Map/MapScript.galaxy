void gt_AlliedBulliesMarinesinVanguardBase_Init () {
    gt_AlliedBulliesMarinesinVanguardBase = TriggerCreate("gt_AlliedBulliesMarinesinVanguardBase_Func");
    TriggerEnable(gt_AlliedBulliesMarinesinVanguardBase, false);
    TriggerAddEventTimePeriodic(gt_AlliedBulliesMarinesinVanguardBase, 5.0, c_timeGame);
}

