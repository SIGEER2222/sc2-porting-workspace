//--------------------------------------------------------------------------------------------------
bool gt_OpenBank_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(1.0, c_timeGame);
    TriggerExecute(libA9E65AFF_gt_OpenUpgradeBank, true, false);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_OpenBank_Init () {
    gt_OpenBank = TriggerCreate("gt_OpenBank_Func");
    TriggerAddEventMapInit(gt_OpenBank);
    TriggerAddEventLoadGameDone(gt_OpenBank);
}

