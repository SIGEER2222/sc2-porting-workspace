        if ((RandomInt(1, 4) == 1)) {
            libNtve_gf_CreateUnitsAtPoint2(1, "VoidRay", 0, gv_pLAYER02_PROTOSSVANGUARD, RegionRandomPoint(RegionFromId(43)));
