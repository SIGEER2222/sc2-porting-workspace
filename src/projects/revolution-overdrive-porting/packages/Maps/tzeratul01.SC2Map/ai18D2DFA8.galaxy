    ai18D2DFA8_wave13_run(p, target, true);
    ai18D2DFA8_wave14_run(p, target, true);
    ai18D2DFA8_wave15_run(p, target, true);
    ai18D2DFA8_wave16_run(p, target, true);

    while (true) {
        ai18D2DFA8_wave14_run(p, target, true);
        ai18D2DFA8_wave15_run(p, target, true);
        ai18D2DFA8_wave16_run(p, target, true);
    }

    return true;
}

