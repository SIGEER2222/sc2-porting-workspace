    ai18D2DFA8_waves_trigger = TriggerCreate("ai18D2DFA8_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool ai18D2DFA8_waves_runFunc (bool c, bool a) {
    int p = ai18D2DFA8_waves_runPlayer;
    playergroup target = ai18D2DFA8_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    ai18D2DFA8_wave1_run(p, target, true);
    ai18D2DFA8_wave2_run(p, target, true);
    ai18D2DFA8_wave3_run(p, target, true);
    ai18D2DFA8_wave4_run(p, target, true);
    ai18D2DFA8_wave5_run(p, target, true);
    ai18D2DFA8_wave6_run(p, target, true);
