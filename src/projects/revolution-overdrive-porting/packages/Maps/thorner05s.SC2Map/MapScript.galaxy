    }
    else {
        AIToggleBulliesInRegion(gv_p14_NERAZIM, lv_bullyRegion, false);
    }
    if ((UnitGroupCount(UnitGroupAlliance(gv_p09_ENTRALLEDDOMINION, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0)) {
        AIToggleBulliesInRegion(gv_p09_ENTRALLEDDOMINION, lv_bullyRegion, true);
    }
    else {
        AIToggleBulliesInRegion(gv_p09_ENTRALLEDDOMINION, lv_bullyRegion, false);
    }
    return true;
}

