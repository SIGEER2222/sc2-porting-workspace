//--------------------------------------------------------------------------------------------------
bool gt_StartGame_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(2.0, c_timeReal);
    TriggerEnable(gt_DefeatIntroFailed, true);
    TriggerExecute(gt_ObjectiveInvestigateCreate, true, true);
    TriggerExecute(gt_TipStorymodeQ, true, false);
    TriggerEnable(gt_IntroComplete, true);
    return true;
}

