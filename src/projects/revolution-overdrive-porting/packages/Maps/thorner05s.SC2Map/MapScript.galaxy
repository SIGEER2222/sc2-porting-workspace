void gf_CreateHybridWarpInEffect (unit lp_unit) {
    auto_gf_CreateHybridWarpInEffect_lp_unit = lp_unit;

    if (auto_gf_CreateHybridWarpInEffect_Trigger == null) {
        auto_gf_CreateHybridWarpInEffect_Trigger = TriggerCreate("auto_gf_CreateHybridWarpInEffect_TriggerFunc");
    }

    TriggerExecute(auto_gf_CreateHybridWarpInEffect_Trigger, false, false);
}

bool auto_gf_CreateHybridWarpInEffect_TriggerFunc (bool testConds, bool runActions) {
    unit lp_unit = auto_gf_CreateHybridWarpInEffect_lp_unit;

    // Variable Declarations
    actor lv_model;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    UnitAbilityEnable(lp_unit, "move", false);
    UnitAbilityEnable(lp_unit, "attack", false);
    libNtve_gf_AttachModelToUnit(lp_unit, "HybridWarpInEffect", "Ref_Center");
    lv_model = libNtve_gf_ActorLastCreated();
    Wait(5.0, c_timeGame);
    libNtve_gf_KillModel(lv_model);
    UnitAbilityEnable(lp_unit, "move", true);
    UnitAbilityEnable(lp_unit, "attack", true);
    return true;
}

