//--------------------------------------------------------------------------------------------------
// Trigger: Start Game Main
//--------------------------------------------------------------------------------------------------
bool gt_StartGameMain_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UISetRestartLoadingScreen(ConversationDataStateText("Maps|THorner05S", "Loading Screen Restart 2"));
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingCircle", PointFromId(1870029995), ColorWithAlpha(100.00, 100.00, 100.00, 0.00), 0.0, 270.0);
    gv_hybridRevivePing = PingLastCreated();
    PingSetScale(PingLastCreated(), 0.5);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/4C4C5FC7"));
