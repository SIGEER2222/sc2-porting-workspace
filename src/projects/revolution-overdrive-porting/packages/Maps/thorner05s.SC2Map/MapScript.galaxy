void gt_HybridUpgrades_Init () {
    gt_HybridUpgrades = TriggerCreate("gt_HybridUpgrades_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Hybrid Attack Initiate
//--------------------------------------------------------------------------------------------------
bool gt_HybridAttackInitiate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerWindowShow(gv_respawnTimerWindow, PlayerGroupAll(), false);
    PingSetVisible(gv_hybridRevivePing, false);
    TriggerExecute(gt_HybridReviveRepeatTransmission, true, false);
    Wait(1.0, c_timeGame);
    libNtve_gf_UnitCreateFacingPoint(1, "Hazrad", 0, gv_p03_HAZRAD, gv_hybridRespawnPoint, PointFromId(3));
    gv_hazrad = UnitLastCreated();
    libNtve_gf_ShareVisionofUnit(gv_hazrad, true, 1);
    if ((gv_parasiticFieldEnabled == true)) {
        UnitBehaviorAddPlayer(gv_hazrad, "ParasiticField", gv_p03_HAZRAD, 1);
    }

    if ((gv_consumingSwarmEnabled == true)) {
        UnitBehaviorAddPlayer(gv_hazrad, "UncleanPresence", gv_p03_HAZRAD, 1);
    }

    gf_CreateHybridWarpInEffect(UnitLastCreated());
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingBoss", UnitGetPosition(gv_hazrad), ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
    PingSetScale(PingLastCreated(), 0.7);
    PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/07BD8A25"));
    PingSetUnit(PingLastCreated(), gv_hazrad);
    libHots_gf_StorePingForUnit(gv_hazrad, 1, PingLastCreated());
    AIAttackWaveUseUnit(gv_p03_HAZRAD, gv_hazrad);
    AIAttackWaveSetTargetPlayer(gv_p03_HAZRAD, PlayerGroupSingle(1));
    AIAttackWaveSetGatherPoint(gv_p03_HAZRAD, UnitGetPosition(gv_hazrad));
    AIAttackWaveSend(gv_p03_HAZRAD, 3, true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_HybridAttackInitiate_Init () {
    gt_HybridAttackInitiate = TriggerCreate("gt_HybridAttackInitiate_Func");
    TriggerAddEventTimer(gt_HybridAttackInitiate, gv_attackTimer);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Hybrid Revive Repeat Transmission
//--------------------------------------------------------------------------------------------------
bool gt_HybridReviveRepeatTransmission_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int autoA4F0E418_val;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if (gv_reviveCycle >= 5) {
        gv_reviveCycle = 0;
    }
    else {
        gv_reviveCycle = gv_reviveCycle + 1;
    }
    TriggerQueueEnter();
    autoA4F0E418_val = gv_reviveCycle;
    if (autoA4F0E418_val == 0) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libA9E65AFF_gf_PlayCustomTransmission(StringExternal("Param/Value/5C3E959E"), StringExternal("Param/Value/BB007F32"), "HybridBehemothPortrait", SoundLink("THorner05_Hazrad_Intro", -1), true, false);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (autoA4F0E418_val == 1) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner05SHorner00044", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (autoA4F0E418_val == 2) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libA9E65AFF_gf_PlayCustomTransmission(StringExternal("Param/Value/83A5BF8A"), StringExternal("Param/Value/80CD54AD"), "HybridBehemothPortrait", SoundLink("THorner05_Hazrad_01", -1), true, false);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (autoA4F0E418_val == 3) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libA9E65AFF_gf_PlayCustomTransmission(StringExternal("Param/Value/57773D89"), StringExternal("Param/Value/D36C0B30"), "HybridBehemothPortrait", SoundLink("THorner05_Hazrad_012", -1), true, false);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (autoA4F0E418_val == 4) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libA9E65AFF_gf_PlayCustomTransmission(StringExternal("Param/Value/8D4C8F19"), StringExternal("Param/Value/02B05A66"), "HybridBehemothPortrait", SoundLink("THorner05_Hazrad_0122", -1), true, false);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }
    else if (autoA4F0E418_val == 5) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
