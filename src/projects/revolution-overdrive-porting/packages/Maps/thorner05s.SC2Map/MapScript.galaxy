//--------------------------------------------------------------------------------------------------
// Trigger: Hybrid Upgrades
//--------------------------------------------------------------------------------------------------
bool gt_HybridUpgrades_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(600.0, c_timeGame);
    gv_dropPodsEnabled = true;
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDefenseBoost", 1);
    Wait(300.0, c_timeGame);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
    Wait(300.0, c_timeGame);
    gv_missileStrikeCount += 1;
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDefenseBoost", 1);
    gv_annihilationBeamEnabled = true;
    Wait(300.0, c_timeGame);
    gv_dropPodCount += libNtve_gf_DifficultyValueInt(0, 0, 0, 1);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
    Wait(300.0, c_timeGame);
    gv_parasiticFieldEnabled = true;
    gv_missileStrikeCount += 1;
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDefenseBoost", 1);
    Wait(300.0, c_timeGame);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "UndyingRage", 1);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDefenseBoost", 1);
    gv_missileStrikeCount += 1;
    Wait(300.0, c_timeGame);
    gv_consumingSwarmEnabled = true;
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
    TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDefenseBoost", 1);
    gv_annihilationBeamCount += libNtve_gf_DifficultyValueInt(0, 0, 1, 1);
    gv_dropPodCount += libNtve_gf_DifficultyValueInt(0, 0, 1, 1);
    while (true) {
        Wait(300.0, c_timeGame);
        TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDamageBoost", 1);
        TechTreeUpgradeAddLevel(gv_p03_HAZRAD, "HybridDefenseBoost", 1);
    }
    return true;
}

