//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoB4ED4600_g;
    int autoB4ED4600_u;
    unit autoB4ED4600_var;

    // Actions
    if (!runActions) {
        return true;
    }

    CampaignInitAI();
    TriggerExecute(libA9E65AFF_gt_UpgradeController, true, false);
    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunProtossAI, true, false);
    TriggerExecute(gt_P12AirSurvivorAttacks, true, false);
    TriggerExecute(gt_P2InfantrySurvivorAttacks, true, false);
    TriggerExecute(gt_P5MoebiusThrallsAttacks, true, false);
    TriggerExecute(gt_P8MechSurvivorAttacks, true, false);
    TriggerExecute(gt_P9EnthralledSurvivorAttacks, true, false);
    TriggerExecute(gt_MoebiusMastermindsAttacks, true, false);
    TriggerExecute(gt_BlightspreaderAttackWaves, true, false);
    TriggerExecute(gt_LeviathanAttackWaves, true, false);
    TriggerExecute(gt_HybridThrallsAttackWaves, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    TriggerExecute(gt_MoebiusTech, true, false);
    libA9E65AFF_gf_MinefieldDesecrator(RegionFromId(13), gv_p05_MOEBIUSTHRALLS, libNtve_gf_DifficultyValueInt(0, 0, 2, 5));
    libA9E65AFF_gf_MinefieldDesecrator(RegionFromId(34), gv_p06_MOEBISMASTERMINDS, libNtve_gf_DifficultyValueInt(0, 0, 2, 5));
    libA9E65AFF_gf_MinefieldDesecrator(RegionFromId(35), gv_p06_MOEBISMASTERMINDS, libNtve_gf_DifficultyValueInt(0, 0, 2, 5));
    TimerStart(gv_intensityTimer2, 840.0, false, c_timeGame);
    TimerStart(gv_intensityTimer3, 1500.0, false, c_timeGame);
    TimerStart(gv_intensityTimer4, 2100.0, false, c_timeGame);
    autoB4ED4600_g = UnitGroup("Bunker", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    autoB4ED4600_u = UnitGroupCount(autoB4ED4600_g, c_unitCountAll);
    for (;; autoB4ED4600_u -= 1) {
        autoB4ED4600_var = UnitGroupUnitFromEnd(autoB4ED4600_g, autoB4ED4600_u);
        if (autoB4ED4600_var == null) { break; }
        UnitCargoCreate(autoB4ED4600_var, "MengskMarine", libNtve_gf_DifficultyValueInt(4, 4, 4, 4));
        UnitCargoCreate(autoB4ED4600_var, "MengskMarauder", libNtve_gf_DifficultyValueInt(1, 1, 1, 1));
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_StartAI_Init () {
    gt_StartAI = TriggerCreate("gt_StartAI_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Moebius Tech
//--------------------------------------------------------------------------------------------------
bool gt_MoebiusTech_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    playergroup autoF728E0F0_g;
    int autoF728E0F0_var;
    playergroup autoD7FFF503_g;
    int autoD7FFF503_var;
    playergroup autoF2DD6EE1_g;
    int autoF2DD6EE1_var;

    // Actions
    if (!runActions) {
        return true;
    }

    autoF728E0F0_g = libA9E65AFF_gv_enemyPlayers;
    autoF728E0F0_var = -1;
    while (true) {
        autoF728E0F0_var = PlayerGroupNextPlayer(autoF728E0F0_g, autoF728E0F0_var);
        if (autoF728E0F0_var < 0) { break; }
        TechTreeUpgradeAddLevel(autoF728E0F0_var, "SelfInjectionSystem", 1);
        TechTreeUpgradeAddLevel(autoF728E0F0_var, "CriusCombatSuit", 1);
        TechTreeUpgradeAddLevel(autoF728E0F0_var, "KineticCapacitors", 1);
        TechTreeUpgradeAddLevel(autoF728E0F0_var, "ExpandedRepairBay", 1);
        TechTreeUpgradeAddLevel(autoF728E0F0_var, "SpectralAmplifiers", 1);
        TechTreeUpgradeAddLevel(autoF728E0F0_var, "VulcanClassMunitions", 1);
        TechTreeUpgradeAddLevel(autoF728E0F0_var, "TerrazineCapacitors", 1);
    }
    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1)) {
        autoD7FFF503_g = libA9E65AFF_gv_enemyPlayers;
        autoD7FFF503_var = -1;
        while (true) {
            autoD7FFF503_var = PlayerGroupNextPlayer(autoD7FFF503_g, autoD7FFF503_var);
            if (autoD7FFF503_var < 0) { break; }
            TechTreeUpgradeAddLevel(autoD7FFF503_var, "SmokingRemains", 1);
            TechTreeUpgradeAddLevel(autoD7FFF503_var, "StaticCling", 1);
            TechTreeUpgradeAddLevel(autoD7FFF503_var, "KMCDeconstructionRockets", 1);
            TechTreeUpgradeAddLevel(autoD7FFF503_var, "U3RefractoringLenses", 1);
            TechTreeUpgradeAddLevel(autoD7FFF503_var, "BloodisFuel", 1);
        }
    }

    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        autoF2DD6EE1_g = libA9E65AFF_gv_enemyPlayers;
        autoF2DD6EE1_var = -1;
        while (true) {
            autoF2DD6EE1_var = PlayerGroupNextPlayer(autoF2DD6EE1_g, autoF2DD6EE1_var);
            if (autoF2DD6EE1_var < 0) { break; }
            TechTreeUpgradeAddLevel(autoF2DD6EE1_var, "UmojanFrame", 1);
            TechTreeUpgradeAddLevel(autoF2DD6EE1_var, "WardenAOEMissiles", 1);
            TechTreeUpgradeAddLevel(autoF2DD6EE1_var, "PrismaticSpray", 1);
            TechTreeUpgradeAddLevel(autoF2DD6EE1_var, "MindNumbingPlague", 1);
        }
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MoebiusTech_Init () {
    gt_MoebiusTech = TriggerCreate("gt_MoebiusTech_Func");
}

