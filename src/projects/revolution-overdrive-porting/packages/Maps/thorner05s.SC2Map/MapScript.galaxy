//--------------------------------------------------------------------------------------------------
// Trigger: Mech Bullies - Entralled Main
//--------------------------------------------------------------------------------------------------
bool gt_MechBulliesEntralledMain_Func (bool testConds, bool runActions) {
    // Variable Declarations
    region lv_bullyRegion;
    int lv_player;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_bullyRegion = RegionFromId(39);
    lv_player = gv_p08_DOOMINIONSURVIVORSBROWN;

    // Conditions
    if (testConds) {
        if (!((UnitGroupCount(UnitGroupAlliance(lv_player, c_unitAllianceEnemy, lv_bullyRegion, UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) <= 0))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    AIToggleBulliesInRegion(lv_player, lv_bullyRegion, true);
    libA9E65AFF_gf_OrderRegionScriptBuild("Barracks", lv_player, lv_bullyRegion, AbilityCommand("MengskMercTrain", 0), libA9E65AFF_gv_scriptBuildingsWaves);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_MechBulliesEntralledMain_Init () {
    gt_MechBulliesEntralledMain = TriggerCreate("gt_MechBulliesEntralledMain_Func");
    TriggerAddEventTimePeriodic(gt_MechBulliesEntralledMain, 5.0, c_timeGame);
}

