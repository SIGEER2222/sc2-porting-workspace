        UnitBehaviorRemove(auto636FB2C4_var, "PlagueTrooperSpawnBroodlingsonDeath", 1);
    }
    libNtve_gf_AddUnitGroupToUnitGroup(UnitCargoLastCreatedGroup(), gv_introDropshipCargoGroup);
