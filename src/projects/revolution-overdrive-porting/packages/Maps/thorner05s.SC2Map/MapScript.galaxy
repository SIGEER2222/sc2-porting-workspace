//--------------------------------------------------------------------------------------------------
bool gt_TestFinalTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup autoC16E5562_g;
    int autoC16E5562_u;
    unit autoC16E5562_var;
    unitgroup auto632911AD_g;
    int auto632911AD_u;
    unit auto632911AD_var;

    // Actions
    if (!runActions) {
        return true;
    }

    autoC16E5562_g = gv_introMoebiusGuards;
    autoC16E5562_u = UnitGroupCount(autoC16E5562_g, c_unitCountAll);
    for (;; autoC16E5562_u -= 1) {
        autoC16E5562_var = UnitGroupUnitFromEnd(autoC16E5562_g, autoC16E5562_u);
        if (autoC16E5562_var == null) { break; }
        UnitKill(autoC16E5562_var);
    }
    auto632911AD_g = UnitGroup(null, c_playerAny, RegionFromId(5), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto632911AD_u = UnitGroupCount(auto632911AD_g, c_unitCountAll);
    for (;; auto632911AD_u -= 1) {
        auto632911AD_var = UnitGroupUnitFromEnd(auto632911AD_g, auto632911AD_u);
        if (auto632911AD_var == null) { break; }
        if ((UnitGetOwner(auto632911AD_var) != 1)) {
            UnitKill(auto632911AD_var);
        }

    }
    return true;
}

