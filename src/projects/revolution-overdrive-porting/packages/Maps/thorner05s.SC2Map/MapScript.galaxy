// Trigger: Hybrid Thralls Attack Waves
//--------------------------------------------------------------------------------------------------
bool gt_HybridThrallsAttackWaves_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_aI;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_aI = gv_p04_HYBRID_THRALLS;

    // Actions
    if (!runActions) {
        return true;
    }

    AIAttackWaveSetTargetPlayer(lv_aI, PlayerGroupAlliance(c_playerGroupEnemy, lv_aI));
    AIAttackWaveSetGatherPoint(lv_aI, PointFromId(1381553363));
    Wait(1200.0, c_timeGame);
    while (true) {
        Wait(1.0, c_timeGame);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(4, 4, 5, 6, "RoachCorpser");
        AIAttackWaveAddUnits4(2, 2, 2, 3, "Dragoon");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "Goliath");
        AIAttackWaveAddUnits4(3, 3, 4, 5, "Hydralisk");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 3, libNtve_gf_DifficultyValueInt(1, 1, 2, 3), "SwarmHostMP");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 4, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "Reaver");
        libA9E65AFF_gf_SendFlexibleAttackWave("RoachVile", 240, 6, lv_aI, 30, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(2, 2, 2, 3, "ImmortalAiur");
        AIAttackWaveAddUnits4(2, 2, 3, 3, "Thor");
        AIAttackWaveAddUnits4(4, 4, 5, 6, "RoachVile");
        AIAttackWaveAddUnits4(1, 1, 1, 2, "Overseer");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 3, libNtve_gf_DifficultyValueInt(1, 1, 1, 2), "HybridReaver");
        gf_AddMoreAttackersBasedonIntensity(lv_aI, 4, libNtve_gf_DifficultyValueInt(2, 2, 3, 4), "Battlecruiser");
        libA9E65AFF_gf_SendFlexibleAttackWave("RoachVile", 180, 6, lv_aI, 60, true);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1505065936), false);
        AIAttackWaveAddUnits4(1, 1, 1, 1, "HybridDestroyer");
        AIAttackWaveAddUnits4(6, 6, 8, 10, "ZealotShakuras");
        AIAttackWaveAddUnits4(2, 2, 3, 4, "BroodLord");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Viper");
        AIAttackWaveAddUnits4(1, 1, 1, 1, "Raven");
