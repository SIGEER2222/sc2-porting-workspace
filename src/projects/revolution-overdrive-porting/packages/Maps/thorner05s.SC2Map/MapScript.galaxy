//--------------------------------------------------------------------------------------------------
// Trigger: Hybrid Respawn Timer
//--------------------------------------------------------------------------------------------------
bool gt_HybridRespawnTimer_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    PingDestroy(libHots_gf_PingStoredForUnit(gv_hazrad, 1));
    TimerWindowShow(gv_respawnTimerWindow, PlayerGroupAll(), true);
    TimerStart(gv_attackTimer, gv_hybridRespawnTime, false, c_timeGame);
    PingSetVisible(gv_hybridRevivePing, true);
    gv_hybridDrivenBackCount += 1;
    if ((gv_hybridDrivenBackCount == 1)) {
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
        libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner05SHorner00049", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SendTransmissionCampaign(null, SoundLink("THorner05SRaynor00050", 0), c_transmissionDurationAdd, 0.0, true);
        libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    }

    return true;
}

