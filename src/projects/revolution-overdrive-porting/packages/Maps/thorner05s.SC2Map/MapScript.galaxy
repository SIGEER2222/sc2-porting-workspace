//--------------------------------------------------------------------------------------------------
// Trigger: Objective Conduits Create Q
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveConduitsCreateQ_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto673F1B64_g;
    int auto673F1B64_u;
    unit auto673F1B64_var;

    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libWCMI_gf_CreateObjectiveCampaign("THorner05_4");
    gv_objectivePowerConduits = ObjectiveLastCreated();
    auto673F1B64_g = UnitGroup("PlatformConnector", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto673F1B64_u = UnitGroupCount(auto673F1B64_g, c_unitCountAll);
    for (;; auto673F1B64_u -= 1) {
        auto673F1B64_var = UnitGroupUnitFromEnd(auto673F1B64_g, auto673F1B64_u);
        if (auto673F1B64_var == null) { break; }
        libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingObjective", UnitGetPosition(auto673F1B64_var), ColorWithAlpha(100.00, 100.00, 0.00, 0.00), 0.0, 270.0);
        PingSetScale(PingLastCreated(), 0.7);
        PingSetTooltip(PingLastCreated(), StringExternal("Param/Value/0429E4FE"));
        libHots_gf_StorePingForUnit(auto673F1B64_var, 1, PingLastCreated());
    }
    Wait(libWCMI_gv_campaignObjectiveDelay, c_timeReal);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ObjectiveConduitsCreateQ_Init () {
    gt_ObjectiveConduitsCreateQ = TriggerCreate("gt_ObjectiveConduitsCreateQ_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Objective Conduits Update
//--------------------------------------------------------------------------------------------------
bool gt_ObjectiveConduitsUpdate_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetType(EventUnit()) == "PlatformConnector"))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gf_MoveRespawnPing();
    gv_conduitsDestroyed += 1;
    libCamp_gf_CreateMissionAutosavePoint(StringExternal("Param/Value/4740E3F3"));
    UnitDamage(gv_reactorCore, "SelfDamage", gv_reactorCore, 0.0);
    UnitBehaviorAdd(gv_reactorCore, "Instability", gv_reactorCore, 1);
    TriggerExecute(gt_ObjectiveConduitsCreateQ, true, false);
    PingDestroy(libHots_gf_PingStoredForUnit(EventUnit(), 1));
    libWCMI_gf_SetMissionObjectiveProgress("THorner05_4", gv_conduitsDestroyed);
    if ((gv_conduitsDestroyed == gv_conduitsTotal)) {
        TriggerExecute(gt_ObjectiveConduitsComplete, true, false);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ObjectiveConduitsUpdate_Init () {
    gt_ObjectiveConduitsUpdate = TriggerCreate("gt_ObjectiveConduitsUpdate_Func");
    TriggerAddEventUnitDied(gt_ObjectiveConduitsUpdate, null);
}

