bool auto_gf_MoveRespawnPing_TriggerFunc (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Implementation
    if ((UnitIsAlive(UnitFromId(2026001750)) == true)) {
        PingSetPosition(gv_hybridRevivePing, PointFromId(1870029995));
        gv_hybridRespawnPoint = PointFromId(1870029995);
    }
    else if ((UnitIsAlive(UnitFromId(1413814025)) == true)) {
        PingSetPosition(gv_hybridRevivePing, PointFromId(391271919));
        gv_hybridRespawnPoint = PointFromId(391271919);
    }
    else if ((UnitIsAlive(UnitFromId(1172338758)) == true)) {
        PingSetPosition(gv_hybridRevivePing, PointFromId(717847118));
        gv_hybridRespawnPoint = PointFromId(717847118);
    }
    else if ((UnitIsAlive(UnitFromId(1504780817)) == true)) {
        PingSetPosition(gv_hybridRevivePing, PointFromId(687948534));
        gv_hybridRespawnPoint = PointFromId(687948534);
    }
    else if ((UnitIsAlive(UnitFromId(490535916)) == true)) {
        PingSetPosition(gv_hybridRevivePing, PointFromId(1084650010));
        gv_hybridRespawnPoint = PointFromId(1084650010);
    }
    else if ((UnitIsAlive(UnitFromId(2026001750)) == false) && (UnitIsAlive(UnitFromId(1413814025)) == false) && (UnitIsAlive(UnitFromId(1172338758)) == false) && (UnitIsAlive(UnitFromId(1504780817)) == false) && (UnitIsAlive(UnitFromId(490535916)) == false)) {
        gv_hybridRespawnPoint = PointFromId(1310562819);
        PingSetPosition(gv_hybridRevivePing, PointFromId(1310562819));
    }
    return true;
}

unitgroup gf_EnemiesWithinRange (unit lp_unit, fixed lp_range, unitfilter lp_filter) {
    // Automatic Variable Declarations
    // Implementation
    return UnitGroupAlliance(UnitGetOwner(lp_unit), c_unitAllianceEnemy, RegionCircle(UnitGetPosition(lp_unit), lp_range), lp_filter, 0);
}

