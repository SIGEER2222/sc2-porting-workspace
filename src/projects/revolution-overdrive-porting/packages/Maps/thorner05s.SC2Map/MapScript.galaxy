        gf_AddMoreAttackersBasedonIntensity(lv_aI, 4, libNtve_gf_DifficultyValueInt(1, 1, 1, 1), "GuardianMP");
        libA9E65AFF_gf_SendFlexibleAttackWave("Mutalisk", 220, 6, lv_aI, 30, true);
