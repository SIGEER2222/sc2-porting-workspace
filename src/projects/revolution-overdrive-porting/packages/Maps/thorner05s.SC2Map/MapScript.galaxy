void gt_ReactorExplosionsat50_Init () {
    gt_ReactorExplosionsat50 = TriggerCreate("gt_ReactorExplosionsat50_Func");
    TriggerAddEventTimePeriodic(gt_ReactorExplosionsat50, 5.0, c_timeGame);
}

