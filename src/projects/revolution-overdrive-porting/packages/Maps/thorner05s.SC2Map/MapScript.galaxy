//--------------------------------------------------------------------------------------------------
// Trigger: Khalai Kills
//--------------------------------------------------------------------------------------------------
bool gt_KhalaiKills_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_p13_KHALAI))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    gv_khalaiKills += 1;
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_KhalaiKills_Init () {
    gt_KhalaiKills = TriggerCreate("gt_KhalaiKills_Func");
    TriggerAddEventUnitDied(gt_KhalaiKills, null);
}

