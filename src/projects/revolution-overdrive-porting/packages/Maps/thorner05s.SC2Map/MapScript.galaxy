        Wait(1.0, c_timeGame);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(637270222), false);
        AIAttackWaveAddWaypoint(lv_aI, PointFromId(1553965089), false);
        AIAttackWaveAddUnits4(12, 12, 15, 20, "HotSRaptor");
