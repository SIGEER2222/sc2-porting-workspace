    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    gv_obejctiveProtossAlliesRescued += 1;
    TriggerExecute(gt_ObjectiveProtossAlliesCreateQ, true, false);
    libWCMI_gf_SetMissionObjectiveProgress("THorner05_6", gv_obejctiveProtossAlliesRescued);
    if ((gv_obejctiveProtossAlliesRescued == gv_obejctiveProtossAlliesTotal)) {
        TriggerExecute(gt_ObjectiveProtossAlliesComplete, true, false);
