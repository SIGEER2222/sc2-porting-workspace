//--------------------------------------------------------------------------------------------------
// Trigger: Start AI
//--------------------------------------------------------------------------------------------------
bool gt_StartAI_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    TimerStart(gv_zergFirstAttackWaveTimer, libNtve_gf_DifficultyValueFixed(60.0, 60.0, 30.0, 30.0), false, c_timeGame);
    CampaignInitAI();
    TriggerExecute(libA9E65AFF_gt_RunTerranAI, true, false);
    TriggerExecute(libA9E65AFF_gt_RunZergAI, true, false);
    TriggerExecute(gt_P2AttackWaves, true, false);
    TriggerExecute(gt_P3AttackWaves, true, false);
    TriggerExecute(gt_AttackWavesPurpleZergP04, true, false);
    TriggerExecute(gt_P5AttackWaves, true, false);
    TriggerExecute(gt_P10AttackWaves, true, false);
    TriggerExecute(gt_P11AttackWaves, true, false);
    TriggerExecute(gt_P12AttackWaves, true, false);
    TriggerExecute(gt_P14AttackWaves, true, false);
    TriggerExecute(gt_ReinforceRegionsWithBullies, true, false);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 0, 1) == 1)) {
        TriggerExecute(gt_AIUpgradesBrutal, true, false);
    }
    else if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 0) == 1)) {
        TriggerExecute(gt_AIUpgradesHard, true, false);
    }
    else if ((libNtve_gf_DifficultyValueInt(1, 1, 0, 0) == 1)) {
        TriggerExecute(gt_AIUpgradesNormal, true, false);
    }
    return true;
}

