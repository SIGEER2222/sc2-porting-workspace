//--------------------------------------------------------------------------------------------------
// Trigger: Stranded Rebel Marines Timing
//--------------------------------------------------------------------------------------------------
bool gt_StrandedRebelMarinesTiming_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Wait(120.0, c_timeGame);
    TriggerExecute(gt_RebelMarines01Intro, true, true);
    TriggerExecute(gt_RebelMarines02Intro, true, true);
    TriggerExecute(gt_RebelMarines03Intro, true, true);
    TriggerExecute(gt_RebelMarines04Intro, true, true);
    TriggerExecute(gt_RebelMarines05Intro, true, true);
    TriggerExecute(gt_RebelMarines06Intro, true, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Speech);
    libLbty_gf_PlayTransmissionCueSound(PlayerGroupAll());
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TRaynor02Raynor00065", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SendTransmissionCampaign(null, SoundLink("TTychus02Tychus00007", -1), c_transmissionDurationAdd, 0.0, true);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Game);
    return true;
}

