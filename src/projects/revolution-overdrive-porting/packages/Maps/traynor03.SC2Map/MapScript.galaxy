void gt_ZergP02EndGameNydusWorms_Init () {
    gt_ZergP02EndGameNydusWorms = TriggerCreate("gt_ZergP02EndGameNydusWorms_Func");
    TriggerAddEventTimer(gt_ZergP02EndGameNydusWorms, gv_oneMinuteWarning);
}

