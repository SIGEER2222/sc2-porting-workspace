    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((gv_rebelFightersRescued == 1)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "SelfInjectionSystem", 1);
        libNtve_gf_SetUpgradeLevelForPlayer(1, "MindNumbingPlague", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/9E6D4DC9"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_rebelFightersRescued == 2)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "SmokingRemains", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/4496F91B"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

    if ((gv_rebelFightersRescued == 3)) {
        libNtve_gf_SetUpgradeLevelForPlayer(1, "U3RefractoringLenses", 1);
        libCamp_gf_DisplayCampaignMessage(PlayerGroupAll(), libCamp_ge_CampaignMessageType_Hint, StringExternal("Param/Value/42811A4C"), libCamp_ge_CampaignMessageFormatNotFormat_FormatMessage);
    }

