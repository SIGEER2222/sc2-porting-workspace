    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroup("VoidThrasher", c_playerAny, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) == 0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    UnitBehaviorRemove(gv_amon, "VileBulwark", 1);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_ThrashersDeadCheck_Init () {
    gt_ThrashersDeadCheck = TriggerCreate("gt_ThrashersDeadCheck_Func");
    TriggerEnable(gt_ThrashersDeadCheck, false);
    TriggerAddEventTimePeriodic(gt_ThrashersDeadCheck, 0.5, c_timeGame);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Bridge Control Destroyed
//--------------------------------------------------------------------------------------------------
bool gt_BridgeControlDestroyed_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    UnitIssueOrder(UnitFromId(1395154995), Order(AbilityCommand("ShakurasLightBridgeNW12", 0)), c_orderQueueReplace);
    UnitIssueOrder(UnitFromId(1887273649), Order(AbilityCommand("ShakurasLightBridgeNW12", 0)), c_orderQueueReplace);
    Wait(10.0, c_timeGame);
    libNtve_gf_PauseUnit(UnitFromId(1887273649), true);
    libNtve_gf_PauseUnit(UnitFromId(1395154995), true);
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_BridgeControlDestroyed_Init () {
    gt_BridgeControlDestroyed = TriggerCreate("gt_BridgeControlDestroyed_Func");
    TriggerAddEventUnitDied(gt_BridgeControlDestroyed, UnitRefFromUnit(UnitFromId(1292782988)));
}

