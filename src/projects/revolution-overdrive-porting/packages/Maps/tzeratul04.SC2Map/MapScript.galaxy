        return true;
    }

    if ((UnitIsAlive(gv_omegalisk1) == true)) {
        Wait(1.0, c_timeGame);
        UnitIssueOrder(gv_omegalisk1, Order(AbilityCommand("BurrowOmegaliskUp", 0)), c_orderQueueReplace);
        Wait(2.0, c_timeGame);
