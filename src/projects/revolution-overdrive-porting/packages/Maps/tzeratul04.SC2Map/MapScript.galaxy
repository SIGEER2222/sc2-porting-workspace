void gt_IntroSequence_Init () {
    gt_IntroSequence = TriggerCreate("gt_IntroSequence_Func");
}

//--------------------------------------------------------------------------------------------------
// Trigger: Start Game - Stage 1
//--------------------------------------------------------------------------------------------------
bool gt_StartGameStage1_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto9BB7FF11_g;
    int auto9BB7FF11_u;
    unit auto9BB7FF11_var;

    // Actions
    if (!runActions) {
        return true;
    }

    UnitFlashSelection(gv_zeratul, 5.0);
    VisRevealerCreate(1, RegionFromId(88));
    VisRevealerCreate(1, RegionFromId(87));
    libA9E65AFF_gf_GenerateTipPopup(StringExternal("Param/Value/96F6EBC4"));
    Wait(3.0, c_timeGame);
    auto9BB7FF11_g = UnitGroup(null, gv_p12_AMON, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterHeroic) | (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto9BB7FF11_u = UnitGroupCount(auto9BB7FF11_g, c_unitCountAll);
    for (;; auto9BB7FF11_u -= 1) {
        auto9BB7FF11_var = UnitGroupUnitFromEnd(auto9BB7FF11_g, auto9BB7FF11_u);
        if (auto9BB7FF11_var == null) { break; }
        UnitBehaviorAdd(auto9BB7FF11_var, "VoidShade", auto9BB7FF11_var, 1);
    }
    TriggerExecute(gt_ObjectiveSurviveCreateQ, true, false);
    Wait(1.0, c_timeGame);
    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_herolessModeEnabledString) == false)) {
        PlayerModifyPropertyInt(1, c_playerPropTerrazine, c_playerPropOperSubtract, 1);
    }

    TriggerExecute(gt_CreateLeaderboard, true, false);
    Wait(10.0, c_timeGame);
    TriggerExecute(gt_CreateAllOutAttackButton, true, false);
    TriggerExecute(gt_ObjectiveKillAmonCreateQ, true, false);
    libCamp_gf_CreateStorymodeTips();
    Wait(10.0, c_timeGame);
    TriggerExecute(gt_TransmissionTemplarsStoreKnowledgeQ, true, true);
    TriggerExecute(gt_ObjectiveProtectArchiveCreateQ, true, false);
    Wait(5.0, c_timeGame);
    TriggerExecute(gt_TransmissionArtanisFinalSpeechQ, true, false);
    Wait(65.0, c_timeGame);
    TriggerExecute(gt_TransmissionDarkVoicePronouncementQ, true, false);
    TriggerExecute(gt_ActivateHeroWayGate, true, false);
    Wait(240.0, c_timeGame);
    TriggerEnable(gt_WarpedinTemplarBehavior, false);
    TriggerExecute(gt_NewTech01PhoenixQ, true, false);
    gf_ActivateBullies(ge_BullyPhase_Early);
    Wait(60.0, c_timeGame);
    TriggerExecute(gt_TransmissionZergswarmingflanksQ, true, false);
    TriggerExecute(gt_AirFlanksNydus, true, false);
    return true;
}

