trigger auto_gf_CreateWarpInEffect_Trigger = null;
unit auto_gf_CreateWarpInEffect_lp_unit;

void gf_CreateWarpInEffect (unit lp_unit) {
    auto_gf_CreateWarpInEffect_lp_unit = lp_unit;

    if (auto_gf_CreateWarpInEffect_Trigger == null) {
        auto_gf_CreateWarpInEffect_Trigger = TriggerCreate("auto_gf_CreateWarpInEffect_TriggerFunc");
    }

    TriggerExecute(auto_gf_CreateWarpInEffect_Trigger, false, false);
}

bool auto_gf_CreateWarpInEffect_TriggerFunc (bool testConds, bool runActions) {
    unit lp_unit = auto_gf_CreateWarpInEffect_lp_unit;

    // Variable Declarations
    actor lv_model;

    // Automatic Variable Declarations
    // Variable Initialization

    // Implementation
    UnitAbilityEnable(lp_unit, "move", false);
    UnitAbilityEnable(lp_unit, "attack", false);
    libNtve_gf_MakeUnitInvulnerable(lp_unit, true);
    if (((UnitGetType(lp_unit) == "HybridDestroyer") || (UnitGetType(lp_unit) == "HybridDominatorVoid") || (UnitGetType(lp_unit) == "HybridReaver") || (UnitGetType(lp_unit) == "HybridBehemoth") || (UnitGetType(lp_unit) == "HybridNemesis"))) {
        libNtve_gf_AttachModelToUnit(lp_unit, "HybridWarpInEffect", "Ref_Center");
    }
    else {
        libNtve_gf_AttachModelToUnit(lp_unit, "ProtossGenericWarpInOut", "Ref_Center");
    }
    lv_model = libNtve_gf_ActorLastCreated();
    Wait(2.0, c_timeGame);
    libNtve_gf_KillModel(lv_model);
    libNtve_gf_MakeUnitInvulnerable(lp_unit, false);
    UnitAbilityEnable(lp_unit, "move", true);
    UnitAbilityEnable(lp_unit, "attack", true);
    return true;
}

void gf_DisplayEndMissionButton () {
    // Automatic Variable Declarations
    // Implementation
    if ((gv_endMissionButton != c_invalidDialogControlId)) {
        return ;
    }

    DialogControlHookupStandard(c_triggerControlTypeButton, "UIContainer/ConsoleUIContainer/Zeratul04EndMission");
    gv_endMissionButton = DialogControlLastCreated();
    DialogControlSetVisible(gv_endMissionButton, PlayerGroupAll(), true);
    TriggerEnable(gt_EndMissionButtonClicked, true);
}

trigger auto_gf_AetherMawAI_Trigger = null;
unit auto_gf_AetherMawAI_lp_aetherMaw;
int auto_gf_AetherMawAI_lp_index;

void gf_AetherMawAI (unit lp_aetherMaw, int lp_index) {
    auto_gf_AetherMawAI_lp_aetherMaw = lp_aetherMaw;
    auto_gf_AetherMawAI_lp_index = lp_index;

    if (auto_gf_AetherMawAI_Trigger == null) {
        auto_gf_AetherMawAI_Trigger = TriggerCreate("auto_gf_AetherMawAI_TriggerFunc");
    }

    TriggerExecute(auto_gf_AetherMawAI_Trigger, false, false);
}

bool auto_gf_AetherMawAI_TriggerFunc (bool testConds, bool runActions) {
    unit lp_aetherMaw = auto_gf_AetherMawAI_lp_aetherMaw;
    int lp_index = auto_gf_AetherMawAI_lp_index;

    // Automatic Variable Declarations
    // Implementation
    while ((UnitIsAlive(lp_aetherMaw) == true)) {
        if ((UnitIsAlive(lp_aetherMaw) == true) && (UnitGroupCount(UnitGroupAlliance(UnitGetOwner(lp_aetherMaw), c_unitAllianceEnemy, RegionCircle(UnitGetPosition(lp_aetherMaw), 15.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) > 0)) {
            UnitIssueOrder(lp_aetherMaw, OrderTargetingPoint(AbilityCommand("AetherMawAetherStorm", 0), UnitGetPosition(UnitGroupRandomUnit(UnitGroupAlliance(gv_p12_AMON, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(lp_aetherMaw), 12.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))), 0), c_unitCountAlive))), c_orderQueueReplace);
            Wait(libLotv_gf_DifficultyValueFixed2(20.0, 20.0, 15.0, 15.0), c_timeAI);
        }
        else {
            Wait(1.0, c_timeAI);
        }
    }
    return true;
}

