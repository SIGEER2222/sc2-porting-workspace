//--------------------------------------------------------------------------------------------------
// Trigger: End Mission Button Clicked
//--------------------------------------------------------------------------------------------------
bool gt_EndMissionButtonClicked_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    unitgroup auto947E29A0_g;
    int auto947E29A0_u;
    unit auto947E29A0_var;

    // Conditions
    if (testConds) {
        if (!((gv_endMissionButton != c_invalidDialogControlId))) {
            return false;
        }

        if (!((EventDialogControl() == gv_endMissionButton))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    DialogControlSetVisible(gv_endMissionButton, PlayerGroupAll(), false);
    while ((UnitCount(null, gv_p01_PLAYER, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0) > 0)) {
        auto947E29A0_g = UnitGroup(null, gv_p01_PLAYER, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        auto947E29A0_u = UnitGroupCount(auto947E29A0_g, c_unitCountAll);
        for (;; auto947E29A0_u -= 1) {
            auto947E29A0_var = UnitGroupUnitFromEnd(auto947E29A0_g, auto947E29A0_u);
            if (auto947E29A0_var == null) { break; }
            UnitKill(auto947E29A0_var);
            Wait(0.0625, c_timeGame);
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void gt_EndMissionButtonClicked_Init () {
    gt_EndMissionButtonClicked = TriggerCreate("gt_EndMissionButtonClicked_Func");
    TriggerEnable(gt_EndMissionButtonClicked, false);
    TriggerAddEventDialogControl(gt_EndMissionButtonClicked, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: Intro Sequence
//--------------------------------------------------------------------------------------------------
bool gt_IntroSequence_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_herolessModeEnabledString) == false)) {
        TechTreeUpgradeAddLevel(gv_p01_PLAYER, "WisdomoftheNerazim", 1);
        libA9E65AFF_gf_UpdateCommandCard("Zeratul");
    }

    if ((BankValueGetAsFlag(libA9E65AFF_gv_bonusBank, libA9E65AFF_gv_bonusesObtainedSection, libA9E65AFF_gv_herolessModeEnabledString) == true)) {
        UnitRemove(gv_zeratul);
    }

    TriggerExecute(gt_StartAI, true, false);
    Wait(0.1, c_timeReal);
    UIAlertPoint("Trigger", gv_p01_PLAYER, StringToText(""), null, UnitGetPosition(gv_zeratul));
    TriggerEnable(gt_VictoryDefeatforPlayer, true);
    TriggerExecute(gt_StartGameStage1, true, false);
    return true;
}

