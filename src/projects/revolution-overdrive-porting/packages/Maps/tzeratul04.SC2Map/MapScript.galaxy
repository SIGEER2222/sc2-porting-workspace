//--------------------------------------------------------------------------------------------------
bool gt_MidOmegalisk1Unburrow_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Conditions
    if (testConds) {
        if (!((gv_inCinematic == true))) {
