//--------------------------------------------------------------------------------------------------
// Trigger: Ally kills
//--------------------------------------------------------------------------------------------------
bool gt_Allykills_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    int auto5AA21567_val;

    // Conditions
    if (testConds) {
        if (!(((UnitGetOwner(libNtve_gf_KillingUnit()) == gv_p3_ARTANIS) || (UnitGetOwner(libNtve_gf_KillingUnit()) == gv_p9_VORAZUN) || (UnitGetOwner(libNtve_gf_KillingUnit()) == gv_p11_KARAX)))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    auto5AA21567_val = libNtve_gf_KillingPlayer();
    if (auto5AA21567_val == gv_p9_VORAZUN) {
        gv_vorazunKills += 1;
    }
    else if (auto5AA21567_val == gv_p3_ARTANIS) {
        gv_artanisHeroKills += 1;
    }
    else if (auto5AA21567_val == gv_p11_KARAX) {
        gv_karaxKills += 1;
    }
    else {
    }
    return true;
}

