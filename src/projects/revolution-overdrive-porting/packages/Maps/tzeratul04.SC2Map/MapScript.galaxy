//--------------------------------------------------------------------------------------------------
// Trigger: Orbital Barrage
//--------------------------------------------------------------------------------------------------
bool gt_OrbitalBarrage_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unit lv_strikeTarget;

    // Automatic Variable Declarations
    int auto9D474B97_n;
    int auto9D474B97_i;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(UnitFromId(63259047)) == true))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(gv_amon, c_unitPropLifePercent, c_unitPropCurrent) <= 95.0))) {
            return false;
        }

        if (!((TriggerIsEnabled(TriggerGetCurrent()) == true))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitGroupCount(UnitGroupAlliance(UnitGetOwner(gv_amon), c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_amon), 18.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) > 0)) {
        TriggerEnable(TriggerGetCurrent(), false);
        auto9D474B97_n = libNtve_gf_DifficultyValueInt(8, 8, 10, 12);
        for (auto9D474B97_i = 1; auto9D474B97_i <= auto9D474B97_n; auto9D474B97_i += 1) {
            UnitCreateEffectPoint(gv_amon, "OrbitalStrikeDelay", RegionRandomPoint(RegionCircle(UnitGetPosition(gv_amon), 15.0)));
        }
        Wait(libNtve_gf_DifficultyValueFixed(20.0, 20.0, 16.0, 13.0), c_timeGame);
        TriggerEnable(TriggerGetCurrent(), true);
    }

    return true;
}

