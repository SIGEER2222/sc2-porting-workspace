        libNtve_gf_PlayAnimation(libNtve_gf_MainActorofUnit(gv_omegalisk1), c_animNameDefault, "Stand Victory", c_animFlagNonLooping, c_animTimeDefault);
        libNtve_gf_ShareVisionofUnit(gv_omegalisk1, true, gv_p01_PLAYER);
    }

    return true;
}

