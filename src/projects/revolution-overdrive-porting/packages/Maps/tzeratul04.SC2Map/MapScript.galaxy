    Wait(5.0, c_timeGame);
    if ((libNtve_gf_DifficultyValueInt(0, 0, 1, 1) == 1) && (gf_AreaIsBeingHarvested(RegionFromId(66)) == true)) {
        gf_SpawnNydusWormZerglings(RegionFromId(69));
    }

    gv_statWavessent += 1;
    return true;
}

