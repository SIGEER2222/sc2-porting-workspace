void cai_startall () {
    cai_start("ai5689EB5F", 4);
    cai_start("ai2C9F37EC", 5);
    cai_start("ai22AF3135", 6);
    AICampaignStart(2);
    AICampaignStart(3);
    AICampaignStart(7);
    AICampaignStart(8);
    AICampaignStart(9);
    AICampaignStart(10);
    AICampaignStart(11);
    AICampaignStart(12);
}

//--------------------------------------------------------------------------------------------------
void cai_runall () {
    playergroup target = PlayerGroupEmpty();

    PlayerGroupClear(target);
    PlayerGroupAdd(target, 1);
    PlayerGroupAdd(target, 3);
    PlayerGroupAdd(target, 9);
    PlayerGroupAdd(target, 11);
    cai_waves_run(4, target);

    PlayerGroupClear(target);
    PlayerGroupAdd(target, 1);
    PlayerGroupAdd(target, 3);
    PlayerGroupAdd(target, 9);
    PlayerGroupAdd(target, 11);
    cai_waves_run(5, target);

    PlayerGroupClear(target);
    PlayerGroupAdd(target, 1);
    PlayerGroupAdd(target, 3);
    PlayerGroupAdd(target, 9);
    PlayerGroupAdd(target, 11);
    cai_waves_run(6, target);
}

