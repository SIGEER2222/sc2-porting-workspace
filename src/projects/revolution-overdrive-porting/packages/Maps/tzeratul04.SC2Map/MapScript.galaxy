//--------------------------------------------------------------------------------------------------
// Trigger: Apocalypse
//--------------------------------------------------------------------------------------------------
bool gt_Apocalypse_Func (bool testConds, bool runActions) {
    // Variable Declarations
    unitgroup lv_plasmaTargets;
    unit lv_target;
    int lv_targetCount;
    int lv_desiredCasts;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_plasmaTargets = UnitGroupEmpty();

    // Conditions
    if (testConds) {
        if (!((UnitIsAlive(gv_amon) == true))) {
            return false;
        }

        if (!((UnitGroupCount(UnitGroupAlliance(gv_p12_AMON, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_amon), 10.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0), c_unitCountAlive) >= 5))) {
            return false;
        }

        if (!((UnitGetPropertyFixed(gv_amon, c_unitPropLifePercent, c_unitPropCurrent) <= 75.0))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    lv_plasmaTargets = UnitGroupAlliance(gv_p12_AMON, c_unitAllianceEnemy, RegionCircle(UnitGetPosition(gv_amon), 10.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_target = UnitGroupRandomUnit(lv_plasmaTargets, c_unitCountAlive);
    libNtve_gf_AICast(gv_amon, OrderTargetingUnit(AbilityCommand("KerriganVoidApocalypse", 0), lv_target));
    Wait(libNtve_gf_DifficultyValueFixed(30.0, 30.0, 25.0, 25.0), c_timeGame);
    TriggerEnable(TriggerGetCurrent(), true);
    return true;
}

