        return true;
    }

    TriggerEnable(TriggerGetCurrent(), false);
    libWCMI_gf_CreateObjectiveCampaign("TZeratul04_22");
    gv_objectiveKillAmon = ObjectiveLastCreated();
    libNtve_gf_CreatePingFacingAngle(PlayerGroupAll(), "PingObjective", UnitGetPosition(gv_amon), ColorWithAlpha(100.00, 0.00, 0.00, 0.00), 0.0, 270.0);
