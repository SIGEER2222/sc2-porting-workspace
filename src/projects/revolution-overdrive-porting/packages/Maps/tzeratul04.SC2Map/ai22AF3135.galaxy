    AIAttackWaveAddUnits(3, 8, "Adept");
    AIAttackWaveAddUnits(4, 10, "Adept");
    AIAttackWaveAddUnits(5, 12, "Adept");

    AIAttackWaveAddUnits(2, 2, "Colossus");
    AIAttackWaveAddUnits(3, 2, "Colossus");
    AIAttackWaveAddUnits(4, 2, "Colossus");
    AIAttackWaveAddUnits(5, 3, "Colossus");

    AIAttackWaveAddUnits(2, 1, "Oracle");
    AIAttackWaveAddUnits(3, 1, "Oracle");
    AIAttackWaveAddUnits(4, 1, "Oracle");
    AIAttackWaveAddUnits(5, 2, "Oracle");

    AIAttackWaveAddUnits(2, 2, "SentryAiur");
    AIAttackWaveAddUnits(3, 2, "SentryAiur");
    AIAttackWaveAddUnits(4, 3, "SentryAiur");
    AIAttackWaveAddUnits(5, 4, "SentryAiur");

    AIAttackWaveAddUnits(2, 2, "CarrierAiur");
    AIAttackWaveAddUnits(3, 2, "CarrierAiur");
    AIAttackWaveAddUnits(4, 2, "CarrierAiur");
    AIAttackWaveAddUnits(5, 3, "CarrierAiur");

    AIAttackWaveAddUnits(2, 8, "Zealot");
    AIAttackWaveAddUnits(3, 8, "Zealot");
    AIAttackWaveAddUnits(4, 10, "Zealot");
    AIAttackWaveAddUnits(5, 12, "Zealot");

    TriggerExecute(TriggerFind("gt_IncrementWavesSent_Func"), true, false);
    AIAttackWaveSend(p, ts, false);
    ai22AF3135_wave14_lastWave[p] = WaveLastCreated();
    ai22AF3135_lastWave[p] = ai22AF3135_wave14_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

