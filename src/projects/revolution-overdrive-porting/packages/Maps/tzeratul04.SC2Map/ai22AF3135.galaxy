//--------------------------------------------------------------------------------------------------
// Attack Wave Sequence
//--------------------------------------------------------------------------------------------------
trigger ai22AF3135_waves_trigger = null;
int ai22AF3135_waves_runPlayer;
playergroup ai22AF3135_waves_runTarget;

//--------------------------------------------------------------------------------------------------
void ai22AF3135_waves_init () {
    ai22AF3135_waves_trigger = TriggerCreate("ai22AF3135_waves_runFunc");
}

//--------------------------------------------------------------------------------------------------
bool ai22AF3135_waves_runFunc (bool c, bool a) {
    int p = ai22AF3135_waves_runPlayer;
    playergroup target = ai22AF3135_waves_runTarget;

    if (p < 0 || p >= 16) {
        return false;
    }

    ai22AF3135_wave1_run(p, target, true);
    ai22AF3135_wave2_run(p, target, true);
    ai22AF3135_wave3_run(p, target, true);
    ai22AF3135_wave4_run(p, target, true);
    ai22AF3135_wave5_run(p, target, true);
    ai22AF3135_wave6_run(p, target, true);
    ai22AF3135_wave7_run(p, target, true);
    ai22AF3135_wave8_run(p, target, true);
    ai22AF3135_wave9_run(p, target, true);
    ai22AF3135_wave10_run(p, target, true);
    ai22AF3135_wave11_run(p, target, true);
    ai22AF3135_wave12_run(p, target, true);
    ai22AF3135_wave13_run(p, target, true);
    ai22AF3135_wave14_run(p, target, true);

    while (true) {
        ai22AF3135_wave12_run(p, target, true);
        ai22AF3135_wave13_run(p, target, true);
        ai22AF3135_wave14_run(p, target, true);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai22AF3135_waves_run (int p, playergroup target) {
    ai22AF3135_waves_runPlayer = p;
    ai22AF3135_waves_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai22AF3135_waves_trigger, false, false);
}

