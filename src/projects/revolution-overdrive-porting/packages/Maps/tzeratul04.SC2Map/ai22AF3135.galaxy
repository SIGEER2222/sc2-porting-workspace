//--------------------------------------------------------------------------------------------------
bool ai22AF3135_wave1_runFunc (bool c, bool a) {
    int p = ai22AF3135_wave1_runPlayer;
    playergroup target = ai22AF3135_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!ai22AF3135_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    ai22AF3135_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 180; }
    if (d == 2) { ta = 180; }
    if (d == 3) { ta = 180; }
    if (d == 4) { ta = 180; }
    tg = 0;
    if (d == 1) { tg = 60; }
    if (d == 2) { tg = 60; }
    if (d == 3) { tg = 60; }
    if (d == 4) { tg = 60; }
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = ai22AF3135_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);
    gatherPoint = PointFromId(205147200);
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);
    AIAttackWaveAddWaypoint(p, PointFromId(1125519508), false);

    AIAttackWaveAddUnits(2, 8, "Zealot");
    AIAttackWaveAddUnits(3, 8, "Zealot");
    AIAttackWaveAddUnits(4, 10, "Zealot");
    AIAttackWaveAddUnits(5, 12, "Zealot");

    AIAttackWaveAddUnits(2, 4, "StalkerShakuras");
    AIAttackWaveAddUnits(3, 4, "StalkerShakuras");
    AIAttackWaveAddUnits(4, 6, "StalkerShakuras");
    AIAttackWaveAddUnits(5, 8, "StalkerShakuras");

    AIAttackWaveAddUnits(2, 1, "ImmortalAiur");
    AIAttackWaveAddUnits(3, 1, "ImmortalAiur");
    AIAttackWaveAddUnits(4, 2, "ImmortalAiur");
    AIAttackWaveAddUnits(5, 3, "ImmortalAiur");

    AIAttackWaveAddUnits(2, 1, "SentryAiur");
    AIAttackWaveAddUnits(3, 1, "SentryAiur");
    AIAttackWaveAddUnits(4, 1, "SentryAiur");
    AIAttackWaveAddUnits(5, 2, "SentryAiur");

    AIAttackWaveAddUnits(2, 4, "Scout");
    AIAttackWaveAddUnits(3, 4, "Scout");
    AIAttackWaveAddUnits(4, 5, "Scout");
    AIAttackWaveAddUnits(5, 6, "Scout");

    TriggerExecute(TriggerFind("gt_IncrementWavesSent_Func"), true, false);
    AIAttackWaveSend(p, ts, false);
    ai22AF3135_wave1_lastWave[p] = WaveLastCreated();
    ai22AF3135_lastWave[p] = ai22AF3135_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

