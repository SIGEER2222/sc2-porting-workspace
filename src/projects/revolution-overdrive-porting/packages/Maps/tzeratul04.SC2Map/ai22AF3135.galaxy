//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool ai22AF3135_initialized = false;

//--------------------------------------------------------------------------------------------------
void ai22AF3135_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!ai22AF3135_initialized) {
        ai22AF3135_wave1_init();
        ai22AF3135_wave2_init();
        ai22AF3135_wave3_init();
        ai22AF3135_wave4_init();
        ai22AF3135_wave5_init();
        ai22AF3135_wave6_init();
        ai22AF3135_wave7_init();
        ai22AF3135_wave8_init();
        ai22AF3135_wave9_init();
        ai22AF3135_wave10_init();
        ai22AF3135_wave11_init();
        ai22AF3135_wave12_init();
        ai22AF3135_wave13_init();
        ai22AF3135_wave14_init();
        ai22AF3135_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            ai22AF3135_defGather[init_i] = PointFromId(205147200);
        }

        ai22AF3135_initialized = true;
    }

    AICampaignStart(p);
}
