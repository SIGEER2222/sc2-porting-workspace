//--------------------------------------------------------------------------------------------------
bool ai5689EB5F_wave1_runFunc (bool c, bool a) {
    int p = ai5689EB5F_wave1_runPlayer;
    playergroup target = ai5689EB5F_wave1_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!ai5689EB5F_wave1_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    ai5689EB5F_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 180; }
    if (d == 2) { ta = 180; }
    if (d == 3) { ta = 180; }
    if (d == 4) { ta = 180; }
    tg = 0;
    if (d == 1) { tg = 60; }
    if (d == 2) { tg = 60; }
    if (d == 3) { tg = 60; }
    if (d == 4) { tg = 60; }
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = ai5689EB5F_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);
    gatherPoint = PointFromId(37175366);
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);
    AIAttackWaveAddWaypoint(p, PointFromId(279986894), false);

    AIAttackWaveAddUnits(2, 8, "MengskMarine");
    AIAttackWaveAddUnits(3, 8, "MengskMarine");
    AIAttackWaveAddUnits(4, 10, "MengskMarine");
    AIAttackWaveAddUnits(5, 12, "MengskMarine");

    AIAttackWaveAddUnits(2, 2, "MengskFirebat");
    AIAttackWaveAddUnits(3, 2, "MengskFirebat");
    AIAttackWaveAddUnits(4, 3, "MengskFirebat");
    AIAttackWaveAddUnits(5, 4, "MengskFirebat");

    AIAttackWaveAddUnits(2, 4, "Medic");
    AIAttackWaveAddUnits(3, 4, "Medic");
    AIAttackWaveAddUnits(4, 4, "Medic");
    AIAttackWaveAddUnits(5, 4, "Medic");

    AIAttackWaveAddUnits(2, 2, "WarHound");
    AIAttackWaveAddUnits(3, 2, "WarHound");
    AIAttackWaveAddUnits(4, 3, "WarHound");
    AIAttackWaveAddUnits(5, 4, "WarHound");

    TriggerExecute(TriggerFind("gt_IncrementWavesSent_Func"), true, false);
    AIAttackWaveSend(p, ts, false);
    ai5689EB5F_wave1_lastWave[p] = WaveLastCreated();
    ai5689EB5F_lastWave[p] = ai5689EB5F_wave1_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
void ai5689EB5F_wave1_run (int p, playergroup target, bool wait) {
    ai5689EB5F_wave1_runPlayer = p;
    ai5689EB5F_wave1_runTarget = PlayerGroupCopy(target);

    TriggerExecute(ai5689EB5F_wave1_trigger, false, wait);
}

