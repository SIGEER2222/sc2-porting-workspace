//--------------------------------------------------------------------------------------------------
bool ai5689EB5F_wave15_runFunc (bool c, bool a) {
    int p = ai5689EB5F_wave15_runPlayer;
    playergroup target = ai5689EB5F_wave15_runTarget;
    int d;
    point gatherPoint = null;
    int ta = 0;
    int tg = 0;
    int ts = 0;
    int tf = 0;
    int td = 0;

    if (p < 0 || p >= 16) {
        return false;
    }
    d = PlayerDifficulty(p);
    if (!ai5689EB5F_wave15_enabled[p]) {
        td = 0;
        if (td > 0) {
            Wait(td, c_timeAI);
        }
        return true;
    }

    ai5689EB5F_customData[p] = "";

    ta = 0;
    if (d == 1) { ta = 120; }
    if (d == 2) { ta = 120; }
    if (d == 3) { ta = 120; }
    if (d == 4) { ta = 120; }
    tg = 0;
    if (d == 1) { tg = 120; }
    if (d == 2) { tg = 120; }
    if (d == 3) { tg = 120; }
    if (d == 4) { tg = 120; }
    ts = ta;
    if (tg > 0 && tg < ta) {
        Wait(ta - tg, c_timeAI);
        ts = tg;
    }
    AIAttackWaveSetTargetPlayer(p, target);

    gatherPoint = ai5689EB5F_defGather[p];
    AIAttackWaveSetGatherPoint(p, gatherPoint);
    gatherPoint = PointFromId(37175366);
    AIAttackWaveSetGatherPoint(p, gatherPoint);

    AIAttackWaveClearWaypoints(p);
    AIAttackWaveAddWaypoint(p, PointFromId(522438767), false);

    AIAttackWaveAddUnits(2, 8, "MengskHellion");
    AIAttackWaveAddUnits(3, 8, "MengskHellion");
    AIAttackWaveAddUnits(4, 10, "MengskHellion");
    AIAttackWaveAddUnits(5, 12, "MengskHellion");

    AIAttackWaveAddUnits(2, 6, "SiegeTank");
    AIAttackWaveAddUnits(3, 6, "SiegeTank");
    AIAttackWaveAddUnits(4, 7, "SiegeTank");
    AIAttackWaveAddUnits(5, 8, "SiegeTank");

    AIAttackWaveAddUnits(2, 4, "MengskMedic");
    AIAttackWaveAddUnits(3, 4, "MengskMedic");
    AIAttackWaveAddUnits(4, 4, "MengskMedic");
    AIAttackWaveAddUnits(5, 4, "MengskMedic");

    AIAttackWaveAddUnits(2, 2, "MengskSiegeTank");
    AIAttackWaveAddUnits(3, 2, "MengskSiegeTank");
    AIAttackWaveAddUnits(4, 2, "MengskSiegeTank");
    AIAttackWaveAddUnits(5, 2, "MengskSiegeTank");

    AIAttackWaveAddUnits(2, 1, "Raven");
    AIAttackWaveAddUnits(3, 1, "Raven");
    AIAttackWaveAddUnits(4, 1, "Raven");
    AIAttackWaveAddUnits(5, 1, "Raven");

    AIAttackWaveAddUnits(4, 1, "MengskThor");
    AIAttackWaveAddUnits(5, 1, "MengskThor");

    AIAttackWaveAddUnits(2, 4, "Wraith");
    AIAttackWaveAddUnits(3, 4, "Wraith");
    AIAttackWaveAddUnits(4, 5, "Wraith");
    AIAttackWaveAddUnits(5, 6, "Wraith");

    TriggerExecute(TriggerFind("gt_IncrementWavesSent_Func"), true, false);
    AIAttackWaveSend(p, ts, false);
    ai5689EB5F_wave15_lastWave[p] = WaveLastCreated();
    ai5689EB5F_lastWave[p] = ai5689EB5F_wave15_lastWave[p];
    Wait(ts, c_timeAI);
    tf = 0;
    if (tf > 0) {
        Wait(tf, c_timeAI);
    }

    return true;
}

