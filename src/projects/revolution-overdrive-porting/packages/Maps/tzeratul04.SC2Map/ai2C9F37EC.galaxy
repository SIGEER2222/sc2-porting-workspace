//--------------------------------------------------------------------------------------------------
void ai2C9F37EC_setDefGather (int p, point val) {
    if (p < 0 || p >= 16) {
        return;
    }
    ai2C9F37EC_defGather[p] = val;
}

//--------------------------------------------------------------------------------------------------
string ai2C9F37EC_getCustomData (int p) {
    if (p < 0 || p >= 16) {
        return null;
    }
    return ai2C9F37EC_customData[p];
}

//--------------------------------------------------------------------------------------------------
wave ai2C9F37EC_getLastWave (int p) {
    if (p < 0 || p >= 16) {
        return null;
    }
    return ai2C9F37EC_lastWave[p];
}

//--------------------------------------------------------------------------------------------------
// Start
//--------------------------------------------------------------------------------------------------
bool ai2C9F37EC_initialized = false;

//--------------------------------------------------------------------------------------------------
void ai2C9F37EC_start (int p) {
    int init_i;

    if (p < 0 || p >= 16) {
        return;
    }
    if (!ai2C9F37EC_initialized) {
        ai2C9F37EC_wave1_init();
        ai2C9F37EC_wave2_init();
        ai2C9F37EC_wave3_init();
        ai2C9F37EC_wave4_init();
        ai2C9F37EC_wave5_init();
        ai2C9F37EC_wave6_init();
        ai2C9F37EC_wave7_init();
        ai2C9F37EC_wave8_init();
        ai2C9F37EC_wave9_init();
        ai2C9F37EC_wave10_init();
        ai2C9F37EC_wave11_init();
        ai2C9F37EC_wave12_init();
        ai2C9F37EC_wave13_init();
        ai2C9F37EC_wave14_init();
        ai2C9F37EC_wave15_init();
        ai2C9F37EC_wave16_init();
        ai2C9F37EC_waves_init();

        for (init_i = 0; init_i <= 16; init_i += 1) {
            ai2C9F37EC_defGather[init_i] = PointFromId(938435911);
        }

        ai2C9F37EC_initialized = true;
    }

    AICampaignStart(p);
}
