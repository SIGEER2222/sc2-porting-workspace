<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Desc>
  <Frame type="Slider" name="StandardSliderTemplate">
    <Image val="Background"/>
    <FillContainer val="FillContainer"/>
    <FillBarImage val="FillImage"/>
    <Button val="Button"/>
    <AutoSizeFillBar val="true"/>
    <!-- 更改方向为垂直 -->
    <Orientation val="Vertical"/>
    <Width val="38"/>

    <Frame type="Image" name="Background">
        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
        <Width val="24"/> <!-- 宽度 -->
        <Texture val="@@UI/StandardSlider"/>
        <TextureType val="Border"/>
        <Tiled val="true"/>
        <DesaturateOnDisable val="false"/>
        <DisabledAlpha val="64"/>
        <DescFlags val="Internal"/>
    </Frame>

    <Frame type="Frame" name="FillContainer">
        <Anchor side="Top" relative="$parent" pos="Min" offset="0"/>
        <Anchor side="Bottom" relative="$parent" pos="Max" offset="0"/>
        <Anchor side="Left" relative="$parent" pos="Mid" offset="-4"/>
        <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
        <Width val="10"/> <!-- 背景宽度 -->
        <DescFlags val="Internal"/>
    </Frame>

    <Frame type="Image" name="FillImage">
        <Texture val="@@UI/StandardSliderFill"/>
        <TextureType val="Border"/>
        <Tiled val="true"/>
        <DesaturateOnDisable val="false"/>
        <DisabledAlpha val="64"/>
        <DescFlags val="Internal"/>
    </Frame>

    <Frame type="Button" name="Button">
        <NormalImage val="NormalImage"/>
        <HoverImage val="HoverImage"/>
        <Width val="40"/> <!-- 调整按钮尺寸 -->
        <Height val="18"/> <!-- 调整按钮尺寸 -->
        <DescFlags val="Internal"/>

        <Frame type="Image" name="NormalImage">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Texture val="Assets\Textures\ui_replay_sliderhandlebutton_normaloverpressedover.dds"/>
            <StateCount val="2"/>
            <DesaturateOnDisable val="false"/>
            <DisabledAlpha val="64"/>
            <DescFlags val="Internal"/>
        </Frame>

        <Frame type="Image" name="HoverImage">
            <Anchor side="Top" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Left" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Bottom" relative="$parent" pos="Mid" offset="0"/>
            <Anchor side="Right" relative="$parent" pos="Mid" offset="0"/>
            <Texture val="Assets\Textures\ui_replay_sliderhandlebutton_normaloverpressedover.dds"/>
            <StateCount val="2"/>
            <DesaturateOnDisable val="false"/>
            <DisabledAlpha val="64"/>
            <DescFlags val="Internal"/>
        </Frame>
    </Frame>
</Frame>
</Desc>