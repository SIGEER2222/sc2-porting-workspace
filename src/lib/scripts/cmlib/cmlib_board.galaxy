    VictoryPanelSetMissionTimeTitle(StringToText(lp_title));
    VictoryPanelSetMissionTimeText(StringToText(lp_text));
}

void CMLib_VPanelReward(string lp_title, string lp_text, int lp_credits) {
    VictoryPanelSetRewardTitle(StringToText(lp_title));
    VictoryPanelSetRewardText(StringToText(lp_text));
    if (lp_credits >= 0) {
        VictoryPanelSetRewardCredits(lp_credits);
    }
}

void CMLib_VPanelStatisticsTitle(string lp_title) {
    VictoryPanelSetStatisticsTitle(StringToText(lp_title));
}

void CMLib_VPanelAchievementsTitle(string lp_title) {
    VictoryPanelSetAchievementsTitle(StringToText(lp_title));
}

void CMLib_VPanelStat(string lp_label, string lp_value) {
    VictoryPanelAddCustomStatisticLine(StringToText(lp_label),
                                       StringToText(lp_value));
}

void CMLib_VPanelStatInt(string lp_label, int lp_value) {
    VictoryPanelAddCustomStatisticLine(StringToText(lp_label),
                                       IntToText(lp_value));
}

void CMLib_VPanelStatFixed(string lp_label, fixed lp_value, int lp_precision) {
    int lv_precision;

    lv_precision = CMLib_ClampInt(lp_precision, 0, 6);
    VictoryPanelAddCustomStatisticLine(StringToText(lp_label),
                                       FixedToText(lp_value, lv_precision));
}

void CMLib_VPanelStatBatch(string lp_csv) {
    int lv_n;
    int lv_i;
    string lv_item;
    string lv_label;
    string lv_value;
    int lv_sepAt;

    if (lp_csv == "") {
        return;
    }
    lv_n = CMLib_SplitCount(lp_csv, ",");
    lv_i = 0;
    while (lv_i < lv_n) {
        lv_item = CMLib_SplitAt(lp_csv, ",", lv_i);
        lv_sepAt = StringFind(lv_item, ":", true);
        if (lv_sepAt > 0) {
            // 只在**第一个**冒号处切，这样 "用时:12:30" 的值仍是 "12:30"。
            lv_label = StringSub(lv_item, 1, lv_sepAt - 1);
            lv_value = StringSub(lv_item, lv_sepAt + 1, StringLength(lv_item));
        } else {
            lv_label = lv_item;
            lv_value = "";
        }
        VictoryPanelAddCustomStatisticLine(StringToText(lv_label),
                                           StringToText(lv_value));
        lv_i = lv_i + 1;
    }
}

void CMLib_VPanelStatClear() {
    VictoryPanelClearCustomStatisticTable();
}

void CMLib_VPanelTracked(string lp_statistic) {
    if (lp_statistic == "") {
        return;
    }
    VictoryPanelAddTrackedStatistic(lp_statistic);
}

void CMLib_VPanelTrackedBatch(string lp_csv) {
    int lv_n;
    int lv_i;
    string lv_stat;

    if (lp_csv == "") {
        return;
    }
    lv_n = CMLib_SplitCount(lp_csv, ",");
    lv_i = 0;
    while (lv_i < lv_n) {
        lv_stat = CMLib_TrimSpaces(CMLib_SplitAt(lp_csv, ",", lv_i));
        if (lv_stat != "") {
            VictoryPanelAddTrackedStatistic(lv_stat);
        }
        lv_i = lv_i + 1;
    }
}

void CMLib_VPanelVisuals(string lp_planetModel, string lp_background,
                         string lp_summaryBackground) {
    if (lp_planetModel != "") {
        VictoryPanelSetPlanetModelLink(lp_planetModel);
    }
    if (lp_background != "") {
        VictoryPanelSetBackgroundFilePath(lp_background);
    }
    if (lp_summaryBackground != "") {
        VictoryPanelSetSummaryBackgroundFilePath(lp_summaryBackground);
    }
}

