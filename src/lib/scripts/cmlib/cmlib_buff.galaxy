bool CMLib_UnitInTransport(unit lp_unit) {
    return CMLib_UStateGet(lp_unit, c_unitStateInsideTransport);
}

bool CMLib_UnitIdleState(unit lp_unit) {
    return CMLib_UStateGet(lp_unit, c_unitStateIdle);
}

bool CMLib_UnitDeadState(unit lp_unit) {
    return CMLib_UStateGet(lp_unit, c_unitStateIsDead);
}

bool CMLib_UnitBuried(unit lp_unit) {
    return CMLib_UStateGet(lp_unit, c_unitStateBuried);
}

// =============================================================================
// 玩家状态位
// =============================================================================

bool CMLib_PStateSet(int lp_player, int lp_state, bool lp_value) {
    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        return false;
    }
    PlayerSetState(lp_player, lp_state, lp_value);
    // 影子缓存：引擎没有 getter，只能自己记
    CMLib_StoreBool(CMLib_Key3("cmlib", "pstate",
        IntToString(lp_player) + "_" + IntToString(lp_state)), lp_value);
    return true;
}

bool CMLib_PStateGet(int lp_player, int lp_state, bool lp_fallback) {
    return CMLib_LoadBool(CMLib_Key3("cmlib", "pstate",
        IntToString(lp_player) + "_" + IntToString(lp_state)), lp_fallback);
}

int CMLib_PStateSetGroup(playergroup lp_players, int lp_state, bool lp_value) {
    int lv_index;
    int lv_done;
    int lv_player;

    if ((lp_players == null)) {
        return 0;
    }
    lv_index = PlayerGroupCount(lp_players);
    lv_done = 0;
    while ((lv_index >= 1)) {
        lv_player = PlayerGroupPlayer(lp_players, lv_index);
        lv_index -= 1;
        if ((CMLib_PStateSet(lv_player, lp_state, lp_value) == true)) {
            lv_done += 1;
        }
    }
    return lv_done;
}

// ---- 具名封装 -----------------------------------------------------------------

void CMLib_PlayerFreeCost(int lp_player, bool lp_on) {
    CMLib_PStateSet(lp_player, c_playerStateMineralCostIgnored, lp_on);
    CMLib_PStateSet(lp_player, c_playerStateVespeneCostIgnored, lp_on);
    CMLib_PStateSet(lp_player, c_playerStateTerrazineCostIgnored, lp_on);
    CMLib_PStateSet(lp_player, c_playerStateCustomCostIgnored, lp_on);
    CMLib_PStateSet(lp_player, c_playerStateFoodIgnored, lp_on);
}

void CMLib_PlayerPauseCooldowns(int lp_player, bool lp_on) {
    CMLib_PStateSet(lp_player, c_playerStateChargesPaused, lp_on);
    CMLib_PStateSet(lp_player, c_playerStateCooldownsPaused, lp_on);
}

bool CMLib_PlayerShowScore(int lp_player, bool lp_on) {
    return CMLib_PStateSet(lp_player, c_playerStateShowScore, lp_on);
}

bool CMLib_PlayerGivesBounty(int lp_player, bool lp_on) {
    return CMLib_PStateSet(lp_player, c_playerStateGivesBounty, lp_on);
}

bool CMLib_PlayerInLeaderPanel(int lp_player, bool lp_on) {
    return CMLib_PStateSet(lp_player, c_playerStateDisplayInLeaderPanel, lp_on);
}
