// =============================================================================
// 点：构造与坐标
// =============================================================================
point CMLib_PointOffset(point lp_p, fixed lp_dx, fixed lp_dy) {
    if (lp_p == null) { return null; }
    return PointWithOffset(lp_p, lp_dx, lp_dy);
}

fixed CMLib_PointX(point lp_p) {
    if (lp_p == null) { return 0.0; }
    return PointGetX(lp_p);
}

fixed CMLib_PointY(point lp_p) {
    if (lp_p == null) { return 0.0; }
    return PointGetY(lp_p);
}

fixed CMLib_PointHeight(point lp_p) {
    if (lp_p == null) { return 0.0; }
    return PointGetHeight(lp_p);
}

// =============================================================================
// 点：关系量
// =============================================================================
fixed CMLib_Distance(point lp_a, point lp_b) {
    if ((lp_a == null) || (lp_b == null)) { return 0.0; }
    return DistanceBetweenPoints(lp_a, lp_b);
}

fixed CMLib_AngleBetween(point lp_a, point lp_b) {
    if ((lp_a == null) || (lp_b == null)) { return 0.0; }
    return AngleBetweenPoints(lp_a, lp_b);
}

point CMLib_PointPolar(point lp_src, fixed lp_distance, fixed lp_angleDeg) {
    if (lp_src == null) { return null; }
    return PointWithOffsetPolar(lp_src, lp_distance, lp_angleDeg);
}

point CMLib_PointTowards(point lp_src, point lp_tgt, fixed lp_distance) {
    if ((lp_src == null) || (lp_tgt == null)) { return null; }
    return PointWithOffsetPolar(lp_src, lp_distance, AngleBetweenPoints(lp_src, lp_tgt));
}

point CMLib_LerpPoint(point lp_a, point lp_b, fixed lp_t) {
    fixed lx = 0.0;
    fixed ly = 0.0;

    if ((lp_a == null) || (lp_b == null)) { return null; }
    lx = PointGetX(lp_a) + (PointGetX(lp_b) - PointGetX(lp_a)) * lp_t;
    ly = PointGetY(lp_a) + (PointGetY(lp_b) - PointGetY(lp_a)) * lp_t;
    // 以 lp_a 为基准做偏移，继承其高度，避免凭空造 Z。
    return PointWithOffset(lp_a, lx - PointGetX(lp_a), ly - PointGetY(lp_a));
}

// =============================================================================
// 点：寻路 / 可达
// =============================================================================
bool CMLib_PointPassable(point lp_p) {
    if (lp_p == null) { return false; }
    return PointPathingPassable(lp_p);
}

bool CMLib_PointsConnected(point lp_a, point lp_b) {
    if ((lp_a == null) || (lp_b == null)) { return false; }
    return PointPathingIsConnected(lp_a, lp_b);
}

point CMLib_FindPathablePoint(point lp_p, fixed lp_maxRadius) {
    fixed lr = 2.0;
    int  lring = 1;
    int  lang = 0;
    int  langMax = 12;
    int  ringMax = 24;
    fixed lang_deg = 0.0;
    point lcand = null;

    if (lp_p == null) { return null; }
    if (PointPathingPassable(lp_p)) { return lp_p; }

    // 螺旋外扩搜索：每圈 12 个角度，半径每圈 +2，直到 lp_maxRadius。
    for (lring = 1; lring <= ringMax; lring += 1) {
        for (lang = 0; lang < langMax; lang += 1) {
            lang_deg = (IntToFixed(lang) * 360.0) / IntToFixed(langMax);
            lcand = PointWithOffsetPolar(lp_p, lr, lang_deg);
            if (PointPathingPassable(lcand)) { return lcand; }
        }
        lr = lr + 2.0;
        if (lr > lp_maxRadius) { break; }
    }
    return null;
}

// =============================================================================
// 区域：构造
// =============================================================================
region CMLib_RegionCircle(point lp_center, fixed lp_radius) {
    if (lp_center == null) { return null; }
    return RegionCircle(lp_center, lp_radius);
}

region CMLib_RegionRect(fixed lp_minx, fixed lp_miny, fixed lp_maxx, fixed lp_maxy) {
    return RegionRect(lp_minx, lp_miny, lp_maxx, lp_maxy);
}

region CMLib_RegionEmpty() {
    return RegionEmpty();
}

// =============================================================================
// 区域：查询 / 修改
// =============================================================================
point CMLib_RegionCenter(region lp_region) {
    if (lp_region == null) { return null; }
    return RegionGetCenter(lp_region);
}

point CMLib_RegionRandomPoint(region lp_region) {
    if (lp_region == null) { return null; }
    return RegionRandomPoint(lp_region);
}

bool CMLib_RegionContains(region lp_region, point lp_p) {
    if ((lp_region == null) || (lp_p == null)) { return false; }
    return RegionContainsPoint(lp_region, lp_p);
}

void CMLib_RegionAddCircle(region lp_region, bool lp_positive, point lp_center, fixed lp_radius) {
    if ((lp_region == null) || (lp_center == null)) { return; }
    RegionAddCircle(lp_region, lp_positive, lp_center, lp_radius);
}

void CMLib_RegionAddRect(region lp_region, bool lp_positive,
                         fixed lp_minx, fixed lp_miny, fixed lp_maxx, fixed lp_maxy) {
    if (lp_region == null) { return; }
    RegionAddRect(lp_region, lp_positive, lp_minx, lp_miny, lp_maxx, lp_maxy);
}

// =============================================================================
// 生成几何：常用组合
// =============================================================================
point CMLib_RandomPointInRadius(point lp_center, fixed lp_radius) {
    region lreg;

    if (lp_center == null) { return null; }
    lreg = RegionCircle(lp_center, lp_radius);
    if (lreg == null) { return null; }
    return RegionRandomPoint(lreg);
}

