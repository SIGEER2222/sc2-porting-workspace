}

// =============================================================================
// 单位状态：行为查询
// =============================================================================
int CMLib_UnitBehaviorCount(unit lp_unit, string lp_behavior) {
    if ((lp_unit == null) || (lp_behavior == "")) { return 0; }
    return UnitBehaviorCount(lp_unit, lp_behavior);
}

bool CMLib_UnitHasBehavior(unit lp_unit, string lp_behavior) {
    return CMLib_UnitBehaviorCount(lp_unit, lp_behavior) > 0;
}

