fixed CMLib_UnitGetValue(unit lp_unit, int lp_index) {
    if (lp_unit == null) { return 0.0; }
    return UnitGetCustomValue(lp_unit, lp_index);
}

void CMLib_UnitSetValue(unit lp_unit, int lp_index, fixed lp_value) {
