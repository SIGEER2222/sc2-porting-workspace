// =============================================================================
// CMLib :: Catalog (实现)
//
// 字段路径速查（已对照 CMRE_Core_Base 的实际 XML 校验）：
//   CUnit      LifeMax / ShieldsMax / Speed / LifeArmor / Food
//              CostResource[Minerals] / CostResource[Vespene]
//   CWeapon    Range / Period
//   CEffect*   Amount
//   CBehavior* Duration / Modification.<字段>
//   CAbil*     Cost[i].Cooldown.TimeUse / Cost[i].Vital[Energy] / InfoArray[slot].Time
//   CButton    Icon
//
// 注意：建造时间不在 CUnit 上，而在生产技能的 InfoArray[slot].Time。
// =============================================================================

include "scripts/cmlib/cmlib_core_h"
include "scripts/cmlib/cmlib_catalog_h"

// -----------------------------------------------------------------------------
// 字段路径构造
// -----------------------------------------------------------------------------

string CMLib_CatPathIndex(string lp_field, int lp_index) {
    return lp_field + "[" + IntToString(lp_index) + "]";
}

string CMLib_CatPathIndexSub(string lp_field, int lp_index, string lp_sub) {
    return lp_field + "[" + IntToString(lp_index) + "]." + lp_sub;
}

string CMLib_CatPathSub(string lp_field, string lp_sub) {
    return lp_field + "." + lp_sub;
}

// -----------------------------------------------------------------------------
// 通用读
// -----------------------------------------------------------------------------

bool CMLib_CatEntryExists(int lp_catalog, string lp_entry) {
    if ((lp_entry == null)) {
        return false;
    }
    if ((lp_entry == "")) {
        return false;
    }
    return CatalogEntryIsValid(lp_catalog, lp_entry);
}

string CMLib_CatGetString(int lp_catalog, string lp_entry, string lp_path, int lp_player, string lp_fallback) {
    string lv_raw;

    if ((CMLib_CatEntryExists(lp_catalog, lp_entry) == false)) {
        return lp_fallback;
    }
    lv_raw = CatalogFieldValueGet(lp_catalog, lp_entry, lp_path, lp_player);
    if ((lv_raw == null)) {
        return lp_fallback;
    }
    if ((lv_raw == "")) {
        return lp_fallback;
    }
    return lv_raw;
}

int CMLib_CatGetInt(int lp_catalog, string lp_entry, string lp_path, int lp_player, int lp_fallback) {
    if ((CMLib_CatEntryExists(lp_catalog, lp_entry) == false)) {
        return lp_fallback;
    }
    return CMLib_ParseInt(CatalogFieldValueGet(lp_catalog, lp_entry, lp_path, lp_player), lp_fallback);
}

fixed CMLib_CatGetFixed(int lp_catalog, string lp_entry, string lp_path, int lp_player, fixed lp_fallback) {
    if ((CMLib_CatEntryExists(lp_catalog, lp_entry) == false)) {
        return lp_fallback;
    }
    return CMLib_ParseFixed(CatalogFieldValueGet(lp_catalog, lp_entry, lp_path, lp_player), lp_fallback);
}

int CMLib_CatArrayCount(int lp_catalog, string lp_entry, string lp_path, int lp_player) {
    if ((CMLib_CatEntryExists(lp_catalog, lp_entry) == false)) {
        return 0;
    }
    return CatalogFieldValueCount(lp_catalog, lp_entry, lp_path, lp_player);
}

// -----------------------------------------------------------------------------
// 通用写
// -----------------------------------------------------------------------------

bool CMLib_CatSetString(int lp_catalog, string lp_entry, string lp_path, int lp_player, string lp_value) {
    bool lv_ok;

    if ((CMLib_CatEntryExists(lp_catalog, lp_entry) == false)) {
        CMLib_LogError("CMLib.Catalog", "unknown entry '" + lp_entry + "' (catalog " + IntToString(lp_catalog) + ")");
        return false;
    }
    lv_ok = CatalogFieldValueSet(lp_catalog, lp_entry, lp_path, lp_player, lp_value);
    if ((lv_ok == false)) {
        CMLib_LogError("CMLib.Catalog", "set failed: " + lp_entry + "." + lp_path + " = " + lp_value);
    }
    return lv_ok;
}

bool CMLib_CatSetInt(int lp_catalog, string lp_entry, string lp_path, int lp_player, int lp_value) {
    return CMLib_CatSetString(lp_catalog, lp_entry, lp_path, lp_player, IntToString(lp_value));
}

bool CMLib_CatSetFixed(int lp_catalog, string lp_entry, string lp_path, int lp_player, fixed lp_value) {
    // 精度 4 位：SC2 数据层多数字段到小数点后 4 位就足够，
    // 用默认 FixedToString(v, c_fixedPrecisionAny) 会带出冗余尾数。
    return CMLib_CatSetString(lp_catalog, lp_entry, lp_path, lp_player, FixedToString(lp_value, 4));
}

bool CMLib_CatModifyInt(int lp_catalog, string lp_entry, string lp_path, int lp_player, int lp_value, int lp_operation) {
    bool lv_ok;

    if ((CMLib_CatEntryExists(lp_catalog, lp_entry) == false)) {
        CMLib_LogError("CMLib.Catalog", "unknown entry '" + lp_entry + "' (catalog " + IntToString(lp_catalog) + ")");
        return false;
    }
    lv_ok = CatalogFieldValueModify(lp_catalog, lp_entry, lp_path, lp_player, IntToString(lp_value), lp_operation);
    if ((lv_ok == false)) {
        CMLib_LogError("CMLib.Catalog", "modify failed: " + lp_entry + "." + lp_path);
    }
    return lv_ok;
}

bool CMLib_CatModifyFixed(int lp_catalog, string lp_entry, string lp_path, int lp_player, fixed lp_value, int lp_operation) {
    bool lv_ok;

    if ((CMLib_CatEntryExists(lp_catalog, lp_entry) == false)) {
        CMLib_LogError("CMLib.Catalog", "unknown entry '" + lp_entry + "' (catalog " + IntToString(lp_catalog) + ")");
        return false;
    }
    lv_ok = CatalogFieldValueModify(lp_catalog, lp_entry, lp_path, lp_player, FixedToString(lp_value, 4), lp_operation);
    if ((lv_ok == false)) {
        CMLib_LogError("CMLib.Catalog", "modify failed: " + lp_entry + "." + lp_path);
    }
    return lv_ok;
}

// percent > 0 → 在基础值上加 percent%；percent < 0 → 在基础值上减 |percent|%。
// 走 AddBaseMultiply/SubtractBaseMultiply 而不是 Multiply，
// 这样多次调用是「线性叠加」而非「连乘」，符合大多数指挥官精通的预期。
bool CMLib_CatScalePercent(int lp_catalog, string lp_entry, string lp_path, int lp_player, int lp_percent) {
    fixed lv_ratio;

    if ((lp_percent == 0)) {
        return true;
    }
    if ((lp_percent > 0)) {
        lv_ratio = (IntToFixed(lp_percent) / 100.0);
        return CMLib_CatModifyFixed(lp_catalog, lp_entry, lp_path, lp_player, lv_ratio, CMLIB_CAT_ADD_BASE);
    }
    lv_ratio = (IntToFixed(-lp_percent) / 100.0);
    return CMLib_CatModifyFixed(lp_catalog, lp_entry, lp_path, lp_player, lv_ratio, CMLIB_CAT_SUB_BASE);
}

// -----------------------------------------------------------------------------
// 单位
// -----------------------------------------------------------------------------

fixed CMLib_UnitDataGetLifeMax(string lp_unitType, int lp_player) {
    return CMLib_CatGetFixed(c_gameCatalogUnit, lp_unitType, "LifeMax", lp_player, 0.0);
}

fixed CMLib_UnitDataGetShieldMax(string lp_unitType, int lp_player) {
    return CMLib_CatGetFixed(c_gameCatalogUnit, lp_unitType, "ShieldsMax", lp_player, 0.0);
}

fixed CMLib_UnitDataGetSpeed(string lp_unitType, int lp_player) {
    return CMLib_CatGetFixed(c_gameCatalogUnit, lp_unitType, "Speed", lp_player, 0.0);
}

int CMLib_UnitDataGetArmor(string lp_unitType, int lp_player) {
    return CMLib_CatGetInt(c_gameCatalogUnit, lp_unitType, "LifeArmor", lp_player, 0);
}

int CMLib_UnitDataGetSupply(string lp_unitType, int lp_player) {
    return CMLib_CatGetInt(c_gameCatalogUnit, lp_unitType, "Food", lp_player, 0);
}

bool CMLib_UnitDataSetLifeMax(string lp_unitType, int lp_player, fixed lp_value) {
    return CMLib_CatSetFixed(c_gameCatalogUnit, lp_unitType, "LifeMax", lp_player, lp_value);
}

bool CMLib_UnitDataSetShieldMax(string lp_unitType, int lp_player, fixed lp_value) {
    return CMLib_CatSetFixed(c_gameCatalogUnit, lp_unitType, "ShieldsMax", lp_player, lp_value);
}

bool CMLib_UnitDataSetSpeed(string lp_unitType, int lp_player, fixed lp_value) {
    return CMLib_CatSetFixed(c_gameCatalogUnit, lp_unitType, "Speed", lp_player, lp_value);
}

bool CMLib_UnitDataAddArmor(string lp_unitType, int lp_player, int lp_delta) {
    if ((lp_delta == 0)) {
        return true;
    }
    if ((lp_delta > 0)) {
        return CMLib_CatModifyInt(c_gameCatalogUnit, lp_unitType, "LifeArmor", lp_player, lp_delta, CMLIB_CAT_ADD);
    }
    return CMLib_CatModifyInt(c_gameCatalogUnit, lp_unitType, "LifeArmor", lp_player, -lp_delta, CMLIB_CAT_SUB);
}

bool CMLib_UnitDataSetCost(string lp_unitType, int lp_player, int lp_minerals, int lp_vespene) {
    bool lv_ok;

    lv_ok = CMLib_CatSetInt(c_gameCatalogUnit, lp_unitType, "CostResource[Minerals]", lp_player, lp_minerals);
    if ((CMLib_CatSetInt(c_gameCatalogUnit, lp_unitType, "CostResource[Vespene]", lp_player, lp_vespene) == false)) {
        lv_ok = false;
    }
    return lv_ok;
}

bool CMLib_UnitDataSetFood(string lp_unitType, int lp_player, fixed lp_food) {
    return CMLib_CatSetFixed(c_gameCatalogUnit, lp_unitType, "Food", lp_player, lp_food);
}

bool CMLib_UnitDataBoostPercent(string lp_unitType, int lp_player, int lp_percent) {
    bool lv_ok;

    if ((CMLib_CatEntryExists(c_gameCatalogUnit, lp_unitType) == false)) {
        CMLib_LogError("CMLib.Catalog", "BoostPercent: unknown unit '" + lp_unitType + "'");
        return false;
    }

    lv_ok = CMLib_CatScalePercent(c_gameCatalogUnit, lp_unitType, "LifeMax", lp_player, lp_percent);
    // 护盾只在原本就有护盾时才缩放，否则会给 0 护盾单位写入无意义的字段覆盖。
    if ((CMLib_UnitDataGetShieldMax(lp_unitType, lp_player) > 0.0)) {
        if ((CMLib_CatScalePercent(c_gameCatalogUnit, lp_unitType, "ShieldsMax", lp_player, lp_percent) == false)) {
            lv_ok = false;
        }
    }
    // 建筑没有移速，跳过以免污染数据。
    if ((CMLib_UnitDataGetSpeed(lp_unitType, lp_player) > 0.0)) {
        if ((CMLib_CatScalePercent(c_gameCatalogUnit, lp_unitType, "Speed", lp_player, lp_percent) == false)) {
            lv_ok = false;
        }
    }
    return lv_ok;
}

// -----------------------------------------------------------------------------
// 武器
// -----------------------------------------------------------------------------

fixed CMLib_WeaponDataGetRange(string lp_weapon, int lp_player) {
    return CMLib_CatGetFixed(c_gameCatalogWeapon, lp_weapon, "Range", lp_player, 0.0);
}

fixed CMLib_WeaponDataGetPeriod(string lp_weapon, int lp_player) {
    return CMLib_CatGetFixed(c_gameCatalogWeapon, lp_weapon, "Period", lp_player, 0.0);
}

bool CMLib_WeaponDataAddRange(string lp_weapon, int lp_player, fixed lp_delta) {
    if ((lp_delta == 0.0)) {
        return true;
    }
    if ((lp_delta > 0.0)) {
        return CMLib_CatModifyFixed(c_gameCatalogWeapon, lp_weapon, "Range", lp_player, lp_delta, CMLIB_CAT_ADD);
    }
    return CMLib_CatModifyFixed(c_gameCatalogWeapon, lp_weapon, "Range", lp_player, -lp_delta, CMLIB_CAT_SUB);
}

bool CMLib_WeaponDataSpeedUpPercent(string lp_weapon, int lp_player, int lp_percent) {
    // Period 是「两次攻击的间隔」，越小越快 —— 所以提速要减 period。
    return CMLib_CatScalePercent(c_gameCatalogWeapon, lp_weapon, "Period", lp_player, -lp_percent);
}

