    if ((lp_unit == null)) {
        return;
    }
    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        CMLib_LogWarn("unit", "UnitSelectFor: 玩家槽位非法");
        return;
    }
    UnitSelect(lp_unit, lp_player, lp_select);
}

void CMLib_UnitSelectOnly(unit lp_unit, int lp_player) {
    if ((lp_unit == null)) {
        return;
    }
    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        CMLib_LogWarn("unit", "UnitSelectOnly: 玩家槽位非法");
        return;
    }
    UnitClearSelection(lp_player);
    UnitSelect(lp_unit, lp_player, true);
}

