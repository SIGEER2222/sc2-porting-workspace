    return UnitGetTag(lp_unit);
}

void CMLib_UnitFace(unit lp_unit, fixed lp_facing, fixed lp_duration) {
    fixed lv_dur;

    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    lv_dur = lp_duration;
    if ((lv_dur < 0.0)) {
        lv_dur = 0.0;
    }
    UnitSetFacing(lp_unit, lp_facing, lv_dur);
}

void CMLib_UnitFaceUnit(unit lp_unit, unit lp_target, fixed lp_duration) {
    if ((CMLib_UnitOk(lp_unit) == false) || (lp_target == null)) {
        return;
