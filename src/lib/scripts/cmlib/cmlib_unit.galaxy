int CMLib_UnitCountOf(string lp_unitType, int lp_player, region lp_region,
                      string lp_filterSpec, int lp_maxCount) {
    region     lv_region;
    unitfilter lv_filter;
    int        lv_max;

    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        return 0;
    }
    lv_region = lp_region;
    if ((lv_region == null)) {
        lv_region = RegionEntireMap();
    }
    if ((lp_filterSpec == "")) {
        lv_filter = CMLib_FilterAlive();
    }
    else {
        lv_filter = UnitFilterStr(lp_filterSpec);
    }
    lv_max = lp_maxCount;
    if ((lv_max < 0)) {
        lv_max = c_noMaxCount;
    }
    return UnitCount(lp_unitType, lp_player, lv_region, lv_filter, lv_max);
}

int CMLib_UnitCountAllianceOf(int lp_player, int lp_alliance, region lp_region,
                              string lp_filterSpec, int lp_maxCount) {
    region     lv_region;
    unitfilter lv_filter;
    int        lv_max;

    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        return 0;
    }
    lv_region = lp_region;
    if ((lv_region == null)) {
        lv_region = RegionEntireMap();
    }
    if ((lp_filterSpec == "")) {
        lv_filter = CMLib_FilterAlive();
    }
    else {
        lv_filter = UnitFilterStr(lp_filterSpec);
    }
    lv_max = lp_maxCount;
    if ((lv_max < 0)) {
        lv_max = c_noMaxCount;
    }
    return UnitCountAlliance(lp_player, lp_alliance, lv_region, lv_filter, lv_max);
}

