// =============================================================================
// CMLib :: Unit (实现)
//
// 关于 unitfilter 的位运算：
//   c_targetFilter* 常量定义在 GameData/Game.galaxy。
//   值 < 32 落在第 1 个 int（inRequired1 / inExcluded1）；
//   值 >= 32 落在第 2 个 int，且必须写成 (1 << (常量 - 32))。
//   原工程里这段位运算被逐字复制上百次，漏掉 -32 会静默失效 —— 在此收口。
// =============================================================================

include "scripts/cmlib/cmlib_core_h"
include "scripts/cmlib/cmlib_unit_h"

// -----------------------------------------------------------------------------
// 单位过滤器
// -----------------------------------------------------------------------------

unitfilter CMLib_FilterAlive() {
    return UnitFilter(
        0,
        0,
        (1 << c_targetFilterMissile),
        (1 << (c_targetFilterDead - 32))
    );
}

unitfilter CMLib_FilterAliveVisible() {
    return UnitFilter(
        0,
        0,
        (1 << c_targetFilterMissile),
        (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
    );
}

unitfilter CMLib_FilterAliveVisibleTargetable() {
    return UnitFilter(
        0,
        0,
        (1 << c_targetFilterMissile),
        (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32)) | (1 << (c_targetFilterInvulnerable - 32))
    );
}

unitfilter CMLib_FilterStructure() {
    return UnitFilter(
        (1 << c_targetFilterStructure),
        0,
        (1 << c_targetFilterMissile),
        (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
    );
}

unitfilter CMLib_FilterNonStructure() {
    return UnitFilter(
        0,
        0,
        (1 << c_targetFilterMissile) | (1 << c_targetFilterStructure),
        (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))
    );
}

// -----------------------------------------------------------------------------
// 单位有效性
// -----------------------------------------------------------------------------

bool CMLib_UnitOk(unit lp_unit) {
    if ((lp_unit == null)) {
        return false;
    }
    if ((UnitIsValid(lp_unit) == false)) {
        return false;
    }
    if ((UnitIsAlive(lp_unit) == false)) {
        return false;
    }
    return true;
}

bool CMLib_UnitIsStructure(unit lp_unit) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    return UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure);
}

bool CMLib_UnitIsType(unit lp_unit, string lp_unitType) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    return StringEqual(UnitGetType(lp_unit), lp_unitType, true);
}

bool CMLib_UnitOwnedBy(unit lp_unit, int lp_player) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    return (UnitGetOwner(lp_unit) == lp_player);
}

// -----------------------------------------------------------------------------
// 单位组：迭代
// -----------------------------------------------------------------------------

void CMLib_UnitVisitor_Proto(unit lp_unit, int lp_arg) {
}

int CMLib_UGSize(unitgroup lp_group) {
    if ((lp_group == null)) {
        return 0;
    }
    return UnitGroupCount(lp_group, c_unitCountAll);
}

int CMLib_UGSizeAlive(unitgroup lp_group) {
    if ((lp_group == null)) {
        return 0;
    }
    return UnitGroupCount(lp_group, c_unitCountAlive);
}

bool CMLib_UGIsEmpty(unitgroup lp_group) {
    return (CMLib_UGSize(lp_group) == 0);
}

unit CMLib_UGAt(unitgroup lp_group, int lp_indexFromEnd) {
    if ((lp_group == null)) {
        return null;
    }
    if ((lp_indexFromEnd < 1)) {
        return null;
    }
    return UnitGroupUnitFromEnd(lp_group, lp_indexFromEnd);
}

// 倒序遍历：先取 count，再从 count 递减到 1。
// 这样遍历过程中调用 UnitRemove / UnitKill 不会导致索引错位漏项。
int CMLib_UGForEach(unitgroup lp_group, CMLib_UnitVisitor lp_visitor, int lp_arg) {
    int lv_index;
    int lv_visited;
    unit lv_unit;

    if ((lp_group == null)) {
        return 0;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    lv_visited = 0;
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((lv_unit == null)) {
            continue;
        }
        lp_visitor(lv_unit, lp_arg);
        lv_visited += 1;
    }
    return lv_visited;
}

int CMLib_UGForEachAlive(unitgroup lp_group, CMLib_UnitVisitor lp_visitor, int lp_arg) {
    int lv_index;
    int lv_visited;
    unit lv_unit;

    if ((lp_group == null)) {
        return 0;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    lv_visited = 0;
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((CMLib_UnitOk(lv_unit) == false)) {
            continue;
        }
        lp_visitor(lv_unit, lp_arg);
        lv_visited += 1;
    }
    return lv_visited;
}

unit CMLib_UGFirstAlive(unitgroup lp_group) {
    int lv_index;
    unit lv_unit;

    if ((lp_group == null)) {
        return null;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((CMLib_UnitOk(lv_unit) == true)) {
            return lv_unit;
        }
    }
    return null;
}

// -----------------------------------------------------------------------------
// 单位组：查询
// -----------------------------------------------------------------------------

unitgroup CMLib_UGOfTypeInMap(string lp_unitType, int lp_player) {
    return UnitGroup(lp_unitType, lp_player, RegionEntireMap(), CMLib_FilterAliveVisible(), 0);
}

unitgroup CMLib_UGOfTypeInRegion(string lp_unitType, int lp_player, region lp_region) {
    if ((lp_region == null)) {
        return UnitGroupEmpty();
    }
    return UnitGroup(lp_unitType, lp_player, lp_region, CMLib_FilterAliveVisible(), 0);
}

unitgroup CMLib_UGOfTypeNearPoint(string lp_unitType, int lp_player, point lp_point, fixed lp_radius) {
    if ((lp_point == null)) {
        return UnitGroupEmpty();
    }
    return UnitGroup(lp_unitType, lp_player, RegionCircle(lp_point, lp_radius), CMLib_FilterAliveVisible(), 0);
}

unitgroup CMLib_UGStructuresOfPlayer(int lp_player) {
    return UnitGroup(null, lp_player, RegionEntireMap(), CMLib_FilterStructure(), 0);
}

unitgroup CMLib_UGArmyOfPlayer(int lp_player) {
    return UnitGroup(null, lp_player, RegionEntireMap(), CMLib_FilterNonStructure(), 0);
}

// -----------------------------------------------------------------------------
// 生成
// -----------------------------------------------------------------------------

unit CMLib_Spawn(string lp_unitType, int lp_player, point lp_pos, fixed lp_facing) {
    if ((lp_pos == null)) {
        CMLib_LogWarn("CMLib.Unit", "Spawn skipped, null point for '" + lp_unitType + "'");
        return null;
    }
    UnitCreate(1, lp_unitType, 0, lp_player, lp_pos, lp_facing);
    return UnitLastCreated();
}

unit CMLib_SpawnForced(string lp_unitType, int lp_player, point lp_pos, fixed lp_facing) {
    if ((lp_pos == null)) {
        CMLib_LogWarn("CMLib.Unit", "SpawnForced skipped, null point for '" + lp_unitType + "'");
        return null;
    }
    UnitCreate(1, lp_unitType, c_unitCreateIgnorePlacement, lp_player, lp_pos, lp_facing);
    return UnitLastCreated();
}

unitgroup CMLib_SpawnMany(int lp_count, string lp_unitType, int lp_player, point lp_pos, fixed lp_facing) {
    if ((lp_count < 1)) {
        return UnitGroupEmpty();
    }
    if ((lp_pos == null)) {
        CMLib_LogWarn("CMLib.Unit", "SpawnMany skipped, null point for '" + lp_unitType + "'");
        return UnitGroupEmpty();
    }
    UnitCreate(lp_count, lp_unitType, c_unitCreateIgnorePlacement, lp_player, lp_pos, lp_facing);
    return UnitLastCreatedGroup();
}

unitgroup CMLib_SpawnRing(int lp_count, string lp_unitType, int lp_player, point lp_center, fixed lp_radius) {
    unitgroup lv_result;
    unit lv_unit;
    fixed lv_angle;
    fixed lv_step;
    point lv_pos;
    int lv_i;

    lv_result = UnitGroupEmpty();
    if ((lp_count < 1)) {
        return lv_result;
    }
    if ((lp_center == null)) {
        CMLib_LogWarn("CMLib.Unit", "SpawnRing skipped, null center for '" + lp_unitType + "'");
        return lv_result;
    }

    lv_step = (360.0 / IntToFixed(lp_count));
    lv_i = 0;
    while ((lv_i < lp_count)) {
        lv_angle = (lv_step * IntToFixed(lv_i));
        lv_pos = PointWithOffsetPolar(lp_center, lp_radius, lv_angle);
        lv_unit = CMLib_SpawnForced(lp_unitType, lp_player, lv_pos, lv_angle);
        if ((lv_unit != null)) {
            UnitGroupAdd(lv_result, lv_unit);
        }
        lv_i += 1;
    }
    return lv_result;
}

unit CMLib_RespawnInPlace(unit lp_unit, string lp_newUnitType, int lp_player) {
    unit lv_new;
    point lv_pos;
    fixed lv_facing;

    if ((CMLib_UnitOk(lp_unit) == false)) {
        return null;
    }

    lv_pos = UnitGetPosition(lp_unit);
    lv_facing = UnitGetFacing(lp_unit);
    lv_new = CMLib_SpawnForced(lp_newUnitType, lp_player, lv_pos, lv_facing);
    if ((lv_new == null)) {
        CMLib_LogError("CMLib.Unit", "RespawnInPlace failed for '" + lp_newUnitType + "'");
        return null;
    }
    CMLib_UnitCopyVitalsPercent(lp_unit, lv_new);
    UnitRemove(lp_unit);
    return lv_new;
}

// -----------------------------------------------------------------------------
// 属性
// -----------------------------------------------------------------------------

fixed CMLib_UnitLifePercent(unit lp_unit) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return 0.0;
    }
    return UnitGetPropertyFixed(lp_unit, c_unitPropLifePercent, true);
}

fixed CMLib_UnitShieldPercent(unit lp_unit) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return 0.0;
    }
    return UnitGetPropertyFixed(lp_unit, c_unitPropShieldsPercent, true);
}

void CMLib_UnitSetLifePercent(unit lp_unit, fixed lp_percent) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    UnitSetPropertyFixed(lp_unit, c_unitPropLifePercent, CMLib_ClampFixed(lp_percent, 0.0, 100.0));
}

void CMLib_UnitCopyVitalsPercent(unit lp_from, unit lp_to) {
    if ((lp_from == null)) {
        return;
    }
    if ((lp_to == null)) {
        return;
    }
    UnitSetPropertyFixed(lp_to, c_unitPropLifePercent, UnitGetPropertyFixed(lp_from, c_unitPropLifePercent, true));
    UnitSetPropertyFixed(lp_to, c_unitPropShieldsPercent, UnitGetPropertyFixed(lp_from, c_unitPropShieldsPercent, true));
    UnitSetPropertyFixed(lp_to, c_unitPropEnergyPercent, UnitGetPropertyFixed(lp_from, c_unitPropEnergyPercent, true));
}

// -----------------------------------------------------------------------------
// 状态 / 位置
// -----------------------------------------------------------------------------

void CMLib_UnitSetState(unit lp_unit, int lp_state, bool lp_val) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    UnitSetState(lp_unit, lp_state, lp_val);
}

void CMLib_UnitSetPosition(unit lp_unit, point lp_pos, bool lp_blend) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    if ((lp_pos == null)) {
        return;
    }
    UnitSetPosition(lp_unit, lp_pos, lp_blend);
}

// -----------------------------------------------------------------------------
// 行为 / 武器
// -----------------------------------------------------------------------------

bool CMLib_UnitEnsureBehavior(unit lp_unit, string lp_behavior, int lp_player, int lp_count) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    if ((UnitHasBehavior2(lp_unit, lp_behavior) == true)) {
        return false;
    }
    UnitBehaviorAddPlayer(lp_unit, lp_behavior, lp_player, lp_count);
    return true;
}

bool CMLib_UnitRemoveBehavior(unit lp_unit, string lp_behavior, int lp_player, int lp_count) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    if ((UnitHasBehavior2(lp_unit, lp_behavior) == false)) {
        return false;
    }
    UnitBehaviorRemovePlayer(lp_unit, lp_behavior, lp_player, lp_count);
    return true;
}

bool CMLib_UnitToggleBehavior(unit lp_unit, string lp_behavior, int lp_player, bool lp_on) {
    if ((lp_on == true)) {
        return CMLib_UnitEnsureBehavior(lp_unit, lp_behavior, lp_player, 1);
    }
    return CMLib_UnitRemoveBehavior(lp_unit, lp_behavior, lp_player, 1);
}

bool CMLib_UnitEnsureWeapon(unit lp_unit, string lp_weapon, string lp_turret) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    UnitWeaponAdd(lp_unit, lp_weapon, lp_turret);
    return true;
}

bool CMLib_UnitRemoveWeapon(unit lp_unit, string lp_weapon) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    UnitWeaponRemove(lp_unit, lp_weapon);
    return true;
}

int CMLib_UGEnsureBehavior(unitgroup lp_group, string lp_behavior, int lp_player, int lp_count) {
    int lv_index;
    int lv_changed;
    unit lv_unit;

    if ((lp_group == null)) {
        return 0;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    lv_changed = 0;
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((CMLib_UnitEnsureBehavior(lv_unit, lp_behavior, lp_player, lp_count) == true)) {
            lv_changed += 1;
        }
    }
    return lv_changed;
}

int CMLib_UGRemoveBehavior(unitgroup lp_group, string lp_behavior, int lp_player, int lp_count) {
    int lv_index;
    int lv_changed;
    unit lv_unit;

    if ((lp_group == null)) {
        return 0;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    lv_changed = 0;
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((CMLib_UnitRemoveBehavior(lv_unit, lp_behavior, lp_player, lp_count) == true)) {
            lv_changed += 1;
        }
    }
    return lv_changed;
}

// 普通行为变体：带 caster 单位，可让 buff 按施法者属性缩放；不依赖玩家归属。
void CMLib_UnitBehaviorAdd(unit lp_unit, string lp_behavior, unit lp_caster, int lp_count) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    if ((lp_behavior == null)) {
        return;
    }
    if ((lp_count < 1)) {
        lp_count = 1;
    }
    if ((lp_caster == null)) {
        lp_caster = lp_unit;
    }
    UnitBehaviorAdd(lp_unit, lp_behavior, lp_caster, lp_count);
}

void CMLib_UnitBehaviorRemove(unit lp_unit, string lp_behavior, int lp_count) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    if ((lp_behavior == null)) {
        return;
    }
    if ((lp_count < 1)) {
        lp_count = 1;
    }
    UnitBehaviorRemove(lp_unit, lp_behavior, lp_count);
}

// -----------------------------------------------------------------------------
// 命令
// -----------------------------------------------------------------------------

bool CMLib_UnitOrderAbility(unit lp_unit, string lp_ability, int lp_cmdIndex, int lp_queueType) {
    order lv_order;

    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    lv_order = Order(AbilityCommand(lp_ability, lp_cmdIndex));
    if ((UnitOrderIsValid(lp_unit, lv_order) == false)) {
        return false;
    }
    return UnitIssueOrder(lp_unit, lv_order, lp_queueType);
}

bool CMLib_UnitOrderAbilityAtPoint(unit lp_unit, string lp_ability, int lp_cmdIndex, point lp_target, int lp_queueType) {
    order lv_order;

    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    if ((lp_target == null)) {
        return false;
    }
    lv_order = OrderTargetingPoint(AbilityCommand(lp_ability, lp_cmdIndex), lp_target);
    if ((UnitOrderIsValid(lp_unit, lv_order) == false)) {
        return false;
    }
    return UnitIssueOrder(lp_unit, lv_order, lp_queueType);
}

int CMLib_UGOrderAbilityAtPoint(unitgroup lp_group, string lp_ability, int lp_cmdIndex, point lp_target, int lp_queueType) {
    int lv_index;
    int lv_issued;
    unit lv_unit;

    if ((lp_group == null)) {
        return 0;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    lv_issued = 0;
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((CMLib_UnitOrderAbilityAtPoint(lv_unit, lp_ability, lp_cmdIndex, lp_target, lp_queueType) == true)) {
            lv_issued += 1;
        }
    }
    return lv_issued;
}

// -----------------------------------------------------------------------------
// 清理
// -----------------------------------------------------------------------------

int CMLib_UGRemoveAll(unitgroup lp_group) {
    int lv_index;
    int lv_removed;
    unit lv_unit;

    if ((lp_group == null)) {
        return 0;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    lv_removed = 0;
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((lv_unit == null)) {
            continue;
        }
        UnitRemove(lv_unit);
        lv_removed += 1;
    }
    return lv_removed;
}

int CMLib_UGKillAll(unitgroup lp_group) {
    int lv_index;
    int lv_killed;
    unit lv_unit;

    if ((lp_group == null)) {
        return 0;
    }

    lv_index = UnitGroupCount(lp_group, c_unitCountAll);
    lv_killed = 0;
    while ((lv_index >= 1)) {
        lv_unit = UnitGroupUnitFromEnd(lp_group, lv_index);
        lv_index -= 1;
        if ((CMLib_UnitOk(lv_unit) == false)) {
            continue;
        }
        UnitKill(lv_unit);
        lv_killed += 1;
    }
    return lv_killed;
}

// 无痕移除单个单位（区别于 CMLib_UGKillAll / CMLib_UGRemove 操作的是组）。
// null / 已消亡单位直接返回，不调用引擎 native 以免误删无效句柄。
void CMLib_UnitRemove(unit lp_unit) {
    if ((lp_unit == null)) {
        return;
    }
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    UnitRemove(lp_unit);
}

// -----------------------------------------------------------------------------
// 单位组：增删 / 取值
// -----------------------------------------------------------------------------

void CMLib_UGAdd(unitgroup lp_group, unit lp_unit) {
    if ((lp_group == null)) {
        return;
    }
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    UnitGroupAdd(lp_group, lp_unit);
}

void CMLib_UGAddGroup(unitgroup lp_group, unitgroup lp_add) {
    if ((lp_group == null)) {
        return;
    }
    if ((lp_add == null)) {
        return;
    }
    UnitGroupAddUnitGroup(lp_group, lp_add);
}

void CMLib_UGRemove(unitgroup lp_group, unit lp_unit) {
    if ((lp_group == null)) {
        return;
    }
    if ((lp_unit == null)) {
        return;
    }
    UnitGroupRemove(lp_group, lp_unit);
}

void CMLib_UGClear(unitgroup lp_group) {
    if ((lp_group == null)) {
        return;
    }
    UnitGroupClear(lp_group);
}

unitgroup CMLib_UGCopy(unitgroup lp_group) {
    if ((lp_group == null)) {
        return UnitGroupEmpty();
    }
    return UnitGroupCopy(lp_group);
}

// 正向 one-based 取值（区别于 CMLib_UGAt 的倒序）。越界 / 组空返回 null。
unit CMLib_UGUnit(unitgroup lp_group, int lp_index) {
    if ((lp_group == null)) {
        return null;
    }
    if ((lp_index < 1)) {
        return null;
    }
    if ((lp_index > CMLib_UGSize(lp_group))) {
        return null;
    }
    return UnitGroupUnit(lp_group, lp_index);
}

unit CMLib_UGRandomUnit(unitgroup lp_group, int lp_type) {
    if ((lp_group == null)) {
        return null;
    }
    return UnitGroupRandomUnit(lp_group, lp_type);
}

bool CMLib_UGHasUnit(unitgroup lp_group, unit lp_unit) {
    if ((lp_group == null)) {
        return false;
    }
    if ((lp_unit == null)) {
        return false;
    }
    return UnitGroupHasUnit(lp_group, lp_unit);
}

// -----------------------------------------------------------------------------
// 过滤器 / 全局暂停 / 归属
// -----------------------------------------------------------------------------

bool CMLib_UnitMatchFilter(unit lp_unit, int lp_player, unitfilter lp_filter) {
    if ((lp_unit == null)) {
        return false;
    }
    return UnitFilterMatch(lp_unit, lp_player, lp_filter);
}

void CMLib_UnitsPauseAll(bool lp_pause) {
    UnitPauseAll(lp_pause);
}

text CMLib_UnitTypeName(string lp_unitType) {
    if ((lp_unitType == "")) {
        return StringExternal("");
    }
    return UnitTypeGetName(lp_unitType);
}

bool CMLib_UnitChangeOwner(unit lp_unit, int lp_player, bool lp_changeColor) {
    if ((CMLib_UnitOk(lp_unit) == false)) {
        return false;
    }
    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        return false;
    }
    UnitSetOwner(lp_unit, lp_player, lp_changeColor);
    return true;
}

// -----------------------------------------------------------------------------
// 编组下令
// -----------------------------------------------------------------------------

bool CMLib_UGIssueOrder(unitgroup lp_group, order lp_order, int lp_queueType) {
    if ((lp_group == null)) {
        return false;
    }
    if ((lp_order == null)) {
        return false;
    }
    if ((UnitGroupCount(lp_group, c_unitCountAll) < 1)) {
        return false;
    }
    return UnitGroupIssueOrder(lp_group, lp_order, lp_queueType);
}

bool CMLib_UGOrderAbility(unitgroup lp_group, string lp_ability, int lp_cmdIndex, int lp_queueType) {
    if ((lp_ability == "")) {
        return false;
    }
    return CMLib_UGIssueOrder(lp_group, Order(AbilityCommand(lp_ability, lp_cmdIndex)), lp_queueType);
}

bool CMLib_UGOrderAbilityAtUnit(unitgroup lp_group, string lp_ability, int lp_cmdIndex, unit lp_target, int lp_queueType) {
    if ((lp_ability == "")) {
        return false;
    }
    if ((lp_target == null)) {
        return false;
    }
    return CMLib_UGIssueOrder(lp_group, OrderTargetingUnit(AbilityCommand(lp_ability, lp_cmdIndex), lp_target), lp_queueType);
}

// -----------------------------------------------------------------------------
// 按同盟关系取编组
// -----------------------------------------------------------------------------

unitgroup CMLib_UGAlliance(int lp_player, int lp_alliance, region lp_region, unitfilter lp_filter, int lp_maxCount) {
    region lv_region;
    int lv_max;

    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        return UnitGroupEmpty();
    }
    lv_region = lp_region;
    if ((lv_region == null)) {
        lv_region = RegionEntireMap();
    }
    lv_max = lp_maxCount;
    if ((lv_max <= 0)) {
        lv_max = c_unitCountAll;
    }
    return UnitGroupAlliance(lp_player, lp_alliance, lv_region, lp_filter, lv_max);
}

unitgroup CMLib_UGEnemiesOf(int lp_player, int lp_maxCount) {
    return CMLib_UGAlliance(lp_player, c_unitAllianceEnemy, null, CMLib_FilterAlive(), lp_maxCount);
}

