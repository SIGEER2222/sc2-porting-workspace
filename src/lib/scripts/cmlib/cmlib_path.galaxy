// =============================================================================
// 航点
// =============================================================================

void CMLib_RouteAddWay(int lp_route, point lp_pos) {
    if ((CMLib_RouteOk(lp_route) == false) || (lp_pos == null)) {
        return;
    }
    PathAddWayPoint(lp_route, lp_pos);
}

void CMLib_RouteClearWays(int lp_route) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return;
    }
    PathClearWayPoints(lp_route);
}

int CMLib_RouteAddWayChain(int lp_route, point lp_from, point lp_to, int lp_steps) {
    int   lv_n;
    int   lv_i;
    fixed lv_t;
    fixed lv_x;
    fixed lv_y;
    fixed lv_x0;
    fixed lv_y0;
    fixed lv_dx;
    fixed lv_dy;

    if ((CMLib_RouteOk(lp_route) == false)) {
        return 0;
    }
    if ((lp_from == null) || (lp_to == null)) {
        return 0;
    }
    lv_n = CMLib_ClampInt(lp_steps, 0, CMLIB_ROUTE_MAX_CHAIN);
    if ((lv_n <= 0)) {
        return 0;
    }
    lv_x0 = PointGetX(lp_from);
    lv_y0 = PointGetY(lp_from);
    lv_dx = PointGetX(lp_to) - lv_x0;
    lv_dy = PointGetY(lp_to) - lv_y0;
    lv_i = 1;
    while ((lv_i <= lv_n)) {
        // 手写插值而不用 PointInterpolate：后者的 fraction 语义（0~1 还是 0~100）
        // 在不同版本文档里说法不一，直接算最保险。
        lv_t = IntToFixed(lv_i) / IntToFixed(lv_n + 1);
        lv_x = lv_x0 + (lv_dx * lv_t);
        lv_y = lv_y0 + (lv_dy * lv_t);
        PathAddWayPoint(lp_route, Point(lv_x, lv_y));
        lv_i = lv_i + 1;
    }
    return lv_n;
}

// =============================================================================
// 外观
// =============================================================================

void CMLib_RouteShow(int lp_route, bool lp_show) {
    CMLib_RouteShowAt(lp_route, CMLIB_ROUTE_ALL, lp_show);
}

void CMLib_RouteShowAt(int lp_route, int lp_loc, bool lp_show) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return;
    }
    PathSetVisible(lp_route, lp_loc, lp_show);
}

bool CMLib_RouteVisibleAt(int lp_route, int lp_loc) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return false;
    }
    return PathGetVisible(lp_route, lp_loc);
}

void CMLib_RouteColor(int lp_route, color lp_color) {
    CMLib_RouteColorAt(lp_route, CMLIB_ROUTE_ALL, lp_color);
}

void CMLib_RouteColorAt(int lp_route, int lp_loc, color lp_color) {
    // 不要写 `lp_color == null`：color 在 Galaxy 里是值类型，与 null 比较是
    // **编译期错误**，而 SC2 对编译失败的反应是静默丢弃整个 MapScript
    // （不报错、InitMap 根本不被调用）。同一坑 cmlib_text.galaxy:57 早有记载，
    // 本模块 round16 又踩一遍，直到 round18 真机矩阵才捞出来。
    if ((CMLib_RouteOk(lp_route) == false)) {
        return;
    }
    PathSetColor(lp_route, lp_loc, lp_color);
}

color CMLib_RouteColorGet(int lp_route, int lp_loc) {
    // 同上：color 不能是 null，失败态只能给一个约定的哨兵色。
    // 取全透明黑（alpha=0）——正常路线色不会全透明，调用方可据此判失败。
    if ((CMLib_RouteOk(lp_route) == false)) {
        return ColorWithAlpha(0.0, 0.0, 0.0, 0.0);
    }
    return PathGetColor(lp_route, lp_loc);
}

void CMLib_RouteLineWidth(int lp_route, fixed lp_width) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return;
