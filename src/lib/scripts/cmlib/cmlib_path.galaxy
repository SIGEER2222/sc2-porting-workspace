// =============================================================================
// CMLib :: Path —— 实现
// 声明见 cmlib_path_h.galaxy
// =============================================================================

// =============================================================================
// 创建 / 销毁
// =============================================================================

int CMLib_RouteForUnit(playergroup lp_players, unit lp_unit) {
    if ((lp_players == null) || (CMLib_UnitOk(lp_unit) == false)) {
        CMLib_LogWarn("path", "RouteForUnit: 玩家组或单位无效");
        return CMLIB_ROUTE_NONE;
    }
    return PathCreateForUnit(lp_players, lp_unit);
}

int CMLib_RouteForUnitType(playergroup lp_players, string lp_type,
                           int lp_player, point lp_source) {
    if ((lp_players == null) || (lp_type == "") || (lp_source == null)) {
        CMLib_LogWarn("path", "RouteForUnitType: 参数无效");
        return CMLIB_ROUTE_NONE;
    }
    if ((CMLib_IsValidPlayerSlot(lp_player) == false)) {
        return CMLIB_ROUTE_NONE;
    }
    return PathCreateForUnitType(lp_players, lp_type, lp_player, lp_source);
}

int CMLib_RouteLast() {
    return PathLastCreated();
}

bool CMLib_RouteOk(int lp_route) {
    return (lp_route != CMLIB_ROUTE_NONE);
}

void CMLib_RouteDestroy(int lp_route) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return;
    }
    PathDestroy(lp_route);
}

void CMLib_RouteDestroyAll(playergroup lp_players) {
    if ((lp_players == null)) {
        return;
    }
    PathDestroyAll(lp_players);
}

