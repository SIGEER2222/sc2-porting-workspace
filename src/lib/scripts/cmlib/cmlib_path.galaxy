// =============================================================================
// 组合封装
// =============================================================================

int CMLib_RouteQuick(playergroup lp_players, unit lp_unit, point lp_to,
                     color lp_color, fixed lp_width) {
    int lv_route;

    lv_route = CMLib_RouteForUnit(lp_players, lp_unit);
    if ((CMLib_RouteOk(lv_route) == false)) {
        return CMLIB_ROUTE_NONE;
    }
    CMLib_RouteSetToPoint(lv_route, lp_to);
    CMLib_RouteColor(lv_route, lp_color);
    if ((lp_width > 0.0)) {
        CMLib_RouteLineWidth(lv_route, lp_width);
    }
    CMLib_RouteShow(lv_route, true);
    return lv_route;
}

int CMLib_RouteQuickToUnit(playergroup lp_players, unit lp_unit, unit lp_target,
                           color lp_color, fixed lp_width) {
    int lv_route;

    lv_route = CMLib_RouteForUnit(lp_players, lp_unit);
    if ((CMLib_RouteOk(lv_route) == false)) {
        return CMLIB_ROUTE_NONE;
    }
    CMLib_RouteSetToUnit(lv_route, lp_target);
    CMLib_RouteColor(lv_route, lp_color);
    if ((lp_width > 0.0)) {
        CMLib_RouteLineWidth(lv_route, lp_width);
    }
    CMLib_RouteShow(lv_route, true);
    return lv_route;
}

// =============================================================================
// 禁飞区
// =============================================================================

void CMLib_RouteNoFlyAdd(point lp_center, fixed lp_inner, fixed lp_outer) {
    fixed lv_inner;
    fixed lv_outer;

    if ((lp_center == null)) {
        return;
    }
    lv_inner = lp_inner;
    lv_outer = lp_outer;
    if ((lv_inner < 0.0)) {
        lv_inner = 0.0;
    }
    if ((lv_outer < lv_inner)) {
        // 内外半径写反是这条 native 最常见的低级错误，直接换过来而不是报错。
        lv_outer = lv_inner;
    }
    PathAddNoFlyZone(lp_center, lv_inner, lv_outer);
}

void CMLib_RouteNoFlyClear(region lp_area) {
    if ((lp_area == null)) {
        return;
    }
    PathRemoveNoFlyZonesInRegion(lp_area);
}

// =============================================================================
// 地形寻路类型查询
// =============================================================================

int CMLib_PathingAt(point lp_pos) {
    if ((lp_pos == null)) {
        return c_pathingUnpathable;
    }
    return PathingType(lp_pos);
}

bool CMLib_PathingIsGround(point lp_pos) {
    return (CMLib_PathingAt(lp_pos) == c_pathingGround);
}

bool CMLib_PathingIsBuilding(point lp_pos) {
    return (CMLib_PathingAt(lp_pos) == c_pathingBuilding);
}

bool CMLib_PathingIsCliff(point lp_pos) {
    return (CMLib_PathingAt(lp_pos) == c_pathingCliff);
}

bool CMLib_PathingIsBlocked(point lp_pos) {
    int lv_type;

    lv_type = CMLib_PathingAt(lp_pos);
    return ((lv_type == c_pathingUnpathable) || (lv_type == c_pathingCliff));
}

string CMLib_PathingName(int lp_type) {
    if ((lp_type == c_pathingGround)) {
        return "Ground";
    }
    if ((lp_type == c_pathingBuilding)) {
        return "Building";
    }
    if ((lp_type == c_pathingCliff)) {
        return "Cliff";
    }
    return "Unpathable";
}
