unit CMLib_RouteToUnit(int lp_route) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return null;
    }
    return PathGetDestinationUnit(lp_route);
}

unit CMLib_RouteUnit(int lp_route) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return null;
