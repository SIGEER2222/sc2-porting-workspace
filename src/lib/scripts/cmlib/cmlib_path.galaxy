// 起点 / 终点
// =============================================================================

void CMLib_RouteSetFromPoint(int lp_route, point lp_pos) {
    if ((CMLib_RouteOk(lp_route) == false) || (lp_pos == null)) {
        return;
    }
    PathSetSourcePoint(lp_route, lp_pos);
}

void CMLib_RouteSetFromUnit(int lp_route, unit lp_unit) {
    if ((CMLib_RouteOk(lp_route) == false) || (CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    PathSetSourceUnit(lp_route, lp_unit);
}

void CMLib_RouteSetToPoint(int lp_route, point lp_pos) {
    if ((CMLib_RouteOk(lp_route) == false) || (lp_pos == null)) {
        return;
    }
    PathSetDestinationPoint(lp_route, lp_pos);
}

void CMLib_RouteSetToUnit(int lp_route, unit lp_unit) {
    if ((CMLib_RouteOk(lp_route) == false) || (CMLib_UnitOk(lp_unit) == false)) {
        return;
    }
    PathSetDestinationUnit(lp_route, lp_unit);
}

point CMLib_RouteFromPoint(int lp_route) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return null;
    }
    return PathGetSourcePoint(lp_route);
}

point CMLib_RouteToPoint(int lp_route) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return null;
    }
    return PathGetDestinationPoint(lp_route);
}

unit CMLib_RouteFromUnit(int lp_route) {
    if ((CMLib_RouteOk(lp_route) == false)) {
        return null;
    }
    return PathGetSourceUnit(lp_route);
