void CMLib_SfxPlayAtFor(string lp_soundId, int lp_owner, playergroup lp_players,
                        point lp_at, fixed lp_volume) {
    if ((lp_soundId == "") || (lp_at == null)) {
        return;
    }
    SoundPlayAtPointForPlayer(CMLib_SfxLink(lp_soundId, -1), lp_owner, lp_players,
                              lp_at, 0.0, CMLib_FxVol(lp_volume), CMLIB_FX_NO_OFFSET);
}


// -----------------------------------------------------------------------------
// round 18：带归属玩家的全局音效
// -----------------------------------------------------------------------------

void CMLib_SfxPlayOwned(string lp_soundId, int lp_owner,
                        playergroup lp_players, fixed lp_volume) {
    playergroup lv_pg;

    if ((lp_soundId == "")) {
        return;
    }
    lv_pg = lp_players;
    if ((lv_pg == null)) {
        lv_pg = PlayerGroupAll();
    }
    SoundPlayForPlayer(CMLib_SfxLink(lp_soundId, -1), lp_owner, lv_pg,
                       CMLib_FxVol(lp_volume), CMLIB_FX_NO_OFFSET);
}

