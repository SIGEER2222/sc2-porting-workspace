text CMLib_DiffName(int lp_difficulty) {
    return DifficultyName(lp_difficulty);
}

text CMLib_DiffNameCampaign(int lp_difficulty) {
    return DifficultyNameCampaign(lp_difficulty);
}

bool CMLib_DiffEnabled(int lp_difficulty) {
    return DifficultyEnabled(lp_difficulty);
}

int CMLib_DiffAPM(int lp_difficulty) {
    return DifficultyAPM(lp_difficulty);
}

int CMLib_DiffOfPlayer(int lp_player) {
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return 0; }
    return PlayerDifficulty(lp_player);
}

void CMLib_DiffSetPlayer(int lp_player, int lp_difficulty) {
    if (CMLib_IsValidPlayerSlot(lp_player) == false) {
        CMLib_LogWarn("STAT", "DiffSetPlayer: 非法玩家槽位 " + IntToString(lp_player));
        return;
    }
    PlayerSetDifficulty(lp_player, lp_difficulty);
}

text CMLib_DiffNameOfPlayer(int lp_player, bool lp_campaignStyle) {
