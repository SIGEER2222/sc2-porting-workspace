// =============================================================================
// CMLib :: Stat —— 实现
// =============================================================================

include "scripts/cmlib/cmlib_stat_h"

// 内部：两位补零，给时间戳拼接用。
static string CMLib_Stat2(int lp_n) {
    if ((lp_n >= 0) && (lp_n < 10)) {
        return "0" + IntToString(lp_n);
    }
    return IntToString(lp_n);
}

// =============================================================================
// 成就
// =============================================================================
void CMLib_AchAward(int lp_player, string lp_name) {
    if (lp_name == "") { return; }
    if (CMLib_IsValidPlayerSlot(lp_player) == false) {
        CMLib_LogWarn("STAT", "AchAward: 非法玩家槽位 " + IntToString(lp_player));
        return;
    }
    AchievementAward(lp_player, lp_name);
}

void CMLib_AchErase(int lp_player, string lp_name) {
    if (lp_name == "") { return; }
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return; }
    AchievementErase(lp_player, lp_name);
}

int CMLib_AchAwardGroup(playergroup lp_players, string lp_name) {
    int lv_i;
    int lv_n;
    int lv_p;
    int lv_done;

    lv_done = 0;
    if ((lp_players == null) || (lp_name == "")) { return 0; }
    lv_n = PlayerGroupCount(lp_players);
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_p = PlayerGroupPlayer(lp_players, lv_i);
        if (CMLib_IsValidPlayerSlot(lv_p) == true) {
            AchievementAward(lv_p, lp_name);
            lv_done = lv_done + 1;
        }
        lv_i = lv_i + 1;
    }
    return lv_done;
}

void CMLib_AchTermSet(int lp_player, string lp_term, int lp_quantity) {
    if (lp_term == "") { return; }
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return; }
    AchievementTermQuantitySet(lp_player, lp_term, lp_quantity);
}

void CMLib_AchTermAdd(int lp_player, string lp_term, int lp_quantity) {
    if (lp_term == "") { return; }
    if (lp_quantity == 0) { return; }
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return; }
    AchievementTermQuantityAdd(lp_player, lp_term, lp_quantity);
}

void CMLib_AchTermTick(int lp_player, string lp_term) {
    CMLib_AchTermAdd(lp_player, lp_term, 1);
}

void CMLib_AchDisable(int lp_player) {
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return; }
    AchievementsDisable(lp_player);
}

bool CMLib_AchDisabled(int lp_player) {
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return true; }
    return AchievementsDisabled(lp_player);
}

void CMLib_AchDisableGroup(playergroup lp_players) {
    int lv_i;
    int lv_n;

    if (lp_players == null) { return; }
    lv_n = PlayerGroupCount(lp_players);
    lv_i = 1;
    while (lv_i <= lv_n) {
        CMLib_AchDisable(PlayerGroupPlayer(lp_players, lv_i));
        lv_i = lv_i + 1;
    }
}

void CMLib_AchPanelCategory(playergroup lp_players, string lp_category) {
    if ((lp_players == null) || (lp_category == "")) { return; }
    AchievementPanelSetCategory(lp_players, lp_category);
}

void CMLib_AchPanelShow(playergroup lp_players, bool lp_visible) {
    if (lp_players == null) { return; }
    AchievementPanelSetVisible(lp_players, lp_visible);
}

text CMLib_AchPercentText(int lp_player, string lp_category) {
    if ((CMLib_IsValidPlayerSlot(lp_player) == false) || (lp_category == "")) {
        return StringToText("");
    }
    return AchievementPercentText(lp_player, lp_category);
}

// =============================================================================
// 计分
// =============================================================================
void CMLib_ScoreSetInt(int lp_player, string lp_value, int lp_amount) {
    if (lp_value == "") { return; }
    if (CMLib_IsValidPlayerSlot(lp_player) == false) {
        CMLib_LogWarn("STAT", "ScoreSetInt: 非法玩家槽位 " + IntToString(lp_player));
        return;
    }
    PlayerScoreValueSetFromInt(lp_player, lp_value, lp_amount);
}

void CMLib_ScoreSetFixed(int lp_player, string lp_value, fixed lp_amount) {
    if (lp_value == "") { return; }
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return; }
    PlayerScoreValueSetFromFixed(lp_player, lp_value, lp_amount);
}

int CMLib_ScoreGetInt(int lp_player, string lp_value) {
    if ((CMLib_IsValidPlayerSlot(lp_player) == false) || (lp_value == "")) { return 0; }
    return PlayerScoreValueGetAsInt(lp_player, lp_value);
}

fixed CMLib_ScoreGetFixed(int lp_player, string lp_value) {
    if ((CMLib_IsValidPlayerSlot(lp_player) == false) || (lp_value == "")) { return 0.0; }
    return PlayerScoreValueGetAsFixed(lp_player, lp_value);
}

void CMLib_ScoreAddInt(int lp_player, string lp_value, int lp_delta) {
    if (lp_delta == 0) { return; }
    CMLib_ScoreSetInt(lp_player, lp_value, CMLib_ScoreGetInt(lp_player, lp_value) + lp_delta);
}

void CMLib_ScoreAddFixed(int lp_player, string lp_value, fixed lp_delta) {
    if (lp_delta == 0.0) { return; }
    CMLib_ScoreSetFixed(lp_player, lp_value, CMLib_ScoreGetFixed(lp_player, lp_value) + lp_delta);
}

void CMLib_ScoreEnable(int lp_player, string lp_value, bool lp_enable) {
    if ((CMLib_IsValidPlayerSlot(lp_player) == false) || (lp_value == "")) { return; }
    PlayerScoreValueEnable(lp_player, lp_value, lp_enable);
}

void CMLib_ScoreEnableAll(int lp_player, bool lp_enable) {
    if (CMLib_IsValidPlayerSlot(lp_player) == false) { return; }
    PlayerScoreValueEnableAll(lp_player, lp_enable);
}

int CMLib_ScoreSetIntGroup(playergroup lp_players, string lp_value, int lp_amount) {
    int lv_i;
    int lv_n;
    int lv_p;
    int lv_done;

    lv_done = 0;
    if ((lp_players == null) || (lp_value == "")) { return 0; }
    lv_n = PlayerGroupCount(lp_players);
    lv_i = 1;
    while (lv_i <= lv_n) {
        lv_p = PlayerGroupPlayer(lp_players, lv_i);
        if (CMLib_IsValidPlayerSlot(lv_p) == true) {
            PlayerScoreValueSetFromInt(lv_p, lp_value, lp_amount);
            lv_done = lv_done + 1;
        }
        lv_i = lv_i + 1;
    }
    return lv_done;
}

