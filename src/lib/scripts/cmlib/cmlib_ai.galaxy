// =============================================================================
// CMLib :: AI —— 实现
// =============================================================================

include "scripts/cmlib/cmlib_ai_h"

// -----------------------------------------------------------------------------
// 波次生命周期
// -----------------------------------------------------------------------------
void CMLib_AIWaveBegin(int lp_player, point lp_gather) {
    if (CMLib_AIWaveState == CMLIB_AIWAVE_BUILDING) {
        CMLib_LogWarn("AI", "AIWaveBegin: 上一波次未 Send 就被覆盖，已强制重置。");
    }
    CMLib_AIWaveOwner = lp_player;
    CMLib_AIWaveState = CMLIB_AIWAVE_BUILDING;
    CMLib_AIWaveEntries = 0;
    if (lp_gather != null) {
        AIAttackWaveSetGatherPoint(lp_player, lp_gather);
    }
}

bool CMLib_AIWaveIsBuilding() {
    return CMLib_AIWaveState == CMLIB_AIWAVE_BUILDING;
}

int CMLib_AIWaveEntryCount() {
    return CMLib_AIWaveEntries;
}

// 内部：加配额前的统一校验。
static bool CMLib_AIWaveGuard(string lp_who, string lp_unitType) {
    if (CMLib_AIWaveState != CMLIB_AIWAVE_BUILDING) {
        CMLib_LogWarn("AI", lp_who + ": 未先调用 CMLib_AIWaveBegin，忽略 " + lp_unitType);
        return false;
    }
    if (lp_unitType == "") {
        CMLib_LogWarn("AI", lp_who + ": 单位类型为空，已忽略。");
        return false;
    }
    return true;
}

// -----------------------------------------------------------------------------
// 波次单位配额
// -----------------------------------------------------------------------------
void CMLib_AIWaveAdd(int lp_qty, string lp_unitType) {
    if (CMLib_AIWaveGuard("AIWaveAdd", lp_unitType) == false) { return; }
    if (lp_qty <= 0) { return; }
    AIAttackWaveAddUnits4(lp_qty, lp_qty, lp_qty, lp_qty, lp_unitType);
    CMLib_AIWaveEntries += 1;
}

void CMLib_AIWaveAdd4(int lp_casual, int lp_normal, int lp_hard, int lp_brutal, string lp_unitType) {
    if (CMLib_AIWaveGuard("AIWaveAdd4", lp_unitType) == false) { return; }
    if ((lp_casual <= 0) && (lp_normal <= 0) && (lp_hard <= 0) && (lp_brutal <= 0)) { return; }
    AIAttackWaveAddUnits4(CMLib_MaxInt(lp_casual, 0), CMLib_MaxInt(lp_normal, 0),
                          CMLib_MaxInt(lp_hard, 0), CMLib_MaxInt(lp_brutal, 0), lp_unitType);
    CMLib_AIWaveEntries += 1;
}

void CMLib_AIWaveAddRamp(int lp_base, int lp_step, string lp_unitType) {
    CMLib_AIWaveAdd4(lp_base,
                     lp_base + lp_step,
                     lp_base + lp_step * 2,
                     lp_base + lp_step * 3,
                     lp_unitType);
}

void CMLib_AIWaveAddScaled(int lp_base, int lp_pctCasual, int lp_pctNormal, int lp_pctHard, int lp_pctBrutal, string lp_unitType) {
    CMLib_AIWaveAdd4(CMLib_ScalePercentInt(lp_base, lp_pctCasual),
                     CMLib_ScalePercentInt(lp_base, lp_pctNormal),
                     CMLib_ScalePercentInt(lp_base, lp_pctHard),
                     CMLib_ScalePercentInt(lp_base, lp_pctBrutal),
                     lp_unitType);
}

void CMLib_AIWaveAddAtDifficulty(int lp_difficulty, int lp_qty, string lp_unitType) {
    // Galaxy 没有三元运算符，四档配额逐个显式赋值。
    int lv_d = CMLib_ClampInt(lp_difficulty, CMLIB_DIFF_CASUAL, CMLIB_DIFF_BRUTAL);
    int lv_c = 0;
    int lv_n = 0;
    int lv_h = 0;
    int lv_b = 0;

    if (lv_d == CMLIB_DIFF_CASUAL)      { lv_c = lp_qty; }
    else if (lv_d == CMLIB_DIFF_NORMAL) { lv_n = lp_qty; }
    else if (lv_d == CMLIB_DIFF_HARD)   { lv_h = lp_qty; }
    else                                { lv_b = lp_qty; }
    CMLib_AIWaveAdd4(lv_c, lv_n, lv_h, lv_b, lp_unitType);
}

// -----------------------------------------------------------------------------
// 波次成员来源
// -----------------------------------------------------------------------------
void CMLib_AIWaveUseGroup(int lp_player, unitgroup lp_group) {
    if (lp_group == null) { return; }
    AIAttackWaveUseGroup(lp_player, lp_group);
    CMLib_AIWaveEntries += 1;
}

void CMLib_AIWaveUseUnit(int lp_player, unit lp_unit) {
    if (lp_unit == null) { return; }
    AIAttackWaveUseUnit(lp_player, lp_unit);
    CMLib_AIWaveEntries += 1;
}

// -----------------------------------------------------------------------------
// 波次目标
// -----------------------------------------------------------------------------
void CMLib_AIWaveTargetPlayers(int lp_player, playergroup lp_targets) {
    if (lp_targets == null) {
        CMLib_LogWarn("AI", "AIWaveTargetPlayers: 目标玩家组为空。");
        return;
    }
    AIAttackWaveSetTargetPlayer(lp_player, lp_targets);
}

void CMLib_AIWaveTargetPlayer(int lp_player, int lp_targetPlayer) {
    AIAttackWaveSetTargetPlayer(lp_player, PlayerGroupSingle(lp_targetPlayer));
}

void CMLib_AIWaveTargetPoint(int lp_player, point lp_target) {
    if (lp_target == null) { return; }
    AIAttackWaveSetTargetPoint(lp_player, lp_target);
}

void CMLib_AIWaveTargetUnit(int lp_player, unit lp_target) {
    if (lp_target == null) { return; }
    AIAttackWaveSetTargetUnit(lp_player, lp_target);
}

void CMLib_AIWaveTargetMelee(int lp_player) {
    AIAttackWaveSetTargetMelee(lp_player);
}

// -----------------------------------------------------------------------------
// 波次路线
// -----------------------------------------------------------------------------
void CMLib_AIWaveWaypoint(int lp_player, point lp_waypoint, bool lp_useTransport) {
    if (lp_waypoint == null) { return; }
    AIAttackWaveAddWaypoint(lp_player, lp_waypoint, lp_useTransport);
}

void CMLib_AIWaveClearWaypoints(int lp_player) {
    AIAttackWaveClearWaypoints(lp_player);
}

// -----------------------------------------------------------------------------
// 发送
// -----------------------------------------------------------------------------
int CMLib_AIWaveSend(int lp_player, int lp_delaySeconds, bool lp_wait) {
    int lv_result;

    if (CMLib_AIWaveState != CMLIB_AIWAVE_BUILDING) {
        CMLib_LogWarn("AI", "AIWaveSend: 没有正在构建的波次，已忽略。");
        return 0;
    }
    if (CMLib_AIWaveEntries == 0) {
        CMLib_LogWarn("AI", "AIWaveSend: 波次里一个单位都没有，仍按空波次发送。");
    }
    lv_result = AIAttackWaveSend(lp_player, CMLib_MaxInt(lp_delaySeconds, 0), lp_wait);
    CMLib_AIWaveState = CMLIB_AIWAVE_IDLE;
    CMLib_AIWaveOwner = -1;
    CMLib_AIWaveEntries = 0;
    return lv_result;
}

int CMLib_AIWaveSendJittered(int lp_player, int lp_delaySeconds, int lp_jitterSeconds, bool lp_wait) {
    int lv_jitter = CMLib_MaxInt(lp_jitterSeconds, 0);
    int lv_delay = lp_delaySeconds;

    if (lv_jitter > 0) {
        lv_delay = lv_delay + RandomInt(-lv_jitter, lv_jitter);
    }
    return CMLib_AIWaveSend(lp_player, CMLib_MaxInt(lv_delay, 0), lp_wait);
}

void CMLib_AIWaveCancelLast() {
    wave lv_w = WaveLastCreated();

    if (lv_w == null) {
        CMLib_LogWarn("AI", "AIWaveCancelLast: 没有可取消的波次。");
        return;
    }
    AIAttackWaveCancel(lv_w);
}

// -----------------------------------------------------------------------------
// 一步式常用组合
// -----------------------------------------------------------------------------
int CMLib_AIWaveSimple(int lp_player, point lp_gather, string lp_unitType, int lp_qty,
                       int lp_targetPlayer, int lp_delaySeconds) {
    CMLib_AIWaveBegin(lp_player, lp_gather);
    CMLib_AIWaveAdd(lp_qty, lp_unitType);
    CMLib_AIWaveTargetPlayer(lp_player, lp_targetPlayer);
    return CMLib_AIWaveSend(lp_player, lp_delaySeconds, false);
}

// -----------------------------------------------------------------------------
// 难度
// -----------------------------------------------------------------------------
void CMLib_AISetDifficulty(int lp_player, int lp_difficulty, bool lp_state) {
    AISetDifficulty(lp_player, lp_difficulty, lp_state);
}

int CMLib_AIPickByDifficulty(int lp_difficulty, int lp_v0, int lp_v1, int lp_v2, int lp_v3) {
    int lv_d = CMLib_ClampInt(lp_difficulty, CMLIB_DIFF_CASUAL, CMLIB_DIFF_BRUTAL);

    if (lv_d == CMLIB_DIFF_CASUAL) { return lp_v0; }
    if (lv_d == CMLIB_DIFF_NORMAL) { return lp_v1; }
    if (lv_d == CMLIB_DIFF_HARD)   { return lp_v2; }
    return lp_v3;
}

int CMLib_AIScaleByDifficulty(int lp_base, int lp_difficulty, int lp_stepPercent) {
    int lv_d = CMLib_ClampInt(lp_difficulty, CMLIB_DIFF_CASUAL, CMLIB_DIFF_BRUTAL);

    return CMLib_ScalePercentInt(lp_base, 100 + lp_stepPercent * lv_d);
}

// -----------------------------------------------------------------------------
// 战术施法
// -----------------------------------------------------------------------------
int CMLib_AICastSelf(unit lp_caster, string lp_ability, int lp_cmdIndex) {
    if (lp_caster == null) { return 0; }
    return AICast(lp_caster, Order(AbilityCommand(lp_ability, lp_cmdIndex)), c_noMarker, false);
}

int CMLib_AICastAtPoint(unit lp_caster, string lp_ability, int lp_cmdIndex, point lp_target) {
    if ((lp_caster == null) || (lp_target == null)) { return 0; }
    return AICast(lp_caster, OrderTargetingPoint(AbilityCommand(lp_ability, lp_cmdIndex), lp_target), c_noMarker, false);
}

int CMLib_AICastAtUnit(unit lp_caster, string lp_ability, int lp_cmdIndex, unit lp_target) {
    if ((lp_caster == null) || (lp_target == null)) { return 0; }
    return AICast(lp_caster, OrderTargetingUnit(AbilityCommand(lp_ability, lp_cmdIndex), lp_target), c_noMarker, false);
}

bool CMLib_AICastIfReady(unit lp_caster, string lp_ability, int lp_cmdIndex, string lp_cooldownLink) {
    if (lp_caster == null) { return false; }
    if (UnitAbilityGetCooldown(lp_caster, lp_ability, lp_cooldownLink) > 0.0) { return false; }
    CMLib_AICastSelf(lp_caster, lp_ability, lp_cmdIndex);
    return true;
}

// -----------------------------------------------------------------------------
// 杂项
// -----------------------------------------------------------------------------
void CMLib_AIBulliesInRegion(int lp_player, region lp_region, bool lp_active) {
    if (lp_region == null) { return; }
    AIToggleBulliesInRegion(lp_player, lp_region, lp_active);
}

void CMLib_AIScriptControl(unit lp_unit, bool lp_scripted) {
    if (lp_unit == null) { return; }
    AISetUnitScriptControlled(lp_unit, lp_scripted);
}

void CMLib_AIScriptControlGroup(unitgroup lp_group, bool lp_scripted) {
    int lv_i;
    int lv_n;
    unit lv_u;

    if (lp_group == null) { return; }
    lv_n = UnitGroupCount(lp_group, c_unitCountAll);
    lv_i = lv_n;
    while (lv_i >= 1) {
        lv_u = UnitGroupUnitFromEnd(lp_group, lv_i);
        if (lv_u != null) {
            AISetUnitScriptControlled(lv_u, lp_scripted);
        }
        lv_i -= 1;
    }
}

// ---- 波次/计时/旗标/计数封装（合作任务 AI 高频原生）--------------------------
void CMLib_AIAttackWaveAddUnits(int lp_difficulty, int lp_count, string lp_unitType) {
    if (lp_unitType == null) { return; }
    if (lp_count < 1) { lp_count = 1; }
    AIAttackWaveAddUnits(lp_difficulty, lp_count, lp_unitType);
}

void CMLib_AISetFlag(int lp_player, int lp_index, bool lp_state) {
    if ((lp_index < 1) || (lp_index > 128)) { return; }
    AISetFlag(lp_player, lp_index, lp_state);
}

fixed CMLib_AIGetTime() {
    return AIGetTime();
}

void CMLib_AICounterUnitSetup(int lp_player, string lp_seeWhat, fixed lp_factorSameTech,
                              string lp_makeSameTech, fixed lp_factorAnyTech, string lp_makeAnyTech) {
    if (lp_seeWhat == null) { return; }
    if (lp_makeSameTech == null) { return; }
    if (lp_makeAnyTech == null) { return; }
    AICounterUnitSetup(lp_player, lp_seeWhat, lp_factorSameTech, lp_makeSameTech, lp_factorAnyTech, lp_makeAnyTech);
}


