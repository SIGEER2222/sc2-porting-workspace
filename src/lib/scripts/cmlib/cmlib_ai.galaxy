    AISetGroupScriptControlled(lp_group, lp_enable);
}

void CMLib_AISubStateChance(int lp_subState, int lp_chance) {
    int lv_c;

    lv_c = lp_chance;
    if ((lv_c < 0)) {
        lv_c = 0;
    }
    if ((lv_c > 100)) {
        lv_c = 100;
    }
    AISetSubStateChance(lp_subState, lv_c);
}

