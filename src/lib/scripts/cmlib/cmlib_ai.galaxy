// =============================================================================
// CMLib :: Round24 —— AI 战术过滤（aifilter 句柄族）实现
// =============================================================================
// 全族裸调（不 include TriggerLibs/Tactical/TacticalAI），理由见 _h 头注释。
// 统一约定：filter == null 一律安全短路，Apply 返回空组而不是 null。

// ---- 句柄层 ----------------------------------------------------------------
aifilter CMLib_AIFilterNew(int lp_player) {
    if (CMLib_IsValidPlayerSlot(lp_player) == false) {
        CMLib_LogWarn("AI", "AIFilterNew: 非法玩家槽，返回 null 过滤器。");
        return null;
    }
    return AIFilter(lp_player);
}

void CMLib_AIFilterAlliance(aifilter lp_filter, int lp_playerGroup) {
    if (lp_filter == null) { return; }
    AISetFilterAlliance(lp_filter, lp_playerGroup);
}

void CMLib_AIFilterTypes(aifilter lp_filter, string lp_filterStr) {
    if (lp_filter == null) { return; }
    if (lp_filterStr == null) { return; }
    AISetFilterBits(lp_filter, UnitFilterStr(lp_filterStr));
}

void CMLib_AIFilterPlane(aifilter lp_filter, int lp_plane) {
    int lv_p;

    if (lp_filter == null) { return; }
    lv_p = lp_plane;
    if (lv_p != CMLIB_AIPLANE_AIR) { lv_p = CMLIB_AIPLANE_GROUND; }
    AISetFilterPlane(lp_filter, lv_p);
}

// 内部：区间参数统一守门。min > max 是调用方笔误，忽略该条件比悄悄过滤成空组好。
static bool CMLib_AIFilterRangeOk(string lp_who, aifilter lp_filter, fixed lp_min, fixed lp_max) {
    if (lp_filter == null) { return false; }
    if (lp_min > lp_max) {
        CMLib_LogWarn("AI", lp_who + ": min > max，条件已忽略。");
        return false;
    }
    return true;
}

void CMLib_AIFilterLife(aifilter lp_filter, fixed lp_min, fixed lp_max) {
    if (CMLib_AIFilterRangeOk("AIFilterLife", lp_filter, lp_min, lp_max) == false) { return; }
    AISetFilterLife(lp_filter, lp_min, lp_max);
}

void CMLib_AIFilterLifePercent(aifilter lp_filter, fixed lp_min, fixed lp_max) {
    fixed lv_lo;
    fixed lv_hi;

    if (CMLib_AIFilterRangeOk("AIFilterLifePercent", lp_filter, lp_min, lp_max) == false) { return; }
    lv_lo = CMLib_ClampFixed(lp_min, 0.0, 100.0);
    lv_hi = CMLib_ClampFixed(lp_max, 0.0, 100.0);
    AISetFilterLifePercent(lp_filter, lv_lo, lv_hi);
}

void CMLib_AIFilterLifeLost(aifilter lp_filter, fixed lp_min, fixed lp_max) {
    if (CMLib_AIFilterRangeOk("AIFilterLifeLost", lp_filter, lp_min, lp_max) == false) { return; }
    AISetFilterLifeLost(lp_filter, lp_min, lp_max);
}

void CMLib_AIFilterShields(aifilter lp_filter, fixed lp_min, fixed lp_max) {
    if (CMLib_AIFilterRangeOk("AIFilterShields", lp_filter, lp_min, lp_max) == false) { return; }
    AISetFilterShields(lp_filter, lp_min, lp_max);
}

void CMLib_AIFilterRange(aifilter lp_filter, unit lp_center, fixed lp_radius) {
    if (lp_filter == null) { return; }
    // center 为 null 时**跳过**而不是照传 —— round24 callall 档的教训：
    // 把无效参数喂进 setter，结果是整组被过滤空，且没有任何报错线索。
    if (lp_center == null) {
        CMLib_LogWarn("AI", "AIFilterRange: 圆心单位为空，半径条件已忽略。");
        return;
    }
    if (lp_radius <= 0.0) { return; }
    AISetFilterRange(lp_filter, lp_center, lp_radius);
}

void CMLib_AIFilterInCombat(aifilter lp_filter, bool lp_want) {
    if (lp_filter == null) { return; }
    AISetFilterInCombat(lp_filter, lp_want);
}

void CMLib_AIFilterSortByLife(aifilter lp_filter, fixed lp_life, fixed lp_distance) {
    if (lp_filter == null) { return; }
    AISetFilterLifeSortReference(lp_filter, lp_life, lp_distance);
}

// ---- round25 新增 -----------------------------------------------------------
// 守门口径统一：**参数无效就跳过这一条件**，不照传给 native。
// 理由是 round24 那条教训——把无效参数喂进 setter，得到的是一个空组，
// 而空组和"确实没有符合的单位"长得一模一样，调用方拿不到任何线索。
void CMLib_AIFilterExcludeUnit(aifilter lp_filter, unit lp_exclude) {
    if (lp_filter == null) { return; }
    if (lp_exclude == null) { return; }
    AISetFilterSelf(lp_filter, lp_exclude);
}

void CMLib_AIFilterLifeMod(aifilter lp_filter, int lp_type, fixed lp_mod) {
    if (lp_filter == null) { return; }
    AISetFilterLifeMod(lp_filter, lp_type, lp_mod);
}

void CMLib_AIFilterBehaviorCount(aifilter lp_filter, int lp_min, int lp_max,
                                 string lp_behavior) {
    if (lp_filter == null) { return; }
    // 空串在 Galaxy 里与 null 等价，两种写法都要拦。
    if ((lp_behavior == null) || (lp_behavior == "")) {
        CMLib_LogWarn("AI", "AIFilterBehaviorCount: behavior 串为空，条件已忽略。");
        return;
    }
    if (lp_min > lp_max) {
        CMLib_LogWarn("AI", "AIFilterBehaviorCount: min > max，条件已忽略。");
        return;
    }
    AISetFilterBehaviorCount(lp_filter, lp_min, lp_max, lp_behavior);
}

void CMLib_AIFilterMelee(aifilter lp_filter, bool lp_want) {
    if (lp_filter == null) { return; }
    AISetFilterMelee(lp_filter, lp_want);
}

void CMLib_AIFilterValidPassenger(aifilter lp_filter, unit lp_transport) {
    if (lp_filter == null) { return; }
    if (lp_transport == null) {
        CMLib_LogWarn("AI", "AIFilterValidPassenger: 运输单位为空，条件已忽略。");
        return;
    }
    AISetFilterValidPassenger(lp_filter, lp_transport);
}

void CMLib_AIFilterMarkerCount(aifilter lp_filter, int lp_min, int lp_max,
                               marker lp_marker) {
    if (lp_filter == null) { return; }
    if (lp_marker == null) {
        CMLib_LogWarn("AI", "AIFilterMarkerCount: marker 为空，条件已忽略。");
        return;
    }
    if (lp_min > lp_max) {
        CMLib_LogWarn("AI", "AIFilterMarkerCount: min > max，条件已忽略。");
        return;
    }
    AISetFilterMarker(lp_filter, lp_min, lp_max, lp_marker);
}

void CMLib_AIFilterLifePerMarker(aifilter lp_filter, fixed lp_each, marker lp_marker) {
    if (lp_filter == null) { return; }
    if (lp_marker == null) {
        CMLib_LogWarn("AI", "AIFilterLifePerMarker: marker 为空，条件已忽略。");
        return;
    }
    if (lp_each <= 0.0) { return; }
    AISetFilterLifePerMarker(lp_filter, lp_each, lp_marker);
}

void CMLib_AIFilterCanAttackAlly(aifilter lp_filter, bool lp_groundAllies,
                                 bool lp_airAllies) {
    if (lp_filter == null) { return; }
    // 真机实证：(false,false) 会把结果筛成空组。它的本意是"没有要照顾的友军"，
    // 但绝大多数调用方会把两个 false 读成"我不关心这个维度"。语义反了 180 度，
    // 而且失败形态是静默空组 —— 这正是最难查的那种。直接拦掉。
    if ((lp_groundAllies == false) && (lp_airAllies == false)) {
        // 注意：Galaxy **没有** C/Python 那种相邻字符串字面量隐式拼接，
        // 写成两行相邻字面量会被解析成多传一个实参（G000 + G1001）。
        CMLib_LogWarn("AI", "AIFilterCanAttackAlly: 两个方向都为 false 会筛成空组，不是「不限制」，条件已忽略。");
        return;
    }
    AISetFilterCanAttackAlly(lp_filter, lp_groundAllies, lp_airAllies);
}

unitgroup CMLib_AIFilterApply(aifilter lp_filter, unitgroup lp_source) {
    unitgroup lv_out;

    if ((lp_filter == null) || (lp_source == null)) { return UnitGroupEmpty(); }
    lv_out = AIGetFilterGroup(lp_filter, lp_source);
    if (lv_out == null) { return UnitGroupEmpty(); }
    return lv_out;
}

int CMLib_AIFilterApplyCount(aifilter lp_filter, unitgroup lp_source) {
    return UnitGroupCount(CMLib_AIFilterApply(lp_filter, lp_source), c_unitCountAll);
}

// ---- 一站式层 ---------------------------------------------------------------
// 内部：建过滤器 + 设阵营，返回 null 表示玩家槽非法。
static aifilter CMLib_AISelectBase(int lp_player, int lp_alliance) {
    aifilter lv_f = CMLib_AIFilterNew(lp_player);

    if (lv_f == null) { return null; }
    AISetFilterAlliance(lv_f, lp_alliance);
    return lv_f;
}

unitgroup CMLib_AISelectEnemies(int lp_player, unitgroup lp_source) {
    return CMLib_AIFilterApply(CMLib_AISelectBase(lp_player, c_playerGroupEnemy), lp_source);
}

unitgroup CMLib_AISelectAllies(int lp_player, unitgroup lp_source) {
    return CMLib_AIFilterApply(CMLib_AISelectBase(lp_player, c_playerGroupAlly), lp_source);
}

unitgroup CMLib_AISelectInRange(int lp_player, unitgroup lp_source, unit lp_center, fixed lp_radius) {
    aifilter lv_f = CMLib_AISelectBase(lp_player, c_playerGroupAny);

    CMLib_AIFilterRange(lv_f, lp_center, lp_radius);
    return CMLib_AIFilterApply(lv_f, lp_source);
}

unitgroup CMLib_AISelectWounded(int lp_player, unitgroup lp_source, fixed lp_maxLifePercent) {
    aifilter lv_f = CMLib_AISelectBase(lp_player, c_playerGroupAny);

    CMLib_AIFilterLifePercent(lv_f, 0.0, lp_maxLifePercent);
    // 血量权重 1 / 距离权重 0 —— 最残的排前面。
    CMLib_AIFilterSortByLife(lv_f, 1.0, 0.0);
    return CMLib_AIFilterApply(lv_f, lp_source);
}

unitgroup CMLib_AISelectByType(int lp_player, unitgroup lp_source, string lp_filterStr) {
    aifilter lv_f = CMLib_AISelectBase(lp_player, c_playerGroupAny);

    CMLib_AIFilterTypes(lv_f, lp_filterStr);
    return CMLib_AIFilterApply(lv_f, lp_source);
}

unitgroup CMLib_AISelectGround(int lp_player, unitgroup lp_source) {
    aifilter lv_f = CMLib_AISelectBase(lp_player, c_playerGroupAny);

    CMLib_AIFilterPlane(lv_f, CMLIB_AIPLANE_GROUND);
    return CMLib_AIFilterApply(lv_f, lp_source);
}

unitgroup CMLib_AISelectAir(int lp_player, unitgroup lp_source) {
    aifilter lv_f = CMLib_AISelectBase(lp_player, c_playerGroupAny);

    CMLib_AIFilterPlane(lv_f, CMLIB_AIPLANE_AIR);
    return CMLib_AIFilterApply(lv_f, lp_source);
}

// ---- 无句柄组过滤 -----------------------------------------------------------
unitgroup CMLib_AIGroupProduction(unitgroup lp_source, bool lp_activeOnly) {
    unitgroup lv_out;

    if (lp_source == null) { return UnitGroupEmpty(); }
    lv_out = AIFilterProduction(lp_source, lp_activeOnly);
    if (lv_out == null) { return UnitGroupEmpty(); }
    return lv_out;
}

unitgroup CMLib_AIGroupPathable(unitgroup lp_source, point lp_from) {
    unitgroup lv_out;

    if ((lp_source == null) || (lp_from == null)) { return UnitGroupEmpty(); }
    lv_out = AIFilterPathable(lp_source, lp_from);
    if (lv_out == null) { return UnitGroupEmpty(); }
    return lv_out;
}

unitgroup CMLib_AIGroupCasters(unitgroup lp_source) {
    unitgroup lv_out;

    if (lp_source == null) { return UnitGroupEmpty(); }
    lv_out = AIFilterCasters(lp_source);
    if (lv_out == null) { return UnitGroupEmpty(); }
    return lv_out;
}

unitgroup CMLib_AIGroupGathering(unitgroup lp_source, int lp_resource, fixed lp_distance) {
    unitgroup lv_out;

    if (lp_source == null) { return UnitGroupEmpty(); }
    lv_out = AIFilterGathering(lp_source, lp_resource, CMLib_MaxFixed(lp_distance, 0.0));
    if (lv_out == null) { return UnitGroupEmpty(); }
    return lv_out;
}


// -----------------------------------------------------------------------------
// CMLib :: Round26 —— AIFilter 能量档
// -----------------------------------------------------------------------------

void CMLib_AIFilterEnergy(aifilter lp_filter, fixed lp_min, fixed lp_max) {
    if (CMLib_AIFilterRangeOk("AIFilterEnergy", lp_filter, lp_min, lp_max) == false) {
        return;
    }
    AISetFilterEnergy(lp_filter, lp_min, lp_max);
}
