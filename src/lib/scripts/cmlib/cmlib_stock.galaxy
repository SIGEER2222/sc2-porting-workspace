// =============================================================================
// CMLib :: Stock —— 实现
// =============================================================================

// ---- 库存：设定 / 增减 -------------------------------------------------------

void CMLib_StockSet(int lp_player, int lp_count, string lp_unitType) {
    int lv_n;

    if (lp_unitType == "") {
        CMLib_LogWarn("stock", "StockSet: 单位类型为空");
        return;
    }
    lv_n = lp_count;
    if (lv_n < 0) {
        lv_n = 0;
    }
    AISetStock(lp_player, lv_n, lp_unitType);
}

void CMLib_StockAdd(int lp_player, int lp_delta, string lp_unitType) {
    int lv_cur;
    int lv_target;

    if (lp_unitType == "") {
        CMLib_LogWarn("stock", "StockAdd: 单位类型为空");
        return;
    }
    // AISetStock 是"设目标存量"而非"加"，先读当前"建造中+已完成"再换算。
    lv_cur = AITechCount(lp_player, lp_unitType, CMLIB_TECH_PROGRESS_UP);
    lv_target = lv_cur + lp_delta;
    if (lv_target < 0) {
        lv_target = 0;
    }
    AISetStock(lp_player, lv_target, lp_unitType);
}

void CMLib_StockSetOpt(int lp_player, int lp_count, string lp_unitType) {
    int lv_n;

    if (lp_unitType == "") {
        return;
    }
    lv_n = lp_count;
    if (lv_n < 0) {
        lv_n = 0;
    }
    AISetStockOpt(lp_player, lv_n, lp_unitType);
}

void CMLib_StockSetAtTown(int lp_player, int lp_town, int lp_count,
                          string lp_unitType) {
    int lv_n;

    if (lp_unitType == "") {
        return;
    }
    lv_n = lp_count;
    if (lv_n < 0) {
        lv_n = 0;
    }
    AISetStockEx(lp_player, lp_town, lv_n, lp_unitType, 0, 0);
}

void CMLib_StockNextIf(int lp_player, int lp_count, string lp_unitType,
                       bool lp_when) {
    if (lp_unitType == "") {
        return;
    }
    AISetStockUnitNext(lp_player, lp_count, lp_unitType, lp_when);
}

void CMLib_StockExtra(int lp_player, int lp_count, string lp_unitType,
                      int lp_minMinerals) {
    if (lp_unitType == "") {
        return;
    }
    AISetStockExtra(lp_player, lp_count, lp_unitType, lp_minMinerals);
}

void CMLib_StockSupply(int lp_player, string lp_supplyType, bool lp_onlyNeeded) {
    if (lp_supplyType == "") {
        return;
    }
    AISetStockFarms(lp_player, lp_supplyType, lp_onlyNeeded);
}

void CMLib_StockWorkers(int lp_player, int lp_max, string lp_workerType) {
    int lv_n;

    if (lp_workerType == "") {
        return;
    }
    lv_n = lp_max;
    if (lv_n < 0) {
        lv_n = 0;
    }
    AISetStockPeons(lp_player, lv_n, lp_workerType, false, true);
}

void CMLib_StockTechNext(int lp_player) {
    AISetStockTechNext(lp_player);
}

bool CMLib_StockTown(int lp_player, string lp_townHallType, string lp_gasType) {
    if (lp_townHallType == "") {
        CMLib_LogWarn("stock", "StockTown: 主基地类型为空");
        return false;
    }
    return AISetStockTown(lp_player, lp_townHallType, lp_gasType);
