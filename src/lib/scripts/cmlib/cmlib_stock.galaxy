// ---- 库存：军队组成 -----------------------------------------------------------

void CMLib_StockArmyAdd(int lp_player, string lp_unitType, int lp_change) {
    if (lp_unitType == "") {
        CMLib_LogWarn("stock", "StockArmyAdd: 单位类型为空");
        return;
    }
    AIAddToStockArmy(lp_player, lp_unitType, lp_change);
}

void CMLib_StockArmyScale(int lp_player, fixed lp_scale) {
    fixed lv_s;

    lv_s = lp_scale;
    if (lv_s < 0.0) {
        lv_s = 0.0;
    }
    AISetStockArmyDefaultScale(lp_player, lv_s);
}

void CMLib_StockArmyReplace(int lp_player, string lp_unitType, int lp_replaceCount,
                            string lp_replaceWith) {
    if (lp_unitType == "" || lp_replaceWith == "") {
        return;
    }
    AISetStockArmyOverride(lp_player, lp_unitType, lp_replaceCount, lp_replaceWith);
}

void CMLib_StockArmyBatch(int lp_player, string lp_spec) {
    int    lv_i;
    int    lv_n;
    int    lv_qty;
    string lv_item;
    string lv_type;
    string lv_qtyStr;

    if (lp_spec == "") {
        return;
    }
    lv_n = CMLib_SplitCount(lp_spec, ",");
    lv_i = 0;
    while (lv_i < lv_n) {
        lv_item = CMLib_SplitAt(lp_spec, ",", lv_i);
        lv_type = CMLib_SplitAt(lv_item, ":", 0);
        lv_qtyStr = CMLib_SplitAt(lv_item, ":", 1);
        lv_qty = StringToInt(lv_qtyStr);
        if (lv_qty <= 0) {          // 缺省 / 非法数量按 1 处理
            lv_qty = 1;
        }
        if (lv_type != "") {
            AIAddToStockArmy(lp_player, lv_type, lv_qty);
        }
        lv_i = lv_i + 1;
    }
}

// ---- 科技计数 ---------------------------------------------------------------

int CMLib_TechCount(int lp_player, string lp_aliasType, int lp_countMask) {
    if (lp_aliasType == "") {
        return 0;
    }
    return AITechCount(lp_player, lp_aliasType, lp_countMask);
}

int CMLib_TechBuilt(int lp_player, string lp_aliasType) {
    return CMLib_TechCount(lp_player, lp_aliasType, CMLIB_TECH_COMPLETE);
}

int CMLib_TechPending(int lp_player, string lp_aliasType) {
    return CMLib_TechCount(lp_player, lp_aliasType, CMLIB_TECH_INCOMPLETE);
}

bool CMLib_TechHas(int lp_player, string lp_aliasType, int lp_atLeast) {
    return CMLib_TechBuilt(lp_player, lp_aliasType) >= lp_atLeast;
}

// ---- 科技树：单位 / 升级 / 技能 / 行为 -----------------------------------------

void CMLib_TechUnitAllow(int lp_player, string lp_unitType, bool lp_allow) {
    if (lp_unitType == "") {
        CMLib_LogWarn("stock", "TechUnitAllow: 单位类型为空");
        return;
    }
    TechTreeUnitAllow(lp_player, lp_unitType, lp_allow);
}

bool CMLib_TechUnitAllowed(int lp_player, string lp_unitType) {
    if (lp_unitType == "") {
        return false;
    }
    return TechTreeUnitIsAllowed(lp_player, lp_unitType);
}

int CMLib_TechUnitCount(int lp_player, string lp_unitType, int lp_countType) {
    if (lp_unitType == "") {
        return 0;
    }
    return TechTreeUnitCount(lp_player, lp_unitType, lp_countType);
}

void CMLib_TechUpgradeAllow(int lp_player, string lp_upgradeType, bool lp_allow) {
    if (lp_upgradeType == "") {
        return;
    }
    TechTreeUpgradeAllow(lp_player, lp_upgradeType, lp_allow);
}

bool CMLib_TechUpgradeAllowed(int lp_player, string lp_upgradeType) {
    if (lp_upgradeType == "") {
        return false;
    }
    return TechTreeUpgradeIsAllowed(lp_player, lp_upgradeType);
}

int CMLib_TechUpgradeLevel(int lp_player, string lp_upgradeType) {
    if (lp_upgradeType == "") {
        return 0;
    }
    return TechTreeUpgradeCount(lp_player, lp_upgradeType, CMLIB_TECH_COMPLETE);
}

void CMLib_TechUpgradeGrant(int lp_player, string lp_upgradeType, int lp_levels) {
    if (lp_upgradeType == "" || lp_levels <= 0) {
        return;
    }
    TechTreeUpgradeAddLevel(lp_player, lp_upgradeType, lp_levels);
}

void CMLib_TechAbilityAllow(int lp_player, abilcmd lp_abilCmd, bool lp_allow) {
    if (lp_abilCmd == null) {
        CMLib_LogWarn("stock", "TechAbilityAllow: abilcmd 为空");
        return;
    }
    TechTreeAbilityAllow(lp_player, lp_abilCmd, lp_allow);
}

bool CMLib_TechAbilityAllowed(int lp_player, abilcmd lp_abilCmd) {
    if (lp_abilCmd == null) {
        return false;
    }
    return TechTreeAbilityIsAllowed(lp_player, lp_abilCmd);
}

void CMLib_TechBehaviorAllow(int lp_player, string lp_behaviorType, bool lp_allow) {
    if (lp_behaviorType == "") {
        return;
    }
    TechTreeBehaviorAllow(lp_player, lp_behaviorType, lp_allow);
}

void CMLib_TechUnitAllowBatch(int lp_player, string lp_unitTypesCsv, bool lp_allow) {
    int    lv_i;
    int    lv_n;
    string lv_type;

    if (lp_unitTypesCsv == "") {
        return;
    }
    lv_n = CMLib_SplitCount(lp_unitTypesCsv, ",");
    lv_i = 0;
    while (lv_i < lv_n) {
        lv_type = CMLib_SplitAt(lp_unitTypesCsv, ",", lv_i);
        if (lv_type != "") {
            TechTreeUnitAllow(lp_player, lv_type, lp_allow);
        }
        lv_i = lv_i + 1;
    }
}

// ---- 科技树：全局开关 ---------------------------------------------------------

void CMLib_TechRequirementsEnable(int lp_player, bool lp_enable) {
    TechTreeRequirementsEnable(lp_player, lp_enable);
}

void CMLib_TechRestrictionsEnable(int lp_player, bool lp_enable) {
    TechTreeRestrictionsEnable(lp_player, lp_enable);
}

void CMLib_TechRequirementEnable(int lp_player, string lp_requirement,
                                 bool lp_enable) {
    if (lp_requirement == "") {
        return;
    }
    TechTreeSpecificRequirementEnable(lp_player, lp_requirement, lp_enable);
}

void CMLib_TechUnlockAll(int lp_player) {
    // 需求判定与限制判定是两个独立开关，只关一个仍然会被卡。
    TechTreeRequirementsEnable(lp_player, false);
    TechTreeRestrictionsEnable(lp_player, false);
}

void CMLib_TechRestoreRules(int lp_player) {
    TechTreeRequirementsEnable(lp_player, true);
    TechTreeRestrictionsEnable(lp_player, true);
}

// ---- AI 用户变量 -------------------------------------------------------------

void CMLib_AIVarSet(int lp_player, int lp_index, int lp_value) {
    AISetUserInt(lp_player, lp_index, lp_value);
}

int CMLib_AIVarGet(int lp_player, int lp_index) {
    return AIGetUserInt(lp_player, lp_index);
}

int CMLib_AIVarBump(int lp_player, int lp_index, int lp_delta) {
    int lv_new;

    lv_new = AIGetUserInt(lp_player, lp_index) + lp_delta;
    AISetUserInt(lp_player, lp_index, lv_new);
    return lv_new;
}

// ---- 库存总开关 -----------------------------------------------------------
void CMLib_AIEnableStock(int lp_player) {
    AIEnableStock(lp_player);
}

void CMLib_AIClearStock(int lp_player) {
    AIClearStock(lp_player);
}


// -----------------------------------------------------------------------------
// CMLib :: Round26 —— 库存别名 / 免费单位 / 科技解限
// -----------------------------------------------------------------------------

void CMLib_StockAlias(int lp_player, int lp_count, string lp_makeType,
                      string lp_aliasType) {
    if (lp_makeType == "") { return; }
    if (lp_aliasType == "") { return; }
    if (lp_count < 0) { return; }
    AISetStockAlias(lp_player, lp_count, lp_makeType, lp_aliasType);
}

void CMLib_StockFree(int lp_player, int lp_count, string lp_makeType,
                     string lp_prereq) {
    if (lp_makeType == "") { return; }
    if (lp_prereq == "") { return; }
    if (lp_count < 0) { return; }
    AISetStockFree(lp_player, lp_count, lp_makeType, lp_prereq);
}

void CMLib_StockTechUncap(int lp_player, int lp_unCapMinerals, int lp_unCapGas) {
    int lv_min;
    int lv_gas;

    lv_min = lp_unCapMinerals;
    lv_gas = lp_unCapGas;
    if (lv_min < 0) { lv_min = 0; }
    if (lv_gas < 0) { lv_gas = 0; }
    AISetStockTechNextUnCap(lp_player, lv_min, lv_gas);
}
