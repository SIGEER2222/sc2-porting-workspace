// =============================================================================
// CMLib :: UI (实现)
// 全部使用 core.sc2mod 原生 native，不依赖 NativeLib(libNtve_*)。
// =============================================================================

include "scripts/cmlib/cmlib_core_h"
include "scripts/cmlib/cmlib_ui_h"

// -----------------------------------------------------------------------------
// 有效性
// -----------------------------------------------------------------------------

bool CMLib_UIValid(int lp_control) {
    if ((lp_control == c_invalidDialogControlId)) {
        return false;
    }
    return true;
}

// -----------------------------------------------------------------------------
// 挂钩
// -----------------------------------------------------------------------------

int CMLib_UIHookup(int lp_parent, int lp_type, string lp_name) {
    if ((CMLib_UIValid(lp_parent) == false)) {
        CMLib_LogWarn("CMLib.UI", "Hookup skipped, invalid parent for '" + lp_name + "'");
        return c_invalidDialogControlId;
    }
    DialogControlHookup(lp_parent, lp_type, lp_name);
    return DialogControlLastCreated();
}

int CMLib_UIHookupIndexed(int lp_parent, int lp_type, string lp_prefix, int lp_index) {
    return CMLib_UIHookup(lp_parent, lp_type, (lp_prefix + IntToString(lp_index)));
}

int CMLib_UIHookupStandard(int lp_type, string lp_name) {
    DialogControlHookupStandard(lp_type, lp_name);
    return DialogControlLastCreated();
}

int CMLib_UIHookupPanel(int lp_parent, string lp_name) {
    return CMLib_UIHookup(lp_parent, c_triggerControlTypePanel, lp_name);
}

int CMLib_UIHookupButton(int lp_parent, string lp_name) {
    return CMLib_UIHookup(lp_parent, c_triggerControlTypeButton, lp_name);
}

int CMLib_UIHookupLabel(int lp_parent, string lp_name) {
    return CMLib_UIHookup(lp_parent, c_triggerControlTypeLabel, lp_name);
}

int CMLib_UIHookupImage(int lp_parent, string lp_name) {
    return CMLib_UIHookup(lp_parent, c_triggerControlTypeImage, lp_name);
}

// -----------------------------------------------------------------------------
// 创建
// -----------------------------------------------------------------------------

int CMLib_UICreateInPanel(int lp_parent, int lp_type) {
    if ((CMLib_UIValid(lp_parent) == false)) {
        CMLib_LogWarn("CMLib.UI", "CreateInPanel skipped, invalid parent");
        return c_invalidDialogControlId;
    }
    DialogControlCreateInPanel(lp_parent, lp_type);
    return DialogControlLastCreated();
}

int CMLib_UICreateFromTemplate(int lp_parent, int lp_type, string lp_template) {
    if ((CMLib_UIValid(lp_parent) == false)) {
        CMLib_LogWarn("CMLib.UI", "CreateFromTemplate skipped, invalid parent for '" + lp_template + "'");
        return c_invalidDialogControlId;
    }
    DialogControlCreateInPanelFromTemplate(lp_parent, lp_type, lp_template);
    return DialogControlLastCreated();
}

