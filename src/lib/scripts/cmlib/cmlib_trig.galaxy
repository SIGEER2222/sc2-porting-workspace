// -----------------------------------------------------------------------------
// 跨触发器传参
// -----------------------------------------------------------------------------
// 内部：统一键名，避免各处自拼字符串撞车。
static string CMLib_TrigArgKey(string lp_slot) {
    return CMLib_Key2(CMLIB_TRIG_ARG_PREFIX, lp_slot);
}

void CMLib_TrigArgSetInt(string lp_slot, int lp_value) {
    CMLib_StoreInt(CMLib_TrigArgKey(lp_slot), lp_value);
}

int CMLib_TrigArgGetInt(string lp_slot, int lp_fallback) {
    return CMLib_LoadInt(CMLib_TrigArgKey(lp_slot), lp_fallback);
}

void CMLib_TrigArgSetFixed(string lp_slot, fixed lp_value) {
    CMLib_StoreFixed(CMLib_TrigArgKey(lp_slot), lp_value);
}

fixed CMLib_TrigArgGetFixed(string lp_slot, fixed lp_fallback) {
    return CMLib_LoadFixed(CMLib_TrigArgKey(lp_slot), lp_fallback);
}

void CMLib_TrigArgSetString(string lp_slot, string lp_value) {
    CMLib_StoreString(CMLib_TrigArgKey(lp_slot), lp_value);
}

string CMLib_TrigArgGetString(string lp_slot, string lp_fallback) {
    return CMLib_LoadString(CMLib_TrigArgKey(lp_slot), lp_fallback);
}

void CMLib_TrigArgSetUnit(string lp_slot, unit lp_value) {
    CMLib_StoreUnit(CMLib_TrigArgKey(lp_slot), lp_value);
}

unit CMLib_TrigArgGetUnit(string lp_slot) {
    return CMLib_LoadUnit(CMLib_TrigArgKey(lp_slot));
}

void CMLib_TrigCallInt(trigger lp_trigger, string lp_slot, int lp_value) {
    if (lp_trigger == null) { return; }
    CMLib_TrigArgSetInt(lp_slot, lp_value);
    TriggerExecute(lp_trigger, true, false);
}

// -----------------------------------------------------------------------------
// 等待
// -----------------------------------------------------------------------------
void CMLib_WaitGame(fixed lp_secs) {
    if (lp_secs <= 0.0) { return; }
    Wait(lp_secs, c_timeGame);
}

void CMLib_WaitReal(fixed lp_secs) {
    if (lp_secs <= 0.0) { return; }
    Wait(lp_secs, c_timeReal);
}

void CMLib_WaitAI(fixed lp_secs) {
    if (lp_secs <= 0.0) { return; }
    Wait(lp_secs, c_timeAI);
}

void CMLib_Yield() {
    Wait(0.0625, c_timeReal);
}

// -----------------------------------------------------------------------------
// 计时器
// -----------------------------------------------------------------------------
// 内部：新建并启动。
static timer CMLib_TimerStartNew(fixed lp_secs, bool lp_periodic) {
    timer lv_t;

    if (lp_secs <= 0.0) {
        CMLib_LogError("Trig",
            "Timer: 时长必须 > 0（收到 " + FixedToString(lp_secs, 3) + "），已拒绝。");
        return null;
    }
    lv_t = TimerCreate();
    TimerStart(lv_t, lp_secs, lp_periodic, c_timeGame);
    return lv_t;
}

timer CMLib_TimerOnce(fixed lp_secs) {
    return CMLib_TimerStartNew(lp_secs, false);
}

timer CMLib_TimerLoop(fixed lp_secs) {
    return CMLib_TimerStartNew(lp_secs, true);
}

fixed CMLib_TimerLeft(timer lp_timer) {
    if (lp_timer == null) { return 0.0; }
    return TimerGetRemaining(lp_timer);
}

fixed CMLib_TimerElapsed(timer lp_timer) {
    if (lp_timer == null) { return 0.0; }
    return TimerGetElapsed(lp_timer);
}

void CMLib_TimerHold(timer lp_timer, bool lp_pause) {
    if (lp_timer == null) { return; }
    TimerPause(lp_timer, lp_pause);
}

void CMLib_TimerReset(timer lp_timer) {
    if (lp_timer == null) { return; }
    TimerRestart(lp_timer);
}

// -----------------------------------------------------------------------------
// 自检
// -----------------------------------------------------------------------------
void CMLib_TrigDumpState() {
    int lv_i;
    int lv_enabled;

    lv_i = 0;
    lv_enabled = 0;
    while (lv_i < CMLib_TrigRegCount) {
        if (CMLib_TrigRegT[lv_i] != null) {
            if (TriggerIsEnabled(CMLib_TrigRegT[lv_i]) == true) { lv_enabled += 1; }
        }
        lv_i += 1;
    }
    CMLib_LogInfo("Trig",
        "注册 " + IntToString(CMLib_TrigRegCount) + " 个 / 启用 " + IntToString(lv_enabled) +
        " 个 / 溢出未管理 " + IntToString(CMLib_TrigOverflow) +
        " 个 / 队列深度 " + IntToString(CMLib_TrigQDepth));
    if (CMLib_TrigQDepth != 0) {
        CMLib_LogError("Trig",
            "队列深度非 0，说明有 CMLib_TrigQueueBegin 没有配对的 End —— " +
            "后续排队触发器会静默不执行。");
    }
}

