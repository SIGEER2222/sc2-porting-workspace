void CMLib_TrigOnPlayerLeft(trigger lp_trigger, int lp_player, int lp_result) {
    if (lp_trigger == null) { return; }
    TriggerAddEventPlayerLeft(lp_trigger, lp_player, lp_result);
}

void CMLib_TrigOnAllianceChange(trigger lp_trigger, int lp_player) {
    if (lp_trigger == null) { return; }
    TriggerAddEventPlayerAllianceChange(lp_trigger, lp_player);
}

void CMLib_TrigOnAIWave(trigger lp_trigger, int lp_player) {
    if (lp_trigger == null) { return; }
    TriggerAddEventPlayerAIWave(lp_trigger, lp_player);
}

void CMLib_TrigOnChat(trigger lp_trigger, int lp_player, string lp_text, bool lp_exact) {
    if (lp_trigger == null) { return; }
    TriggerAddEventChatMessage(lp_trigger, lp_player, lp_text, lp_exact);
}

void CMLib_TrigOnGeneric(trigger lp_trigger, string lp_eventName) {
    if (lp_trigger == null) { return; }
    if (lp_eventName == "") {
        CMLib_LogWarn("Trig", "TrigOnGeneric: 事件名为空，已忽略。");
        return;
    }
    TriggerAddEventGeneric(lp_trigger, lp_eventName);
}

void CMLib_TrigSend(string lp_eventName) {
    if (lp_eventName == "") {
        CMLib_LogWarn("Trig", "TrigSend: 事件名为空，已忽略。");
        return;
    }
    TriggerSendEvent(lp_eventName);
}

