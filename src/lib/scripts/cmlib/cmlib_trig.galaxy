// =============================================================================
// CMLib :: Trig —— 实现
// =============================================================================

include "scripts/cmlib/cmlib_trig_h"

// -----------------------------------------------------------------------------
// 内部状态
// -----------------------------------------------------------------------------
trigger[CMLIB_TRIG_MAX] CMLib_TrigRegT;
string[CMLIB_TRIG_MAX]  CMLib_TrigRegName;
string[CMLIB_TRIG_MAX]  CMLib_TrigRegTag;
int     CMLib_TrigRegCount = 0;
// 因容量不足而未纳入管理的触发器计数（自检时输出，便于发现该调大 CMLIB_TRIG_MAX）。
int     CMLib_TrigOverflow = 0;
// TriggerQueueEnter/Exit 的配对深度。
int     CMLib_TrigQDepth = 0;
// 队列深度告警阈值：超过这个层数基本可以断定有漏 Exit。
const int CMLIB_TRIG_QDEPTH_WARN = 16;

// 跨触发器传参的键名前缀，避免与业务键撞车。
const string CMLIB_TRIG_ARG_PREFIX = "cmlib.trigarg";

// 内部：按 trigger 句柄找注册表下标，找不到返回 CMLIB_TRIG_NONE。
static int CMLib_TrigIndexOf(trigger lp_trigger) {
    int lv_i;

    if (lp_trigger == null) { return CMLIB_TRIG_NONE; }
    lv_i = 0;
    while (lv_i < CMLib_TrigRegCount) {
        if (CMLib_TrigRegT[lv_i] == lp_trigger) { return lv_i; }
        lv_i += 1;
    }
    return CMLIB_TRIG_NONE;
}

// 内部：从注册表摘除下标 lp_index（用末位覆盖，O(1)）。
static void CMLib_TrigRemoveAt(int lp_index) {
    int lv_last;

    if ((lp_index < 0) || (lp_index >= CMLib_TrigRegCount)) { return; }
    lv_last = CMLib_TrigRegCount - 1;
    CMLib_TrigRegT[lp_index] = CMLib_TrigRegT[lv_last];
    CMLib_TrigRegName[lp_index] = CMLib_TrigRegName[lv_last];
    CMLib_TrigRegTag[lp_index] = CMLib_TrigRegTag[lv_last];
    CMLib_TrigRegT[lv_last] = null;
    CMLib_TrigRegName[lv_last] = "";
    CMLib_TrigRegTag[lv_last] = "";
    CMLib_TrigRegCount = lv_last;
}

// -----------------------------------------------------------------------------
// 创建与注册
// -----------------------------------------------------------------------------
void CMLib_TrigRegister(trigger lp_trigger, string lp_name, string lp_tag) {
    if (lp_trigger == null) {
        CMLib_LogWarn("Trig", "TrigRegister: 传入 null 触发器，已忽略。");
        return;
    }
    if (CMLib_TrigIndexOf(lp_trigger) != CMLIB_TRIG_NONE) {
        CMLib_LogWarn("Trig", "TrigRegister: 触发器已登记，忽略重复登记 " + lp_name);
        return;
    }
    if (CMLib_TrigRegCount >= CMLIB_TRIG_MAX) {
        CMLib_TrigOverflow += 1;
        CMLib_LogError("Trig",
            "TrigRegister: 注册表已满(" + IntToString(CMLIB_TRIG_MAX) +
            ")，" + lp_name + " 不受分组管理。请调大 CMLIB_TRIG_MAX。");
        return;
    }
    CMLib_TrigRegT[CMLib_TrigRegCount] = lp_trigger;
    CMLib_TrigRegName[CMLib_TrigRegCount] = lp_name;
    CMLib_TrigRegTag[CMLib_TrigRegCount] = lp_tag;
    CMLib_TrigRegCount += 1;
}

void CMLib_TrigUnregister(trigger lp_trigger) {
    CMLib_TrigRemoveAt(CMLib_TrigIndexOf(lp_trigger));
}

trigger CMLib_TrigNew(string lp_funcName, string lp_tag) {
    trigger lv_t;

    if (lp_funcName == "") {
        CMLib_LogError("Trig", "TrigNew: 函数名为空，无法创建触发器。");
        return null;
    }
    lv_t = TriggerCreate(lp_funcName);
    CMLib_TrigRegister(lv_t, lp_funcName, lp_tag);
    return lv_t;
}

trigger CMLib_TrigNewDisabled(string lp_funcName, string lp_tag) {
    trigger lv_t;

    lv_t = CMLib_TrigNew(lp_funcName, lp_tag);
    if (lv_t != null) { TriggerEnable(lv_t, false); }
    return lv_t;
}

// -----------------------------------------------------------------------------
// 查询
// -----------------------------------------------------------------------------
int CMLib_TrigCount() {
    return CMLib_TrigRegCount;
}

int CMLib_TrigCountByTag(string lp_tag) {
    int lv_i;
    int lv_n;

    lv_i = 0;
    lv_n = 0;
    while (lv_i < CMLib_TrigRegCount) {
        if (CMLib_TrigRegTag[lv_i] == lp_tag) { lv_n += 1; }
        lv_i += 1;
    }
    return lv_n;
}

trigger CMLib_TrigFind(string lp_name) {
    int lv_i;

    lv_i = 0;
    while (lv_i < CMLib_TrigRegCount) {
        if (CMLib_TrigRegName[lv_i] == lp_name) { return CMLib_TrigRegT[lv_i]; }
        lv_i += 1;
    }
    return null;
}

bool CMLib_TrigIsRegistered(trigger lp_trigger) {
    return CMLib_TrigIndexOf(lp_trigger) != CMLIB_TRIG_NONE;
}

bool CMLib_TrigEnabled(trigger lp_trigger) {
    if (lp_trigger == null) { return false; }
    return TriggerIsEnabled(lp_trigger);
}

// -----------------------------------------------------------------------------
// 开关 / 销毁：单个
// -----------------------------------------------------------------------------
void CMLib_TrigSet(trigger lp_trigger, bool lp_enable) {
    if (lp_trigger == null) { return; }
    TriggerEnable(lp_trigger, lp_enable);
}

void CMLib_TrigOn(trigger lp_trigger) {
    CMLib_TrigSet(lp_trigger, true);
}

void CMLib_TrigOff(trigger lp_trigger) {
    CMLib_TrigSet(lp_trigger, false);
}

void CMLib_TrigKill(trigger lp_trigger) {
    if (lp_trigger == null) { return; }
    CMLib_TrigUnregister(lp_trigger);
    TriggerDestroy(lp_trigger);
}

// -----------------------------------------------------------------------------
// 开关 / 销毁：按 tag 批量
// -----------------------------------------------------------------------------
// 内部：批量设置启用态，返回受影响个数。
static int CMLib_TrigTagSet(string lp_tag, bool lp_enable) {
    int lv_i;
    int lv_n;

    lv_i = 0;
    lv_n = 0;
    while (lv_i < CMLib_TrigRegCount) {
        if (CMLib_TrigRegTag[lv_i] == lp_tag) {
            if (CMLib_TrigRegT[lv_i] != null) {
                TriggerEnable(CMLib_TrigRegT[lv_i], lp_enable);
                lv_n += 1;
            }
        }
        lv_i += 1;
    }
    return lv_n;
}

int CMLib_TrigTagOn(string lp_tag) {
    return CMLib_TrigTagSet(lp_tag, true);
}

int CMLib_TrigTagOff(string lp_tag) {
    return CMLib_TrigTagSet(lp_tag, false);
}

int CMLib_TrigTagKill(string lp_tag) {
    int lv_i;
    int lv_n;
    trigger lv_t;

    lv_n = 0;
    // 倒序遍历：CMLib_TrigRemoveAt 用末位覆盖，倒序才不会漏检被搬上来的元素。
    lv_i = CMLib_TrigRegCount - 1;
    while (lv_i >= 0) {
        if (CMLib_TrigRegTag[lv_i] == lp_tag) {
            lv_t = CMLib_TrigRegT[lv_i];
            CMLib_TrigRemoveAt(lv_i);
            if (lv_t != null) {
                TriggerDestroy(lv_t);
                lv_n += 1;
            }
        }
        lv_i -= 1;
    }
    return lv_n;
}

// -----------------------------------------------------------------------------
// 执行
// -----------------------------------------------------------------------------
void CMLib_TrigRun(trigger lp_trigger) {
    if (lp_trigger == null) { return; }
    TriggerExecute(lp_trigger, true, false);
}

void CMLib_TrigRunNow(trigger lp_trigger) {
    if (lp_trigger == null) { return; }
    TriggerExecute(lp_trigger, true, true);
}

void CMLib_TrigForce(trigger lp_trigger) {
    if (lp_trigger == null) { return; }
    TriggerExecute(lp_trigger, false, false);
}

void CMLib_TrigForceNow(trigger lp_trigger) {
    if (lp_trigger == null) { return; }
    TriggerExecute(lp_trigger, false, true);
}

bool CMLib_TrigTest(trigger lp_trigger) {
    if (lp_trigger == null) { return false; }
    return TriggerEvaluate(lp_trigger);
}

void CMLib_TrigStopSelf() {
    trigger lv_t;

    lv_t = TriggerGetCurrent();
    if (lv_t == null) {
        CMLib_LogWarn("Trig", "TrigStopSelf: 不在触发器执行上下文中，已忽略。");
        return;
    }
    TriggerStop(lv_t);
}

// -----------------------------------------------------------------------------
// 执行队列（成对保护）
// -----------------------------------------------------------------------------
void CMLib_TrigQueueBegin() {
    TriggerQueueEnter();
    CMLib_TrigQDepth += 1;
    if (CMLib_TrigQDepth == CMLIB_TRIG_QDEPTH_WARN) {
        CMLib_LogWarn("Trig",
            "队列嵌套深度已达 " + IntToString(CMLIB_TRIG_QDEPTH_WARN) +
            "，很可能有触发器漏调 CMLib_TrigQueueEnd。");
    }
}

void CMLib_TrigQueueEnd() {
    if (CMLib_TrigQDepth <= 0) {
        CMLib_LogError("Trig",
            "TrigQueueEnd: 没有对应的 Begin（深度已为 0），已忽略。" +
            "多余的 Exit 会释放掉别人的队列位，导致后续触发器错乱。");
        return;
    }
    CMLib_TrigQDepth -= 1;
    TriggerQueueExit();
}

int CMLib_TrigQueueDepth() {
    return CMLib_TrigQDepth;
}

bool CMLib_TrigQueueIsEmpty() {
    return TriggerQueueIsEmpty();
}

void CMLib_TrigQueuePause(bool lp_pause) {
    TriggerQueuePause(lp_pause);
}

// -----------------------------------------------------------------------------
// 事件挂载：生命周期
// -----------------------------------------------------------------------------
void CMLib_TrigOnMapInit(trigger lp_trigger) {
    if (lp_trigger == null) { return; }
    TriggerAddEventMapInit(lp_trigger);
}

void CMLib_TrigOnElapsed(trigger lp_trigger, fixed lp_secs) {
    if (lp_trigger == null) { return; }
    TriggerAddEventTimeElapsed(lp_trigger, lp_secs, c_timeGame);
}

// 内部：周期事件的公共校验。周期 <= 0 会让触发器每帧反复执行，必须拦。
static bool CMLib_TrigPeriodGuard(trigger lp_trigger, fixed lp_secs) {
    if (lp_trigger == null) { return false; }
    if (lp_secs <= 0.0) {
        CMLib_LogError("Trig",
            "TrigOnPeriod: 周期必须 > 0（收到 " + FixedToString(lp_secs, 3) +
            "）。周期 0 会让触发器无限重入并卡死游戏，已拒绝挂载。");
        return false;
    }
    return true;
}

void CMLib_TrigOnPeriod(trigger lp_trigger, fixed lp_secs) {
    if (CMLib_TrigPeriodGuard(lp_trigger, lp_secs) == false) { return; }
    TriggerAddEventTimePeriodic(lp_trigger, lp_secs, c_timeGame);
}

void CMLib_TrigOnPeriodReal(trigger lp_trigger, fixed lp_secs) {
    if (CMLib_TrigPeriodGuard(lp_trigger, lp_secs) == false) { return; }
    TriggerAddEventTimePeriodic(lp_trigger, lp_secs, c_timeReal);
}

void CMLib_TrigOnTimer(trigger lp_trigger, timer lp_timer) {
    if (lp_trigger == null) { return; }
    if (lp_timer == null) {
        CMLib_LogWarn("Trig", "TrigOnTimer: 计时器为 null，已忽略。");
        return;
    }
    TriggerAddEventTimer(lp_trigger, lp_timer);
}

// -----------------------------------------------------------------------------
// 事件挂载：单位
// -----------------------------------------------------------------------------
// 内部：unit -> unitref，null 保持 null（原生用 null 表示「任意单位」通配）。
static unitref CMLib_TrigUnitRef(unit lp_unit) {
    if (lp_unit == null) { return null; }
    return UnitRefFromUnit(lp_unit);
}

void CMLib_TrigOnUnitDied(trigger lp_trigger, unit lp_unit) {
    if (lp_trigger == null) { return; }
    TriggerAddEventUnitDied(lp_trigger, CMLib_TrigUnitRef(lp_unit));
}

void CMLib_TrigOnUnitAttacked(trigger lp_trigger, unit lp_unit) {
    if (lp_trigger == null) { return; }
    TriggerAddEventUnitAttacked(lp_trigger, CMLib_TrigUnitRef(lp_unit));
}

void CMLib_TrigOnUnitChangeOwner(trigger lp_trigger, unit lp_unit) {
    if (lp_trigger == null) { return; }
    TriggerAddEventUnitChangeOwner(lp_trigger, CMLib_TrigUnitRef(lp_unit));
}

void CMLib_TrigOnUnitGainLevel(trigger lp_trigger, unit lp_unit) {
    if (lp_trigger == null) { return; }
    TriggerAddEventUnitGainLevel(lp_trigger, CMLib_TrigUnitRef(lp_unit));
}

void CMLib_TrigOnUnitCreated(trigger lp_trigger, unit lp_unit,
                             string lp_creatorAbil, string lp_creatorBehavior) {
    if (lp_trigger == null) { return; }
    TriggerAddEventUnitCreated(lp_trigger, CMLib_TrigUnitRef(lp_unit),
                               lp_creatorAbil, lp_creatorBehavior);
}

void CMLib_TrigOnUnitDamaged(trigger lp_trigger, unit lp_unit, string lp_effect) {
    if (lp_trigger == null) { return; }
    // c_unitDamageTypeAny(-1) = 不限伤害类型；c_unitDamageEither(0) = 致命与非致命都收。
    // 注意别把「是否致命」这一档写成 c_unitDamageTypeAny —— 两组常量域不同，
    // 传错会变成只收致命伤害，导致掉血监听整体失效。
    TriggerAddEventUnitDamaged(lp_trigger, CMLib_TrigUnitRef(lp_unit),
                               c_unitDamageTypeAny, c_unitDamageEither, lp_effect);
}

void CMLib_TrigOnUnitIdle(trigger lp_trigger, unit lp_unit, bool lp_idle) {
    if (lp_trigger == null) { return; }
    TriggerAddEventUnitBecomesIdle(lp_trigger, CMLib_TrigUnitRef(lp_unit), lp_idle);
}

// -----------------------------------------------------------------------------
// 事件挂载：单位 · 空间与交互
// -----------------------------------------------------------------------------
void CMLib_TrigOnUnitRegion(trigger lp_trigger, unit lp_unit, region lp_region,
                            bool lp_entering) {
    if (lp_trigger == null) { return; }
    if (lp_region == null) {
        CMLib_LogWarn("Trig", "TrigOnUnitRegion: 区域为 null，事件未挂载。");
        return;
    }
    TriggerAddEventUnitRegion(lp_trigger, CMLib_TrigUnitRef(lp_unit), lp_region,
                              lp_entering);
}

void CMLib_TrigOnUnitRegionBoth(trigger lp_trigger, unit lp_unit, region lp_region) {
    // 进入与离开是两条独立事件；只挂一条会让「区域内计数」单向漂移。
    CMLib_TrigOnUnitRegion(lp_trigger, lp_unit, lp_region, true);
    CMLib_TrigOnUnitRegion(lp_trigger, lp_unit, lp_region, false);
}

void CMLib_TrigOnUnitRange(trigger lp_trigger, unit lp_unit, unit lp_from,
                           fixed lp_range, bool lp_entering) {
    if (lp_trigger == null) { return; }
    if (lp_from == null) {
        CMLib_LogWarn("Trig", "TrigOnUnitRange: 参照单位为 null，事件未挂载。");
        return;
    }
    TriggerAddEventUnitRange(lp_trigger, CMLib_TrigUnitRef(lp_unit), lp_from,
                             lp_range, lp_entering);
}

void CMLib_TrigOnUnitRangePoint(trigger lp_trigger, unit lp_unit, point lp_point,
                                fixed lp_range, bool lp_entering) {
    if (lp_trigger == null) { return; }
    if (lp_point == null) {
        CMLib_LogWarn("Trig", "TrigOnUnitRangePoint: 参照点为 null，事件未挂载。");
        return;
    }
    TriggerAddEventUnitRangePoint(lp_trigger, CMLib_TrigUnitRef(lp_unit), lp_point,
                                  lp_range, lp_entering);
}

