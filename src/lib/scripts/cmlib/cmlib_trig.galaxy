// -----------------------------------------------------------------------------
void CMLib_TrigOnUnitAbility(trigger lp_trigger, unit lp_unit, abilcmd lp_abilcmd,
                             int lp_stage, bool lp_includeShared) {
    if (lp_trigger == null) { return; }
    TriggerAddEventUnitAbility(lp_trigger, CMLib_TrigUnitRef(lp_unit), lp_abilcmd,
                               lp_stage, lp_includeShared);
}

void CMLib_TrigOnUnitAbilityUsed(trigger lp_trigger, unit lp_unit, abilcmd lp_abilcmd) {
    // c_unitAbilStageExecute(-3) = 真正开始施放那一刻，不含排队/取消。
    // includeSharedAbils=true：不带这个，建造类共享技能（AbilBuild 等）收不到。
    CMLib_TrigOnUnitAbility(lp_trigger, lp_unit, lp_abilcmd,
                            c_unitAbilStageExecute, true);
}

void CMLib_TrigOnUnitAutoCast(trigger lp_trigger, unit lp_unit, abilcmd lp_abilcmd,
