// -----------------------------------------------------------------------------
// 事件挂载：面板 / 对话框控件
// -----------------------------------------------------------------------------
void CMLib_TrigOnDialogControl(trigger lp_trigger, int lp_player, int lp_control,
                               int lp_eventType) {
    if (lp_trigger == null) { return; }
    TriggerAddEventDialogControl(lp_trigger, lp_player, lp_control, lp_eventType);
}

void CMLib_TrigOnButtonClick(trigger lp_trigger, int lp_control) {
    if (lp_trigger == null) { return; }
    if (lp_control == c_invalidDialogControlId) {
        // 传 0 在原生里等价于「任意控件」，但绝大多数情况是控件创建失败留下的 0。
        // 这里不拦截（保留通配能力），只提示，避免一个失败的控件让全局按钮乱响。
        CMLib_LogWarn("Trig",
            "TrigOnButtonClick: 控件 id 为 0（无效/通配），请确认控件已创建成功。");
    }
    TriggerAddEventDialogControl(lp_trigger, c_playerAny, lp_control,
                                 c_triggerControlEventTypeClick);
}

// -----------------------------------------------------------------------------
// 事件取参：上述事件族的配套读取
// -----------------------------------------------------------------------------
region CMLib_EvtRegion() {
    return EventUnitRegion();
