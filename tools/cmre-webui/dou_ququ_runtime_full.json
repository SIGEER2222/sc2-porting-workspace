{
  "vm": "vibe-debug/1",
  "mode": "debug",
  "steps": [
    {"op":"call","fn":"douququ.reset","args":{"seed":42}},
    {"op":"call","fn":"douququ.runtime.status","args":{},"save":"runtime"},
    {"op":"assert","source":"$vars.runtime","path":"active","equals":true},
    {"op":"call","fn":"douququ.runtime.set_proc_chances","args":{"reaver_ordinary_percent":100,"reaver_kill_percent":100,"broodlord_percent":100},"save":"procChances"},
    {"op":"assert","source":"$vars.procChances","path":"reaverOrdinaryPercent","equals":100},
    {"op":"assert","source":"$vars.procChances","path":"broodLordPercent","equals":100},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"Reaver","owner":1,"x":65.0,"y":70.0},"save":"reaver"},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"CommandCenter","owner":2,"x":95.0,"y":70.0},"save":"reaverTarget"},
    {"op":"call","fn":"douququ.attack","args":{"attacker_tag":{"$ref":"vars.reaver.tag"},"target_tag":{"$ref":"vars.reaverTarget.tag"}},"save":"reaverAttack"},
    {"op":"assert","source":"$vars.reaverAttack","path":"effect.triggered","equals":true},
    {"op":"call","fn":"douququ.snapshot","args":{},"save":"reaverSnapshot"},
    {"op":"assert","source":"$vars.reaverSnapshot","path":"zealotCount","gte":1},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"Vulture","owner":1,"x":30.0,"y":30.0},"save":"vulture"},
    {"op":"call","fn":"douququ.vulture.consume","args":{"unit_tag":{"$ref":"vars.vulture.tag"},"count":2}},
    {"op":"call","fn":"douququ.player.set_minerals","args":{"owner":1,"minerals":50}},
    {"op":"call","fn":"douququ.vulture.refill","args":{"unit_tag":{"$ref":"vars.vulture.tag"}},"save":"refill"},
    {"op":"assert","source":"$vars.refill","path":"storedMines","equals":5},
    {"op":"assert","source":"$vars.refill","path":"minerals","equals":0},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"Vulture","owner":2,"x":115.0,"y":30.0},"save":"vultureVictim"},
    {"op":"call","fn":"douququ.kill","args":{"killer_tag":{"$ref":"vars.vulture.tag"},"victim_tag":{"$ref":"vars.vultureVictim.tag"}},"save":"vultureDeath"},
    {"op":"assert","source":"$vars.vultureDeath","path":"spawned.0","exists":true},
    {"op":"assert","source":"$vars.vultureDeath","path":"spawned.1","exists":true},
    {"op":"assert","source":"$vars.vultureDeath","path":"spawned.2","exists":true},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"InfestedBanshee","owner":1,"x":55.0,"y":35.0},"save":"banshee"},
    {"op":"call","fn":"douququ.unit.set_energy","args":{"unit_tag":{"$ref":"vars.banshee.tag"},"energy":20.0}},
    {"op":"call","fn":"douququ.tick","args":{"seconds":10.0},"save":"hatch"},
    {"op":"assert","source":"$vars.hatch","path":"spawned.0","exists":true},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"BroodLord","owner":1,"x":45.0,"y":90.0},"save":"broodlord"},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"CommandCenter","owner":2,"x":80.0,"y":90.0},"save":"broodTarget"},
    {"op":"call","fn":"douququ.attack","args":{"attacker_tag":{"$ref":"vars.broodlord.tag"},"target_tag":{"$ref":"vars.broodTarget.tag"}},"save":"broodAttack"},
    {"op":"assert","source":"$vars.broodAttack","path":"effect.triggered","equals":true},
    {"op":"call","fn":"douququ.snapshot","args":{},"save":"broodSnapshot"},
    {"op":"assert","source":"$vars.broodSnapshot","path":"banelingCount","gte":1},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"Hydralisk","owner":1,"x":90.0,"y":30.0},"save":"hydra"},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"Marine","owner":2,"x":108.0,"y":30.0},"save":"hydraTarget"},
    {"op":"call","fn":"douququ.unit.set_life","args":{"unit_tag":{"$ref":"vars.hydra.tag"},"life":20.0}},
    {"op":"call","fn":"douququ.kill","args":{"killer_tag":{"$ref":"vars.hydra.tag"},"victim_tag":{"$ref":"vars.hydraTarget.tag"}},"save":"hydraKill"},
    {"op":"assert","source":"$vars.hydraKill","path":"healed","equals":25.0},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"K5Kerrigan","owner":1,"x":90.0,"y":50.0},"save":"kerrigan"},
    {"op":"call","fn":"douququ.unit.spawn","args":{"unit_type":"Marine","owner":2,"x":115.0,"y":50.0},"save":"kerriganTarget"},
    {"op":"call","fn":"douququ.kill","args":{"killer_tag":{"$ref":"vars.kerrigan.tag"},"victim_tag":{"$ref":"vars.kerriganTarget.tag"}},"save":"kerriganKill"},
    {"op":"assert","source":"$vars.kerriganKill","path":"kerriganBroodlings.0","exists":true},
    {"op":"assert","source":"$vars.kerriganKill","path":"kerriganBroodlings.1","exists":true},
    {"op":"call","fn":"douququ.snapshot","args":{},"save":"finalSnapshot"},
    {"op":"assert","source":"$vars.finalSnapshot","path":"broodlingCount","gte":2},
    {"op":"call","fn":"douququ.runtime.reset_proc_chances","args":{},"save":"restoredProcChances"},
    {"op":"assert","source":"$vars.restoredProcChances","path":"reaverOrdinaryPercent","equals":20},
    {"op":"assert","source":"$vars.restoredProcChances","path":"broodLordPercent","equals":15}
  ]
}
