string libDouQuquRuntime_gf_UnitSetLife(string argsJson) { return libDouQuquRuntimeDisabled_gf_Reject("douququ.unit.set_life"); }
string libDouQuquRuntime_gf_PlayerSetMinerals(string argsJson) { return libDouQuquRuntimeDisabled_gf_Reject("douququ.player.set_minerals"); }
