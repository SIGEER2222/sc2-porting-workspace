include "LibVibeKernel_h"

// Fail-closed implementation used when the live VM module was not requested.
string libDouQuquRuntimeDisabled_gf_Reject(string functionId) {
    return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "PLUGIN_DISABLED", "{\"function_id\":\"" + functionId + "\",\"reason\":\"use -EnableDouQuquRuntime\"}");
}

string libDouQuquRuntime_gf_Status(string argsJson) { return libDouQuquRuntimeDisabled_gf_Reject("douququ.runtime.status"); }
string libDouQuquRuntime_gf_Reset(string argsJson) { return libDouQuquRuntimeDisabled_gf_Reject("douququ.reset"); }
string libDouQuquRuntime_gf_SetProcChances(string argsJson) { return libDouQuquRuntimeDisabled_gf_Reject("douququ.runtime.set_proc_chances"); }
