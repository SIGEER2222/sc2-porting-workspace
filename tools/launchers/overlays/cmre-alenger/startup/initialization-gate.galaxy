// CMRE_ON_DEMAND_INITIALIZATION_GATE
// Actions and Vibe RPCs are allowed only after the map startup path has
// finished and the declared starting structures/workers are present.
trigger gt_CmreOnDemandInitializationGate;

int gf_CmreOnDemandDebugInt(string key) {
    BankLoad("CMRERebornDebug", 1);
    if (BankLastCreated() == null) { return 0; }
    BankWait(BankLastCreated());
    return BankValueGetAsInt(BankLastCreated(), "debug", key);
}

int gf_CmreOnDemandAliveCount(string unitType, int player) {
    unitgroup lv_units;
    if ((unitType == "") || (!CatalogEntryIsValid(c_gameCatalogUnit, unitType))) { return 0; }
    lv_units = UnitGroup(unitType, player, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 1);
    return UnitGroupCount(lv_units, c_unitCountAlive);
}

int gf_CmreOnDemandOwnedAliveCount(int player) {
    unitgroup lv_units;
    lv_units = UnitGroup(null, player, RegionEntireMap(),
        UnitFilter(0, 0, 0,
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    return UnitGroupCount(lv_units, c_unitCountAlive);
}

bool gf_CmreOnDemandInitializationReady() {
    string lv_structureType = "";
    string lv_workerType = "";
    string lv_commanderRace = "";
    int lv_workerCount = 0;
    int lv_createP1 = 0;
    int lv_createP2 = 0;
    int lv_ensureP1 = 0;
    int lv_ensureP2 = 0;
    int lv_rebornHandled = 0;
    bool lv_buildingP1 = false;
    bool lv_buildingP2 = false;
    bool lv_unitsP1 = false;
    bool lv_unitsP2 = false;
    bool lv_rebornDirectReady = false;

    if (gf_CmreOnDemandDebugInt("map_init_entered") == 0) { return false; }
    // Direct Reborn launches do not pass through CMRE's saved-profile
    // startup, so startup_dev_finish remains zero even after the native
    // Reborn library and adapter have initialized successfully.
    lv_rebornDirectReady =
        (gf_CmreOnDemandDebugInt("initlib_patch_ran") != 0) &&
        (gf_CmreOnDemandDebugInt("reborn_adapter_initialized") != 0);
    if ((gf_CmreOnDemandDebugInt("startup_dev_finish") == 0) &&
        (!lv_rebornDirectReady)) { return false; }
    if (gf_CmreOnDemandDebugInt("runtime_listener_ready") == 0) { return false; }
    if (gf_CmreOnDemandDebugInt("world_cover_dialog_visible_p1") != 0) { return false; }

    lv_structureType = gf_CmreOnDemandProfileString("StartingStructure", "CommandCenter");
    lv_workerType = gf_CmreOnDemandProfileString("StartingWorker", "SCV");
    lv_commanderRace = gf_CmreOnDemandProfileString("CommanderRace", "");
    lv_workerCount = gf_CmreOnDemandProfileInt("WorkerCount");
    if (lv_workerCount <= 0) { lv_workerCount = 5; }
    lv_createP1 = gf_CmreOnDemandProfileInt("CreateStartingUnitsP1");
    lv_createP2 = gf_CmreOnDemandProfileInt("CreateStartingUnitsP2");
    lv_ensureP1 = gf_CmreOnDemandProfileInt("EnsurePreventDefeatP1");
    lv_ensureP2 = gf_CmreOnDemandProfileInt("EnsurePreventDefeatP2");
    lv_rebornHandled = gf_CmreOnDemandProfileInt("RebornStartingUnitsHandled");

    // Custom commander catalog IDs can be reported through their vanilla
    // runtime alias after API map loading. Prefer the explicit bridge marker
    // plus owned-unit presence, while retaining the exact catalog check when
    // it is available.
    lv_buildingP1 = (gf_CmreOnDemandAliveCount(lv_structureType, 1) > 0) ||
        (gf_CmreOnDemandDebugInt("bridge_prevent_defeat_p1") != 0) ||
        (gf_CmreOnDemandDebugInt("bridge_prevent_defeat_created_p1") != 0);
    lv_buildingP2 = (gf_CmreOnDemandAliveCount(lv_structureType, 2) > 0) ||
        (gf_CmreOnDemandDebugInt("bridge_prevent_defeat_p2") != 0) ||
        (gf_CmreOnDemandDebugInt("bridge_prevent_defeat_created_p2") != 0);
    if ((lv_ensureP1 != 0) && (!lv_buildingP1)) { return false; }
    if ((lv_ensureP2 != 0) && (!lv_buildingP2)) { return false; }

    lv_unitsP1 = true;
    lv_unitsP2 = true;
    if (lv_createP1 != 0) {
        lv_unitsP1 = (gf_CmreOnDemandDebugInt("bridge_starting_units_created_p1") != 0) &&
            (gf_CmreOnDemandOwnedAliveCount(1) >= lv_workerCount + 1);
    }
    if (lv_createP2 != 0) {
        lv_unitsP2 = (gf_CmreOnDemandDebugInt("bridge_starting_units_created_p2") != 0) &&
            (gf_CmreOnDemandOwnedAliveCount(2) >= lv_workerCount + 1);
    }
    if ((!lv_unitsP1) || (!lv_unitsP2)) { return false; }

    // Reborn Zerg performs an additional SwarmSetup phase after the adapter
    // creates the basic base/workers. Wait for its mission buildings too.
    if ((lv_rebornHandled != 0) && (lv_commanderRace == "Zerg")) {
        if (gf_CmreOnDemandDebugInt("zerg_starting_buildings_created_p1") == 0) { return false; }
        if ((lv_ensureP2 != 0) && (gf_CmreOnDemandDebugInt("zerg_starting_buildings_created_p2") == 0)) { return false; }
    }
    if ((lv_rebornHandled != 0) && (gf_CmreOnDemandDebugInt("reborn_adapter_initialized") == 0)) { return false; }
    return true;
}

bool gt_CmreOnDemandInitializationGate_Func(bool testConds, bool runActions) {
    int lv_createP1 = 0;
    int lv_createP2 = 0;
    int lv_ensureP1 = 0;
    int lv_ensureP2 = 0;
    if (testConds) { return true; }
    if (!runActions) { return true; }
    libMapModBridge_gf_WriteDebugBank("initialization_gate_started", 1);
    libMapModBridge_gf_WriteDebugBank("initialization_complete", 0);
    while (true) {
        if (gf_CmreOnDemandInitializationReady()) {
            // EVAL-020 honest gate. gf_CmreOnDemandInitializationReady() only
            // verifies P1/P2 ownership when the launch profile asked for it
            // (EnsurePreventDefeat* gates the building check at lines 79-80,
            // CreateStartingUnits* gates the owned-unit check at lines 84-91).
            // Writing all five "ready" markers = 1 unconditionally turned one
            // boolean into five restatements and let Stage 6 attempt-3 run
            // 192k loops against a player that owned nothing. Write each marker
            // to reflect the check that was actually performed, and publish an
            // explicit "checks skipped" witness so a reader can distinguish
            // "verified present" from "never checked". These are debug /
            // observability markers only; gameplay and the readiness gate
            // condition are unchanged.
            lv_createP1 = gf_CmreOnDemandProfileInt("CreateStartingUnitsP1");
            lv_createP2 = gf_CmreOnDemandProfileInt("CreateStartingUnitsP2");
            lv_ensureP1 = gf_CmreOnDemandProfileInt("EnsurePreventDefeatP1");
            lv_ensureP2 = gf_CmreOnDemandProfileInt("EnsurePreventDefeatP2");
            if (lv_ensureP1 != 0) {
                libMapModBridge_gf_WriteDebugBank("initialization_building_ready_p1", 1);
            } else {
                libMapModBridge_gf_WriteDebugBank("initialization_building_ready_p1", 0);
            }
            if (lv_ensureP2 != 0) {
                libMapModBridge_gf_WriteDebugBank("initialization_building_ready_p2", 1);
            } else {
                libMapModBridge_gf_WriteDebugBank("initialization_building_ready_p2", 0);
            }
            if (lv_createP1 != 0) {
                libMapModBridge_gf_WriteDebugBank("initialization_units_ready_p1", 1);
            } else {
                libMapModBridge_gf_WriteDebugBank("initialization_units_ready_p1", 0);
            }
            if (lv_createP2 != 0) {
                libMapModBridge_gf_WriteDebugBank("initialization_units_ready_p2", 1);
            } else {
                libMapModBridge_gf_WriteDebugBank("initialization_units_ready_p2", 0);
            }
            // 1 == "no P1 ownership check was performed", so a green
            // initialization_complete says nothing about whether P1 owns a
            // faction. run_live_rl.faction_precondition_failures is the
            // independent API-side witness for that case.
            if ((lv_createP1 == 0) && (lv_ensureP1 == 0)) {
                libMapModBridge_gf_WriteDebugBank("initialization_checks_skipped_p1", 1);
            } else {
                libMapModBridge_gf_WriteDebugBank("initialization_checks_skipped_p1", 0);
            }
            if ((lv_createP2 == 0) && (lv_ensureP2 == 0)) {
                libMapModBridge_gf_WriteDebugBank("initialization_checks_skipped_p2", 1);
            } else {
                libMapModBridge_gf_WriteDebugBank("initialization_checks_skipped_p2", 0);
            }
            libMapModBridge_gf_WriteDebugBank("initialization_complete", 1);
            libPortingObserver_gf_Publish("initialization_complete",
                "CMRE map initialization complete; starting structures and workers are present", false);
            return true;
        }
        Wait(0.25, c_timeReal);
    }
    return true;
}

void gt_CmreOnDemandInitializationGate_Init() {
    gt_CmreOnDemandInitializationGate = TriggerCreate("gt_CmreOnDemandInitializationGate_Func");
    TriggerExecute(gt_CmreOnDemandInitializationGate, false, true);
}
