// CMRE_ON_DEMAND_MAP_GLUE
trigger gt_CmreOnDemandDeadOfNightPoll;
trigger gt_CmreOnDemandCommanderStartingUnits;
trigger gt_CmreOnDemandRuntimeListener;
trigger gt_CmreOnDemandComputerAllyReady;
trigger gt_CmreOnDemandAllyChat;
string gv_CmreOnDemandAllyFallbackLastCommand = "";

void gf_CmreOnDemandWriteAllyDebugInt(string key, int value) {
    libMapModBridge_gf_WriteDebugBank("ally_" + key, value);
}

void gf_CmreOnDemandWriteAllyDebugString(string key, string value) {
    BankLoad("CMRERebornDebug", 1);
    BankWait(BankLastCreated());
    BankValueSetFromString(BankLastCreated(), "debug", "ally_" + key, value);
    BankSave(BankLastCreated());
}

void gf_CmreOnDemandAllyEcho(string message) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(message));
    gf_CmreOnDemandWriteAllyDebugString("fallback_last_signal", message);
    gf_CmreOnDemandWriteAllyDebugInt("fallback_signal_count", 1);
}

bool gf_CmreOnDemandAllyChatCommand(string chat) {
    string command;
    unitgroup p2Units;
    unitgroup enemyUnits;
    unit target;
    int p2Count;
    int enemyCount;

    if (StringFind(chat, "!ally ", false) != 1) { return true; }
    if (chat == gv_CmreOnDemandAllyFallbackLastCommand) { return true; }
    gv_CmreOnDemandAllyFallbackLastCommand = chat;
    command = StringWord(chat, 2);
    gf_CmreOnDemandWriteAllyDebugString("fallback_last_command", chat);
    gf_CmreOnDemandWriteAllyDebugString("fallback_last_mode", command);
    gf_CmreOnDemandWriteAllyDebugInt("fallback_command_count", 1);

    if (EventPlayer() != 1) {
        gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "rejected_non_p1");
        return true;
    }
    if (!PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupAlly, 1), 2)) {
        gf_CmreOnDemandAllyEcho("[Ally P2] Rejected: P2 is not allied to P1.");
        gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "rejected_not_allied");
        return true;
    }

    p2Units = UnitGroup(null, 2, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    p2Count = UnitGroupCount(p2Units, c_unitCountAlive);
    gf_CmreOnDemandWriteAllyDebugInt("fallback_p2_unit_count", p2Count);

    if (command == "status") {
        gf_CmreOnDemandAllyEcho("[Ally P2] Status: " + IntToString(p2Count) + " living units; mode=ready.");
        gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "status");
        return true;
    }
    if (command == "help" || command == "") {
        gf_CmreOnDemandAllyEcho("[Ally P2] Commands: follow, attack, defend, regroup, retreat, status, help.");
        gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "help");
        return true;
    }
    if ((command == "follow") || (command == "regroup") || (command == "defend") || (command == "retreat")) {
        UnitGroupIssueOrder(p2Units,
            OrderTargetingPoint(AbilityCommand("move", 0), PlayerStartLocation(1)),
            c_orderQueueReplace);
        gf_CmreOnDemandAllyEcho("[Ally P2] Acknowledged: " + command + ". Moving to P1 defense point.");
        gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "acknowledged");
        gf_CmreOnDemandWriteAllyDebugInt("fallback_order_issued", 1);
        return true;
    }
    if (command == "attack") {
        enemyUnits = UnitGroupAlliance(2, c_unitAllianceEnemy, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile),
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        enemyCount = UnitGroupCount(enemyUnits, c_unitCountAlive);
        gf_CmreOnDemandWriteAllyDebugInt("fallback_visible_enemy_count", enemyCount);
        if (enemyCount <= 0) {
            gf_CmreOnDemandAllyEcho("[Ally P2] Attack acknowledged, but no hostile target is visible.");
            gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "attack_no_target");
            return true;
        }
        target = UnitGroupClosestToPoint(enemyUnits, PlayerStartLocation(1));
        UnitGroupIssueOrder(p2Units,
            OrderTargetingUnit(AbilityCommand("attack", 0), target),
            c_orderQueueReplace);
        gf_CmreOnDemandAllyEcho("[Ally P2] Acknowledged: attack. P2 units engaging hostile target.");
        gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "attack_issued");
        gf_CmreOnDemandWriteAllyDebugInt("fallback_order_issued", 1);
        return true;
    }

    gf_CmreOnDemandAllyEcho("[Ally P2] Unknown command. Try: follow, attack, defend, regroup, retreat, status.");
    gf_CmreOnDemandWriteAllyDebugString("fallback_last_result", "rejected_unknown");
    return true;
}

bool gt_CmreOnDemandAllyChat_Func(bool testConds, bool runActions) {
    if (testConds) { return true; }
    if (!runActions) { return true; }
    return gf_CmreOnDemandAllyChatCommand(EventChatMessage(false));
}

void gt_CmreOnDemandAllyChat_Init() {
    gt_CmreOnDemandAllyChat = TriggerCreate("gt_CmreOnDemandAllyChat_Func");
    TriggerAddEventChatMessage(gt_CmreOnDemandAllyChat, c_playerAny, "!ally", false);
}

bool gt_CmreOnDemandComputerAllyReady_Func(bool testConds, bool runActions) {
    point lv_p2Start;
    string lv_p2Race;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    // Clear this run's native-ally contract before inspecting the live slot.
    // The Bank is persistent across launcher windows and must never provide
    // stale readiness evidence to the runtime probe.
    libVibeKernel_gf_WriteBankInt("ally", "computer_ally_ready", 0);
    libVibeKernel_gf_WriteBankInt("ally", "p2_start_point_available", 0);
    libVibeKernel_gf_WriteBankInt("ally", "p2_starting_units_initialized", 0);
    libVibeKernel_gf_WriteBankInt("ally", "p2_starting_resources_initialized", 0);
    libVibeKernel_gf_WriteBankInt("ally", "p2_native_ai_path", 0);
    gf_CmreOnDemandWriteAllyDebugInt("computer_ally_ready", 0);
    gf_CmreOnDemandWriteAllyDebugInt("p2_start_point_available", 0);
    gf_CmreOnDemandWriteAllyDebugInt("p2_starting_units_initialized", 0);
    gf_CmreOnDemandWriteAllyDebugInt("p2_starting_resources_initialized", 0);
    gf_CmreOnDemandWriteAllyDebugInt("p2_native_ai_path", 0);
    gf_CmreOnDemandWriteAllyDebugString("not_ready_reason", "checking");
    gf_CmreOnDemandWriteAllyDebugInt("p2_player_type", PlayerType(2));
    if (PlayerType(2) != c_playerTypeComputer) {
        gf_CmreOnDemandWriteAllyDebugString("not_ready_reason", "p2_not_computer");
        libPortingObserver_gf_Publish(
            "computer_ally_not_ready",
            "P2 is not a Computer slot; native ally AI is unavailable", false);
        return true;
    }

    // This map owns mission waves, but it has no native melee starting units
    // for the custom P2 Computer slot. Use the standard melee initializer so
    // P2 owns a real Command Center and workers before libCOMI starts the
    // existing AIMeleeStart(2) path. P1 remains owned by CMRE commander
    // startup and is intentionally not created here.
    lv_p2Start = PlayerStartLocation(2);
    lv_p2Race = PlayerRace(2);
    if ((lv_p2Race == "") || (lv_p2Race == "random")) {
        lv_p2Race = "Terr";
    }
    if (lv_p2Start == null) {
        gf_CmreOnDemandWriteAllyDebugString("not_ready_reason", "p2_start_point_missing");
        libVibeKernel_gf_WriteBankInt("ally", "p2_start_point_available", 0);
        libPortingObserver_gf_Publish(
            "computer_ally_not_ready",
            "P2 Computer has no map start point; native melee initialization skipped", false);
        return true;
    }
    MeleeInitUnitsForPlayer(2, lv_p2Race, lv_p2Start);
    MeleeInitResourcesForPlayer(2, lv_p2Race);
    gf_CmreOnDemandWriteAllyDebugInt("p2_start_point_available", 1);
    gf_CmreOnDemandWriteAllyDebugInt("p2_starting_units_initialized", 1);
    gf_CmreOnDemandWriteAllyDebugInt("p2_starting_resources_initialized", 1);
    libVibeKernel_gf_WriteBankInt("ally", "p2_start_point_available", 1);
    libVibeKernel_gf_WriteBankInt("ally", "p2_starting_units_initialized", 1);
    libVibeKernel_gf_WriteBankInt("ally", "p2_starting_resources_initialized", 1);

    // Dead of Night's existing LibCOMI setup owns AIMeleeStart(2). The
    // adapter starts the same native Computer AI explicitly after its real
    // melee opening exists. AIMeleeStart is idempotent with the map's later
    // setup call, so this remains a single P2-owned AI path.
    libNtve_gf_SetAlliance(1, 2,
        libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    libNtve_gf_SetAlliance(2, 1,
        libNtve_ge_AllianceSetting_AllyWithSharedVisionAndPushable);
    AIMeleeStart(2);
    gf_CmreOnDemandWriteAllyDebugInt("computer_ally_ready", 1);
    gf_CmreOnDemandWriteAllyDebugInt("p2_player_type", 2);
    gf_CmreOnDemandWriteAllyDebugInt("p2_native_ai_path", 1);
    gf_CmreOnDemandWriteAllyDebugInt("p2_unit_count", UnitGroupCount(UnitGroup(null, 2, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0), c_unitCountAlive));
    gf_CmreOnDemandWriteAllyDebugString("not_ready_reason", "none");
    libVibeKernel_gf_WriteBankInt("ally", "computer_ally_ready", 1);
    libVibeKernel_gf_WriteBankInt("ally", "p2_player_type", 2);
    libVibeKernel_gf_WriteBankInt("ally", "p2_native_ai_path", 1);
    libPortingObserver_gf_Publish(
        "computer_ally_ready",
        "P1 Participant + P2 Computer; native AIMeleeStart(2) path active", false);
    return true;
}

void gt_CmreOnDemandComputerAllyReady_Init() {
    gt_CmreOnDemandComputerAllyReady = TriggerCreate(
        "gt_CmreOnDemandComputerAllyReady_Func");
    // InitMap runs before the first playable frame. Defer until game time 0 so
    // PlayerType/PlayerStartLocation and the map's startup graph are live.
    TriggerAddEventTimeElapsed(gt_CmreOnDemandComputerAllyReady, 0.0, c_timeGame);
    // DirectMap startup can expose a live map without advancing the game-time
    // event queue. Execute once here so the native Computer slot is still
    // initialized and audited in that approved launcher topology.
    TriggerExecute(gt_CmreOnDemandComputerAllyReady, false, true);
}

int gf_CmreOnDemandProfileInt(string key) {
    BankLoad("CMCoopLaunchProfile", 1);
    BankWait(BankLastCreated());
    return BankValueGetAsInt(BankLastCreated(), "CMUI|LaunchProfile", key);
}

string gf_CmreOnDemandProfileString(string key, string fallback) {
    string value = "";
    BankLoad("CMCoopLaunchProfile", 1);
    BankWait(BankLastCreated());
    value = BankValueGetAsString(BankLastCreated(), "CMUI|LaunchProfile", key);
    if (value == "") { return fallback; }
    return value;
}

int gf_CmreOnDemandRemoveConfiguredVanilla(int player) {
    int count = gf_CmreOnDemandProfileInt("VanillaRemovalCount");
    int index = 1;
    int removed = 0;
    string unitType = "";
    for (index = 1; index <= count; index += 1) {
        unitType = gf_CmreOnDemandProfileString("VanillaRemoval|" + IntToString(index) + "|Type", "");
        removed += libMapModBridge_gf_RemoveAllUnitsOfType(player, unitType);
    }
    return removed;
}

bool gt_CmreOnDemandCommanderStartingUnits_Func(bool testConds, bool runActions) {
    string structureType = "";
    string workerType = "";
    int workerCount = 0;
    int removedP1 = 0;
    int removedP2 = 0;
    if (testConds) { return true; }
    if (!runActions) { return true; }
    if (gf_CmreOnDemandProfileInt("RebornStartingUnitsHandled") != 0) {
        libPortingObserver_gf_Publish("commander_starting_units_skip", "reborn mode: adapter owns starting units", false);
        return true;
    }
    Wait(5.0, c_timeReal);
    structureType = gf_CmreOnDemandProfileString("StartingStructure", "CommandCenter");
    workerType = gf_CmreOnDemandProfileString("StartingWorker", "SCV");
    workerCount = gf_CmreOnDemandProfileInt("WorkerCount");
    if (workerCount <= 0) { workerCount = 5; }
    if (gf_CmreOnDemandProfileInt("EnsurePreventDefeatP1") != 0) {
        libMapModBridge_gf_EnsurePreventDefeat(1, structureType);
    }
    if (gf_CmreOnDemandProfileInt("EnsurePreventDefeatP2") != 0) {
        libMapModBridge_gf_EnsurePreventDefeat(2, structureType);
    }
    if (gf_CmreOnDemandProfileInt("CreateStartingUnitsP1") != 0) {
        removedP1 = gf_CmreOnDemandRemoveConfiguredVanilla(1);
        libMapModBridge_gf_CreateStartingUnits(1, structureType, workerType, workerCount);
    }
    if (gf_CmreOnDemandProfileInt("CreateStartingUnitsP2") != 0) {
        removedP2 = gf_CmreOnDemandRemoveConfiguredVanilla(2);
        libMapModBridge_gf_CreateStartingUnits(2, structureType, workerType, workerCount);
    }
    libPortingObserver_gf_Publish("commander_starting_units_done",
        "structure=" + structureType + "; worker=" + workerType + "; worker_count=" + IntToString(workerCount) +
        "; removed_vanilla_p1=" + IntToString(removedP1) + "; removed_vanilla_p2=" + IntToString(removedP2), false);
    return true;
}

void gt_CmreOnDemandCommanderStartingUnits_Init() {
    gt_CmreOnDemandCommanderStartingUnits = TriggerCreate("gt_CmreOnDemandCommanderStartingUnits_Func");
    TriggerExecute(gt_CmreOnDemandCommanderStartingUnits, false, true);
}

bool gt_CmreOnDemandRuntimeListener_Func(bool testConds, bool runActions) {
    if (testConds) { return true; }
    if (!runActions) { return true; }
    libMapModBridge_gf_WriteDebugBank("runtime_listener_started", 1);
    libMapModBridge_gf_WriteDebugBank("runtime_listener_ready", 1);
    libMapModBridge_gf_StartHeartbeat();
    libPortingObserver_gf_Publish("runtime_listener_ready", "CMRE runtime listener and heartbeat are active", false);
    return true;
}

void gt_CmreOnDemandRuntimeListener_Init() {
    gt_CmreOnDemandRuntimeListener = TriggerCreate("gt_CmreOnDemandRuntimeListener_Func");
    TriggerExecute(gt_CmreOnDemandRuntimeListener, false, true);
}

bool gt_CmreOnDemandDeadOfNightPoll_Func(bool testConds, bool runActions) {
    int lv_primaryState = -1;
    int lv_bonusState = -1;
    if (testConds) { return true; }
    if (!runActions) { return true; }
    libPortingObserver_gf_Publish("poll_trigger_started", "DeadOfNight on-demand poll trigger is running", false);
    Wait(10.0, c_timeReal);
    while (true) {
        if (gv_objective_Primary_DestroyInfestation != c_invalidObjectiveId) {
            lv_primaryState = ObjectiveGetState(gv_objective_Primary_DestroyInfestation);
        }
        if (gv_objective_Bonus_DestroyInfestationSource != c_invalidObjectiveId) {
            lv_bonusState = ObjectiveGetState(gv_objective_Bonus_DestroyInfestationSource);
        }
        libDeadOfNightObserver_gf_Update(gv_dayORNight, gv_nightNumber,
            gv_infestedStructuresRemaining, gv_infestedStructuresTotal, lv_primaryState, lv_bonusState);
        libPortingObserver_gf_PublishPlayerInventory(1);
        Wait(1.0, c_timeReal);
        libPortingObserver_gf_PublishPlayerInventory(2);
        Wait(9.0, c_timeReal);
    }
    return true;
}

void gt_CmreOnDemandDeadOfNightPoll_Init() {
    gt_CmreOnDemandDeadOfNightPoll = TriggerCreate("gt_CmreOnDemandDeadOfNightPoll_Func");
    TriggerExecute(gt_CmreOnDemandDeadOfNightPoll, false, true);
}
