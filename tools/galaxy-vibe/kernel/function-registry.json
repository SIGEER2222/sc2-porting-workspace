{
  "version": "1.0",
  "description": "Explicit Vibe function registry. Only listed function IDs may be invoked.",
  "functions": {
    "vibe.test.ping": {
      "handler": "libVibeKernel_gf_FunctionVibeTestPing",
      "side_effect": false,
      "debug_only": false,
      "capability": "diagnostic",
      "args": {
        "nonce": {
          "type": "string",
          "required": false,
          "default": "",
          "maxLength": 64
        }
      },
      "returns": {
        "function_id": "string",
        "message": "string",
        "nonce": "string"
      }
    },
    "vibe.player.set_resource": {
      "handler": "libVibeKernel_gf_FunctionPlayerSetResource",
      "side_effect": true,
      "debug_only": true,
      "capability": "debug-injection",
      "args": {
        "player": {"type": "integer", "required": true, "min": 1, "max": 15},
        "resource": {"type": "string", "required": true, "enum": ["minerals", "vespene"]},
        "value": {"type": "integer", "required": true, "min": 0, "max": 999999}
      },
      "returns": {
        "function_id": "string",
        "player": "integer",
        "resource": "string",
        "value": "integer"
      }
    },
    "vibe.unit.spawn": {
      "handler": "libVibeKernel_gf_FunctionUnitSpawn",
      "side_effect": true,
      "debug_only": true,
      "capability": "debug-injection",
      "args": {
        "unit_type": {"type": "string", "required": true},
        "count": {"type": "integer", "required": true, "min": 1, "max": 200},
        "player": {"type": "integer", "required": true, "min": 1, "max": 15},
        "x": {"type": "fixed", "required": false, "default": 0.0},
        "y": {"type": "fixed", "required": false, "default": 0.0}
      },
      "returns": {
        "function_id": "string",
        "created": "integer",
        "unit_tag": "integer",
        "unit_type": "string",
        "player": "integer"
      }
    },
    "vibe.unit.spawn_group": {
      "handler": "libVibeKernel_gf_FunctionUnitSpawnGroup",
      "side_effect": true,
      "debug_only": true,
      "capability": "debug-injection",
      "args": {
        "unit_type": {"type": "string", "required": true, "maxLength": 128},
        "count": {"type": "integer", "required": true, "min": 1, "max": 200},
        "player": {"type": "integer", "required": true, "min": 1, "max": 15},
        "x": {"type": "fixed", "required": false, "default": 0.0},
        "y": {"type": "fixed", "required": false, "default": 0.0}
      },
      "returns": {
        "function_id": "string",
        "created": "integer",
        "unit_tags": "array",
        "unit_type": "string",
        "player": "integer"
      }
    },
    "vibe.unit.add_behavior": {
      "handler": "libVibeKernel_gf_FunctionUnitAddBehavior",
      "side_effect": true,
      "debug_only": true,
      "capability": "debug-injection",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "behavior": {"type": "string", "required": true, "maxLength": 128},
        "stacks": {"type": "integer", "required": true, "min": 1, "max": 100}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "behavior": "string",
        "stacks": "integer",
        "count": "integer"
      }
    },
    "vibe.unit.add_ability": {
      "handler": "libVibeKernel_gf_FunctionUnitAddAbility",
      "side_effect": true,
      "debug_only": true,
      "capability": "debug-injection",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "ability": {"type": "string", "required": true, "maxLength": 128}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "ability": "string",
        "has_ability": "boolean"
      }
    },
    "vibe.unit.query_ability": {
      "handler": "libVibeKernel_gf_FunctionUnitQueryAbility",
      "side_effect": false,
      "debug_only": false,
      "capability": "observation",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "ability": {"type": "string", "required": true, "maxLength": 128}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "ability": "string",
        "has_ability": "boolean"
      }
    },
    "vibe.unit.query_behavior": {
      "handler": "libVibeKernel_gf_FunctionUnitQueryBehavior",
      "side_effect": false,
      "debug_only": false,
      "capability": "observation",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "behavior": {"type": "string", "required": true, "maxLength": 128}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "behavior": "string",
        "count": "integer",
        "has_behavior": "boolean"
      }
    },
    "vibe.unit.set_vital": {
      "handler": "libVibeKernel_gf_FunctionUnitSetVital",
      "side_effect": true,
      "debug_only": true,
      "capability": "debug-injection",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "vital": {"type": "string", "required": true, "enum": ["life", "shield", "energy"]},
        "value": {"type": "fixed", "required": true, "min": 0.0, "max": 1000000.0}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "vital": "string",
        "value": "fixed"
      }
    },
    "vibe.unit.query_attrs": {
      "handler": "libVibeKernel_gf_FunctionUnitQueryAttrs",
      "side_effect": false,
      "debug_only": false,
      "capability": "observation",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "unit_type": "string",
        "life": "fixed",
        "max_life": "fixed",
        "shields": "fixed",
        "energy": "fixed",
        "armor": "fixed"
      }
    },
    "vibe.catalog.get": {
      "handler": "libVibeKernel_gf_FunctionCatalogGet",
      "side_effect": false,
      "debug_only": false,
      "capability": "catalog-observation",
      "args": {
        "catalog": {"type": "string", "required": true, "enum": ["unit", "abil", "behavior", "weapon", "effect", "upgrade", "button", "actor"]},
        "entry": {"type": "string", "required": true, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
        "field": {"type": "string", "required": true, "maxLength": 256, "pattern": "^[A-Za-z0-9_.\\[\\]-]+$"},
        "player": {"type": "integer", "required": false, "default": 0, "min": 0, "max": 15}
      },
      "returns": {
        "function_id": "string",
        "catalog": "string",
        "entry": "string",
        "field": "string",
        "player": "integer",
        "value": "string"
      }
    },
    "vibe.catalog.set": {
      "handler": "libVibeKernel_gf_FunctionCatalogSet",
      "side_effect": true,
      "debug_only": true,
      "capability": "catalog-mutation",
      "args": {
        "catalog": {"type": "string", "required": true, "enum": ["unit", "abil", "behavior", "weapon", "effect", "upgrade", "button", "actor"]},
        "entry": {"type": "string", "required": true, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
        "field": {"type": "string", "required": true, "maxLength": 256, "pattern": "^[A-Za-z0-9_.\\[\\]-]+$"},
        "player": {"type": "integer", "required": false, "default": 0, "min": 0, "max": 15},
        "value": {"type": "string", "required": true, "maxLength": 256}
      },
      "returns": {
        "function_id": "string",
        "catalog": "string",
        "entry": "string",
        "field": "string",
        "player": "integer",
        "old_value": "string",
        "value": "string"
      }
    },
    "vibe.visual.model_swap": {
      "handler": "libVibeKernel_gf_FunctionVisualModelSwap",
      "side_effect": true,
      "debug_only": true,
      "capability": "visual",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "model": {"type": "string", "required": true, "maxLength": 128},
        "variation": {"type": "integer", "required": false, "default": 0, "min": 0, "max": 255}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "model": "string",
        "variation": "integer",
        "applied": "boolean"
      }
    },
    "vibe.visual.set_scale": {
      "handler": "libVibeKernel_gf_FunctionVisualSetScale",
      "side_effect": true,
      "debug_only": true,
      "capability": "visual",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "scale": {"type": "fixed", "required": true, "min": 0.01, "max": 100.0}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "scale": "fixed",
        "applied": "boolean"
      }
    },
    "vibe.visual.set_tint": {
      "handler": "libVibeKernel_gf_FunctionVisualSetTint",
      "side_effect": true,
      "debug_only": true,
      "capability": "visual",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "color": {"type": "string", "required": true, "maxLength": 64}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "color": "string",
        "applied": "boolean"
      }
    },
    "vibe.visual.set_opacity": {
      "handler": "libVibeKernel_gf_FunctionVisualSetOpacity",
      "side_effect": true,
      "debug_only": true,
      "capability": "visual",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1},
        "opacity": {"type": "fixed", "required": true, "min": 0.0, "max": 1.0}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "opacity": "fixed",
        "applied": "boolean"
      }
    },
    "vibe.query.units": {
      "handler": "libVibeKernel_gf_FunctionQueryUnits",
      "side_effect": false,
      "debug_only": false,
      "capability": "observation",
      "args": {
        "player": {"type": "integer", "required": false, "default": 0, "min": 0, "max": 15},
        "unit_type": {"type": "string", "required": false, "default": ""}
      },
      "returns": {
        "function_id": "string",
        "count": "integer",
        "unit_type": "string",
        "player": "integer"
      }
    },
    "vibe.unit.kill": {
      "handler": "libVibeKernel_gf_FunctionUnitKill",
      "side_effect": true,
      "debug_only": true,
      "capability": "debug-injection",
      "args": {
        "unit_tag": {"type": "integer", "required": true, "min": 1}
      },
      "returns": {
        "function_id": "string",
        "unit_tag": "integer",
        "killed": "boolean"
      }
    },
    "vibe.unit.attack": {
      "handler": "libVibeKernel_gf_FunctionUnitAttack",
      "side_effect": true,
      "debug_only": false,
      "capability": "control",
      "args": {
        "attacker_tag": {"type": "integer", "required": true, "min": 1},
        "target_tag": {"type": "integer", "required": true, "min": 1}
      },
      "returns": {
        "function_id": "string",
        "attacker_tag": "integer",
        "target_tag": "integer",
        "target_owner": "integer",
        "target_type": "string",
        "issued": "boolean"
      }
    },
    "vibe.query.structures": {
      "handler": "libVibeKernel_gf_FunctionQueryStructures",
      "side_effect": false,
      "debug_only": false,
      "capability": "observation",
      "args": {
        "owner_player": {"type": "integer", "required": false, "default": 0, "min": 0, "max": 15},
        "unit_type": {"type": "string", "required": false, "default": ""}
      },
      "returns": {
        "function_id": "string",
        "owner_player": "integer",
        "unit_type": "string",
        "live_count": "integer",
        "structures": "array"
      }
    }
  }
}
