include "TriggerLibs/NativeLib"

// === LibVibeKernel: SC2 Vibe 框架的运行时 Kernel ===
// 职责：
//   1. 接收 Host 下发的 RPC 请求（Bank 轮询或聊天前缀 "!vibe"）
//   2. 解析 protocol_version/session_id/request_id/sequence/operation/args/checksum
//   3. 在白名单注册表中查找操作 handler
//   4. 校验参数、执行幂等检查
//   5. 调用对应 Galaxy 函数（spawn/kill/set_vital/set_resource/query/visual）
//   6. 将 ack/result/error 写入 GalaxyVibe.SC2Bank 供 Host 读取
//
// 设计原则（依据 sc2-vibe完整实施计划.md）：
//   - 不提供任意 call FuncName 能力（白名单 100% 拒绝未知操作）
//   - function.invoke 只允许 function-registry.json 中的显式 function_id
//   - 重复 request_id 返回原结果不重复执行（幂等）
//   - 过期 session/乱序/越界参数显式拒绝
//   - 状态版本号每次副作用递增

// ---- 全局状态 ----
bool   libVibeKernel_gv_initialized = false;
int    libVibeKernel_gv_stateVersion = 0;
string libVibeKernel_gv_currentSession = "";
int    libVibeKernel_gv_lastSequence = -1;
string libVibeKernel_gv_lastRequestId = "";
string libVibeKernel_gv_lastResponseJson = "";
int    libVibeKernel_gv_requestCount = 0;
int    libVibeKernel_gv_rejectedCount = 0;

// ---- unit tag 查找缓存 ----
// FindUnitByTag 原本是 O(15 玩家 × 全图单位) 全扫描。在刷兵潮地图（亡者之夜）
// 夜间单位量暴涨时，单次扫描会把触发线程顶到 Galaxy 操作上限而被静默 halt——
// 该请求于是永远不会写回响应，Host 侧表现为 TIMEOUT。
// 实测同一批 RPC 里 unit.spawn / handle.drop / vibe.unit.set_vital /
// vibe.visual.model_swap 间歇性挂死，白天秒回、夜里超时，就是这个原因。
// 这里加正/负双向记忆：连续对同一个 tag 的调用（query.unit → query.unit_attrs →
// set_vital → tint → scale → opacity 是典型序列）降为 O(1)；
// 对不存在的 tag 也记住，避免每次都白扫 15 个玩家。
int    libVibeKernel_gv_tagCacheTag = 0;
unit   libVibeKernel_gv_tagCacheUnit = null;
bool   libVibeKernel_gv_tagCacheMiss = false;
int    libVibeKernel_gv_tagCacheVersion = -1;

// ---- 触发器句柄 ----
trigger libVibeKernel_gt_ChatCommand = null;
trigger libVibeKernel_gt_AllyCommand = null;
trigger libVibeKernel_gt_BankPoll = null;
trigger libVibeKernel_gt_UnitWake = null;
trigger libVibeKernel_gt_PollLoop = null;
string libVibeKernel_gv_lastPolledRequestId = "";
string libVibeKernel_gv_lastAllyCommand = "";

// ---- 诊断计数器 ----
int libVibeKernel_gv_bankPollCount = 0;
int libVibeKernel_gv_mapCommandCount = 0;
bool libVibeKernel_gv_pollLoopRunning = false;
// VIBE_KERNEL_005：PollLoop 首帧是否已补过一次 BankSave（把 init 阶段缓冲在
// 内存里的标记逼着落盘）。必须夹在 ReloadBank 与首次 ReadBankKey 之间，
// 否则连续两次 BankReload 会用空磁盘覆盖内存态、抹掉全部 init 标记。
bool libVibeKernel_gv_pollLoopFirstFlushed = false;

// ---- 看门狗（VIBE-KERNEL-001）----
// Galaxy 运行时错误会中止整条触发器线程；PollLoop 的 while(true) 一旦被中止，
// Kernel 在本局余下时间彻底失联。Watchdog 自身从不调用 Dispatch，因此不会被
// handler 的错误波及，可以安全地把 PollLoop 重新拉起来。

// ---- Bank 名称 ----
const string libVibeKernel_gv_BankName = "GalaxyVibe";
const int    libVibeKernel_gv_BankPlayer = 1;
const string libVibeKernel_gv_BankSection = "rpc";

// ==== BEGIN VIBE_GEN_007_BANK_CHANNEL_SPLIT ====
// N1 架构级治本（2026-08-09）：Bank RPC 是「双写单文件、全量覆盖、无锁」的有损通道。
// 内核每次 BankSave 都会把**整个内存态**刷回同一个 GalaxyVibe.SC2Bank，
// 于是 Host 在 ReloadBank 之后、下次 BankSave 之前落盘的请求会被整份抹掉。
// 真机 A/B 已证：单点补 ReloadBank 无效（重发是通道固有竞态方差，已 ABANDONED 回退）。
//
// 真正治本 = **按通道分库**：把与 RPC 无关的高频模型快照（p2_* 经济计数）
// 挪到独立的 GalaxyVibeModel.SC2Bank，使 WriteModelP2Snapshot 的 BankSave
// 只写模型库、**绝不再覆盖** Host 写入 GalaxyVibe 的 RPC 请求/响应。
// 这样 RPC 库的 BankSave 只剩「写 response / index」这一类必需写入，
// 覆盖窗口从「整个 handler 时长」收敛到「仅响应落盘瞬间」。
//
// 先例佐证：本代码库早已并存两个 bank 名（GalaxyVibe / CMRERebornDebug），
// BankLoad 对未存在的 bank 会直接新建，无需在地图里预声明。
const string libVibeKernel_gv_ModelBankName = "GalaxyVibeModel";
// ==== END VIBE_GEN_007_BANK_CHANNEL_SPLIT ====

// ---- Bank handle ----
// 读取 Host 外部写入时必须先 BankRemove，再 BankLoad 重新加载磁盘内容。
// 写入路径不能每个 key 都 reload，否则连续写入会丢失同一响应里的其他 key。
bank   libVibeKernel_gv_bankHandle = null;
// 模型库 handle（与 RPC handle 完全独立，遵循同一套 VIBE_KERNEL_003 缓存语义）。
bank   libVibeKernel_gv_modelBankHandle = null;

