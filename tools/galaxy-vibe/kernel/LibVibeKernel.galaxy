include "TriggerLibs/NativeLib"
include "LibVibeKernel_h"
// Stage26: LibVibeHandles provides the handle registry used by the HANDLE_OPS
// dispatch below. It depends only on libVibeKernel_gf_FindUnitByTag, so declare
// that before including it to satisfy Galaxy's prior-declaration rule.
unit libVibeKernel_gf_FindUnitByTag(int unitTag);
include "LibVibeHandles"

// === LibVibeKernel: SC2 Vibe 框架运行时 Kernel 实现 ===
// 依据 sc2-vibe完整实施计划.md 的 RPC 契约与 MVP 操作集
//
// 通信流程：
//   1. Host 将请求 JSON 写入 Bank(GalaxyVibe, section="request", key=request_id)
//   2. Host 通过 Bank 轮询或聊天 "!vibe <args>" 触发
//   3. Kernel 从 Bank 读取请求，解析 operation/args
//   4. Kernel 在白名单中查找 handler 并执行
//   5. Kernel 将响应 JSON 写入 Bank(section="response", key=request_id)
//   6. Host 轮询 Bank 读取响应

// ---- 最小字符串/参数解析工具 ----
// args 格式：key1=value1;key2=value2;...
// 简单的线性扫描解析器，避免 Galaxy JSON 解析的复杂性

// 简单 trim：去掉首尾空格（Galaxy 无原生 StringTrim）
string libVibeKernel_gf_Trim(string s) {
    int len;
    int start;
    int end;
    len = StringLength(s);
    start = 1;
    end = len;
    while (start <= end && StringSub(s, start, start) == " ") {
        start += 1;
    }
    while (end >= start && StringSub(s, end, end) == " ") {
        end -= 1;
    }
    if (start > end) { return ""; }
    return StringSub(s, start, end);
}

string libVibeKernel_gf_ArgsGet(string args, string key) {
    string search;
    int findPos;
    int valStart;
    int end;
    search = key + "=";
    findPos = StringFind(args, search, false);
    if (findPos < 0) { return ""; }
    valStart = findPos + StringLength(search);
    end = StringFind(StringSub(args, valStart, StringLength(args)), ";", false);
    if (end < 0) {
        return StringSub(args, valStart, StringLength(args));
    }
    // StringFind is 1-based and StringSub's end index is inclusive.
    // Exclude the delimiter itself from the parsed value.
    return StringSub(args, valStart, valStart + end - 2);
}

int libVibeKernel_gf_ArgsGetInt(string args, string key) {
    string v;
    v = libVibeKernel_gf_ArgsGet(args, key);
    if (v == "") { return 0; }
    return StringToInt(v);
}

fixed libVibeKernel_gf_ArgsGetFixed(string args, string key) {
    string v;
    v = libVibeKernel_gf_ArgsGet(args, key);
    if (v == "") { return 0.0; }
    return StringToFixed(v);
}

// UnitGetTag returns a runtime tag; UnitFromId expects an editor unit id.
unit libVibeKernel_gf_FindUnitByTag(int unitTag) {
    int ownerPlayer;
    int index;
    int total;
    unitgroup candidates;
    unit current;
    if (unitTag < 1) { return null; }

    // 缓存命中（同一 stateVersion 内有效；任何改状态的算子都会 +1 使其失效）
    if (libVibeKernel_gv_tagCacheVersion == libVibeKernel_gv_stateVersion
        && libVibeKernel_gv_tagCacheTag == unitTag) {
        if (libVibeKernel_gv_tagCacheMiss) { return null; }
        if (libVibeKernel_gv_tagCacheUnit != null
            && UnitIsAlive(libVibeKernel_gv_tagCacheUnit)
            && UnitGetTag(libVibeKernel_gv_tagCacheUnit) == unitTag) {
            return libVibeKernel_gv_tagCacheUnit;
        }
    }

    for (ownerPlayer = 1; ownerPlayer <= 15; ownerPlayer += 1) {
        candidates = UnitGroup(null, ownerPlayer, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        total = UnitGroupCount(candidates, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(candidates, index);
            if (current != null && UnitIsAlive(current) && UnitGetTag(current) == unitTag && UnitGetType(current) != "") {
                libVibeKernel_gv_tagCacheTag = unitTag;
                libVibeKernel_gv_tagCacheUnit = current;
                libVibeKernel_gv_tagCacheMiss = false;
                libVibeKernel_gv_tagCacheVersion = libVibeKernel_gv_stateVersion;
                return current;
            }
        }
    }

    // 负缓存：记住「这个 tag 在本 stateVersion 下确实不存在」，
    // 避免同一批 RPC 里对同一个无效 tag 反复做 15 玩家全图扫描。
    libVibeKernel_gv_tagCacheTag = unitTag;
    libVibeKernel_gv_tagCacheUnit = null;
    libVibeKernel_gv_tagCacheMiss = true;
    libVibeKernel_gv_tagCacheVersion = libVibeKernel_gv_stateVersion;
    return null;
}

// ---- Bank 工具 ----
// SC2 会缓存已加载的 Bank。Host 从进程外改写 SC2Bank 文件后，
// game-side 读取路径必须先卸载旧 handle 再 BankLoad，才能看到新 pending_request_id。
// 写入路径只 EnsureBankLoaded，避免连续写 response/index key 时 reload 丢失内存中尚未保存的键。
// ==== BEGIN VIBE_KERNEL_003_HANDLE_CACHE ====
// 【2026-08-09 真机 L1/L2/L2a 三点对照推翻旧「绝不缓存」铁律，勿再改回无条件 BankLoad】
//
// 旧写法（VIBE_KERNEL_003_NO_HANDLE_CACHE）在每次读写前无条件执行
//     gv_bankHandle = BankLoad(name, player);
// 真机后果：InitMap 同步阶段（InitLib / Init / RegisterEntryPoints）BankLoad 返回 null，
// 这一行会把**上一次已经拿到的有效 handle 覆盖成 null**，紧接着的
// `if (handle == null) { return; }` 直接吞掉写入 —— 整个初始化阶段的 Bank 键全部静默丢失。
// 而 Wait 之后的异步线程（PollLoop / Watchdog / AllySnapshot）BankLoad 能拿到 handle，
// 所以表现极具迷惑性：watchdog_last_seen_poll 每 2 秒正常递增，
// init_entered / initlib_entered / kernel_initialized / register_entrypoints_* 一个都没有，
// 看起来像「MapScript 被静默丢弃」，其实内核跑得好好的。
//
// 真机三点对照（同一 SC2 会话 PID 3556，API 模式，channels=bank）：
//   L1  地图自带内核（缓存语义）+ Common + 空 active + 299 前置原型 → P0 PASS（6/6 标记命中）
//   L2  工作区内核（无条件 BankLoad + UIDisplayMessage 诊断）        → P0 FAIL（bank_keys=5，只有 watchdog/ally）
//   L2a 工作区内核（无条件 BankLoad，删掉 UIDisplayMessage）         → P0 FAIL（同上）
//   ⇒ UIDisplayMessage 无关；唯一自变量 = handle 是否被无条件覆盖。
//
// 缓存语义本身自带重试：handle 为 null 时每次都会再 BankLoad，
// 所以「早期拿不到就永远拿不到」的担心不成立（真机 L1 已证）。
// 真正强制重读磁盘的是 BankReload，只放在下行读取路径 ReloadBank 里。
void libVibeKernel_gf_ReloadBank() {
    if (libVibeKernel_gv_bankHandle == null) {
        libVibeKernel_gv_bankHandle = BankLoad(libVibeKernel_gv_BankName, libVibeKernel_gv_BankPlayer);
    } else {
        BankReload(libVibeKernel_gv_bankHandle);
    }
    if (libVibeKernel_gv_bankHandle != null) {
        BankWait(libVibeKernel_gv_bankHandle);
    }
}

void libVibeKernel_gf_EnsureBankLoaded() {
    if (libVibeKernel_gv_bankHandle == null) {
        libVibeKernel_gv_bankHandle = BankLoad(libVibeKernel_gv_BankName, libVibeKernel_gv_BankPlayer);
        if (libVibeKernel_gv_bankHandle != null) {
            BankWait(libVibeKernel_gv_bankHandle);
        }
    }
}
// ==== END VIBE_KERNEL_003_HANDLE_CACHE ====

// ==== BEGIN VIBE_GEN_007_BANK_CHANNEL_SPLIT ====
// 模型库（GalaxyVibeModel）专用加载/写入路径。与 RPC 库 handle 完全独立，
// 因此 WriteModelP2Snapshot 的 BankSave 只刷模型库的内存态到 GalaxyVibeModel.SC2Bank，
// **不会**把内核内存态整份刷回 GalaxyVibe.SC2Bank、抹掉 Host 刚落盘的 RPC 请求。
//
// 缓存语义与 VIBE_KERNEL_003 完全一致：handle 为 null 时才 BankLoad（自带重试），
// 绝不无条件覆盖已有 handle（否则 InitMap 同步阶段会把有效 handle 打成 null）。
// 模型库是纯上行（内核写、Host 读），没有下行读取需求，故不提供 Reload 路径。
void libVibeKernel_gf_EnsureModelBankLoaded() {
    if (libVibeKernel_gv_modelBankHandle == null) {
        libVibeKernel_gv_modelBankHandle =
            BankLoad(libVibeKernel_gv_ModelBankName, libVibeKernel_gv_BankPlayer);
        if (libVibeKernel_gv_modelBankHandle != null) {
            BankWait(libVibeKernel_gv_modelBankHandle);
        }
    }
}

void libVibeKernel_gf_WriteModelBankInt(string section, string key, int value) {
    libVibeKernel_gf_EnsureModelBankLoaded();
    if (libVibeKernel_gv_modelBankHandle == null) { return; }
    BankValueSetFromInt(libVibeKernel_gv_modelBankHandle, section, key, value);
    BankSave(libVibeKernel_gv_modelBankHandle);
}
// ==== END VIBE_GEN_007_BANK_CHANNEL_SPLIT ====

void libVibeKernel_gf_WriteBankKey(string section, string key, string value) {
    libVibeKernel_gf_EnsureBankLoaded();
    if (libVibeKernel_gv_bankHandle == null) { return; }
    BankValueSetFromString(libVibeKernel_gv_bankHandle, section, key, value);
    BankSave(libVibeKernel_gv_bankHandle);
}

string libVibeKernel_gf_ReadBankKey(string section, string key) {
    libVibeKernel_gf_ReloadBank();
    if (libVibeKernel_gv_bankHandle == null) { return ""; }
    return BankValueGetAsString(libVibeKernel_gv_bankHandle, section, key);
}

void libVibeKernel_gf_WriteBankInt(string section, string key, int value) {
    libVibeKernel_gf_EnsureBankLoaded();
    if (libVibeKernel_gv_bankHandle == null) { return; }
    BankValueSetFromInt(libVibeKernel_gv_bankHandle, section, key, value);
    BankSave(libVibeKernel_gv_bankHandle);
}

int libVibeKernel_gf_ReadBankInt(string section, string key) {
    libVibeKernel_gf_ReloadBank();
    if (libVibeKernel_gv_bankHandle == null) { return 0; }
    return BankValueGetAsInt(libVibeKernel_gv_bankHandle, section, key);
}

void libVibeKernel_gf_EchoChat(string message) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(message));
}

void libVibeKernel_gf_EchoAlly(string message) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(message));
    libVibeKernel_gf_WriteBankKey("ally", "last_signal", message);
    libVibeKernel_gf_WriteBankInt("ally", "signal_count",
        libVibeKernel_gf_ReadBankInt("ally", "signal_count") + 1);
}

// ---- Session 与幂等检查 ----
bool libVibeKernel_gf_CheckSession(string sessionId) {
    if (sessionId == "") { return false; }
    if (libVibeKernel_gv_currentSession == "") {
        libVibeKernel_gv_currentSession = sessionId;
        return true;
    }
    return libVibeKernel_gv_currentSession == sessionId;
}

bool libVibeKernel_gf_CheckIdempotency(string requestId) {
    string existing;
    // 检查 Bank 中是否已有该 request_id 的响应
    existing = libVibeKernel_gf_ReadBankKey("response", requestId);
    if (existing != "") {
        // 已处理过，返回缓存结果
        libVibeKernel_gv_lastRequestId = requestId;
        libVibeKernel_gv_lastResponseJson = existing;
        return false;
    }
    return true;
}

// ---- 响应生成 ----
string libVibeKernel_gf_MakeResponse(string kind, string sessionId, string requestId, int sequence, string operation, string errorCode, string payloadJson) {
    string resp;
    // 紧凑 JSON 格式（Galaxy 字符串拼接）
    resp = "{";
    resp = resp + "\"kind\":\"" + kind + "\",";
    resp = resp + "\"protocol_version\":\"vibe/1.0\",";
    resp = resp + "\"session_id\":\"" + sessionId + "\",";
    resp = resp + "\"request_id\":\"" + requestId + "\",";
    resp = resp + "\"sequence\":" + IntToString(sequence) + ",";
    resp = resp + "\"operation\":\"" + operation + "\",";
    resp = resp + "\"error_code\":\"" + errorCode + "\",";
    resp = resp + "\"payload\":" + payloadJson + ",";
    resp = resp + "\"state_version\":" + IntToString(libVibeKernel_gv_stateVersion);
    resp = resp + "}";
    return resp;
}

void libVibeKernel_gf_WriteResponseToBank(string requestId, string responseJson) {
    libVibeKernel_gf_WriteBankKey("response", requestId, responseJson);
    // 同时更新 last-request 索引（供 Host 快速查询最新响应）
    libVibeKernel_gf_WriteBankKey("index", "last_request_id", requestId);
    libVibeKernel_gf_WriteBankInt("index", "state_version", libVibeKernel_gv_stateVersion);
}

// ---- 操作 handler 实现 ----

string libVibeKernel_gf_HandleSystemPing(string argsJson) {
    string payload;
    // ping 不产生副作用，不递增 state_version
    payload = "{\"pong\":true,\"request_count\":" + IntToString(libVibeKernel_gv_requestCount) + ",\"rejected_count\":" + IntToString(libVibeKernel_gv_rejectedCount) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "system.ping", "OK", payload);
}

string libVibeKernel_gf_HandleScenarioReset(string argsJson) {
    int lv_p;
    unitgroup lv_units;
    unit lv_u;
    int lv_killed;
    string payload;
    // 杀死所有非 PreventDefeat 单位（保留 PreventDefeat 单位避免任务失败）
    lv_p = 1;
    lv_killed = 0;
    for (lv_p = 1; lv_p <= 15; lv_p += 1) {
        lv_units = UnitGroup(null, lv_p, RegionEntireMap(),
            UnitFilter(0, (1 << c_targetFilterPreventDefeat), 0,
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        while (UnitGroupCount(lv_units, c_unitCountAlive) > 0) {
            lv_u = UnitGroupUnit(lv_units, 1);
            if (lv_u != null) {
                UnitRemove(lv_u);
                lv_killed += 1;
            } else {
                break;
            }
        }
    }
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"killed\":" + IntToString(lv_killed) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "scenario.reset", "OK", payload);
}

string libVibeKernel_gf_HandleUnitSpawn(string argsJson) {
    string unitType;
    int count;
    int player;
    fixed x;
    fixed y;
    point spawnPoint;
    unitgroup createdGroup;
    int created;
    string payload;
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");
    count = libVibeKernel_gf_ArgsGetInt(argsJson, "count");
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    x = libVibeKernel_gf_ArgsGetFixed(argsJson, "x");
    y = libVibeKernel_gf_ArgsGetFixed(argsJson, "y");

    // 参数校验
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "INVALID_ARGS", "{}");
    }
    if (count < 1 || count > 200) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "COUNT_OUT_OF_RANGE", "{}");
    }
    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "PLAYER_OUT_OF_RANGE", "{}");
    }

    if (x != 0.0 || y != 0.0) {
        spawnPoint = Point(x, y);
    } else {
        spawnPoint = PlayerStartLocation(player);
    }
    if (spawnPoint == null) {
        spawnPoint = Point(0.0, 0.0);
    }

    createdGroup = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, player, spawnPoint, 270.0);
    created = UnitGroupCount(createdGroup, c_unitCountAlive);
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"created\":" + IntToString(created) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "OK", payload);
}

string libVibeKernel_gf_HandleUnitKill(string argsJson) {
    int player;
    string unitType;
    string allFlag;
    unitgroup lv_units;
    unit lv_u;
    int lv_killed;
    int lv_i;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");
    allFlag = libVibeKernel_gf_ArgsGet(argsJson, "all");

    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.kill", "PLAYER_OUT_OF_RANGE", "{}");
    }

    lv_killed = 0;

    if (allFlag == "1" || allFlag == "true") {
        // 杀死所有玩家单位（保留 PreventDefeat）
        for (lv_i = 1; lv_i <= 15; lv_i += 1) {
            lv_units = UnitGroup(null, lv_i, RegionEntireMap(),
                UnitFilter(0, (1 << c_targetFilterPreventDefeat), 0,
                    (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
            while (UnitGroupCount(lv_units, c_unitCountAlive) > 0) {
                lv_u = UnitGroupUnit(lv_units, 1);
                if (lv_u != null) {
                    UnitKill(lv_u);
                    lv_killed += 1;
                } else {
                    break;
                }
            }
        }
    } else {
        if (unitType != "" && !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
            return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.kill", "INVALID_ARGS", "{}");
        }
        lv_units = UnitGroup(unitType, player, RegionEntireMap(),
            UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        while (UnitGroupCount(lv_units, c_unitCountAlive) > 0) {
            lv_u = UnitGroupUnit(lv_units, 1);
            if (lv_u != null) {
                UnitKill(lv_u);
                lv_killed += 1;
            } else {
                break;
            }
        }
    }

    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"killed\":" + IntToString(lv_killed) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.kill", "OK", payload);
}

string libVibeKernel_gf_HandleUnitSetVital(string argsJson) {
    int unitTag;
    string vital;
    fixed value;
    unit lv_u;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    vital = libVibeKernel_gf_ArgsGet(argsJson, "vital");
    value = libVibeKernel_gf_ArgsGetFixed(argsJson, "value");

    lv_u = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "UNIT_NOT_FOUND", "{}");
    }
    if (value < 0.0 || value > 1000000.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "VITAL_OUT_OF_RANGE", "{}");
    }

    if (vital == "life") {
        UnitSetPropertyFixed(lv_u, c_unitPropLife, value);
    } else if (vital == "shield") {
        UnitSetPropertyFixed(lv_u, c_unitPropShields, value);
    } else if (vital == "energy") {
        UnitSetPropertyFixed(lv_u, c_unitPropEnergy, value);
    } else {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "INVALID_ARGS", "{}");
    }

    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"vital\":\"" + vital + "\",\"value\":" + FixedToString(value, 2) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "OK", payload);
}

string libVibeKernel_gf_HandlePlayerSetResource(string argsJson) {
    int player;
    string resource;
    int value;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    resource = libVibeKernel_gf_ArgsGet(argsJson, "resource");
    value = libVibeKernel_gf_ArgsGetInt(argsJson, "value");

    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "PLAYER_OUT_OF_RANGE", "{}");
    }
    if (value < 0 || value > 999999) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "RESOURCE_OUT_OF_RANGE", "{}");
    }

    if (resource == "minerals") {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, value);
    } else if (resource == "vespene") {
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, value);
    } else if (resource == "supply") {
        PlayerModifyPropertyInt(player, c_playerPropSuppliesMade, c_playerPropOperSetTo, value);
    } else {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "INVALID_ARGS", "{}");
    }

    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"player\":" + IntToString(player) + ",\"resource\":\"" + resource + "\",\"value\":" + IntToString(value) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnits(string argsJson) {
    int player;
    string unitType;
    unitgroup lv_units;
    int count;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");

    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.units", "PLAYER_OUT_OF_RANGE", "{}");
    }

    lv_units = UnitGroup(unitType, player, RegionEntireMap(),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    count = UnitGroupCount(lv_units, c_unitCountAlive);

    // 不产生副作用，不递增 state_version
    payload = "{\"count\":" + IntToString(count) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.units", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnit(string argsJson) {
    int unitTag;
    unit lv_u;
    fixed life;
    fixed shields;
    fixed energy;
    int owner;
    string typeName;
    point pos;
    fixed px;
    fixed py;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    lv_u = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit", "UNIT_NOT_FOUND", "{}");
    }

    life = UnitGetPropertyFixed(lv_u, c_unitPropLife, true);
    shields = UnitGetPropertyFixed(lv_u, c_unitPropShields, true);
    energy = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, true);
    owner = UnitGetOwner(lv_u);
    typeName = UnitGetType(lv_u);
    pos = null;
    px = 0.0;
    py = 0.0;
    if (owner >= 0) {
        pos = UnitGetPosition(lv_u);
        if (pos != null) {
            px = PointGetX(pos);
            py = PointGetY(pos);
        }
    }

    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"type\":\"" + typeName + "\",\"owner\":" + IntToString(owner) + ",\"life\":" + FixedToString(life, 2) + ",\"shields\":" + FixedToString(shields, 2) + ",\"energy\":" + FixedToString(energy, 2) + ",\"x\":" + FixedToString(px, 2) + ",\"y\":" + FixedToString(py, 2) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit", "OK", payload);
}

string libVibeKernel_gf_HandleQueryMission(string argsJson) {
    int lv_p;
    string players;
    int minerals;
    int vespene;
    int supplyUsed;
    int supplyCap;
    string payload;
    players = "[";
    for (lv_p = 1; lv_p <= 15; lv_p += 1) {
        if (PlayerStatus(lv_p) == c_playerStatusActive) {
            if (StringLength(players) > 1) { players = players + ","; }
            players = players + IntToString(lv_p);
        }
    }
    players = players + "]";

    minerals = PlayerGetPropertyInt(1, c_playerPropMinerals);
    vespene = PlayerGetPropertyInt(1, c_playerPropVespene);
    supplyUsed = PlayerGetPropertyInt(1, c_playerPropSuppliesUsed);
    supplyCap = PlayerGetPropertyInt(1, c_playerPropSuppliesMade);

    payload = "{\"active_players\":" + players + ",\"mission_time\":" + FixedToString(GameGetMissionTime(), 2) + ",\"p1_minerals\":" + IntToString(minerals) + ",\"p1_vespene\":" + IntToString(vespene) + ",\"p1_supply_used\":" + IntToString(supplyUsed) + ",\"p1_supply_cap\":" + IntToString(supplyCap) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.mission", "OK", payload);
}

string libVibeKernel_gf_HandleVisualActorTint(string argsJson) {
    int unitTag;
    string colorStr;
    unit lv_u;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    colorStr = libVibeKernel_gf_ArgsGet(argsJson, "color");

    lv_u = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_tint", "UNIT_NOT_FOUND", "{}");
    }

    // ActorScopeSend 设置单位 tint（colorStr 格式 R,G,B 或 hex）
    ActorScopeSend(ActorScopeFromUnit(lv_u), "SetTintColor {" + colorStr + "}");
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"color\":\"" + colorStr + "\"}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_tint", "OK", payload);
}

string libVibeKernel_gf_HandleVisualActorScale(string argsJson) {
    int unitTag;
    fixed scale;
    unit lv_u;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    scale = libVibeKernel_gf_ArgsGetFixed(argsJson, "scale");

    lv_u = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_scale", "UNIT_NOT_FOUND", "{}");
    }
    if (scale < 0.01 || scale > 100.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_scale", "VITAL_OUT_OF_RANGE", "{}");
    }

    ActorScopeSend(ActorScopeFromUnit(lv_u), "SetScale {" + FixedToString(scale, 3) + "}");
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"scale\":" + FixedToString(scale, 3) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_scale", "OK", payload);
}

string libVibeKernel_gf_HandleVisualActorOpacity(string argsJson) {
    int unitTag;
    fixed opacity;
    unit lv_u;
    int opacityPct;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    opacity = libVibeKernel_gf_ArgsGetFixed(argsJson, "opacity");

    lv_u = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_opacity", "UNIT_NOT_FOUND", "{}");
    }
    if (opacity < 0.0 || opacity > 1.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_opacity", "VITAL_OUT_OF_RANGE", "{}");
    }

    // opacity 0-1 -> 0-100 for actor
    opacityPct = FixedToInt(opacity * 100.0);
    ActorScopeSend(ActorScopeFromUnit(lv_u), "SetOpacity {" + IntToString(opacityPct) + "}");
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"opacity\":" + FixedToString(opacity, 3) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_opacity", "OK", payload);
}

// ---- Explicit function registry handlers ----
// This is the Galaxy-side implementation map for function-registry.json.
// Keep this explicit: function IDs must never become arbitrary function names.
string libVibeKernel_gf_FunctionVibeTestPing(string argsJson) {
    string nonce;
    nonce = libVibeKernel_gf_ArgsGet(argsJson, "arg_nonce");
    return "{\"function_id\":\"vibe.test.ping\",\"message\":\"pong\",\"nonce\":\"" + nonce + "\"}";
}

string libVibeKernel_gf_FunctionPlayerSetResource(string argsJson) {
    int player;
    string resource;
    int value;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    resource = libVibeKernel_gf_ArgsGet(argsJson, "arg_resource");
    value = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_value");
    if (player < 1 || player > 15 || (resource != "minerals" && resource != "vespene") || value < 0 || value > 999999) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    if (resource == "minerals") {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, value);
    } else {
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, value);
    }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.player.set_resource\",\"player\":" + IntToString(player) + ",\"resource\":\"" + resource + "\",\"value\":" + IntToString(value) + "}");
}

string libVibeKernel_gf_FunctionUnitSpawn(string argsJson) {
    string unitType;
    int count;
    int player;
    fixed x;
    fixed y;
    point spawnPoint;
    unitgroup createdGroup;
    unit createdUnit;
    int created;
    int unitTag;
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "arg_unit_type");
    count = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_count");
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    x = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_x");
    y = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_y");
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType) || count < 1 || count > 200 || player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    if (x != 0.0 || y != 0.0) {
        spawnPoint = Point(x, y);
    } else {
        spawnPoint = PlayerStartLocation(player);
    }
    if (spawnPoint == null) { spawnPoint = Point(0.0, 0.0); }
    createdGroup = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, player, spawnPoint, 270.0);
    created = UnitGroupCount(createdGroup, c_unitCountAlive);
    unitTag = 0;
    if (created > 0) {
        createdUnit = UnitGroupUnit(createdGroup, 1);
        if (createdUnit != null) { unitTag = UnitGetTag(createdUnit); }
    }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.spawn\",\"created\":" + IntToString(created) + ",\"unit_tag\":" + IntToString(unitTag) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}");
}

string libVibeKernel_gf_FunctionUnitSpawnGroup(string argsJson) {
    string unitType;
    int count;
    int player;
    fixed x;
    fixed y;
    point spawnPoint;
    unitgroup createdGroup;
    unit current;
    int created;
    int index;
    int total;
    string tags;
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "arg_unit_type");
    count = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_count");
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    x = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_x");
    y = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_y");
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType) || count < 1 || count > 200 || player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    if (x != 0.0 || y != 0.0) { spawnPoint = Point(x, y); }
    else { spawnPoint = PlayerStartLocation(player); }
    if (spawnPoint == null) { spawnPoint = Point(0.0, 0.0); }
    createdGroup = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, player, spawnPoint, 270.0);
    created = UnitGroupCount(createdGroup, c_unitCountAlive);
    tags = "[";
    total = UnitGroupCount(createdGroup, c_unitCountAll);
    for (index = 1; index <= total; index += 1) {
        current = UnitGroupUnit(createdGroup, index);
        if (current != null && UnitIsAlive(current) && UnitGetPropertyFixed(current, c_unitPropLife, true) > 0.0) {
            if (StringLength(tags) > 1) { tags = tags + ","; }
            tags = tags + IntToString(UnitGetTag(current));
        }
    }
    tags = tags + "]";
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.spawn_group\",\"created\":" + IntToString(created) + ",\"unit_tags\":" + tags + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}");
}

string libVibeKernel_gf_FunctionUnitAddBehavior(string argsJson) {
    int unitTag;
    string behavior;
    int stacks;
    int ownerPlayer;
    int index;
    int total;
    unitgroup candidates;
    unit current;
    unit target;
    int count;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    behavior = libVibeKernel_gf_ArgsGet(argsJson, "arg_behavior");
    stacks = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_stacks");
    target = null;
    if (unitTag < 1 || behavior == "" || stacks < 1 || stacks > 100 || !CatalogEntryIsValid(c_gameCatalogBehavior, behavior)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    for (ownerPlayer = 1; ownerPlayer <= 15; ownerPlayer += 1) {
        if (target != null) { break; }
        candidates = UnitGroup(null, ownerPlayer, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        total = UnitGroupCount(candidates, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(candidates, index);
            if (current != null && UnitIsAlive(current) && UnitGetTag(current) == unitTag) {
                target = current;
                break;
            }
        }
    }
    if (target == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    UnitBehaviorAdd(target, behavior, target, stacks);
    count = UnitBehaviorCount(target, behavior);
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.add_behavior\",\"unit_tag\":" + IntToString(unitTag) + ",\"behavior\":\"" + behavior + "\",\"stacks\":" + IntToString(stacks) + ",\"count\":" + IntToString(count) + "}");
}

string libVibeKernel_gf_FunctionUnitAddAbility(string argsJson) {
    int unitTag;
    string ability;
    int ownerPlayer;
    int index;
    int total;
    unitgroup candidates;
    unit current;
    unit target;
    string hasAbility;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    ability = libVibeKernel_gf_ArgsGet(argsJson, "arg_ability");
    target = null;
    if (unitTag < 1 || ability == "" || !CatalogEntryIsValid(c_gameCatalogAbil, ability)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    for (ownerPlayer = 1; ownerPlayer <= 15; ownerPlayer += 1) {
        if (target != null) { break; }
        candidates = UnitGroup(null, ownerPlayer, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        total = UnitGroupCount(candidates, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(candidates, index);
            if (current != null && UnitIsAlive(current) && UnitGetTag(current) == unitTag) {
                target = current;
                break;
            }
        }
    }
    if (target == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    UnitAbilityAdd(target, ability);
    hasAbility = "false";
    if (UnitAbilityExists(target, ability)) { hasAbility = "true"; }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.add_ability\",\"unit_tag\":" + IntToString(unitTag) + ",\"ability\":\"" + ability + "\",\"has_ability\":" + hasAbility + "}");
}

