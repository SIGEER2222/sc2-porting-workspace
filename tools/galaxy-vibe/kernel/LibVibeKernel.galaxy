    }
    if (handleType == "wave") {
        aliveS = "false";
        if (libVibeHandles_gf_Has_wave(handleId)) { aliveS = "true"; }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.query", "OK", "{\"handle_type\":\"wave\",\"alive\":" + aliveS + ",\"handle_id\":" + IntToString(handleId) + "}");
    }
