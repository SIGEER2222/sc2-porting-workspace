    }
    if (handleType == "wavetarget") {
        aliveS = "false";
        if (libVibeHandles_gf_Has_wavetarget(handleId)) { aliveS = "true"; }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.query", "OK", "{\"handle_type\":\"wavetarget\",\"alive\":" + aliveS + ",\"handle_id\":" + IntToString(handleId) + "}");
    }
    if (handleType == "libCOTF_gs_HistogramData") {
        aliveS = "false";
        if (libVibeHandles_gf_Has_libCOTF_gs_HistogramData(handleId)) { aliveS = "true"; }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.query", "OK", "{\"handle_type\":\"libCOTF_gs_HistogramData\",\"alive\":" + aliveS + ",\"handle_id\":" + IntToString(handleId) + "}");
    }
    return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.query", "INVALID_ARGS", "{\"reason\":\"unknown_handle_type\"}");
}

string libVibeKernel_gf_HandleHandleDrop(string argsJson) {
    string handleType;
    int handleId;
    bool dropped;
    handleType = libVibeKernel_gf_ArgsGet(argsJson, "handle_type");
    handleId = libVibeKernel_gf_ArgsGetInt(argsJson, "handle_id");
    if (handleType == "unit") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.drop", "INVALID_ARGS", "{\"reason\":\"unit_lifetime_game_owned\"}");
    }
    dropped = false;
    if (!dropped && handleType == "actor") { dropped = libVibeHandles_gf_Drop_actor(handleId); }
    if (!dropped && handleType == "aifilter") { dropped = libVibeHandles_gf_Drop_aifilter(handleId); }
    if (!dropped && handleType == "bank") { dropped = libVibeHandles_gf_Drop_bank(handleId); }
    if (!dropped && handleType == "doodad") { dropped = libVibeHandles_gf_Drop_doodad(handleId); }
    if (!dropped && handleType == "marker") { dropped = libVibeHandles_gf_Drop_marker(handleId); }
    if (!dropped && handleType == "playergroup") { dropped = libVibeHandles_gf_Drop_playergroup(handleId); }
    if (!dropped && handleType == "point") { dropped = libVibeHandles_gf_Drop_point(handleId); }
    if (!dropped && handleType == "region") { dropped = libVibeHandles_gf_Drop_region(handleId); }
    if (!dropped && handleType == "revealer") { dropped = libVibeHandles_gf_Drop_revealer(handleId); }
    if (!dropped && handleType == "timer") { dropped = libVibeHandles_gf_Drop_timer(handleId); }
    if (!dropped && handleType == "trigger") { dropped = libVibeHandles_gf_Drop_trigger(handleId); }
    if (!dropped && handleType == "unitfilter") { dropped = libVibeHandles_gf_Drop_unitfilter(handleId); }
    if (!dropped && handleType == "unitgroup") { dropped = libVibeHandles_gf_Drop_unitgroup(handleId); }
    if (!dropped && handleType == "wave") { dropped = libVibeHandles_gf_Drop_wave(handleId); }
    if (!dropped && handleType == "waveinfo") { dropped = libVibeHandles_gf_Drop_waveinfo(handleId); }
    if (!dropped && handleType == "wavetarget") { dropped = libVibeHandles_gf_Drop_wavetarget(handleId); }
    if (!dropped && handleType == "libCOTF_gs_HistogramData") { dropped = libVibeHandles_gf_Drop_libCOTF_gs_HistogramData(handleId); }
    if (!dropped) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.drop", "HANDLE_NOT_FOUND", "{\"handle_type\":\"" + handleType + "\",\"handle_id\":" + IntToString(handleId) + "}");
    }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.drop", "OK", "{\"handle_type\":\"" + handleType + "\",\"handle_id\":" + IntToString(handleId) + ",\"dropped\":true}");
}

string libVibeKernel_gf_HandleHandleClear(string argsJson) {
    string handleType;
    handleType = libVibeKernel_gf_ArgsGet(argsJson, "handle_type");
    if (handleType == "all") {
        libVibeHandles_gf_Clear_actor();
        libVibeHandles_gf_Clear_aifilter();
        libVibeHandles_gf_Clear_bank();
        libVibeHandles_gf_Clear_doodad();
        libVibeHandles_gf_Clear_marker();
        libVibeHandles_gf_Clear_playergroup();
        libVibeHandles_gf_Clear_point();
        libVibeHandles_gf_Clear_region();
        libVibeHandles_gf_Clear_revealer();
        libVibeHandles_gf_Clear_timer();
        libVibeHandles_gf_Clear_trigger();
        libVibeHandles_gf_Clear_unitfilter();
        libVibeHandles_gf_Clear_unitgroup();
        libVibeHandles_gf_Clear_wave();
        libVibeHandles_gf_Clear_waveinfo();
        libVibeHandles_gf_Clear_wavetarget();
        libVibeHandles_gf_Clear_libCOTF_gs_HistogramData();
        libVibeKernel_gv_stateVersion += 1;
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"all\"}");
    }
    if (handleType == "actor") { libVibeHandles_gf_Clear_actor(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"actor\"}"); }
    if (handleType == "aifilter") { libVibeHandles_gf_Clear_aifilter(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"aifilter\"}"); }
    if (handleType == "bank") { libVibeHandles_gf_Clear_bank(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"bank\"}"); }
    if (handleType == "doodad") { libVibeHandles_gf_Clear_doodad(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"doodad\"}"); }
    if (handleType == "marker") { libVibeHandles_gf_Clear_marker(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"marker\"}"); }
    if (handleType == "playergroup") { libVibeHandles_gf_Clear_playergroup(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"playergroup\"}"); }
    if (handleType == "point") { libVibeHandles_gf_Clear_point(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"point\"}"); }
    if (handleType == "region") { libVibeHandles_gf_Clear_region(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"region\"}"); }
    if (handleType == "revealer") { libVibeHandles_gf_Clear_revealer(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"revealer\"}"); }
    if (handleType == "timer") { libVibeHandles_gf_Clear_timer(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"timer\"}"); }
    if (handleType == "trigger") { libVibeHandles_gf_Clear_trigger(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"trigger\"}"); }
    if (handleType == "unitfilter") { libVibeHandles_gf_Clear_unitfilter(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"unitfilter\"}"); }
    if (handleType == "unitgroup") { libVibeHandles_gf_Clear_unitgroup(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"unitgroup\"}"); }
    if (handleType == "wave") { libVibeHandles_gf_Clear_wave(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"wave\"}"); }
    if (handleType == "waveinfo") { libVibeHandles_gf_Clear_waveinfo(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"waveinfo\"}"); }
    if (handleType == "wavetarget") { libVibeHandles_gf_Clear_wavetarget(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"wavetarget\"}"); }
    if (handleType == "libCOTF_gs_HistogramData") { libVibeHandles_gf_Clear_libCOTF_gs_HistogramData(); libVibeKernel_gv_stateVersion += 1; return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "OK", "{\"handle_type\":\"libCOTF_gs_HistogramData\"}"); }
    return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.clear", "INVALID_ARGS", "{\"reason\":\"unknown_handle_type\"}");
}
// ==== END STAGE26_FULL_INVOKE HANDLE_OPS ====

// ==== BEGIN STAGE26_FULL_INVOKE KERNEL001_WATCHDOG ====
// ---- VIBE-KERNEL-001 watchdog ----
// Never calls Dispatch, so a faulting handler can never take this thread down.
// Observes the PollLoop heartbeat (gv_bankPollCount); if it stops advancing for
// ~4 seconds the PollLoop thread is presumed dead and gets restarted.
//
// ！！！铁律 VIBE-KERNEL-004（2026-08-10 静态归因 + 真机 A/B 取证）！！！
// watchdog 的诊断写入**必须走模型库**（GalaxyVibeModel），绝不能碰 RPC 库。
//
// 机理：gf_WriteBankInt 内部是 BankSave(gv_bankHandle)，即把内核内存态整份刷回
//       GalaxyVibe.SC2Bank。VIBE_KERNEL_002 已经把 **PollLoop 线程**的写入
//       全部排到 pending_request_id 读取之后，正是为了避免抹掉 Host 刚落盘的请求；
//       但 watchdog 是**同一个 Bank 上的第二个写者**，每 2.0s 一次、
//       与 PollLoop 的读写顺序毫无协调 —— VIBE_KERNEL_002 那条纪律它一天也没遵守过。
//
// 后果：Host 写 pending_request_id 到 PollLoop 下一拍 ReloadBank 之间有 ~0~500ms
//       危险窗；watchdog 周期 2000ms ⇒ 单请求碰撞率 ≈ 250/2000 = 12.5%
//       （真机 n=100 实测 over_2s = 15%，吻合）。被抹掉的请求由 Host 的
//       at-least-once 补发（reassert_sec=2.0）救回来 —— 于是缺陷不表现为「丢」
//       而表现为**延迟按 ~2 秒量子阶梯化**（中位 684ms / p95 4904ms / max 7200ms
//       ≈ 基线 + 1~3 次补发）。补发一直在**掩盖**这个 bug，不是在修它。
//
// 修法：心跳与重启计数改写模型库（VIBE_GEN_007 已做通道隔离，其 BankSave 只刷
//       GalaxyVibeModel.SC2Bank，天然伤不到 RPC 库）。RPC 库的落盘时机仍由
//       VIBE_KERNEL_005 首帧 flush + 各 handler 的响应写入保证，不依赖 watchdog。
bool libVibeKernel_gt_Watchdog_Func(bool testConds, bool runActions) {
    int stalled;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    stalled = 0;
    while (true) {
        Wait(2.0, c_timeGame);
        if (libVibeKernel_gv_bankPollCount == libVibeKernel_gv_watchdogLastSeen) {
            stalled += 1;
        } else {
            stalled = 0;
            libVibeKernel_gv_watchdogLastSeen = libVibeKernel_gv_bankPollCount;
        }
        libVibeKernel_gf_WriteModelBankInt("index", "watchdog_last_seen_poll", libVibeKernel_gv_watchdogLastSeen);
        if (stalled >= 2) {
            stalled = 0;
            libVibeKernel_gv_watchdogRestarts += 1;
            libVibeKernel_gv_pollLoopRunning = false;
            libVibeKernel_gf_WriteModelBankInt("index", "kernel_restart_count", libVibeKernel_gv_watchdogRestarts);
            if (libVibeKernel_gt_PollLoop != null) {
                // 必须异步：同步调用会让 watchdog 自身被 PollLoop 的 while(true) 永久吞掉，
                // 重启一次之后 watchdog 就再也不工作了（自废）。
                TriggerExecute(libVibeKernel_gt_PollLoop, false, false);
            }
        }
    }

    return true;
}
// ==== END STAGE26_FULL_INVOKE KERNEL001_WATCHDOG ====
