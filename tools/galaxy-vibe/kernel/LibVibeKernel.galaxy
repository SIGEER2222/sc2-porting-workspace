string libVibeKernel_gf_FunctionUnitSetVital(string argsJson) {
    int unitTag;
    string vital;
    fixed value;
    unit target;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    vital = libVibeKernel_gf_ArgsGet(argsJson, "arg_vital");
    value = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_value");
    target = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (target == null || unitTag < 1 || value < 0.0 || (vital != "life" && vital != "shield" && vital != "energy")) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    if (vital == "life") { UnitSetPropertyFixed(target, c_unitPropLife, value); }
    else if (vital == "shield") { UnitSetPropertyFixed(target, c_unitPropShields, value); }
    else { UnitSetPropertyFixed(target, c_unitPropEnergy, value); }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.set_vital\",\"unit_tag\":" + IntToString(unitTag) + ",\"vital\":\"" + vital + "\",\"value\":" + FixedToString(value, 3) + "}");
}

string libVibeKernel_gf_FunctionUnitQueryAttrs(string argsJson) {
    int unitTag;
    unit target;
    string typeName;
    fixed life;
    fixed maxLife;
    fixed shields;
    fixed energy;
    fixed armor;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    target = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (target == null || unitTag < 1) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    typeName = UnitGetType(target);
    life = UnitGetPropertyFixed(target, c_unitPropLife, true);
    maxLife = UnitGetPropertyFixed(target, c_unitPropLifeMax, true);
    shields = UnitGetPropertyFixed(target, c_unitPropShields, true);
    energy = UnitGetPropertyFixed(target, c_unitPropEnergy, true);
    armor = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogUnit, typeName, "ArmorArray[0].Value", UnitGetOwner(target));
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.query_attrs\",\"unit_tag\":" + IntToString(unitTag) + ",\"unit_type\":\"" + typeName + "\",\"life\":" + FixedToString(life, 3) + ",\"max_life\":" + FixedToString(maxLife, 3) + ",\"shields\":" + FixedToString(shields, 3) + ",\"energy\":" + FixedToString(energy, 3) + ",\"armor\":" + FixedToString(armor, 3) + "}");
}

int libVibeKernel_gf_CatalogType(string catalogName) {
    if (catalogName == "unit") { return c_gameCatalogUnit; }
    if (catalogName == "abil") { return c_gameCatalogAbil; }
    if (catalogName == "behavior") { return c_gameCatalogBehavior; }
    if (catalogName == "weapon") { return c_gameCatalogWeapon; }
    if (catalogName == "effect") { return c_gameCatalogEffect; }
    if (catalogName == "upgrade") { return c_gameCatalogUpgrade; }
    if (catalogName == "button") { return c_gameCatalogButton; }
    if (catalogName == "actor") { return c_gameCatalogActor; }
    return -1;
}

string libVibeKernel_gf_FunctionCatalogGet(string argsJson) {
    string catalogName;
    string entry;
    string field;
    string value;
    int player;
    int catalogType;
    int catalogPlayer;
    catalogName = libVibeKernel_gf_ArgsGet(argsJson, "arg_catalog");
    entry = libVibeKernel_gf_ArgsGet(argsJson, "arg_entry");
    field = libVibeKernel_gf_ArgsGet(argsJson, "arg_field");
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    catalogType = libVibeKernel_gf_CatalogType(catalogName);
    catalogPlayer = player;
    if (catalogPlayer == 0) { catalogPlayer = c_playerAny; }
    if (catalogType < 0 || entry == "" || field == "" || !CatalogEntryIsValid(catalogType, entry)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    value = CatalogFieldValueGet(catalogType, entry, field, catalogPlayer);
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.catalog.get\",\"catalog\":\"" + catalogName + "\",\"entry\":\"" + entry + "\",\"field\":\"" + field + "\",\"player\":" + IntToString(player) + ",\"value\":\"" + value + "\"}");
}

string libVibeKernel_gf_FunctionCatalogSet(string argsJson) {
    string catalogName;
    string entry;
    string field;
    string value;
    string oldValue;
    string requestedValue;
    int player;
    int catalogType;
    int catalogPlayer;
    int writePlayer;
    bool wrote;
    catalogName = libVibeKernel_gf_ArgsGet(argsJson, "arg_catalog");
    entry = libVibeKernel_gf_ArgsGet(argsJson, "arg_entry");
    field = libVibeKernel_gf_ArgsGet(argsJson, "arg_field");
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    value = libVibeKernel_gf_ArgsGet(argsJson, "arg_value");
    catalogType = libVibeKernel_gf_CatalogType(catalogName);
    catalogPlayer = player;
    if (catalogPlayer == 0) { catalogPlayer = c_playerAny; }
    // Catalog reads accept c_playerAny, but writes need a concrete player.
    writePlayer = player;
    if (writePlayer == 0) { writePlayer = 1; }
    if (catalogType < 0 || entry == "" || field == "" || value == "" || !CatalogEntryIsValid(catalogType, entry) || StringFind(value, ";", false) >= 0 || StringFind(value, "=", false) >= 0 || StringFind(value, "\"", false) >= 0 || StringFind(value, "\\", false) >= 0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    requestedValue = value;
    oldValue = CatalogFieldValueGet(catalogType, entry, field, catalogPlayer);
    if (catalogType == c_gameCatalogUnit && (field == "LifeMax" || field == "Speed")) {
        wrote = libNtve_gf_CatalogFieldValueSetAsReal(catalogType, entry, field, writePlayer, StringToFixed(value));
    } else {
        wrote = CatalogFieldValueSet(catalogType, entry, field, writePlayer, value);
    }
    value = CatalogFieldValueGet(catalogType, entry, field, writePlayer);
    if (!wrote || (catalogType == c_gameCatalogUnit && (field == "LifeMax" || field == "Speed") && StringToFixed(value) != StringToFixed(requestedValue))) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "CATALOG_WRITE_FAILED", "{}");
    }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.catalog.set\",\"catalog\":\"" + catalogName + "\",\"entry\":\"" + entry + "\",\"field\":\"" + field + "\",\"player\":" + IntToString(player) + ",\"old_value\":\"" + oldValue + "\",\"value\":\"" + value + "\"}");
}

string libVibeKernel_gf_FunctionVisualModelSwap(string argsJson) {
    int unitTag;
    int variation;
    string model;
    unit target;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    model = libVibeKernel_gf_ArgsGet(argsJson, "arg_model");
    variation = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_variation");
    target = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (target == null || unitTag < 1 || model == "" || variation < 0 || variation > 255) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    libNtve_gf_SendActorMessageToUnit(target, libNtve_gf_ModelSwap(model, variation));
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.visual.model_swap\",\"unit_tag\":" + IntToString(unitTag) + ",\"model\":\"" + model + "\",\"variation\":" + IntToString(variation) + ",\"applied\":true}");
}

string libVibeKernel_gf_FunctionVisualSetScale(string argsJson) {
    int unitTag;
    fixed scale;
    unit target;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    scale = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_scale");
    target = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (target == null || unitTag < 1 || scale < 0.01 || scale > 100.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    ActorScopeSend(ActorScopeFromUnit(target), "SetScale " + FixedToString(scale, 3));
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.visual.set_scale\",\"unit_tag\":" + IntToString(unitTag) + ",\"scale\":" + FixedToString(scale, 3) + ",\"applied\":true}");
}

string libVibeKernel_gf_FunctionVisualSetTint(string argsJson) {
    int unitTag;
    string colorValue;
    unit target;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    colorValue = libVibeKernel_gf_ArgsGet(argsJson, "arg_color");
    target = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (target == null || unitTag < 1 || colorValue == "") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    ActorScopeSend(ActorScopeFromUnit(target), "SetTintColor " + colorValue);
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.visual.set_tint\",\"unit_tag\":" + IntToString(unitTag) + ",\"color\":\"" + colorValue + "\",\"applied\":true}");
}

string libVibeKernel_gf_FunctionVisualSetOpacity(string argsJson) {
    int unitTag;
    fixed opacity;
    int opacityPct;
    unit target;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    opacity = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_opacity");
    target = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (target == null || unitTag < 1 || opacity < 0.0 || opacity > 1.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    opacityPct = FixedToInt(opacity * 100.0);
    ActorScopeSend(ActorScopeFromUnit(target), "SetOpacity " + IntToString(opacityPct));
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.visual.set_opacity\",\"unit_tag\":" + IntToString(unitTag) + ",\"opacity\":" + FixedToString(opacity, 3) + ",\"applied\":true}");
}

string libVibeKernel_gf_FunctionUnitQueryBehavior(string argsJson) {
    int unitTag;
    string behavior;
    int ownerPlayer;
    int index;
    int total;
    unitgroup candidates;
    unit current;
    unit target;
    int count;
    string hasBehavior;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    behavior = libVibeKernel_gf_ArgsGet(argsJson, "arg_behavior");
    target = null;
    if (unitTag < 1 || behavior == "" || !CatalogEntryIsValid(c_gameCatalogBehavior, behavior)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    for (ownerPlayer = 1; ownerPlayer <= 15; ownerPlayer += 1) {
        if (target != null) { break; }
        candidates = UnitGroup(null, ownerPlayer, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        total = UnitGroupCount(candidates, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(candidates, index);
            if (current != null && UnitIsAlive(current) && UnitGetTag(current) == unitTag) {
                target = current;
                break;
            }
        }
    }
    if (target == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    count = UnitBehaviorCount(target, behavior);
    hasBehavior = "false";
    if (count > 0) { hasBehavior = "true"; }
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.query_behavior\",\"unit_tag\":" + IntToString(unitTag) + ",\"behavior\":\"" + behavior + "\",\"count\":" + IntToString(count) + ",\"has_behavior\":" + hasBehavior + "}");
}

string libVibeKernel_gf_FunctionQueryUnits(string argsJson) {
    int player;
    string unitType;
    unitgroup units;
    unit current;
    int index;
    int total;
    int count;
    int owner;
    string currentType;
    fixed currentLife;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "arg_unit_type");
    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    units = UnitGroup(unitType, player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    total = UnitGroupCount(units, c_unitCountAll);
    count = 0;
    for (index = 1; index <= total; index += 1) {
        current = UnitGroupUnit(units, index);
        if (current != null) {
            owner = UnitGetOwner(current);
            currentType = UnitGetType(current);
            currentLife = UnitGetPropertyFixed(current, c_unitPropLife, true);
            if (UnitIsAlive(current) && currentLife > 0.0 && owner >= 1 && owner <= 15 && currentType != "" &&
                (player == 0 || owner == player) && (unitType == "" || currentType == unitType)) {
                count += 1;
            }
        }
    }
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.query.units\",\"count\":" + IntToString(count) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}");
}

string libVibeKernel_gf_FunctionUnitKill(string argsJson) {
    int unitTag;
    unit target;
    unitgroup candidates;
    unit current;
    int ownerPlayer;
    int index;
    int total;
    bool found;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    target = null;
    found = false;
    if (unitTag < 1) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    // UnitGetTag returns a runtime tag, not the editor unit id accepted by
    // UnitFromId. Resolve the tag against live groups before killing it.
    for (ownerPlayer = 1; ownerPlayer <= 15; ownerPlayer += 1) {
        if (found) { break; }
        candidates = UnitGroup(null, ownerPlayer, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        total = UnitGroupCount(candidates, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(candidates, index);
            if (current != null && UnitGetTag(current) == unitTag &&
                UnitGetPropertyFixed(current, c_unitPropLife, true) > 0.0 && UnitGetType(current) != "") {
                target = current;
                found = true;
                break;
            }
        }
    }
    if (!found || target == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    UnitKill(target);
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.kill\",\"unit_tag\":" + IntToString(unitTag) + ",\"killed\":true}");
}

string libVibeKernel_gf_FunctionUnitAttack(string argsJson) {
    int attackerTag;
    int targetTag;
    unitgroup candidates;
    unit current;
    unit attacker;
    unit target;
    int index;
    int total;
    int attackerOwner;
    int targetOwner;
    string targetType;
    attackerTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_attacker_tag");
    targetTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_target_tag");
    attacker = null;
    target = null;
    if (attackerTag < 1 || targetTag < 1 || attackerTag == targetTag) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"invalid_tags\"}");
    }

    // Resolve runtime tags from live units. UnitFromId accepts editor ids,
    // while UnitGetTag returns the runtime tag exposed by this API.
    candidates = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    total = UnitGroupCount(candidates, c_unitCountAll);
    for (index = 1; index <= total; index += 1) {
        current = UnitGroupUnit(candidates, index);
        if (current != null && UnitIsAlive(current) &&
            UnitGetPropertyFixed(current, c_unitPropLife, true) > 0.0) {
            if (UnitGetTag(current) == attackerTag) { attacker = current; }
            if (UnitGetTag(current) == targetTag) { target = current; }
            if (attacker != null && target != null) { break; }
        }
    }
    if (attacker == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"attacker_not_found\"}");
    }
    if (target == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"target_not_found_or_stale\"}");
    }
    attackerOwner = UnitGetOwner(attacker);
    targetOwner = UnitGetOwner(target);
    if (attackerOwner < 1 || attackerOwner > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"attacker_owner_invalid\"}");
    }
    if (targetOwner < 1 || targetOwner > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"target_neutral\"}");
    }
    if (!PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupEnemy, attackerOwner), targetOwner)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"target_ally\"}");
    }

    targetType = UnitGetType(target);
    UnitIssueOrder(attacker, OrderTargetingUnit(AbilityCommand("attack", 0), target), c_orderQueueReplace);
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.attack\",\"attacker_tag\":" + IntToString(attackerTag) + ",\"target_tag\":" + IntToString(targetTag) + ",\"target_owner\":" + IntToString(targetOwner) + ",\"target_type\":\"" + targetType + "\",\"issued\":true}");
}

string libVibeKernel_gf_FunctionQueryStructures(string argsJson) {
    int ownerPlayer;
    int firstOwner;
    int lastOwner;
    int scanOwner;
    string unitType;
    string currentType;
    unitgroup structures;
    unit current;
    int index;
    int total;
    int count;
    string entries;
    int currentOwner;
    int currentTag;
    ownerPlayer = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_owner_player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "arg_unit_type");
    if (ownerPlayer < 0 || ownerPlayer > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"owner_out_of_range\"}");
    }
    if (unitType != "" && !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"unit_type_not_found\"}");
    }

    firstOwner = 1;
    lastOwner = 15;
    if (ownerPlayer > 0) {
        firstOwner = ownerPlayer;
        lastOwner = ownerPlayer;
    }
    count = 0;
    entries = "[";
    for (scanOwner = firstOwner; scanOwner <= lastOwner; scanOwner += 1) {
        if (unitType == "") {
            structures = UnitGroup(null, scanOwner, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        } else {
            structures = UnitGroup(unitType, scanOwner, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        }
        total = UnitGroupCount(structures, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(structures, index);
            if (current != null && UnitIsAlive(current) &&
                UnitGetPropertyFixed(current, c_unitPropLife, true) > 0.0) {
                currentType = UnitGetType(current);
                currentOwner = UnitGetOwner(current);
                if (currentOwner == scanOwner &&
                    UnitTypeTestAttribute(currentType, c_unitAttributeStructure)) {
                    currentTag = UnitGetTag(current);
                    if (count > 0) { entries = entries + ","; }
                    entries = entries + "{\"owner\":" + IntToString(currentOwner) + ",\"unit_type\":\"" + currentType + "\",\"unit_tag\":" + IntToString(currentTag) + "}";
                    count += 1;
                }
            }
        }
    }
    entries = entries + "]";
    // This query is observational and deliberately does not change state_version.
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.query.structures\",\"owner_player\":" + IntToString(ownerPlayer) + ",\"unit_type\":\"" + unitType + "\",\"live_count\":" + IntToString(count) + ",\"structures\":" + entries + "}");
}

string libVibeKernel_gf_HandleFunctionInvoke(string argsJson) {
    string functionId;
    string argNames;
    string nonce;
    functionId = libVibeKernel_gf_ArgsGet(argsJson, "function_id");
    argNames = libVibeKernel_gf_ArgsGet(argsJson, "arg_names");
    if (functionId == "vibe.test.ping") {
        if (argNames != "nonce") { return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}"); }
        nonce = libVibeKernel_gf_ArgsGet(argsJson, "arg_nonce");
        if (StringLength(nonce) > 64 || StringFind(nonce, ";", false) >= 0 || StringFind(nonce, "=", false) >= 0 || StringFind(nonce, "\"", false) >= 0 || StringFind(nonce, "\\", false) >= 0 || StringFind(nonce, "{", false) >= 0 || StringFind(nonce, "}", false) >= 0) {
            return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
        }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", libVibeKernel_gf_FunctionVibeTestPing(argsJson));
    }
    if (functionId == "vibe.player.set_resource" && argNames == "player,resource,value") { return libVibeKernel_gf_FunctionPlayerSetResource(argsJson); }
    if (functionId == "vibe.unit.spawn" && argNames == "count,player,unit_type,x,y") { return libVibeKernel_gf_FunctionUnitSpawn(argsJson); }
    if (functionId == "vibe.unit.spawn_group" && argNames == "count,player,unit_type,x,y") { return libVibeKernel_gf_FunctionUnitSpawnGroup(argsJson); }
    if (functionId == "vibe.unit.add_behavior" && argNames == "behavior,stacks,unit_tag") { return libVibeKernel_gf_FunctionUnitAddBehavior(argsJson); }
    if (functionId == "vibe.unit.add_ability" && argNames == "ability,unit_tag") { return libVibeKernel_gf_FunctionUnitAddAbility(argsJson); }
    if (functionId == "vibe.unit.query_ability" && argNames == "ability,unit_tag") { return libVibeKernel_gf_FunctionUnitQueryAbility(argsJson); }
    if (functionId == "vibe.unit.query_behavior" && argNames == "behavior,unit_tag") { return libVibeKernel_gf_FunctionUnitQueryBehavior(argsJson); }
    if (functionId == "vibe.unit.set_vital" && argNames == "unit_tag,value,vital") { return libVibeKernel_gf_FunctionUnitSetVital(argsJson); }
    if (functionId == "vibe.unit.query_attrs" && argNames == "unit_tag") { return libVibeKernel_gf_FunctionUnitQueryAttrs(argsJson); }
    if (functionId == "vibe.catalog.get" && argNames == "catalog,entry,field,player") { return libVibeKernel_gf_FunctionCatalogGet(argsJson); }
    if (functionId == "vibe.catalog.set" && argNames == "catalog,entry,field,player,value") { return libVibeKernel_gf_FunctionCatalogSet(argsJson); }
    if (functionId == "vibe.visual.model_swap" && argNames == "model,unit_tag,variation") { return libVibeKernel_gf_FunctionVisualModelSwap(argsJson); }
    if (functionId == "vibe.visual.set_scale" && argNames == "scale,unit_tag") { return libVibeKernel_gf_FunctionVisualSetScale(argsJson); }
    if (functionId == "vibe.visual.set_tint" && argNames == "color,unit_tag") { return libVibeKernel_gf_FunctionVisualSetTint(argsJson); }
    if (functionId == "vibe.visual.set_opacity" && argNames == "opacity,unit_tag") { return libVibeKernel_gf_FunctionVisualSetOpacity(argsJson); }
    if (functionId == "vibe.query.units" && argNames == "player,unit_type") { return libVibeKernel_gf_FunctionQueryUnits(argsJson); }
    if (functionId == "vibe.unit.kill" && argNames == "unit_tag") { return libVibeKernel_gf_FunctionUnitKill(argsJson); }
    if (functionId == "vibe.unit.attack" && argNames == "attacker_tag,target_tag") { return libVibeKernel_gf_FunctionUnitAttack(argsJson); }
    if (functionId == "vibe.query.structures" && argNames == "owner_player,unit_type") { return libVibeKernel_gf_FunctionQueryStructures(argsJson); }
    if (functionId == "douququ.runtime.status" && argNames == "") { return libDouQuquRuntime_gf_Status(argsJson); }
    if (functionId == "douququ.reset" && argNames == "seed") { return libDouQuquRuntime_gf_Reset(argsJson); }
    if (functionId == "douququ.runtime.set_proc_chances" && argNames == "broodlord_percent,reaver_kill_percent,reaver_ordinary_percent") { return libDouQuquRuntime_gf_SetProcChances(argsJson); }
    if (functionId == "douququ.runtime.reset_proc_chances" && argNames == "") { return libDouQuquRuntime_gf_ResetProcChancesInvoke(argsJson); }
    if (functionId == "douququ.user.run" && argNames == "mineral_delta,owner,unit_type,x,y") { return libDouQuquUser_gf_Run(argsJson); }
    if (functionId == "douququ.unit.spawn" && argNames == "owner,unit_type,x,y") { return libDouQuquRuntime_gf_UnitSpawn(argsJson); }
    if (functionId == "douququ.unit.set_energy" && argNames == "energy,unit_tag") { return libDouQuquRuntime_gf_UnitSetEnergy(argsJson); }
    if (functionId == "douququ.unit.set_life" && argNames == "life,unit_tag") { return libDouQuquRuntime_gf_UnitSetLife(argsJson); }
    if (functionId == "douququ.player.set_minerals" && argNames == "minerals,owner") { return libDouQuquRuntime_gf_PlayerSetMinerals(argsJson); }
    if (functionId == "douququ.attack" && argNames == "attacker_tag,target_tag") { return libDouQuquRuntime_gf_Attack(argsJson); }
    if (functionId == "douququ.reaver.scarab_impact" && argNames == "attacker_tag,fatal,impact_x,impact_y,victim_tag") { return libDouQuquRuntime_gf_ReaverScarabImpact(argsJson); }
    if (functionId == "douququ.kill" && argNames == "killer_tag,victim_tag") { return libDouQuquRuntime_gf_Kill(argsJson); }
    if (functionId == "douququ.banshee.hatch" && argNames == "requested_count,requested_energy,unit_tag") { return libDouQuquRuntime_gf_BansheeHatch(argsJson); }
    if (functionId == "douququ.tick" && argNames == "seconds") { return libDouQuquRuntime_gf_Tick(argsJson); }
    if (functionId == "douququ.vulture.refill" && argNames == "unit_tag") { return libDouQuquRuntime_gf_VultureRefill(argsJson); }
    if (functionId == "douququ.vulture.consume" && argNames == "count,unit_tag") { return libDouQuquRuntime_gf_VultureConsume(argsJson); }
    if (functionId == "douququ.snapshot" && argNames == "") { return libDouQuquRuntime_gf_Snapshot(argsJson); }
    if (functionId == "vibe.player.set_resource" || functionId == "vibe.unit.spawn" || functionId == "vibe.unit.spawn_group" || functionId == "vibe.unit.add_behavior" || functionId == "vibe.unit.add_ability" || functionId == "vibe.unit.query_ability" || functionId == "vibe.unit.query_behavior" || functionId == "vibe.unit.set_vital" || functionId == "vibe.unit.query_attrs" || functionId == "vibe.catalog.get" || functionId == "vibe.catalog.set" || functionId == "vibe.visual.model_swap" || functionId == "vibe.visual.set_scale" || functionId == "vibe.visual.set_tint" || functionId == "vibe.visual.set_opacity" || functionId == "vibe.query.units" || functionId == "vibe.unit.kill" || functionId == "vibe.unit.attack" || functionId == "vibe.query.structures" || functionId == "douququ.runtime.status" || functionId == "douququ.reset" || functionId == "douququ.runtime.set_proc_chances" || functionId == "douququ.runtime.reset_proc_chances" || functionId == "douququ.user.run" || functionId == "douququ.unit.spawn" || functionId == "douququ.unit.set_energy" || functionId == "douququ.unit.set_life" || functionId == "douququ.player.set_minerals" || functionId == "douququ.attack" || functionId == "douququ.reaver.scarab_impact" || functionId == "douququ.kill" || functionId == "douququ.banshee.hatch" || functionId == "douququ.tick" || functionId == "douququ.vulture.refill" || functionId == "douququ.vulture.consume" || functionId == "douququ.snapshot") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
// ==== BEGIN STAGE26_FULL_INVOKE INVOKE_GEN ====
    // Stage 26: generated adapter dispatch (gen.<int> function ids).
    if (StringSub(functionId, 1, 4) == "gen.") {
        if (StringToInt(StringSub(functionId, 5, StringLength(functionId))) < 1) {
            return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"function_id_not_numeric\"}");
        }
        libVibeKernel_gv_stateVersion += 1;
        return libVibeInvoke_gf_Dispatch(StringToInt(StringSub(functionId, 5, StringLength(functionId))), argsJson);
    }
// ==== END STAGE26_FULL_INVOKE INVOKE_GEN ====
    return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "FUNCTION_NOT_FOUND", "{}");
}

// ---- Stage 1 动态诊断 handler ----

string libVibeKernel_gf_HandleUpgradeSetLevel(string argsJson) {
    int player;
    string upgrade;
    int level;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    upgrade = libVibeKernel_gf_ArgsGet(argsJson, "upgrade");
    level = libVibeKernel_gf_ArgsGetInt(argsJson, "level");

    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "PLAYER_OUT_OF_RANGE", "{}");
    }
    if (level < 0 || level > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "INVALID_LEVEL", "{}");
    }
    if (upgrade == "") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "INVALID_ARGS", "{}");
    }

    libNtve_gf_SetUpgradeLevelForPlayer(player, upgrade, level);
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"applied\":1,\"player\":" + IntToString(player) + ",\"upgrade\":\"" + upgrade + "\",\"level\":" + IntToString(level) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "OK", payload);
}

string libVibeKernel_gf_HandleTechTreeCheck(string argsJson) {
    int player;
    string upgrade;
    int count;
    int unlocked;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    upgrade = libVibeKernel_gf_ArgsGet(argsJson, "upgrade");

    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "tech_tree.check", "PLAYER_OUT_OF_RANGE", "{}");
    }
    if (upgrade == "") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "tech_tree.check", "INVALID_ARGS", "{}");
    }

    count = TechTreeUpgradeCount(player, upgrade, c_techCountCompleteOnly);
    unlocked = 0;
    if (count > 0) { unlocked = 1; }
    // 查询不产生副作用，不递增 state_version
    payload = "{\"count\":" + IntToString(count) + ",\"unlocked\":" + IntToString(unlocked) + ",\"upgrade\":\"" + upgrade + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "tech_tree.check", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnitTags(string argsJson) {
    int player;
    string unitType;
    unitgroup lv_units;
    int count;
    int lv_i;
    unit lv_u;
    int lv_tag;
    string tags;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");

    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_tags", "PLAYER_OUT_OF_RANGE", "{}");
    }

    if (unitType == "") {
        lv_units = UnitGroup(null, player, RegionEntireMap(),
            UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    } else {
        lv_units = UnitGroup(unitType, player, RegionEntireMap(),
            UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    }
    count = UnitGroupCount(lv_units, c_unitCountAlive);
    tags = "[";
    for (lv_i = 1; lv_i <= count; lv_i += 1) {
        lv_u = UnitGroupUnit(lv_units, lv_i);
        if (lv_u != null) {
            lv_tag = UnitGetTag(lv_u);
            if (StringLength(tags) > 1) { tags = tags + ","; }
            tags = tags + IntToString(lv_tag);
        }
    }
    tags = tags + "]";
    // 查询不产生副作用，不递增 state_version
    payload = "{\"count\":" + IntToString(count) + ",\"tags\":" + tags + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_tags", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnitAttrs(string argsJson) {
    int unitTag;
    unit lv_u;
    string typeName;
    fixed life;
    fixed maxLife;
    fixed shields;
    fixed energy;
    fixed armor;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    lv_u = libVibeKernel_gf_FindUnitByTag(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_attrs", "UNIT_NOT_FOUND", "{}");
    }

    typeName = UnitGetType(lv_u);
    life = UnitGetPropertyFixed(lv_u, c_unitPropLife, true);
    maxLife = UnitGetPropertyFixed(lv_u, c_unitPropLifeMax, true);
    shields = UnitGetPropertyFixed(lv_u, c_unitPropShields, true);
    energy = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, true);
    armor = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogUnit, typeName, "ArmorArray[0].Value", UnitGetOwner(lv_u));
    // 查询不产生副作用，不递增 state_version
    // MVP: weapon_damage/weapon_range/attributes 标 unavailable（Catalog 路径复杂，延后）
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"unit_type\":\"" + typeName + "\",\"life\":" + FixedToString(life, 2) + ",\"max_life\":" + FixedToString(maxLife, 2) + ",\"shields\":" + FixedToString(shields, 2) + ",\"energy\":" + FixedToString(energy, 2) + ",\"armor\":" + FixedToString(armor, 2) + ",\"weapon_damage\":\"unavailable\",\"weapon_range\":\"unavailable\",\"attributes\":\"unavailable\"}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_attrs", "OK", payload);
}

// ==== STAGE26_FULL_INVOKE HANDLE_OPS PROTOTYPES ====
// Galaxy requires prior declaration: the Handle* ops are defined later in this
// file but are dispatched from libVibeKernel_gf_Dispatch above, so declare prototypes
// here to satisfy the forward-reference constraint.
string libVibeKernel_gf_HandleHandleQuery(string argsJson);
string libVibeKernel_gf_HandleHandleDrop(string argsJson);
string libVibeKernel_gf_HandleHandleClear(string argsJson);

// ---- 主分发器 ----
string libVibeKernel_gf_Dispatch(string requestJson) {
    string sessionId;
    string requestId;
    int sequence;
    string operation;
    string args;
    string result;
    // 解析请求字段（简单 key=value 解析）
    // 注：args 直接嵌入 requestJson 中（key=value;key=value 格式），
    // 不单独提取 args 字段，handler 直接从 requestJson 中读取参数
    sessionId = libVibeKernel_gf_ArgsGet(requestJson, "session_id");
    requestId = libVibeKernel_gf_ArgsGet(requestJson, "request_id");
    sequence = libVibeKernel_gf_ArgsGetInt(requestJson, "sequence");
    operation = libVibeKernel_gf_ArgsGet(requestJson, "operation");
    // args 直接使用完整 requestJson，handler 通过 ArgsGet 查找具体参数
    args = requestJson;

    libVibeKernel_gv_lastRequestId = requestId;
    libVibeKernel_gv_lastSequence = sequence;
    libVibeKernel_gv_requestCount += 1;

    // 1. Session 检查
    if (!libVibeKernel_gf_CheckSession(sessionId)) {
        libVibeKernel_gv_rejectedCount += 1;
// ==== BEGIN VIBE_KERNEL_003_OBSERVABLE_REJECT ====
        // VIBE-KERNEL-003: 拒绝也必须可观测（silent-rejection 修复）。
        // PollLoop 丢弃 Dispatch 的返回值——响应统一由 handler / PESSIMISTIC 占位
        // 自行落 Bank。而本分支早于下方 PESSIMISTIC 占位就 return，导致
        // SESSION_EXPIRED 裁决**永远写不进 Bank**：Host 只能一直轮询到自身超时，
        // 观测结果表现为 host 侧 INTERNAL_ERROR，而非内核裁决 SESSION_EXPIRED。
        // 安全语义本来是对的（请求未执行、state_version 不变），坏的是可观测性——
        // 「被拒绝」与「内核死了」在 Host 看来无法区分。
        // 只写 response key，不调 WriteResponseToBank：被拒请求不应污染
        // index/last_request_id 与 state_version。
        result = libVibeKernel_gf_MakeResponse("error", sessionId, requestId, sequence, operation, "SESSION_EXPIRED", "{}");
        libVibeKernel_gf_WriteBankKey("response", requestId, result);
        return result;
// ==== END VIBE_KERNEL_003_OBSERVABLE_REJECT ====
    }

    // 2. 幂等检查
    if (!libVibeKernel_gf_CheckIdempotency(requestId)) {
        // 返回缓存结果
        return libVibeKernel_gv_lastResponseJson;
    }

// ==== BEGIN STAGE26_FULL_INVOKE KERNEL001_PESSIMISTIC ====
    // VIBE-KERNEL-001: land a pessimistic response before the handler runs.
    // If the handler aborts the trigger thread, the Host still sees a terminal
    // HANDLER_ABORTED instead of blocking until its own timeout.
    libVibeKernel_gf_WriteBankKey("response", requestId,
        libVibeKernel_gf_MakeResponse("error", sessionId, requestId, sequence, operation,
            "HANDLER_ABORTED", "{\"reason\":\"handler_did_not_complete\"}"));
    libVibeKernel_gf_WriteBankKey("index", "last_dispatch_started", requestId + "|" + operation);
// ==== END STAGE26_FULL_INVOKE KERNEL001_PESSIMISTIC ====
    // 3. 白名单分发
    if (operation == "system.ping") {
        result = libVibeKernel_gf_HandleSystemPing(args);
    } else if (operation == "function.invoke") {
        result = libVibeKernel_gf_HandleFunctionInvoke(args);
    } else if (operation == "scenario.reset") {
        result = libVibeKernel_gf_HandleScenarioReset(args);
    } else if (operation == "unit.spawn") {
        result = libVibeKernel_gf_HandleUnitSpawn(args);
    } else if (operation == "unit.kill") {
        result = libVibeKernel_gf_HandleUnitKill(args);
    } else if (operation == "unit.set_vital") {
        result = libVibeKernel_gf_HandleUnitSetVital(args);
    } else if (operation == "player.set_resource") {
        result = libVibeKernel_gf_HandlePlayerSetResource(args);
    } else if (operation == "query.units") {
        result = libVibeKernel_gf_HandleQueryUnits(args);
    } else if (operation == "query.unit") {
        result = libVibeKernel_gf_HandleQueryUnit(args);
    } else if (operation == "query.mission") {
        result = libVibeKernel_gf_HandleQueryMission(args);
    } else if (operation == "visual.actor_tint") {
        result = libVibeKernel_gf_HandleVisualActorTint(args);
    } else if (operation == "visual.actor_scale") {
        result = libVibeKernel_gf_HandleVisualActorScale(args);
    } else if (operation == "visual.actor_opacity") {
        result = libVibeKernel_gf_HandleVisualActorOpacity(args);
    } else if (operation == "upgrade.set_level") {
        result = libVibeKernel_gf_HandleUpgradeSetLevel(args);
    } else if (operation == "tech_tree.check") {
        result = libVibeKernel_gf_HandleTechTreeCheck(args);
    } else if (operation == "query.unit_tags") {
        result = libVibeKernel_gf_HandleQueryUnitTags(args);
    } else if (operation == "query.unit_attrs") {
        result = libVibeKernel_gf_HandleQueryUnitAttrs(args);
// ==== BEGIN STAGE26_FULL_INVOKE HANDLE_OPS_DISPATCH ====
    } else if (operation == "handle.drop") {
        result = libVibeKernel_gf_HandleHandleDrop(args);
    } else if (operation == "handle.clear") {
        result = libVibeKernel_gf_HandleHandleClear(args);
    } else if (operation == "handle.query") {
        result = libVibeKernel_gf_HandleHandleQuery(args);
// ==== END STAGE26_FULL_INVOKE HANDLE_OPS_DISPATCH ====
    } else {
        // 未知操作，100% 拒绝（不 fallback）
        libVibeKernel_gv_rejectedCount += 1;
        result = libVibeKernel_gf_MakeResponse("error", sessionId, requestId, sequence, operation, "UNKNOWN_OPERATION", "{}");
    }

    // 4. 写入 Bank 供 Host 读取
    libVibeKernel_gf_WriteResponseToBank(requestId, result);

    return result;
}

// ---- Bank 轮询入口 ----
// Host 将 request_id 写入 Bank(section="index", key="pending_request_id")
// Kernel 定时轮询该键，发现新 request_id 后读取完整请求并分发
bool libVibeKernel_gt_BankPoll_Func(bool testConds, bool runActions) {
    string pendingId;
    string requestJson;
    string response;
    string opName;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    // Refresh before the diagnostic write so external Host requests are not
    // overwritten by the cached Bank handle.
    libVibeKernel_gf_ReloadBank();
    // 诊断标记：证明 BankPoll 触发器被调用（每次递增）
    libVibeKernel_gv_bankPollCount += 1;

    // 读取 pending_request_id
    pendingId = libVibeKernel_gf_ReadBankKey("index", "pending_request_id");
    if (pendingId == "") { return true; }
    if (pendingId == libVibeKernel_gv_lastPolledRequestId) { return true; }

    // 读取完整请求
    requestJson = libVibeKernel_gf_ReadBankKey("request", pendingId);
    if (requestJson == "") { return true; }

    // 分发处理
    // VIBE-KERNEL-001: consume before dispatch so a poison request is never replayed.
    libVibeKernel_gv_lastPolledRequestId = pendingId;
    response = libVibeKernel_gf_Dispatch(requestJson);

    // 简短回声（完整响应已写入 Bank）
    opName = libVibeKernel_gf_ArgsGet(requestJson, "operation");
    libVibeKernel_gf_EchoChat("[Vibe] " + opName + " done (id=" + pendingId + ")");

    return true;
}

// ---- Chat 入口 ----
// 聊天前缀 "!vibe" 触发，格式："!vibe <args_string>"
// args_string 包含完整请求字段：session_id=...;request_id=...;operation=...;...
// Kernel 直接从聊天消息解析请求，不依赖 Bank 读取请求
bool libVibeKernel_gt_ChatCommand_Func(bool testConds, bool runActions) {
    string chat;
    string requestArgs;
    string response;
    string opName;
    string requestId;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    chat = EventChatMessage(false);
    // 期望格式："!vibe <args_string>"
    if (StringFind(chat, "!vibe ", false) != 1) { return true; }

    // 提取 args_string（"!vibe " 后的全部内容）
    requestArgs = libVibeKernel_gf_Trim(StringSub(chat, 7, StringLength(chat)));
    if (requestArgs == "") {
        libVibeKernel_gf_EchoChat("[Vibe] 用法：!vibe <args_string>");
        return true;
    }

    // 直接分发（args_string 已是 key=value;key=value 格式）
    response = libVibeKernel_gf_Dispatch(requestArgs);
    opName = libVibeKernel_gf_ArgsGet(requestArgs, "operation");
    requestId = libVibeKernel_gf_ArgsGet(requestArgs, "request_id");
    libVibeKernel_gf_EchoChat("[Vibe] " + opName + " done (id=" + requestId + ")");

    return true;
}

// ---- P1 -> P2 cooperative ally command channel ----
// This channel is intentionally separate from the typed debug registry. Only
// player 1 may issue it; every order is issued to units owned by player 2.
// Commands: !ally follow|regroup|defend|attack|retreat|status|help
bool libVibeKernel_gf_ProcessAllyCommand(string chat) {
    string command;
    unitgroup p2Units;
    unitgroup p2CombatUnits;
    unitgroup enemyUnits;
    unit target;
    int unitCount;
    int enemyCount;

    if (StringFind(chat, "!ally ", false) != 1) { return true; }
    command = StringWord(chat, 2);
    if (command == "") {
        libVibeKernel_gf_EchoAlly("[Ally P2] Commands: follow, attack, defend, regroup, retreat, status, help.");
        return true;
    }

    // Reject a stale or repeated visible chat message without reissuing orders.
    if (chat == libVibeKernel_gv_lastAllyCommand) { return true; }
    if (chat == libVibeKernel_gf_ReadBankKey("ally", "last_command")) { return true; }
    libVibeKernel_gv_lastAllyCommand = chat;
    libVibeKernel_gf_WriteBankKey("ally", "last_command", chat);
    libVibeKernel_gf_WriteBankInt("ally", "command_count",
        libVibeKernel_gf_ReadBankInt("ally", "command_count") + 1);
    libVibeKernel_gf_WriteBankKey("ally", "last_mode", command);

    if (!PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupAlly, 1), 2)) {
        libVibeKernel_gf_EchoAlly("[Ally P2] Rejected: P2 is not allied to P1.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "rejected_not_allied");
        return true;
    }

    p2Units = UnitGroup(null, 2, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    unitCount = UnitGroupCount(p2Units, c_unitCountAlive);
    // Tactical bridge commands must never redirect workers or structures.
    p2CombatUnits = UnitGroup(null, 2, RegionEntireMap(),
        UnitFilter(0, 0,
            (1 << c_targetFilterWorker) | (1 << c_targetFilterStructure) | (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);

    if (command == "status") {
        libVibeKernel_gf_EchoAlly("[Ally P2] Status: " + IntToString(unitCount) + " living units; mode=ready.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "status");
        return true;
    }
    if (command == "help") {
        libVibeKernel_gf_EchoAlly("[Ally P2] Commands: follow, attack, defend, regroup, retreat, status, help.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "help");
        return true;
    }
    if (command == "hold") {
        libVibeKernel_gf_EchoAlly("[Ally P2] Acknowledged: hold. P2 combat units keep their current orders.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "hold");
        return true;
    }
    if ((command == "follow") || (command == "regroup") || (command == "defend") || (command == "retreat")) {
        UnitGroupIssueOrder(p2CombatUnits,
            OrderTargetingPoint(AbilityCommand("move", 0), PlayerStartLocation(1)),
            c_orderQueueReplace);
        libVibeKernel_gf_EchoAlly("[Ally P2] Acknowledged: " + command + ". Moving to P1 defense point.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "acknowledged");
        return true;
    }
    if (command == "attack") {
        enemyUnits = UnitGroupAlliance(2, c_unitAllianceEnemy, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile),
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        enemyCount = UnitGroupCount(enemyUnits, c_unitCountAlive);
        if (enemyCount <= 0) {
            libVibeKernel_gf_EchoAlly("[Ally P2] Attack acknowledged, but no hostile target is visible.");
            libVibeKernel_gf_WriteBankKey("ally", "last_result", "attack_no_target");
            return true;
        }
        target = UnitGroupClosestToPoint(enemyUnits, PlayerStartLocation(1));
        UnitGroupIssueOrder(p2CombatUnits,
            OrderTargetingUnit(AbilityCommand("attack", 0), target),
            c_orderQueueReplace);
        libVibeKernel_gf_EchoAlly("[Ally P2] Acknowledged: attack. P2 units engaging hostile target.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "attack_issued");
        return true;
    }

    libVibeKernel_gf_EchoAlly("[Ally P2] Unknown command. Try: follow, attack, defend, regroup, retreat, status.");
    libVibeKernel_gf_WriteBankKey("ally", "last_result", "rejected_unknown");
    return true;
}

// Publish only P2-owned economy counters. The API client is P1, so its
// player_common observation cannot be reused as the ally's resource state.
// VIBE_GEN_007 分库（N1 治本）：这是 PollLoop 每轮都会调用的**最高频写入方**，
// 原先每轮 4 次 BankSave 都把内核内存态整份刷回 GalaxyVibe.SC2Bank，
// 正是把「Host 请求被覆盖」的窗口从 ~0ms 拉宽到整个 handler 时长的元凶。
// 改走独立的 GalaxyVibeModel 库后，模型快照与 RPC 通道彻底解耦。
void libVibeKernel_gf_WriteModelP2Snapshot() {
    libVibeKernel_gf_WriteModelBankInt("ally", "p2_minerals",
        PlayerGetPropertyInt(2, c_playerPropMinerals));
    libVibeKernel_gf_WriteModelBankInt("ally", "p2_vespene",
        PlayerGetPropertyInt(2, c_playerPropVespene));
    libVibeKernel_gf_WriteModelBankInt("ally", "p2_supply_used",
        PlayerGetPropertyInt(2, c_playerPropSuppliesUsed));
    libVibeKernel_gf_WriteModelBankInt("ally", "p2_supply_cap",
        PlayerGetPropertyInt(2, c_playerPropSuppliesMade));
}

// Apply high-level model labels through native P2 Computer boundaries. This
// function intentionally contains no raw ability IDs: the native AI resolves
// the current map/catalog, while worker orders are restricted to P2 workers
// and public resource targets.
bool libVibeKernel_gf_ApplyModelP2Intent(string economy, string production) {
    unitgroup workers;
    unitgroup idleWorkers;
    unitgroup mineralFields;
    unitgroup refineries;
    unit worker;
    unit resource;
    int workerIndex;
    int mineralCount;
    int refineryCount;
    int minerals;
    int economyDispatched;
    int productionDispatched;
    string economyResult;
    string productionResult;

    if (!PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupAlly, 1), 2)) {
        libVibeKernel_gf_WriteBankKey("ally", "last_model_result", "rejected_not_allied");
        return false;
    }
    if ((economy != "gather_minerals") && (economy != "gather_gas")
        && (economy != "train_worker") && (economy != "build_supply")
        && (economy != "maintain_economy")) {
        libVibeKernel_gf_WriteBankKey("ally", "last_model_result", "rejected_unknown_economy");
        return false;
    }
    if ((production != "no_op") && (production != "build_refinery")
        && (production != "build_barracks") && (production != "build_factory")
        && (production != "train_marine") && (production != "train_marauder")
        && (production != "research_upgrade")) {
        libVibeKernel_gf_WriteBankKey("ally", "last_model_result", "rejected_unknown_production");
        return false;
    }

    economyDispatched = 0;
    productionDispatched = 0;
    economyResult = "no_op";
    productionResult = "no_op";
    minerals = PlayerGetPropertyInt(2, c_playerPropMinerals);

    workers = UnitGroup(null, 2, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterWorker), 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    mineralFields = UnitGroup(null, c_playerAny, RegionEntireMap(),
        UnitFilter((1 << c_targetFilterHarvestableResource), 0,
            (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    refineries = UnitGroup("Refinery", 2, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterStructure),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    mineralCount = UnitGroupCount(mineralFields, c_unitCountAlive);
    refineryCount = UnitGroupCount(refineries, c_unitCountAlive);

    if ((economy == "gather_minerals") || (economy == "maintain_economy")) {
        idleWorkers = UnitGroupFilter(null, 2, UnitGroupIdle(2, false),
            UnitFilter((1 << c_targetFilterWorker), 0, (1 << c_targetFilterMissile),
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        workerIndex = UnitGroupCount(idleWorkers, c_unitCountAlive);
        while (workerIndex > 0 && mineralCount > 0) {
            worker = UnitGroupUnitFromEnd(idleWorkers, workerIndex);
            resource = UnitGroupClosestToPoint(mineralFields, UnitGetPosition(worker));
            if (worker != null && resource != null) {
                UnitIssueOrder(worker,
                    OrderTargetingUnit(AbilityCommand("Smart", 0), resource),
                    c_orderQueueReplace);
                economyDispatched += 1;
            }
            workerIndex -= 1;
        }
        economyResult = "gather_minerals";
    } else if (economy == "gather_gas") {
        idleWorkers = UnitGroupFilter(null, 2, UnitGroupIdle(2, false),
            UnitFilter((1 << c_targetFilterWorker), 0, (1 << c_targetFilterMissile),
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        workerIndex = UnitGroupCount(idleWorkers, c_unitCountAlive);
        while (workerIndex > 0 && refineryCount > 0) {
            worker = UnitGroupUnitFromEnd(idleWorkers, workerIndex);
            resource = UnitGroupClosestToPoint(refineries, UnitGetPosition(worker));
            if (worker != null && resource != null) {
                UnitIssueOrder(worker,
                    OrderTargetingUnit(AbilityCommand("Smart", 0), resource),
                    c_orderQueueReplace);
                economyDispatched += 1;
            }
            workerIndex -= 1;
        }
        if (refineryCount > 0) {
            economyResult = "gather_gas";
        } else {
            economyResult = "gather_gas_waiting_refinery";
        }
    } else if (economy == "train_worker") {
        if ((minerals >= 50)
            && (TechTreeUnitCount(2, "SCV", c_techCountQueuedOrBetter) < 20)) {
            AITrain(2, c_makePriorityTown, c_townMain, "SCV", 1);
            economyDispatched = 1;
            economyResult = "train_worker_requested";
        } else if (TechTreeUnitCount(2, "SCV", c_techCountQueuedOrBetter) >= 20) {
            economyResult = "train_worker_target_reached";
        } else {
            economyResult = "train_worker_waiting_minerals";
        }
    } else if (economy == "build_supply") {
        if ((minerals >= 100)
            && (PlayerGetPropertyInt(2, c_playerPropSuppliesUsed) + 2
                >= PlayerGetPropertyInt(2, c_playerPropSuppliesMade))
            && (AIGetInternalBuildQueueCount(2) <= 1)) {
            AIBuild(2, c_makePriorityTown, c_townMain, "SupplyDepot", 1, c_makeDefault);
            economyDispatched = 1;
            economyResult = "build_supply_requested";
        } else {
            economyResult = "build_supply_waiting_minerals";
        }
    }

    if ((production == "build_refinery") && (refineryCount <= 0)) {
        AISetStock(2, 1, "Refinery");
        AIBuild(2, c_makePriorityTown, c_townMain, "Refinery", 1, c_makeDefault);
        productionDispatched = 1;
        productionResult = "build_refinery_requested";
    } else if ((production == "build_refinery") && (refineryCount > 0)) {
        productionResult = "build_refinery_target_reached";
    } else if ((production == "build_barracks")
        && (TechTreeUnitCount(2, "Barracks", c_techCountQueuedOrBetter) <= 0)) {
        AIBuild(2, c_makePriorityTown, c_townMain, "Barracks", 1, c_makeDefault);
        productionDispatched = 1;
        productionResult = "build_barracks_requested";
    } else if ((production == "build_barracks")
        && (TechTreeUnitCount(2, "Barracks", c_techCountQueuedOrBetter) > 0)) {
        productionResult = "build_barracks_target_reached";
    } else if ((production == "build_factory")
        && (TechTreeUnitCount(2, "Factory", c_techCountQueuedOrBetter) <= 0)) {
        AIBuild(2, c_makePriorityTown, c_townMain, "Factory", 1, c_makeDefault);
        productionDispatched = 1;
        productionResult = "build_factory_requested";
    } else if ((production == "build_factory")
        && (TechTreeUnitCount(2, "Factory", c_techCountQueuedOrBetter) > 0)) {
        productionResult = "build_factory_target_reached";
    } else if ((production == "train_marine")
        && (TechTreeUnitCount(2, "Marine", c_techCountQueuedOrBetter) < 8)) {
        AITrain(2, c_makePriorityAttack, c_townMain, "Marine", 1);
        productionDispatched = 1;
        productionResult = "train_marine_requested";
    } else if ((production == "train_marine")
        && (TechTreeUnitCount(2, "Marine", c_techCountQueuedOrBetter) >= 8)) {
        productionResult = "train_marine_target_reached";
    } else if ((production == "train_marauder")
        && (TechTreeUnitCount(2, "Marauder", c_techCountQueuedOrBetter) < 8)) {
        AITrain(2, c_makePriorityAttack, c_townMain, "Marauder", 1);
        productionDispatched = 1;
        productionResult = "train_marauder_requested";
    } else if ((production == "train_marauder")
        && (TechTreeUnitCount(2, "Marauder", c_techCountQueuedOrBetter) >= 8)) {
        productionResult = "train_marauder_target_reached";
    } else if (production == "research_upgrade") {
        AIResearch(2, 4, -1, "TerranInfantryWeapons");
        productionDispatched = 1;
        productionResult = "research_upgrade_requested";
    }

    libVibeKernel_gf_WriteBankKey("ally", "last_model_economy", economy);
    libVibeKernel_gf_WriteBankKey("ally", "last_model_production", production);
    libVibeKernel_gf_WriteBankKey("ally", "last_model_economy_result", economyResult);
    libVibeKernel_gf_WriteBankKey("ally", "last_model_production_result", productionResult);
    libVibeKernel_gf_WriteBankInt("ally", "last_model_economy_dispatched", economyDispatched);
    libVibeKernel_gf_WriteBankInt("ally", "last_model_production_dispatched", productionDispatched);
    libVibeKernel_gf_WriteModelP2Snapshot();
    return true;
}

// The external imitation model is a P2 controller. It is accepted only from
// the explicit Bank source tag and records provenance before reusing the same
// owner/alliance-safe order implementation as the player command path.
bool libVibeKernel_gf_ProcessModelAllyCommand(string chat) {
    string modelSchema;
    string modelHash;
    string decisionId;
    string economyIntent;
    string productionIntent;
    if (libVibeKernel_gf_ReadBankKey("ally", "pending_source") != "ml_policy") {
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "rejected_model_source");
        return true;
    }
    modelSchema = libVibeKernel_gf_ReadBankKey("ally", "pending_model_schema");
    modelHash = libVibeKernel_gf_ReadBankKey("ally", "pending_model_hash");
    decisionId = libVibeKernel_gf_ReadBankKey("ally", "pending_decision_id");
    economyIntent = libVibeKernel_gf_ReadBankKey("ally", "pending_economy_intent");
    productionIntent = libVibeKernel_gf_ReadBankKey("ally", "pending_production_intent");
    if (modelSchema == "" || modelHash == "" || decisionId == "") {
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "rejected_model_provenance");
        return true;
    }
    if (economyIntent == "") { economyIntent = "maintain_economy"; }
    if (productionIntent == "") { productionIntent = "no_op"; }
    libVibeKernel_gf_WriteBankKey("ally", "last_source", "ml_policy");
    libVibeKernel_gf_WriteBankInt("ally", "last_issuer_player_id", 2);
    libVibeKernel_gf_WriteBankKey("ally", "last_model_schema", modelSchema);
    libVibeKernel_gf_WriteBankKey("ally", "last_model_hash", modelHash);
    libVibeKernel_gf_WriteBankKey("ally", "last_model_decision_id", decisionId);
    if (!libVibeKernel_gf_ApplyModelP2Intent(economyIntent, productionIntent)) {
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "rejected_model_intent");
        return true;
    }
    return libVibeKernel_gf_ProcessAllyCommand(chat);
}

bool libVibeKernel_gt_AllyCommand_Func(bool testConds, bool runActions) {
    string chat;
    if (testConds) { return true; }
    if (!runActions) { return true; }
    if (EventPlayer() != 1) { return true; }
    chat = EventChatMessage(false);
    return libVibeKernel_gf_ProcessAllyCommand(chat);
}

// ---- UnitWake 入口（API 模式主传输路径）----
// SC2 API 模式下 TimePeriodic/ChatMessage 触发器不触发，但 UnitCreated 触发器正常工作。
// Host 写入 pending_request_id 后，通过 SC2API RequestDebug(create_unit) 创建一个单位唤醒 Kernel。
// 触发器检查 Bank pending，有新请求则调用 BankPoll_Func 处理。
bool libVibeKernel_gt_UnitWake_Func(bool testConds, bool runActions) {
    string pendingId;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    // 诊断计数
    libVibeKernel_gv_mapCommandCount += 1;

    // 检查是否有 pending 请求
    pendingId = libVibeKernel_gf_ReadBankKey("index", "pending_request_id");
    if (pendingId == "") { return true; }
    if (pendingId == libVibeKernel_gv_lastPolledRequestId) { return true; }

    // 有新请求，调用 BankPoll 处理（testConds=false 让函数体执行）
    libVibeKernel_gt_BankPoll_Func(false, true);
    return true;
}

// ---- PollLoop 入口（Wait-based 轮询，API 模式主传输路径）----
// SC2 API 模式下 TimePeriodic/ChatMessage/UnitCreated 事件触发器不触发，
// 但 Wait 在触发器函数中可以正常工作（每次 Wait 让出控制权给游戏循环）。
// 本触发器使用 while(true) + Wait(0.5) 实现持续轮询 Bank pending。
// 启动方式：TimeElapsed 0.0 + TriggerExecute 双保险。
bool libVibeKernel_gt_PollLoop_Func(bool testConds, bool runActions) {
    string pendingId;
    string requestJson;
    string response;
    string opName;
    string pendingAllyCommand;
    string pendingAllySource;
    int pendingAllyPlayer;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    // 防止重复启动
    if (libVibeKernel_gv_pollLoopRunning) { return true; }
    libVibeKernel_gv_pollLoopRunning = true;

    // 写入标记：证明 PollLoop 被启动
    libVibeKernel_gf_WriteBankInt("diag", "pollloop_started", 1);
    // 构建指纹：确认真机跑的确实是合并过 3 处修复的这一版。
    libVibeKernel_gf_WriteBankInt("diag", "pollorder_fix", 2);
    libVibeKernel_gf_WriteBankInt("diag", "bankhandle_fix", 3);
    libVibeKernel_gf_WriteBankInt("diag", "merged_fix", 5);

    while (true) {
// ==== BEGIN VIBE_KERNEL_002_POLL_ORDER HEAD ====
        // ！！！读写顺序铁律（2026-08-08 真机取证）！！！
        // 循环体内任何 BankSave 都必须排在 pending_request_id 读取之后。
        // ReloadBank() 若这一拍没抓到 Host 刚写盘的请求（SC2 Bank 缓存，
        // CMRE-RUNTIME-003），紧随其后的写入会用内核内存态 BankSave 覆盖磁盘，
        // 把 Host 的 request/<id> 与 index/pending_request_id 永久抹掉 ——
        // 一次偶发漏读就此变成永久失败，且现场证据同时被销毁。
        libVibeKernel_gf_ReloadBank();
        // 诊断计数（纯内存自增，不落盘）
        libVibeKernel_gv_bankPollCount += 1;
// ==== BEGIN VIBE_KERNEL_005_FIRST_PASS_FLUSH ====
        // ！！！铁律 VIBE_KERNEL_005（2026-08-09 真机 L3/L4/L5/L6 四点二分取证）！！！
        //
        // 现象：整局 Bank 里 init 类标记（initlib_entered / init_entered /
        //       kernel_initialized / state_version / register_entrypoints_* /
        //       diag/pollloop_started）**一个都不落盘**，只有 Wait 之后异步线程写的键
        //       （watchdog_last_seen_poll、ally/p2_*）正常。伪装成「MapScript 被静默
        //       丢弃」，但内核其实一直在跑，误诊成本极高。
        //
        // 机理：map-init 阶段的 BankSave 只写内存，磁盘 flush 统一发生在游戏真正开跑
        //       （真机实测 t≈19s）。而 ReadBankKey() 内部会调 ReloadBank() →
        //       BankReload()，用**当时还是空的磁盘内容**覆盖内存态。
        //       若 ReloadBank 与首次 ReadBankKey 之间没有任何 BankSave，
        //       连续两次 reload 之间无脏数据可 flush，内存里的 init 标记直接蒸发。
        //
        //       基准(standalone)内核之所以正常，纯属巧合：它把 WriteModelP2Snapshot()
        //       放在循环开头（ReloadBank 之后、首次 ReadBankKey 之前），
        //       那次 BankSave 顺带把 init 标记逼着落了盘。
        //       VIBE_KERNEL_002 把所有写入挪到读之后，恰好抽掉了这次救命的 flush。
        //
        // 修法：只在**首帧**、且**夹在 ReloadBank 与首次 ReadBankKey 之间**补一次
        //       BankSave。稳态循环仍严格保持 VIBE_KERNEL_002 的读优先语义，
        //       不会覆盖 Host 请求；首帧时 Host 尚未发出任何请求，无覆盖风险。
        if (!libVibeKernel_gv_pollLoopFirstFlushed) {
            libVibeKernel_gv_pollLoopFirstFlushed = true;
            libVibeKernel_gf_WriteBankInt("diag", "pollloop_first_flush", 1);
        }
// ==== END VIBE_KERNEL_005_FIRST_PASS_FLUSH ====
        // 先把 pending 请求抢读进局部变量，之后任何写入都伤不到它。
        pendingId = libVibeKernel_gf_ReadBankKey("index", "pending_request_id");
        requestJson = "";
        if (pendingId != "" && pendingId != libVibeKernel_gv_lastPolledRequestId) {
            requestJson = libVibeKernel_gf_ReadBankKey("request", pendingId);
        }
// ==== END VIBE_KERNEL_002_POLL_ORDER HEAD ====

        // ChatMessage is not delivered reliably while a game is driven by
        // SC2API. The P1 API adapter mirrors its real team-chat message into
        // this pending key; only an explicitly P1-tagged command is accepted.
        pendingAllyPlayer = libVibeKernel_gf_ReadBankInt("ally", "pending_player_id");
        pendingAllyCommand = libVibeKernel_gf_ReadBankKey("ally", "pending_command");
        pendingAllySource = libVibeKernel_gf_ReadBankKey("ally", "pending_source");
        if (pendingAllyPlayer == 1 && pendingAllyCommand != ""
            && (pendingAllySource == "" || pendingAllySource == "p1_chat")) {
            libVibeKernel_gf_WriteBankKey("ally", "last_source", "p1_chat");
            libVibeKernel_gf_WriteBankInt("ally", "last_issuer_player_id", 1);
            libVibeKernel_gf_ProcessAllyCommand(pendingAllyCommand);
            libVibeKernel_gf_WriteBankKey("ally", "pending_command", "");
            libVibeKernel_gf_WriteBankInt("ally", "pending_player_id", 0);
            libVibeKernel_gf_WriteBankKey("ally", "pending_source", "");
            libVibeKernel_gf_WriteBankKey("ally", "pending_economy_intent", "");
            libVibeKernel_gf_WriteBankKey("ally", "pending_production_intent", "");
        } else if (pendingAllyPlayer == 2 && pendingAllyCommand != ""
            && pendingAllySource == "ml_policy") {
            libVibeKernel_gf_ProcessModelAllyCommand(pendingAllyCommand);
            libVibeKernel_gf_WriteBankKey("ally", "pending_command", "");
            libVibeKernel_gf_WriteBankInt("ally", "pending_player_id", 0);
            libVibeKernel_gf_WriteBankKey("ally", "pending_source", "");
            libVibeKernel_gf_WriteBankKey("ally", "pending_economy_intent", "");
            libVibeKernel_gf_WriteBankKey("ally", "pending_production_intent", "");
        }

// ==== BEGIN VIBE_KERNEL_002_POLL_ORDER TAIL ====
        // 请求已在循环开头抢读，这里只分发，不再重复读 Bank。
        if (requestJson != "") {
            // VIBE-KERNEL-001: consume before dispatch (poison-request guard).
            libVibeKernel_gv_lastPolledRequestId = pendingId;
            response = libVibeKernel_gf_Dispatch(requestJson);
            opName = libVibeKernel_gf_ArgsGet(requestJson, "operation");
            libVibeKernel_gf_EchoChat("[Vibe] " + opName + " done (id=" + pendingId + ")");
        }

        // P2 经济快照：必须排在请求分发之后（见循环开头的读写顺序铁律）。
        libVibeKernel_gf_WriteModelP2Snapshot();
// ==== END VIBE_KERNEL_002_POLL_ORDER TAIL ====

        // 等待 0.5 秒游戏时间（让出控制权给游戏循环）
        Wait(0.5, c_timeGame);
    }

    return true;
}

// ---- 注册入口 ----
// 必须在 InitTriggers() 之后调用（即所有库初始化完成后），
// 否则在 NativeLib 初始化前创建的触发器对象可能无效，导致事件不触发。
// 调用点：MapScript.galaxy 的 InitMap() 中 InitTriggers() 之后。
void libVibeKernel_gf_RegisterEntryPoints() {
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_entered", 1);
    if (libVibeKernel_gt_ChatCommand != null) { return; }

    // Chat 入口（手动调试用）
    libVibeKernel_gt_ChatCommand = TriggerCreate("libVibeKernel_gt_ChatCommand_Func");
    TriggerAddEventChatMessage(libVibeKernel_gt_ChatCommand, c_playerAny, "!vibe", false);
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_chat_done", 1);

    libVibeKernel_gt_AllyCommand = TriggerCreate("libVibeKernel_gt_AllyCommand_Func");
    TriggerAddEventChatMessage(libVibeKernel_gt_AllyCommand, c_playerAny, "!ally", false);
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_ally_chat_done", 1);

    // Bank 轮询入口（非 API 模式：每 0.5 秒检查一次）
    libVibeKernel_gt_BankPoll = TriggerCreate("libVibeKernel_gt_BankPoll_Func");
    TriggerAddEventTimePeriodic(libVibeKernel_gt_BankPoll, 0.5, c_timeGame);

    // UnitWake 入口（API 模式备用传输路径，通过单位创建事件唤醒）
    libVibeKernel_gt_UnitWake = TriggerCreate("libVibeKernel_gt_UnitWake_Func");
    TriggerAddEventUnitCreated(libVibeKernel_gt_UnitWake, null, "", "");

    // ！！！死代码铁律补充（2026-08-08 真机二次取证）！！！
    // TriggerAddEventTimeElapsed(t, 0.0, c_timeGame) 在 SC2 中会**同步触发**
    // 事件一次。如果被绑定 trigger 的 body 是 while(true)+Wait 的循环体
    // （PollLoop / Watchdog 这种），就会永久卡在 TriggerAddEventTimeElapsed
    // 本行，之后所有语句变死代码——表现为 "watchdog_done / done 永远不写
    // 但 chat_done 存在"。因此所有循环体 trigger 一律**不绑定 0.0 立即事件**，
    // 全部通过 TriggerExecute(t, false, false) 异步派发（显式 fire-and-forget）。

    // PollLoop 入口（API 模式主传输路径，Wait-based 持续轮询）
    // 仅创建 trigger；启动通过文末 TriggerExecute 显式异步 fire，
    // 避免 0.0 事件同步触发 while(true) 把后续注册/写 marker 卡死。
    libVibeKernel_gt_PollLoop = TriggerCreate("libVibeKernel_gt_PollLoop_Func");
    // 注意：此处不再 TriggerAddEventTimeElapsed(0.0) —— 详见上方铁律补充。
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_pollloop_trigger_created", 1);
// ==== BEGIN VIBE_KERNEL_001_WATCHDOG_REGISTER ====
    // 传输层自愈兜底。先于 PollLoop 派发注册，保证任何情况下 watchdog 都已就位。
    // watchdog 体内是 while(true)+Wait，waitUntilDone 必须为 false，
    // 否则本行之后全是死代码（历史事故：watchdog_done / register_entrypoints_done 从未写入）。
    libVibeKernel_gt_Watchdog = TriggerCreate("libVibeKernel_gt_Watchdog_Func");
    TriggerExecute(libVibeKernel_gt_Watchdog, false, false);   // 异步——见死代码铁律
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_watchdog_done", 1);
// ==== END VIBE_KERNEL_001_WATCHDOG_REGISTER ====

    // 注册完成标记必须写在 PollLoop 派发之前（PollLoop 进入后不再返回）。
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_done", 1);

    // 以显式异步 TriggerExecute 启动 PollLoop while(true) 循环；
    // 不依赖游戏时钟推进，也避免 TriggerAddEventTimeElapsed(0.0) 同步触发死代码。
    TriggerExecute(libVibeKernel_gt_PollLoop, false, false);   // 异步——见死代码铁律
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_pollloop_fired", 1);

}

// ---- 自注册包装器（供 InitLib 延迟调用）----
bool libVibeKernel_gf_RegisterEntryPoints_Func(bool testConds, bool runActions) {
    if (testConds) { return true; }
    if (!runActions) { return true; }
    libVibeKernel_gf_RegisterEntryPoints();
    return true;
}

// ---- 初始化 ----
void libVibeKernel_gf_Init() {
    if (libVibeKernel_gv_initialized) { return; }
    libVibeKernel_gv_initialized = true;

    // 银行写入优先（证明 Init 被进入，供 Host 端验证）
    libVibeKernel_gf_WriteBankInt("index", "init_entered", 1);

    libVibeKernel_gv_stateVersion = 0;
    libVibeKernel_gv_currentSession = "";
    libVibeKernel_gv_lastSequence = -1;
    libVibeKernel_gv_lastRequestId = "";
    libVibeKernel_gv_lastResponseJson = "";
    libVibeKernel_gv_requestCount = 0;
    libVibeKernel_gv_rejectedCount = 0;

    // 注意：触发器注册已移至 MapScript.galaxy 的 InitMap() 中 InitTriggers() 之后，
    // 由 libVibeKernel_gf_RegisterEntryPoints() 外部调用。
    // 原因：在 NativeLib 初始化前创建的触发器对象可能无效，导致事件不触发。

    // 注意：不在此处同步调用 BankPoll_Func，因为其内部 ReadBankKey 会 ReloadBank
    // (BankRemove+BankLoad)，导致内存中的 init 标记被清空后只剩最后几个 key。
    // UnitWake 触发器会在 Host 创建单位时调用 BankPoll_Func。

    // 写入初始化标记（Bank 操作可能失败，不影响触发器）
    libVibeKernel_gf_WriteBankInt("index", "kernel_initialized", 1);
    libVibeKernel_gf_WriteBankInt("index", "state_version", 0);
    libVibeKernel_gf_WriteBankInt("index", "bankpoll_sync_call_done", 1);
    libVibeKernel_gf_EchoChat("[Vibe] Kernel initialized. Use chat '!vibe <args>'.");
}

// ---- Auto-init 触发器（地图加载后自动初始化）----
bool libVibeKernel_gt_AutoInit_Func(bool testConds, bool runActions) {
    if (testConds) { return true; }
    if (!runActions) { return true; }
    libVibeKernel_gf_Init();
    return true;
}

trigger libVibeKernel_gt_AutoInit = null;

void libVibeKernel_InitLib() {
    trigger t;
    // 写入银行标记，证明 InitLib 被调用（供 Host 端验证）
    libVibeKernel_gf_WriteBankInt("index", "initlib_entered", 1);
    libVibeKernel_gf_Init();
// ==== BEGIN VIBE_KERNEL_004_NO_SYNC_REGISTER ====
    // ！！！铁律 VIBE_KERNEL_004（2026-08-09 真机 L1/L2/L2a/L2b/L3 五点对照取证）！！！
    //
    // 绝对禁止在 InitLib()（map-init 同步阶段）里同步调用 RegisterEntryPoints()。
    //
    // 现象：整局 Bank 里 init 类标记（initlib_entered / init_entered /
    //       kernel_initialized / state_version / register_entrypoints_*）**一个都不落盘**，
    //       只有 Wait 之后由异步线程写的键（watchdog_last_seen_poll、ally/p2_*）正常，
    //       表现极像"MapScript 被静默丢弃"，但其实内核一直在跑，误诊成本极高。
    //
    // 机理：map-init 阶段的 BankSave 是**缓冲**的，尚未 flush 到磁盘。
    //       RegisterEntryPoints() 会创建并派发 PollLoop / Watchdog，
    //       PollLoop 体内首个动作 ReloadBank()（BankRemove + BankLoad）
    //       会把**未落盘的内存态 Bank 整个清空并从磁盘重读**（此时磁盘还是空的），
    //       于是此前所有 init 标记灰飞烟灭。
    //       基准内核 gf_Init() 里"不在此处同步调用 BankPoll_Func"那段注释
    //       警告的就是同一个坑，只是这次从 RegisterEntryPoints 这条路又踩了一遍。
    //
    // 正确做法：只创建 TimeElapsed(0.0) 延迟触发器，让 RegisterEntryPoints 在
    //       完整 init 之后（InitTriggers 之后）异步执行。此时 Bank 已就绪，
    //       ReloadBank 不会吞掉任何东西。真机 L1（基准内核，同一路径）已证明
    //       TimeElapsed(0.0) 在 API 模式下可靠触发，6/6 init 标记全落盘。
    //
    // 反向对照：L2/L2a/L2b（保留同步调用，分别改 UIDisplayMessage / handle 缓存语义）
    //       全部 FAIL —— 证明这两个变量都不是根因，唯一自变量就是这一行同步调用。
    t = TriggerCreate("libVibeKernel_gf_RegisterEntryPoints_Func");
    TriggerAddEventTimeElapsed(t, 0.0, c_timeGame);
    // 严禁在此处追加 libVibeKernel_gf_RegisterEntryPoints(); —— 见上方铁律。
// ==== END VIBE_KERNEL_004_NO_SYNC_REGISTER ====
}

// ==== BEGIN STAGE26_FULL_INVOKE HANDLE_OPS ====
// ---- Stage 26: generated handle registry operations ----

string libVibeKernel_gf_HandleHandleQuery(string argsJson) {
    string handleType;
    int handleId;
    string aliveS;
    handleType = libVibeKernel_gf_ArgsGet(argsJson, "handle_type");
    handleId = libVibeKernel_gf_ArgsGetInt(argsJson, "handle_id");
    if (handleType == "unit") {
        aliveS = "false";
        if (libVibeHandles_gf_Has_unit(handleId)) { aliveS = "true"; }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.query", "OK", "{\"handle_type\":\"unit\",\"alive\":" + aliveS + ",\"handle_id\":" + IntToString(handleId) + "}");
    }
    if (handleType == "actor") {
        aliveS = "false";
        if (libVibeHandles_gf_Has_actor(handleId)) { aliveS = "true"; }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.query", "OK", "{\"handle_type\":\"actor\",\"alive\":" + aliveS + ",\"handle_id\":" + IntToString(handleId) + "}");
    }
    if (handleType == "aifilter") {
        aliveS = "false";
        if (libVibeHandles_gf_Has_aifilter(handleId)) { aliveS = "true"; }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "handle.query", "OK", "{\"handle_type\":\"aifilter\",\"alive\":" + aliveS + ",\"handle_id\":" + IntToString(handleId) + "}");
