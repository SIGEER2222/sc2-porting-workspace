include "TriggerLibs/NativeLib"
include "LibVibeKernel_h"

// === LibVibeKernel: SC2 Vibe 框架运行时 Kernel 实现 ===
// 依据 sc2-vibe完整实施计划.md 的 RPC 契约与 MVP 操作集
//
// 通信流程：
//   1. Host 将请求 JSON 写入 Bank(GalaxyVibe, section="request", key=request_id)
//   2. Host 通过 Bank 轮询或聊天 "!vibe <args>" 触发
//   3. Kernel 从 Bank 读取请求，解析 operation/args
//   4. Kernel 在白名单中查找 handler 并执行
//   5. Kernel 将响应 JSON 写入 Bank(section="response", key=request_id)
//   6. Host 轮询 Bank 读取响应

// ---- 最小字符串/参数解析工具 ----
// args 格式：key1=value1;key2=value2;...
// 简单的线性扫描解析器，避免 Galaxy JSON 解析的复杂性

// 简单 trim：去掉首尾空格（Galaxy 无原生 StringTrim）
string libVibeKernel_gf_Trim(string s) {
    int len;
    int start;
    int end;
    len = StringLength(s);
    start = 1;
    end = len;
    while (start <= end && StringSub(s, start, start) == " ") {
        start += 1;
    }
    while (end >= start && StringSub(s, end, end) == " ") {
        end -= 1;
    }
    if (start > end) { return ""; }
    return StringSub(s, start, end);
}

string libVibeKernel_gf_ArgsGet(string args, string key) {
    string search;
    int findPos;
    int valStart;
    int end;
    search = key + "=";
    findPos = StringFind(args, search, false);
    if (findPos < 0) { return ""; }
    valStart = findPos + StringLength(search);
    end = StringFind(StringSub(args, valStart, StringLength(args)), ";", false);
    if (end < 0) {
        return StringSub(args, valStart, StringLength(args));
    }
    // StringFind is 1-based and StringSub's end index is inclusive.
    // Exclude the delimiter itself from the parsed value.
    return StringSub(args, valStart, valStart + end - 2);
}

int libVibeKernel_gf_ArgsGetInt(string args, string key) {
    string v;
    v = libVibeKernel_gf_ArgsGet(args, key);
    if (v == "") { return 0; }
    return StringToInt(v);
}

fixed libVibeKernel_gf_ArgsGetFixed(string args, string key) {
    string v;
    v = libVibeKernel_gf_ArgsGet(args, key);
    if (v == "") { return 0.0; }
    return StringToFixed(v);
}

// ---- Bank 工具 ----
// SC2 会缓存已加载的 Bank。Host 从进程外改写 SC2Bank 文件后，
// game-side 读取路径必须先卸载旧 handle 再 BankLoad，才能看到新 pending_request_id。
// 写入路径只 EnsureBankLoaded，避免连续写 response/index key 时 reload 丢失内存中尚未保存的键。
void libVibeKernel_gf_ReloadBank() {
    if (libVibeKernel_gv_bankHandle == null) {
        libVibeKernel_gv_bankHandle = BankLoad(libVibeKernel_gv_BankName, libVibeKernel_gv_BankPlayer);
    } else {
        BankReload(libVibeKernel_gv_bankHandle);
    }
    if (libVibeKernel_gv_bankHandle != null) {
        BankWait(libVibeKernel_gv_bankHandle);
    }
}

void libVibeKernel_gf_EnsureBankLoaded() {
    if (libVibeKernel_gv_bankHandle == null) {
        libVibeKernel_gv_bankHandle = BankLoad(libVibeKernel_gv_BankName, libVibeKernel_gv_BankPlayer);
        if (libVibeKernel_gv_bankHandle != null) {
            BankWait(libVibeKernel_gv_bankHandle);
        }
    }
}

void libVibeKernel_gf_WriteBankKey(string section, string key, string value) {
    libVibeKernel_gf_EnsureBankLoaded();
    if (libVibeKernel_gv_bankHandle == null) { return; }
    BankValueSetFromString(libVibeKernel_gv_bankHandle, section, key, value);
    BankSave(libVibeKernel_gv_bankHandle);
}

string libVibeKernel_gf_ReadBankKey(string section, string key) {
    libVibeKernel_gf_ReloadBank();
    if (libVibeKernel_gv_bankHandle == null) { return ""; }
    return BankValueGetAsString(libVibeKernel_gv_bankHandle, section, key);
}

void libVibeKernel_gf_WriteBankInt(string section, string key, int value) {
    libVibeKernel_gf_EnsureBankLoaded();
    if (libVibeKernel_gv_bankHandle == null) { return; }
    BankValueSetFromInt(libVibeKernel_gv_bankHandle, section, key, value);
    BankSave(libVibeKernel_gv_bankHandle);
}

int libVibeKernel_gf_ReadBankInt(string section, string key) {
    libVibeKernel_gf_ReloadBank();
    if (libVibeKernel_gv_bankHandle == null) { return 0; }
    return BankValueGetAsInt(libVibeKernel_gv_bankHandle, section, key);
}

void libVibeKernel_gf_EchoChat(string message) {
    UIDisplayMessage(PlayerGroupAll(), c_messageAreaChat, StringToText(message));
}

// ---- Session 与幂等检查 ----
bool libVibeKernel_gf_CheckSession(string sessionId) {
    if (sessionId == "") { return false; }
    if (libVibeKernel_gv_currentSession == "") {
        libVibeKernel_gv_currentSession = sessionId;
        return true;
    }
    return libVibeKernel_gv_currentSession == sessionId;
}

bool libVibeKernel_gf_CheckIdempotency(string requestId) {
    string existing;
    // 检查 Bank 中是否已有该 request_id 的响应
    existing = libVibeKernel_gf_ReadBankKey("response", requestId);
    if (existing != "") {
        // 已处理过，返回缓存结果
        libVibeKernel_gv_lastRequestId = requestId;
        libVibeKernel_gv_lastResponseJson = existing;
        return false;
    }
    return true;
}

// ---- 响应生成 ----
string libVibeKernel_gf_MakeResponse(string kind, string sessionId, string requestId, int sequence, string operation, string errorCode, string payloadJson) {
    string resp;
    // 紧凑 JSON 格式（Galaxy 字符串拼接）
    resp = "{";
    resp = resp + "\"kind\":\"" + kind + "\",";
    resp = resp + "\"protocol_version\":\"vibe/1.0\",";
    resp = resp + "\"session_id\":\"" + sessionId + "\",";
    resp = resp + "\"request_id\":\"" + requestId + "\",";
    resp = resp + "\"sequence\":" + IntToString(sequence) + ",";
    resp = resp + "\"operation\":\"" + operation + "\",";
    resp = resp + "\"error_code\":\"" + errorCode + "\",";
    resp = resp + "\"payload\":" + payloadJson + ",";
    resp = resp + "\"state_version\":" + IntToString(libVibeKernel_gv_stateVersion);
    resp = resp + "}";
    return resp;
}

void libVibeKernel_gf_WriteResponseToBank(string requestId, string responseJson) {
    libVibeKernel_gf_WriteBankKey("response", requestId, responseJson);
    // 同时更新 last-request 索引（供 Host 快速查询最新响应）
    libVibeKernel_gf_WriteBankKey("index", "last_request_id", requestId);
    libVibeKernel_gf_WriteBankInt("index", "state_version", libVibeKernel_gv_stateVersion);
}

// ---- 操作 handler 实现 ----

string libVibeKernel_gf_HandleSystemPing(string argsJson) {
    string payload;
    // ping 不产生副作用，不递增 state_version
    payload = "{\"pong\":true,\"request_count\":" + IntToString(libVibeKernel_gv_requestCount) + ",\"rejected_count\":" + IntToString(libVibeKernel_gv_rejectedCount) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "system.ping", "OK", payload);
}

string libVibeKernel_gf_HandleScenarioReset(string argsJson) {
    int lv_p;
    unitgroup lv_units;
    unit lv_u;
    int lv_killed;
    string payload;
    // 杀死所有非 PreventDefeat 单位（保留 PreventDefeat 单位避免任务失败）
    lv_p = 1;
    lv_killed = 0;
    for (lv_p = 1; lv_p <= 15; lv_p += 1) {
        lv_units = UnitGroup(null, lv_p, RegionEntireMap(),
            UnitFilter(0, (1 << c_targetFilterPreventDefeat), 0,
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        while (UnitGroupCount(lv_units, c_unitCountAlive) > 0) {
            lv_u = UnitGroupUnit(lv_units, 1);
            if (lv_u != null) {
                UnitRemove(lv_u);
                lv_killed += 1;
            } else {
                break;
            }
        }
    }
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"killed\":" + IntToString(lv_killed) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "scenario.reset", "OK", payload);
}

string libVibeKernel_gf_HandleUnitSpawn(string argsJson) {
    string unitType;
    int count;
    int player;
    fixed x;
    fixed y;
    point spawnPoint;
    unitgroup createdGroup;
    int created;
    string payload;
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");
    count = libVibeKernel_gf_ArgsGetInt(argsJson, "count");
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    x = libVibeKernel_gf_ArgsGetFixed(argsJson, "x");
    y = libVibeKernel_gf_ArgsGetFixed(argsJson, "y");

    // 参数校验
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "INVALID_ARGS", "{}");
    }
    if (count < 1 || count > 200) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "COUNT_OUT_OF_RANGE", "{}");
    }
    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "PLAYER_OUT_OF_RANGE", "{}");
    }

    if (x != 0.0 || y != 0.0) {
        spawnPoint = Point(x, y);
    } else {
        spawnPoint = PlayerStartLocation(player);
    }
    if (spawnPoint == null) {
        spawnPoint = Point(0.0, 0.0);
    }

    createdGroup = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, player, spawnPoint, 270.0);
    created = UnitGroupCount(createdGroup, c_unitCountAlive);
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"created\":" + IntToString(created) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.spawn", "OK", payload);
}

string libVibeKernel_gf_HandleUnitKill(string argsJson) {
    int player;
    string unitType;
    string allFlag;
    unitgroup lv_units;
    unit lv_u;
    int lv_killed;
    int lv_i;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");
    allFlag = libVibeKernel_gf_ArgsGet(argsJson, "all");

    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.kill", "PLAYER_OUT_OF_RANGE", "{}");
    }

    lv_killed = 0;

    if (allFlag == "1" || allFlag == "true") {
        // 杀死所有玩家单位（保留 PreventDefeat）
        for (lv_i = 1; lv_i <= 15; lv_i += 1) {
            lv_units = UnitGroup(null, lv_i, RegionEntireMap(),
                UnitFilter(0, (1 << c_targetFilterPreventDefeat), 0,
                    (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
            while (UnitGroupCount(lv_units, c_unitCountAlive) > 0) {
                lv_u = UnitGroupUnit(lv_units, 1);
                if (lv_u != null) {
                    UnitKill(lv_u);
                    lv_killed += 1;
                } else {
                    break;
                }
            }
        }
    } else {
        if (unitType != "" && !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
            return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.kill", "INVALID_ARGS", "{}");
        }
        lv_units = UnitGroup(unitType, player, RegionEntireMap(),
            UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        while (UnitGroupCount(lv_units, c_unitCountAlive) > 0) {
            lv_u = UnitGroupUnit(lv_units, 1);
            if (lv_u != null) {
                UnitKill(lv_u);
                lv_killed += 1;
            } else {
                break;
            }
        }
    }

    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"killed\":" + IntToString(lv_killed) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.kill", "OK", payload);
}

string libVibeKernel_gf_HandleUnitSetVital(string argsJson) {
    int unitTag;
    string vital;
    fixed value;
    unit lv_u;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    vital = libVibeKernel_gf_ArgsGet(argsJson, "vital");
    value = libVibeKernel_gf_ArgsGetFixed(argsJson, "value");

    lv_u = UnitFromId(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "UNIT_NOT_FOUND", "{}");
    }
    if (value < 0.0 || value > 1000000.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "VITAL_OUT_OF_RANGE", "{}");
    }

    if (vital == "life") {
        UnitSetPropertyFixed(lv_u, c_unitPropLife, value);
    } else if (vital == "shield") {
        UnitSetPropertyFixed(lv_u, c_unitPropShields, value);
    } else if (vital == "energy") {
        UnitSetPropertyFixed(lv_u, c_unitPropEnergy, value);
    } else {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "INVALID_ARGS", "{}");
    }

    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"vital\":\"" + vital + "\",\"value\":" + FixedToString(value, 2) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "unit.set_vital", "OK", payload);
}

string libVibeKernel_gf_HandlePlayerSetResource(string argsJson) {
    int player;
    string resource;
    int value;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    resource = libVibeKernel_gf_ArgsGet(argsJson, "resource");
    value = libVibeKernel_gf_ArgsGetInt(argsJson, "value");

    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "PLAYER_OUT_OF_RANGE", "{}");
    }
    if (value < 0 || value > 999999) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "RESOURCE_OUT_OF_RANGE", "{}");
    }

    if (resource == "minerals") {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, value);
    } else if (resource == "vespene") {
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, value);
    } else if (resource == "supply") {
        PlayerModifyPropertyInt(player, c_playerPropSuppliesMade, c_playerPropOperSetTo, value);
    } else {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "INVALID_ARGS", "{}");
    }

    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"player\":" + IntToString(player) + ",\"resource\":\"" + resource + "\",\"value\":" + IntToString(value) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "player.set_resource", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnits(string argsJson) {
    int player;
    string unitType;
    unitgroup lv_units;
    int count;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");

    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.units", "PLAYER_OUT_OF_RANGE", "{}");
    }

    lv_units = UnitGroup(unitType, player, RegionEntireMap(),
        UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    count = UnitGroupCount(lv_units, c_unitCountAlive);

    // 不产生副作用，不递增 state_version
    payload = "{\"count\":" + IntToString(count) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.units", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnit(string argsJson) {
    int unitTag;
    unit lv_u;
    fixed life;
    fixed shields;
    fixed energy;
    int owner;
    string typeName;
    point pos;
    fixed px;
    fixed py;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    lv_u = UnitFromId(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit", "UNIT_NOT_FOUND", "{}");
    }

    life = UnitGetPropertyFixed(lv_u, c_unitPropLife, true);
    shields = UnitGetPropertyFixed(lv_u, c_unitPropShields, true);
    energy = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, true);
    owner = UnitGetOwner(lv_u);
    typeName = UnitGetType(lv_u);
    pos = null;
    px = 0.0;
    py = 0.0;
    if (owner >= 0) {
        pos = UnitGetPosition(lv_u);
        if (pos != null) {
            px = PointGetX(pos);
            py = PointGetY(pos);
        }
    }

    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"type\":\"" + typeName + "\",\"owner\":" + IntToString(owner) + ",\"life\":" + FixedToString(life, 2) + ",\"shields\":" + FixedToString(shields, 2) + ",\"energy\":" + FixedToString(energy, 2) + ",\"x\":" + FixedToString(px, 2) + ",\"y\":" + FixedToString(py, 2) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit", "OK", payload);
}

string libVibeKernel_gf_HandleQueryMission(string argsJson) {
    int lv_p;
    string players;
    int minerals;
    int vespene;
    int supplyUsed;
    int supplyCap;
    string payload;
    players = "[";
    for (lv_p = 1; lv_p <= 15; lv_p += 1) {
        if (PlayerStatus(lv_p) == c_playerStatusActive) {
            if (StringLength(players) > 1) { players = players + ","; }
            players = players + IntToString(lv_p);
        }
    }
    players = players + "]";

    minerals = PlayerGetPropertyInt(1, c_playerPropMinerals);
    vespene = PlayerGetPropertyInt(1, c_playerPropVespene);
    supplyUsed = PlayerGetPropertyInt(1, c_playerPropSuppliesUsed);
    supplyCap = PlayerGetPropertyInt(1, c_playerPropSuppliesMade);

    payload = "{\"active_players\":" + players + ",\"mission_time\":" + FixedToString(GameGetMissionTime(), 2) + ",\"p1_minerals\":" + IntToString(minerals) + ",\"p1_vespene\":" + IntToString(vespene) + ",\"p1_supply_used\":" + IntToString(supplyUsed) + ",\"p1_supply_cap\":" + IntToString(supplyCap) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.mission", "OK", payload);
}

string libVibeKernel_gf_HandleVisualActorTint(string argsJson) {
    int unitTag;
    string colorStr;
    unit lv_u;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    colorStr = libVibeKernel_gf_ArgsGet(argsJson, "color");

    lv_u = UnitFromId(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_tint", "UNIT_NOT_FOUND", "{}");
    }

    // ActorScopeSend 设置单位 tint（colorStr 格式 R,G,B 或 hex）
    ActorScopeSend(ActorScopeFromUnit(lv_u), "SetTintColor {" + colorStr + "}");
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"color\":\"" + colorStr + "\"}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_tint", "OK", payload);
}

string libVibeKernel_gf_HandleVisualActorScale(string argsJson) {
    int unitTag;
    fixed scale;
    unit lv_u;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    scale = libVibeKernel_gf_ArgsGetFixed(argsJson, "scale");

    lv_u = UnitFromId(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_scale", "UNIT_NOT_FOUND", "{}");
    }
    if (scale < 0.01 || scale > 100.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_scale", "VITAL_OUT_OF_RANGE", "{}");
    }

    ActorScopeSend(ActorScopeFromUnit(lv_u), "SetScale {" + FixedToString(scale, 3) + "}");
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"scale\":" + FixedToString(scale, 3) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_scale", "OK", payload);
}

string libVibeKernel_gf_HandleVisualActorOpacity(string argsJson) {
    int unitTag;
    fixed opacity;
    unit lv_u;
    int opacityPct;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    opacity = libVibeKernel_gf_ArgsGetFixed(argsJson, "opacity");

    lv_u = UnitFromId(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_opacity", "UNIT_NOT_FOUND", "{}");
    }
    if (opacity < 0.0 || opacity > 1.0) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_opacity", "VITAL_OUT_OF_RANGE", "{}");
    }

    // opacity 0-1 -> 0-100 for actor
    opacityPct = FixedToInt(opacity * 100.0);
    ActorScopeSend(ActorScopeFromUnit(lv_u), "SetOpacity {" + IntToString(opacityPct) + "}");
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"opacity\":" + FixedToString(opacity, 3) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "visual.actor_opacity", "OK", payload);
}

// ---- Explicit function registry handlers ----
// This is the Galaxy-side implementation map for function-registry.json.
// Keep this explicit: function IDs must never become arbitrary function names.
string libVibeKernel_gf_FunctionVibeTestPing(string argsJson) {
    string nonce;
    nonce = libVibeKernel_gf_ArgsGet(argsJson, "arg_nonce");
    return "{\"function_id\":\"vibe.test.ping\",\"message\":\"pong\",\"nonce\":\"" + nonce + "\"}";
}

string libVibeKernel_gf_FunctionPlayerSetResource(string argsJson) {
    int player;
    string resource;
    int value;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    resource = libVibeKernel_gf_ArgsGet(argsJson, "arg_resource");
    value = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_value");
    if (player < 1 || player > 15 || (resource != "minerals" && resource != "vespene") || value < 0 || value > 999999) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    if (resource == "minerals") {
        PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, value);
    } else {
        PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, value);
    }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.player.set_resource\",\"player\":" + IntToString(player) + ",\"resource\":\"" + resource + "\",\"value\":" + IntToString(value) + "}");
}

string libVibeKernel_gf_FunctionUnitSpawn(string argsJson) {
    string unitType;
    int count;
    int player;
    fixed x;
    fixed y;
    point spawnPoint;
    unitgroup createdGroup;
    unit createdUnit;
    int created;
    int unitTag;
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "arg_unit_type");
    count = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_count");
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    x = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_x");
    y = libVibeKernel_gf_ArgsGetFixed(argsJson, "arg_y");
    if (unitType == "" || !CatalogEntryIsValid(c_gameCatalogUnit, unitType) || count < 1 || count > 200 || player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    if (x != 0.0 || y != 0.0) { spawnPoint = Point(x, y); }
    else { spawnPoint = PlayerStartLocation(player); }
    if (spawnPoint == null) { spawnPoint = Point(0.0, 0.0); }
    createdGroup = UnitCreate(count, unitType, c_unitCreateIgnorePlacement, player, spawnPoint, 270.0);
    created = UnitGroupCount(createdGroup, c_unitCountAlive);
    unitTag = 0;
    if (created > 0) {
        createdUnit = UnitGroupUnit(createdGroup, 1);
        if (createdUnit != null) { unitTag = UnitGetTag(createdUnit); }
    }
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.spawn\",\"created\":" + IntToString(created) + ",\"unit_tag\":" + IntToString(unitTag) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}");
}

string libVibeKernel_gf_FunctionQueryUnits(string argsJson) {
    int player;
    string unitType;
    unitgroup units;
    unit current;
    int index;
    int total;
    int count;
    int owner;
    string currentType;
    fixed currentLife;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "arg_unit_type");
    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    units = UnitGroup(unitType, player, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    total = UnitGroupCount(units, c_unitCountAll);
    count = 0;
    for (index = 1; index <= total; index += 1) {
        current = UnitGroupUnit(units, index);
        if (current != null) {
            owner = UnitGetOwner(current);
            currentType = UnitGetType(current);
            currentLife = UnitGetPropertyFixed(current, c_unitPropLife, true);
            if (UnitIsAlive(current) && currentLife > 0.0 && owner >= 1 && owner <= 15 && currentType != "" &&
                (player == 0 || owner == player) && (unitType == "" || currentType == unitType)) {
                count += 1;
            }
        }
    }
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.query.units\",\"count\":" + IntToString(count) + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}");
}

string libVibeKernel_gf_FunctionUnitKill(string argsJson) {
    int unitTag;
    unit target;
    unitgroup candidates;
    unit current;
    int ownerPlayer;
    int index;
    int total;
    bool found;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_unit_tag");
    target = null;
    found = false;
    if (unitTag < 1) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    // UnitGetTag returns a runtime tag, not the editor unit id accepted by
    // UnitFromId. Resolve the tag against live groups before killing it.
    for (ownerPlayer = 1; ownerPlayer <= 15; ownerPlayer += 1) {
        if (found) { break; }
        candidates = UnitGroup(null, ownerPlayer, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        total = UnitGroupCount(candidates, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(candidates, index);
            if (current != null && UnitGetTag(current) == unitTag &&
                UnitGetPropertyFixed(current, c_unitPropLife, true) > 0.0 && UnitGetType(current) != "") {
                target = current;
                found = true;
                break;
            }
        }
    }
    if (!found || target == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "UNIT_NOT_FOUND", "{}");
    }
    UnitKill(target);
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.kill\",\"unit_tag\":" + IntToString(unitTag) + ",\"killed\":true}");
}

string libVibeKernel_gf_FunctionUnitAttack(string argsJson) {
    int attackerTag;
    int targetTag;
    unitgroup candidates;
    unit current;
    unit attacker;
    unit target;
    int index;
    int total;
    int attackerOwner;
    int targetOwner;
    string targetType;
    attackerTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_attacker_tag");
    targetTag = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_target_tag");
    attacker = null;
    target = null;
    if (attackerTag < 1 || targetTag < 1 || attackerTag == targetTag) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"invalid_tags\"}");
    }
    candidates = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    total = UnitGroupCount(candidates, c_unitCountAll);
    for (index = 1; index <= total; index += 1) {
        current = UnitGroupUnit(candidates, index);
        if (current != null && UnitIsAlive(current) && UnitGetPropertyFixed(current, c_unitPropLife, true) > 0.0) {
            if (UnitGetTag(current) == attackerTag) { attacker = current; }
            if (UnitGetTag(current) == targetTag) { target = current; }
            if (attacker != null && target != null) { break; }
        }
    }
    if (attacker == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"attacker_not_found\"}");
    }
    if (target == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"target_not_found_or_stale\"}");
    }
    attackerOwner = UnitGetOwner(attacker);
    targetOwner = UnitGetOwner(target);
    if (attackerOwner < 1 || attackerOwner > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"attacker_owner_invalid\"}");
    }
    if (targetOwner < 1 || targetOwner > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"target_neutral\"}");
    }
    if (!PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupEnemy, attackerOwner), targetOwner)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"target_ally\"}");
    }
    targetType = UnitGetType(target);
    UnitIssueOrder(attacker, OrderTargetingUnit(AbilityCommand("attack", 0), target), c_orderQueueReplace);
    libVibeKernel_gv_stateVersion += 1;
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.unit.attack\",\"attacker_tag\":" + IntToString(attackerTag) + ",\"target_tag\":" + IntToString(targetTag) + ",\"target_owner\":" + IntToString(targetOwner) + ",\"target_type\":\"" + targetType + "\",\"issued\":true}");
}

string libVibeKernel_gf_FunctionQueryStructures(string argsJson) {
    int ownerPlayer;
    int firstOwner;
    int lastOwner;
    int scanOwner;
    string unitType;
    string currentType;
    unitgroup structures;
    unit current;
    int index;
    int total;
    int count;
    string entries;
    int currentOwner;
    int currentTag;
    ownerPlayer = libVibeKernel_gf_ArgsGetInt(argsJson, "arg_owner_player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "arg_unit_type");
    if (ownerPlayer < 0 || ownerPlayer > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"owner_out_of_range\"}");
    }
    if (unitType != "" && !CatalogEntryIsValid(c_gameCatalogUnit, unitType)) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{\"reason\":\"unit_type_not_found\"}");
    }
    firstOwner = 1;
    lastOwner = 15;
    if (ownerPlayer > 0) { firstOwner = ownerPlayer; lastOwner = ownerPlayer; }
    count = 0;
    entries = "[";
    for (scanOwner = firstOwner; scanOwner <= lastOwner; scanOwner += 1) {
        if (unitType == "") {
            structures = UnitGroup(null, scanOwner, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        } else {
            structures = UnitGroup(unitType, scanOwner, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        }
        total = UnitGroupCount(structures, c_unitCountAll);
        for (index = 1; index <= total; index += 1) {
            current = UnitGroupUnit(structures, index);
            if (current != null && UnitIsAlive(current) && UnitGetPropertyFixed(current, c_unitPropLife, true) > 0.0) {
                currentType = UnitGetType(current);
                currentOwner = UnitGetOwner(current);
                if (currentOwner == scanOwner && UnitTypeTestAttribute(currentType, c_unitAttributeStructure)) {
                    currentTag = UnitGetTag(current);
                    if (count > 0) { entries = entries + ","; }
                    entries = entries + "{\"owner\":" + IntToString(currentOwner) + ",\"unit_type\":\"" + currentType + "\",\"unit_tag\":" + IntToString(currentTag) + "}";
                    count += 1;
                }
            }
        }
    }
    entries = entries + "]";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", "{\"function_id\":\"vibe.query.structures\",\"owner_player\":" + IntToString(ownerPlayer) + ",\"unit_type\":\"" + unitType + "\",\"live_count\":" + IntToString(count) + ",\"structures\":" + entries + "}");
}

string libVibeKernel_gf_HandleFunctionInvoke(string argsJson) {
    string functionId;
    string argNames;
    string nonce;
    functionId = libVibeKernel_gf_ArgsGet(argsJson, "function_id");
    argNames = libVibeKernel_gf_ArgsGet(argsJson, "arg_names");
    if (functionId == "vibe.test.ping") {
        if (argNames != "nonce") { return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}"); }
        nonce = libVibeKernel_gf_ArgsGet(argsJson, "arg_nonce");
        if (StringLength(nonce) > 64 || StringFind(nonce, ";", false) >= 0 || StringFind(nonce, "=", false) >= 0 || StringFind(nonce, "\"", false) >= 0 || StringFind(nonce, "\\", false) >= 0 || StringFind(nonce, "{", false) >= 0 || StringFind(nonce, "}", false) >= 0) {
            return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
        }
        return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "OK", libVibeKernel_gf_FunctionVibeTestPing(argsJson));
    }
    if (functionId == "vibe.player.set_resource" && argNames == "player,resource,value") { return libVibeKernel_gf_FunctionPlayerSetResource(argsJson); }
    if (functionId == "vibe.unit.spawn" && argNames == "count,player,unit_type,x,y") { return libVibeKernel_gf_FunctionUnitSpawn(argsJson); }
    if (functionId == "vibe.query.units" && argNames == "player,unit_type") { return libVibeKernel_gf_FunctionQueryUnits(argsJson); }
    if (functionId == "vibe.unit.kill" && argNames == "unit_tag") { return libVibeKernel_gf_FunctionUnitKill(argsJson); }
    if (functionId == "vibe.unit.attack" && argNames == "attacker_tag,target_tag") { return libVibeKernel_gf_FunctionUnitAttack(argsJson); }
    if (functionId == "vibe.query.structures" && argNames == "owner_player,unit_type") { return libVibeKernel_gf_FunctionQueryStructures(argsJson); }
    if (functionId == "vibe.player.set_resource" || functionId == "vibe.unit.spawn" || functionId == "vibe.query.units" || functionId == "vibe.unit.kill" || functionId == "vibe.unit.attack" || functionId == "vibe.query.structures") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "INVALID_ARGS", "{}");
    }
    return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "function.invoke", "FUNCTION_NOT_FOUND", "{}");
}

// ---- Stage 1 动态诊断 handler ----

string libVibeKernel_gf_HandleUpgradeSetLevel(string argsJson) {
    int player;
    string upgrade;
    int level;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    upgrade = libVibeKernel_gf_ArgsGet(argsJson, "upgrade");
    level = libVibeKernel_gf_ArgsGetInt(argsJson, "level");

    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "PLAYER_OUT_OF_RANGE", "{}");
    }
    if (level < 0 || level > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "INVALID_LEVEL", "{}");
    }
    if (upgrade == "") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "INVALID_ARGS", "{}");
    }

    libNtve_gf_SetUpgradeLevelForPlayer(player, upgrade, level);
    libVibeKernel_gv_stateVersion += 1;
    payload = "{\"applied\":1,\"player\":" + IntToString(player) + ",\"upgrade\":\"" + upgrade + "\",\"level\":" + IntToString(level) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "upgrade.set_level", "OK", payload);
}

string libVibeKernel_gf_HandleTechTreeCheck(string argsJson) {
    int player;
    string upgrade;
    int count;
    int unlocked;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    upgrade = libVibeKernel_gf_ArgsGet(argsJson, "upgrade");

    if (player < 1 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "tech_tree.check", "PLAYER_OUT_OF_RANGE", "{}");
    }
    if (upgrade == "") {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "tech_tree.check", "INVALID_ARGS", "{}");
    }

    count = TechTreeUpgradeCount(player, upgrade, c_techCountCompleteOnly);
    unlocked = 0;
    if (count > 0) { unlocked = 1; }
    // 查询不产生副作用，不递增 state_version
    payload = "{\"count\":" + IntToString(count) + ",\"unlocked\":" + IntToString(unlocked) + ",\"upgrade\":\"" + upgrade + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "tech_tree.check", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnitTags(string argsJson) {
    int player;
    string unitType;
    unitgroup lv_units;
    int count;
    int lv_i;
    unit lv_u;
    int lv_tag;
    string tags;
    string payload;
    player = libVibeKernel_gf_ArgsGetInt(argsJson, "player");
    unitType = libVibeKernel_gf_ArgsGet(argsJson, "unit_type");

    if (player < 0 || player > 15) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_tags", "PLAYER_OUT_OF_RANGE", "{}");
    }

    if (unitType == "") {
        lv_units = UnitGroup(null, player, RegionEntireMap(),
            UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    } else {
        lv_units = UnitGroup(unitType, player, RegionEntireMap(),
            UnitFilter(0, 0, 0, (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    }
    count = UnitGroupCount(lv_units, c_unitCountAlive);
    tags = "[";
    for (lv_i = 1; lv_i <= count; lv_i += 1) {
        lv_u = UnitGroupUnit(lv_units, lv_i);
        if (lv_u != null) {
            lv_tag = UnitGetTag(lv_u);
            if (StringLength(tags) > 1) { tags = tags + ","; }
            tags = tags + IntToString(lv_tag);
        }
    }
    tags = tags + "]";
    // 查询不产生副作用，不递增 state_version
    payload = "{\"count\":" + IntToString(count) + ",\"tags\":" + tags + ",\"unit_type\":\"" + unitType + "\",\"player\":" + IntToString(player) + "}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_tags", "OK", payload);
}

string libVibeKernel_gf_HandleQueryUnitAttrs(string argsJson) {
    int unitTag;
    unit lv_u;
    string typeName;
    fixed life;
    fixed maxLife;
    fixed shields;
    fixed energy;
    fixed armor;
    string payload;
    unitTag = libVibeKernel_gf_ArgsGetInt(argsJson, "unit_tag");
    lv_u = UnitFromId(unitTag);
    if (lv_u == null) {
        return libVibeKernel_gf_MakeResponse("error", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_attrs", "UNIT_NOT_FOUND", "{}");
    }

    typeName = UnitGetType(lv_u);
    life = UnitGetPropertyFixed(lv_u, c_unitPropLife, true);
    maxLife = UnitGetPropertyFixed(lv_u, c_unitPropLifeMax, true);
    shields = UnitGetPropertyFixed(lv_u, c_unitPropShields, true);
    energy = UnitGetPropertyFixed(lv_u, c_unitPropEnergy, true);
    armor = libNtve_gf_CatalogFieldValueGetAsReal(c_gameCatalogUnit, typeName, "ArmorArray[0].Value", UnitGetOwner(lv_u));
    // 查询不产生副作用，不递增 state_version
    // MVP: weapon_damage/weapon_range/attributes 标 unavailable（Catalog 路径复杂，延后）
    payload = "{\"unit_tag\":" + IntToString(unitTag) + ",\"unit_type\":\"" + typeName + "\",\"life\":" + FixedToString(life, 2) + ",\"max_life\":" + FixedToString(maxLife, 2) + ",\"shields\":" + FixedToString(shields, 2) + ",\"energy\":" + FixedToString(energy, 2) + ",\"armor\":" + FixedToString(armor, 2) + ",\"weapon_damage\":\"unavailable\",\"weapon_range\":\"unavailable\",\"attributes\":\"unavailable\"}";
    return libVibeKernel_gf_MakeResponse("result", libVibeKernel_gv_currentSession, libVibeKernel_gv_lastRequestId, libVibeKernel_gv_lastSequence, "query.unit_attrs", "OK", payload);
}

// ---- 主分发器 ----
string libVibeKernel_gf_Dispatch(string requestJson) {
    string sessionId;
    string requestId;
    int sequence;
    string operation;
    string args;
    string result;
    // 解析请求字段（简单 key=value 解析）
    // 注：args 直接嵌入 requestJson 中（key=value;key=value 格式），
    // 不单独提取 args 字段，handler 直接从 requestJson 中读取参数
    sessionId = libVibeKernel_gf_ArgsGet(requestJson, "session_id");
    requestId = libVibeKernel_gf_ArgsGet(requestJson, "request_id");
    sequence = libVibeKernel_gf_ArgsGetInt(requestJson, "sequence");
    operation = libVibeKernel_gf_ArgsGet(requestJson, "operation");
    // args 直接使用完整 requestJson，handler 通过 ArgsGet 查找具体参数
    args = requestJson;

    libVibeKernel_gv_lastRequestId = requestId;
    libVibeKernel_gv_lastSequence = sequence;
    libVibeKernel_gv_requestCount += 1;

    // 1. Session 检查
    if (!libVibeKernel_gf_CheckSession(sessionId)) {
        libVibeKernel_gv_rejectedCount += 1;
        return libVibeKernel_gf_MakeResponse("error", sessionId, requestId, sequence, operation, "SESSION_EXPIRED", "{}");
    }

    // 2. 幂等检查
    if (!libVibeKernel_gf_CheckIdempotency(requestId)) {
        // 返回缓存结果
        return libVibeKernel_gv_lastResponseJson;
    }

    // 3. 白名单分发
    if (operation == "system.ping") {
        result = libVibeKernel_gf_HandleSystemPing(args);
    } else if (operation == "function.invoke") {
        result = libVibeKernel_gf_HandleFunctionInvoke(args);
    } else if (operation == "scenario.reset") {
        result = libVibeKernel_gf_HandleScenarioReset(args);
    } else if (operation == "unit.spawn") {
        result = libVibeKernel_gf_HandleUnitSpawn(args);
    } else if (operation == "unit.kill") {
        result = libVibeKernel_gf_HandleUnitKill(args);
    } else if (operation == "unit.set_vital") {
        result = libVibeKernel_gf_HandleUnitSetVital(args);
    } else if (operation == "player.set_resource") {
        result = libVibeKernel_gf_HandlePlayerSetResource(args);
    } else if (operation == "query.units") {
        result = libVibeKernel_gf_HandleQueryUnits(args);
    } else if (operation == "query.unit") {
        result = libVibeKernel_gf_HandleQueryUnit(args);
    } else if (operation == "query.mission") {
        result = libVibeKernel_gf_HandleQueryMission(args);
    } else if (operation == "visual.actor_tint") {
        result = libVibeKernel_gf_HandleVisualActorTint(args);
    } else if (operation == "visual.actor_scale") {
        result = libVibeKernel_gf_HandleVisualActorScale(args);
    } else if (operation == "visual.actor_opacity") {
        result = libVibeKernel_gf_HandleVisualActorOpacity(args);
    } else if (operation == "upgrade.set_level") {
        result = libVibeKernel_gf_HandleUpgradeSetLevel(args);
    } else if (operation == "tech_tree.check") {
        result = libVibeKernel_gf_HandleTechTreeCheck(args);
    } else if (operation == "query.unit_tags") {
        result = libVibeKernel_gf_HandleQueryUnitTags(args);
    } else if (operation == "query.unit_attrs") {
        result = libVibeKernel_gf_HandleQueryUnitAttrs(args);
    } else {
        // 未知操作，100% 拒绝（不 fallback）
        libVibeKernel_gv_rejectedCount += 1;
        result = libVibeKernel_gf_MakeResponse("error", sessionId, requestId, sequence, operation, "UNKNOWN_OPERATION", "{}");
    }

    // 4. 写入 Bank 供 Host 读取
    libVibeKernel_gf_WriteResponseToBank(requestId, result);

    return result;
}

// ---- Bank 轮询入口 ----
// Host 将 request_id 写入 Bank(section="index", key="pending_request_id")
// Kernel 定时轮询该键，发现新 request_id 后读取完整请求并分发
bool libVibeKernel_gt_BankPoll_Func(bool testConds, bool runActions) {
    string pendingId;
    string requestJson;
    string response;
    string opName;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    // Refresh before the diagnostic write so external Host requests are not
    // overwritten by the cached Bank handle.
    libVibeKernel_gf_ReloadBank();
    // 诊断标记：证明 BankPoll 触发器被调用（每次递增）
    libVibeKernel_gv_bankPollCount += 1;

    // 读取 pending_request_id
    pendingId = libVibeKernel_gf_ReadBankKey("index", "pending_request_id");
    if (pendingId == "") { return true; }
    if (pendingId == libVibeKernel_gv_lastPolledRequestId) { return true; }

    // 读取完整请求
    requestJson = libVibeKernel_gf_ReadBankKey("request", pendingId);
    if (requestJson == "") { return true; }

    // 分发处理
    response = libVibeKernel_gf_Dispatch(requestJson);
    libVibeKernel_gv_lastPolledRequestId = pendingId;

    // 简短回声（完整响应已写入 Bank）
    opName = libVibeKernel_gf_ArgsGet(requestJson, "operation");
    libVibeKernel_gf_EchoChat("[Vibe] " + opName + " done (id=" + pendingId + ")");

    return true;
}

// ---- Chat 入口 ----
// 聊天前缀 "!vibe" 触发，格式："!vibe <args_string>"
// args_string 包含完整请求字段：session_id=...;request_id=...;operation=...;...
// Kernel 直接从聊天消息解析请求，不依赖 Bank 读取请求
bool libVibeKernel_gt_ChatCommand_Func(bool testConds, bool runActions) {
    string chat;
    string requestArgs;
    string response;
    string opName;
    string requestId;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    chat = EventChatMessage(false);
    // 期望格式："!vibe <args_string>"
    if (StringFind(chat, "!vibe ", false) != 1) { return true; }

    // 提取 args_string（"!vibe " 后的全部内容）
    requestArgs = libVibeKernel_gf_Trim(StringSub(chat, 7, StringLength(chat)));
    if (requestArgs == "") {
        libVibeKernel_gf_EchoChat("[Vibe] 用法：!vibe <args_string>");
        return true;
    }

    // 直接分发（args_string 已是 key=value;key=value 格式）
    response = libVibeKernel_gf_Dispatch(requestArgs);
    opName = libVibeKernel_gf_ArgsGet(requestArgs, "operation");
    requestId = libVibeKernel_gf_ArgsGet(requestArgs, "request_id");
    libVibeKernel_gf_EchoChat("[Vibe] " + opName + " done (id=" + requestId + ")");

    return true;
}

// ---- MapCommand 入口 ----
// SC2API RequestMapCommand(trigger_cmd="vibe") 触发。
// Host 先把完整请求写入 Bank(request/<pending_id>)，这里只负责可靠唤醒并分发。
+// ---- P1 -> P2 cooperative ally command channel ----
// Only player 1 may issue this channel; every order is issued to player 2.
// Commands: !ally follow|regroup|defend|attack|retreat|status|help
bool libVibeKernel_gt_AllyCommand_Func(bool testConds, bool runActions) {
    string chat;
    string command;
    unitgroup p2Units;
    unitgroup enemyUnits;
    unit target;
    int unitCount;
    int enemyCount;
    if (testConds) { return true; }
    if (!runActions) { return true; }
    if (EventPlayer() != 1) { return true; }
    chat = EventChatMessage(false);
    if (StringFind(chat, "!ally ", false) != 1) { return true; }
    command = StringWord(chat, 2);
    if (command == "") {
        libVibeKernel_gf_EchoChat("[Ally P2] Commands: follow, attack, defend, regroup, retreat, status, help.");
        return true;
    }
    if (chat == libVibeKernel_gf_ReadBankKey("ally", "last_command")) { return true; }
    libVibeKernel_gf_WriteBankKey("ally", "last_command", chat);
    libVibeKernel_gf_WriteBankInt("ally", "command_count",
        libVibeKernel_gf_ReadBankInt("ally", "command_count") + 1);
    libVibeKernel_gf_WriteBankKey("ally", "last_mode", command);
    if (!PlayerGroupHasPlayer(PlayerGroupAlliance(c_playerGroupAlly, 1), 2)) {
        libVibeKernel_gf_EchoChat("[Ally P2] Rejected: P2 is not allied to P1.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "rejected_not_allied");
        return true;
    }
    p2Units = UnitGroup(null, 2, RegionEntireMap(),
        UnitFilter(0, 0, (1 << c_targetFilterMissile),
            (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    unitCount = UnitGroupCount(p2Units, c_unitCountAlive);
    if (command == "status") {
        libVibeKernel_gf_EchoChat("[Ally P2] Status: " + IntToString(unitCount) + " living units; mode=ready.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "status");
        return true;
    }
    if (command == "help") {
        libVibeKernel_gf_EchoChat("[Ally P2] Commands: follow, attack, defend, regroup, retreat, status, help.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "help");
        return true;
    }
    if ((command == "follow") || (command == "regroup") || (command == "defend") || (command == "retreat")) {
        UnitGroupIssueOrder(p2Units,
            OrderTargetingPoint(AbilityCommand("move", 0), PlayerStartLocation(1)),
            c_orderQueueReplace);
        libVibeKernel_gf_EchoChat("[Ally P2] Acknowledged: " + command + ". Moving to P1 defense point.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "acknowledged");
        return true;
    }
    if (command == "attack") {
        enemyUnits = UnitGroupAlliance(2, c_unitAllianceEnemy, RegionEntireMap(),
            UnitFilter(0, 0, (1 << c_targetFilterMissile),
                (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        enemyCount = UnitGroupCount(enemyUnits, c_unitCountAlive);
        if (enemyCount <= 0) {
            libVibeKernel_gf_EchoChat("[Ally P2] Attack acknowledged, but no hostile target is visible.");
            libVibeKernel_gf_WriteBankKey("ally", "last_result", "attack_no_target");
            return true;
        }
        target = UnitGroupClosestToPoint(enemyUnits, PlayerStartLocation(1));
        UnitGroupIssueOrder(p2Units,
            OrderTargetingUnit(AbilityCommand("attack", 0), target),
            c_orderQueueReplace);
        libVibeKernel_gf_EchoChat("[Ally P2] Acknowledged: attack. P2 units engaging hostile target.");
        libVibeKernel_gf_WriteBankKey("ally", "last_result", "attack_issued");
        return true;
    }
    libVibeKernel_gf_EchoChat("[Ally P2] Unknown command. Try: follow, attack, defend, regroup, retreat, status.");
    libVibeKernel_gf_WriteBankKey("ally", "last_result", "rejected_unknown");
    return true;
}

bool libVibeKernel_gt_MapCommand_Func(bool testConds, bool runActions) {
    string pendingId;
    string requestJson;
    string response;
    string opName;
    if (testConds) { return true; }
    if (!runActions) { return true; }

    // 诊断标记：证明 MapCommand 触发器被调用
    libVibeKernel_gv_mapCommandCount += 1;
    libVibeKernel_gf_WriteBankInt("diag", "mapcmd_count", libVibeKernel_gv_mapCommandCount);

    // 读取 pending_request_id
    pendingId = libVibeKernel_gf_ReadBankKey("index", "pending_request_id");
    if (pendingId == "") { return true; }
    if (pendingId == libVibeKernel_gv_lastPolledRequestId) { return true; }

    // 读取完整请求
    requestJson = libVibeKernel_gf_ReadBankKey("request", pendingId);
    if (requestJson == "") { return true; }

    // 分发处理
    response = libVibeKernel_gf_Dispatch(requestJson);
    libVibeKernel_gv_lastPolledRequestId = pendingId;

    // 简短回声
    opName = libVibeKernel_gf_ArgsGet(requestJson, "operation");
    libVibeKernel_gf_EchoChat("[Vibe] " + opName + " done (id=" + pendingId + ")");

    return true;
}

// ---- 注册入口 ----
void libVibeKernel_gf_RegisterEntryPoints() {
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_entered", 1);
    if (libVibeKernel_gt_ChatCommand != null) { return; }

    // Chat 入口（手动调试用）
    libVibeKernel_gt_ChatCommand = TriggerCreate("libVibeKernel_gt_ChatCommand_Func");
    TriggerAddEventChatMessage(libVibeKernel_gt_ChatCommand, c_playerAny, "!vibe", false);
    libVibeKernel_gt_AllyCommand = TriggerCreate("libVibeKernel_gt_AllyCommand_Func");
    TriggerAddEventChatMessage(libVibeKernel_gt_AllyCommand, c_playerAny, "!ally", false);
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_chat_done", 1);

    // Bank 轮询入口（API 自动化用，每 0.5 秒检查一次）
    libVibeKernel_gt_BankPoll = TriggerCreate("libVibeKernel_gt_BankPoll_Func");
    TriggerAddEventTimePeriodic(libVibeKernel_gt_BankPoll, 0.5, c_timeGame);

    // MapCommand 入口（SC2API RequestMapCommand 触发）
    libVibeKernel_gt_MapCommand = TriggerCreate("libVibeKernel_gt_MapCommand_Func");
    TriggerAddEventMapCommand(libVibeKernel_gt_MapCommand, c_playerAny, "vibe", false);
    libVibeKernel_gf_WriteBankInt("index", "register_entrypoints_mapcommand_done", 1);
}

// ---- 初始化 ----
void libVibeKernel_gf_Init() {
    if (libVibeKernel_gv_initialized) { return; }
    libVibeKernel_gv_initialized = true;

    // 银行写入优先（证明 Init 被进入，供 Host 端验证）
    libVibeKernel_gf_WriteBankInt("index", "init_entered", 1);

    libVibeKernel_gv_stateVersion = 0;
    libVibeKernel_gv_currentSession = "";
    libVibeKernel_gv_lastSequence = -1;
    libVibeKernel_gv_lastRequestId = "";
    libVibeKernel_gv_lastResponseJson = "";
    libVibeKernel_gv_requestCount = 0;
    libVibeKernel_gv_rejectedCount = 0;

    // 写入初始化标记（Bank 操作可能失败，不影响触发器）
    libVibeKernel_gf_WriteBankInt("index", "kernel_initialized", 1);
    libVibeKernel_gf_WriteBankInt("index", "state_version", 0);
    libVibeKernel_gf_EchoChat("[Vibe] Kernel initialized. Use chat '!vibe <args>'.");
}

// ---- Auto-init 触发器（地图加载后自动初始化）----
bool libVibeKernel_gt_AutoInit_Func(bool testConds, bool runActions) {
    if (testConds) { return true; }
    if (!runActions) { return true; }
    libVibeKernel_gf_Init();
    return true;
}

trigger libVibeKernel_gt_AutoInit = null;

void libVibeKernel_InitLib() {
    // 写入银行标记，证明 InitLib 被调用（供 Host 端验证）
    libVibeKernel_gf_WriteBankInt("index", "initlib_entered", 1);
    libVibeKernel_gf_Init();
}
